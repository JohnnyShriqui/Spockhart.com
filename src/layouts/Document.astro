---
/** Long-form document pages: security, privacy, terms, accessibility. */
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';

interface Props {
  title: string;
  eyebrow: string;
  lead: string;
  description: string;
  updated?: string;
}
const { title, eyebrow, lead, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <PageHero eyebrow={eyebrow} title={title} lead={lead} />
  <section class="section tight">
    <div class="wrap doc">
      <aside class="doc-aside">
        {updated && <p class="updated"><span>Last updated</span>{updated}</p>}
        <slot name="aside" />
      </aside>
      <div class="prose legal">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .doc { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--s-6); }
  .doc-aside { display: grid; gap: var(--s-4); align-content: start; position: sticky; top: 112px; }
  .updated { font-size: 0.875rem; color: var(--ink-2); }
  .updated span {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }
  @media (max-width: 860px) {
    .doc { grid-template-columns: minmax(0, 1fr); }
    .doc-aside { position: static; }
  }
</style>
