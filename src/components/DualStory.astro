---
/**
 * "Built for business. Driven by purpose." told as two charts and no copy. For growing companies,
 * revenue climbs away from costs and the gap opens. For nonprofits, resources rise to meet
 * demand and the gap closes. One firm joins the two. Illustrations, not data.
 * The lines draw in when the section scrolls into view.
 */
const biz = {
  revenue: 'M24 128 C150 120 260 82 376 38',
  costs: 'M24 128 C150 136 260 160 376 172',
  gap: 'M24 128 C150 120 260 82 376 38 L376 172 C260 160 150 136 24 128 Z',
};
const np = {
  demand: 'M24 62 C150 58 260 54 376 48',
  resources: 'M24 182 C150 176 260 110 376 54',
  gap: 'M24 62 C150 58 260 54 376 48 L376 54 C260 110 150 176 24 182 Z',
};
---

<div class="dual" data-dual>
  <h2 class="visually-hidden">Built for business. Driven by purpose.</h2>

  <div class="half half-biz">
    <p class="half-title" aria-hidden="true">Built for business.</p>
    <svg class="chart" viewBox="0 0 400 210" role="img" aria-label="For growing companies: revenue climbs away from costs, and the gap between them opens.">
      <path d="M24 50H376M24 100H376M24 150H376" class="grid" />
      <path d="M24 200H376" class="base" />
      <path d={biz.gap} class="gap gap-biz" />
      <path d={biz.costs} pathLength="1" class="line line-costs" />
      <path d={biz.revenue} pathLength="1" class="line line-revenue" />
      <circle cx="376" cy="38" r="5" class="dot dot-revenue" />
      <circle cx="376" cy="172" r="4.5" class="dot dot-costs" />
      <text x="362" y="24" text-anchor="end" class="lbl lbl-revenue">Revenue</text>
      <text x="362" y="194" text-anchor="end" class="lbl lbl-costs">Costs</text>
    </svg>
    <a class="half-link" href="/approach/">For growing companies <span aria-hidden="true">→</span></a>
  </div>

  <div class="half half-np">
    <p class="half-title" aria-hidden="true">Driven by purpose.</p>
    <svg class="chart" viewBox="0 0 400 210" role="img" aria-label="For nonprofits: resources rise to meet demand, and the gap between them closes.">
      <defs>
        <pattern id="dual-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <path d="M0 0V7" stroke="rgb(142 192 230 / 0.28)" stroke-width="1.5" />
        </pattern>
      </defs>
      <path d="M24 50H376M24 100H376M24 150H376" class="grid grid-np" />
      <path d="M24 200H376" class="base base-np" />
      <path d={np.gap} class="gap gap-np" />
      <path d={np.demand} pathLength="1" class="line line-demand" />
      <path d={np.resources} pathLength="1" class="line line-resources" />
      <circle cx="24" cy="62" r="4.5" class="dot dot-demand" />
      <circle cx="24" cy="182" r="4.5" class="dot dot-resources" />
      <circle cx="376" cy="51" r="6" class="dot dot-meet" />
      <text x="38" y="48" class="lbl lbl-demand">Demand</text>
      <text x="38" y="201" class="lbl lbl-resources">Resources</text>
    </svg>
    <a class="half-link" href="/nonprofits/">For nonprofits <span aria-hidden="true">→</span></a>
  </div>

  <div class="dual-badge" aria-hidden="true"><span>Spockhart</span></div>
</div>

<script>
  // The lines draw in once, when the section comes into view
  function initDual() {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-dual]').forEach((el) => {
      if (el.dataset.ready || still || !('IntersectionObserver' in window)) return;
      el.dataset.ready = '1';
      const play = () => {
        el.classList.add('is-playing');
        el.classList.remove('will-play');
      };
      if (el.getBoundingClientRect().top < window.innerHeight * 0.85) {
        play();
        return;
      }
      el.classList.add('will-play');
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          play();
        },
        { threshold: 0.3 },
      );
      io.observe(el);
    });
  }
  initDual();
  document.addEventListener('spockhart:view', initDual);
</script>

<style>
  .dual {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-radius: 24px;
    box-shadow: 0 1px 2px rgb(27 42 61 / 0.05), 0 50px 90px -60px rgb(27 42 61 / 0.6);
  }
  .half {
    display: grid;
    gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    align-content: start;
    padding: clamp(2.25rem, 1.5rem + 2.5vw, 3.75rem) clamp(1.5rem, 1rem + 2vw, 3.25rem) clamp(1.75rem, 1.25rem + 1.5vw, 2.5rem);
  }
  .half-biz { background: #fff; border-radius: 24px 0 0 24px; }
  .half-np {
    background:
      radial-gradient(80% 60% at 100% 0%, rgb(74 138 186 / 0.35), transparent 70%),
      linear-gradient(160deg, #1d3a57 0%, #122538 70%, #0e1d2d 100%);
    border-radius: 0 24px 24px 0;
  }
  .half-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.5rem);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .half-np .half-title { color: #fff; font-style: italic; font-weight: 400; }
  .chart { width: 100%; height: auto; overflow: visible; }
  .half-link { justify-self: start; font-weight: 600; font-size: 0.9375rem; color: var(--accent); text-decoration: none; }
  .half-link:hover { text-decoration: underline; }
  .half-np .half-link { color: #b9dcf5; }

  /* The firm, joining the two */
  .dual-badge {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 2;
    transform: translate(-50%, -50%);
    padding: 0.85rem 1.4rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid rgb(27 42 61 / 0.1);
    box-shadow: 0 14px 30px -14px rgb(27 42 61 / 0.5);
  }
  .dual-badge span {
    display: block;
    font-family: var(--font-wordmark);
    font-size: 0.75rem;
    letter-spacing: 0.34em;
    margin-right: -0.34em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
  }

  /* Charts */
  .grid { stroke: rgb(27 42 61 / 0.06); stroke-width: 1; fill: none; }
  .grid-np { stroke: rgb(255 255 255 / 0.07); }
  .base { stroke: rgb(27 42 61 / 0.22); stroke-width: 1.2; }
  .base-np { stroke: rgb(255 255 255 / 0.2); }
  .line { fill: none; stroke-linecap: round; stroke-dasharray: 1 1; }
  .line-revenue { stroke: #2c5f8a; stroke-width: 3.5; }
  .line-costs { stroke: #a9524a; stroke-width: 2.5; }
  .line-demand { stroke: #eef3f8; stroke-width: 3; }
  .line-resources { stroke: #8ec0e6; stroke-width: 3.5; }
  .gap-biz { fill: rgb(44 95 138 / 0.12); }
  .gap-np { fill: url(#dual-hatch); }
  .dot-revenue { fill: #2c5f8a; }
  .dot-costs { fill: #a9524a; }
  .dot-demand { fill: #eef3f8; }
  .dot-resources { fill: #8ec0e6; }
  .dot-meet { fill: #8ec0e6; stroke: #122538; stroke-width: 2.5; }
  .lbl { font-family: var(--font-body); font-size: 13px; font-weight: 600; }
  .lbl-revenue { fill: #2c5f8a; }
  .lbl-costs { fill: #a9524a; }
  .lbl-demand { fill: #eef3f8; }
  .lbl-resources { fill: #8ec0e6; }

  /* Drawing in: lines draw left to right, the gaps follow behind them */
  .will-play .line { stroke-dashoffset: 1; }
  .will-play .gap, .will-play .dot, .will-play .lbl { opacity: 0; }
  .is-playing .line { animation: dual-draw 1800ms var(--ease-out) 150ms both; }
  .is-playing .gap { animation: dual-gap 1800ms var(--ease-out) 250ms both; }
  .is-playing .dot, .is-playing .lbl { animation: dual-fade 600ms var(--ease) 1500ms both; }
  .is-playing .dot-demand, .is-playing .dot-resources, .is-playing .lbl-demand, .is-playing .lbl-resources { animation-delay: 200ms; }
  @keyframes dual-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes dual-gap { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes dual-fade { from { opacity: 0; } to { opacity: 1; } }

  @media (max-width: 760px) {
    .dual { grid-template-columns: minmax(0, 1fr); border-radius: 20px; }
    .half-biz { border-radius: 20px 20px 0 0; }
    .half-np { border-radius: 0 0 20px 20px; }
    .half { padding-top: 2.5rem; }
  }
</style>
