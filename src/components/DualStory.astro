---
/**
 * Who we are, in one sentence across one card: "Built for Business, Driven by Purpose".
 * The card fades from daylight on the left to deep navy on the right, with no line between.
 * Left, for corporations, the revenue vs costs bars from the home page. Right, for nonprofits,
 * the demand and resources chart from the Nonprofits page. Both are held on their finished frame.
 * The two sides mirror each other, so the middle stays open for the fade.
 */
import HeroLive from './HeroLive.astro';
import GapChart from './GapChart.astro';
import { smoothFade } from '../lib/fade';

interface Props {
  /** 1 when this opens the page */
  level?: 1 | 2;
}
const { level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const Label = level === 1 ? 'h2' : 'h3';

/* Daylight to deep navy: flat at each side, one long smooth blend across the middle */
const LIGHT = '#f2f5f9';
const NAVY = '#0f2135';
const fadeX = smoothFade('90deg', LIGHT, NAVY, 18, 82, 40);
const fadeY = smoothFade('180deg', LIGHT, NAVY, 40, 62, 40);
---

<section class="bp" aria-label="Built for Business, Driven by Purpose">
  <Heading class="visually-hidden">Built for Business, Driven by Purpose</Heading>

  <div class="bp-stage" style={`--fade-x:${fadeX};--fade-y:${fadeY}`}>
  <div class="bp-card">
    <div class="side side-biz">
      <p class="side-title load-in" style="--i:1" aria-hidden="true">Built for Business,</p>
      <Label class="side-label load-in" style="--i:2">Corporations</Label>
      <div class="side-figure load-fade">
        <HeroLive inline light still labels />
      </div>
      <a class="side-link" href="/approach/">How we work <span aria-hidden="true">→</span></a>
    </div>

    <div class="side side-np">
      <p class="side-title load-in" style="--i:2" aria-hidden="true">Driven by Purpose</p>
      <Label class="side-label load-in" style="--i:3">Nonprofits</Label>
      <div class="side-figure load-fade">
        <GapChart still />
      </div>
      <a class="side-link" href="/nonprofits/">Nonprofits <span aria-hidden="true">→</span></a>
    </div>
  </div>
  </div>
</section>

<style>
  .bp {
    padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px));
  }
  .bp-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    /* The two sides share rows, so titles, labels, graphics and links line up */
    grid-template-rows: auto auto 1fr auto;
    border-radius: 28px;
    overflow: hidden;
    /* Daylight to deep navy (see --fade-x), with a soft glow in each top corner */
    background:
      radial-gradient(50% 70% at 0% 0%, rgb(255 255 255 / 0.7), transparent 70%),
      radial-gradient(45% 75% at 100% 0%, rgb(46 104 152 / 0.42), transparent 70%),
      var(--fade-x);
    /* Standing in the room: a lit top edge, a tight contact shadow, and a long soft one */
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 1px 1px rgb(12 26 41 / 0.08),
      0 6px 10px -4px rgb(12 26 41 / 0.14),
      0 34px 50px -26px rgb(12 26 41 / 0.42),
      0 80px 110px -50px rgb(12 26 41 / 0.42);
  }
  /* The stage: the card and its shadow on the floor */
  .bp-stage { position: relative; isolation: isolate; max-width: var(--max); margin-inline: auto; }
  .bp-stage::before {
    content: '';
    position: absolute;
    z-index: -2;
    left: 7%;
    right: 7%;
    bottom: -46px;
    height: 70px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(12 26 41 / 0.32), rgb(12 26 41 / 0.12) 55%, transparent);
    filter: blur(10px);
  }
  /* Engineering paper on the light side, fading out before the middle */
  .bp-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(27 42 61 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(27 42 61 / 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, rgb(0 0 0 / 0.5) 20%, transparent 40%);
    mask-image: linear-gradient(90deg, #000 0%, rgb(0 0 0 / 0.5) 20%, transparent 40%);
  }
  /* A fine grain across the card: texture on the navy, and a dither that keeps the blend from banding */
  .bp-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 200px;
    opacity: 0.1;
    mix-blend-mode: overlay;
  }

  .side {
    display: grid;
    grid-row: 1 / span 4;
    grid-template-rows: subgrid;
    row-gap: 0.85rem;
    padding: clamp(2.25rem, 1.5rem + 2vw, 3.25rem) clamp(1.75rem, 1rem + 2.5vw, 3.5rem) clamp(2rem, 1.25rem + 1.75vw, 2.75rem);
  }
  .side-biz { grid-column: 1; justify-items: start; }
  /* The right side mirrors the left */
  .side-np {
    grid-column: 2;
    justify-items: end;
    text-align: right;
    /* The dark-hero colours, so the nonprofit chart reads as it does on its own page */
    --ink: #eef3f8;
    --ink-2: #b5c4d3;
    --ink-3: #94a8bc;
    --rule: rgb(255 255 255 / 0.1);
    --rule-2: rgb(255 255 255 / 0.2);
    --accent: #8ec0e6;
    --accent-soft: #6fa8d6;
    --paper: #102236;
    color: var(--ink);
  }

  .side-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.25rem + 2.4vw, 3.25rem);
    font-weight: 450;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #1b2a3d;
    white-space: nowrap;
  }
  .side-np .side-title { color: #fff; font-style: italic; font-weight: 400; }

  .side-label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2c5f8a;
  }
  .side-np .side-label { color: #8ec0e6; margin-right: -0.18em; }

  .side-figure { align-self: end; width: 100%; max-width: 380px; margin-top: 1.25rem; }
  .side-biz .side-figure :global(.live-inline) { max-width: none; margin: 0; }
  .side-np .side-figure :global(.gap) { max-width: none; }

  .side-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding: 0.6rem 1.05rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.875rem;
    text-decoration: none;
    color: #1b2a3d;
    border: 1px solid rgb(27 42 61 / 0.18);
    background: rgb(255 255 255 / 0.5);
    transition: background-color 300ms var(--ease), border-color 300ms var(--ease);
  }
  .side-link:hover { background: #fff; border-color: rgb(27 42 61 / 0.35); }
  .side-np .side-link { color: #fff; border-color: rgb(255 255 255 / 0.25); background: rgb(255 255 255 / 0.04); }
  .side-np .side-link:hover { background: rgb(255 255 255 / 0.1); border-color: rgb(255 255 255 / 0.5); }

  /* Tablets and phones: one side above the other, fading top to bottom */
  @media (max-width: 900px) {
    .bp-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      border-radius: 22px;
      background:
        radial-gradient(80% 30% at 0% 0%, rgb(255 255 255 / 0.7), transparent 70%),
        radial-gradient(80% 30% at 100% 100%, rgb(46 104 152 / 0.4), transparent 70%),
        var(--fade-y);
    }
    .bp-card::before { -webkit-mask-image: linear-gradient(180deg, #000 0%, transparent 42%); mask-image: linear-gradient(180deg, #000 0%, transparent 42%); }
    .side { grid-row: auto; grid-column: auto; grid-template-rows: none; }
    .side-biz { padding-bottom: 4.5rem; }
    .side-np { padding-top: 4.5rem; justify-items: start; text-align: left; }
    .side-np .side-label { margin-right: 0; }
    .side-figure { max-width: 420px; }
    .side-title { white-space: normal; }
  }
</style>
