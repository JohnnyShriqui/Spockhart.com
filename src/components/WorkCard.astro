---
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const { title, summary, sector, client, metrics, kind, status } = entry.data;
const lead = metrics[0];
---

<article class="work-card">
  <a class="work-link" href={`/work/${entry.id}/`}>
    <div class="work-top">
      <span class="tag">{status === 'in-development' ? 'In development' : kind === 'spockhart' ? 'Spockhart client work' : 'Team experience'}</span>
      <span class="work-sector">{sector}</span>
    </div>
    <p class="work-metric">{lead.value}</p>
    <p class="work-metric-label">{lead.label}</p>
    <h3>{title}</h3>
    <p class="work-summary">{summary}</p>
    <span class="work-spacer" aria-hidden="true"></span>
    <p class="work-foot">
      <span class="work-client">{client}</span>
      <span class="arr" aria-hidden="true">→</span>
    </p>
  </a>
</article>

<style>
  .work-card {
    display: grid;
    grid-row: span 7;
    grid-template-rows: subgrid;
    row-gap: 0;
  }
  .work-link {
    display: grid;
    grid-row: span 7;
    grid-template-rows: subgrid;
    row-gap: var(--s-3);
    padding: var(--s-6) var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 400ms var(--ease), transform 400ms var(--ease-out), box-shadow 400ms var(--ease);
  }
  .work-link:hover {
    border-color: var(--accent-soft);
    transform: translateY(-3px);
    box-shadow: 0 14px 30px -22px rgb(15 26 43 / 0.45);
  }
  .work-spacer { display: block; }
  .work-top { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  .work-sector { font-size: 0.8125rem; color: var(--ink-3); }
  .work-metric {
    margin-top: var(--s-4);
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.3vw, 2.375rem);
    font-weight: 450;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--ink);
    font-variant-numeric: lining-nums;
  }
  .work-metric-label { font-size: 0.875rem; color: var(--accent); font-weight: 600; margin-top: -0.25rem; }
  .work-link h3 { font-size: var(--step-1); font-family: var(--font-display); font-weight: 550; margin-top: var(--s-3); }
  .work-summary { color: var(--ink-2); font-size: 0.975rem; }
  .work-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
    color: var(--ink-3);
  }
  .work-foot .arr { color: var(--ink); transition: transform var(--dur) var(--ease); }
  .work-link:hover .arr { transform: translateX(4px); }
</style>
