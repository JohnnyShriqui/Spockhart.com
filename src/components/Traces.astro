---
/**
 * Approach, below the hero: fine lines that run down out of the dark hero and through the page,
 * drawn to fit the layout, like a circuit. A spine down the left margin branches into each
 * section's heading marker and ends at the closing line; a quieter one runs down the right margin.
 * Each set of steps is fed from the spine by a line that drops into the top of every card, and the
 * first set joins back into the spine below it, so the scroll reads as one connected path.
 * A light grid of dots sits behind it all. Still, decorative, behind the content.
 */
---

<div class="traces" aria-hidden="true" data-traces>
  <svg><g data-traces-draw></g></svg>
</div>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const el = (name: string, attrs: Record<string, string | number>) => {
    const n = document.createElementNS(NS, name);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    return n;
  };

  function drawTraces() {
    const host = document.querySelector<HTMLElement>('[data-traces]');
    const g = host?.querySelector<SVGGElement>('[data-traces-draw]');
    if (!host || !g) return;
    const svg = g.ownerSVGElement!;
    g.replaceChildren();
    if (window.matchMedia('(max-width: 900px)').matches) return;

    const box = host.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width.toFixed(0)} ${box.height.toFixed(0)}`);
    const X = (x: number) => +(x - box.left).toFixed(1);
    const Y = (y: number) => +(y - box.top).toFixed(1);

    // Card positions from the (unmoving) lists, so a card still rising into place is measured
    // where it will settle
    const sets = Array.from(document.querySelectorAll<HTMLElement>('.engagement')).map((section) => {
      const list = section.querySelector<HTMLElement>('.phases')!;
      const lr = list.getBoundingClientRect();
      const cards = Array.from(list.children).map((c) => {
        const card = c as HTMLElement;
        const left = lr.left + card.offsetLeft - list.offsetLeft;
        return { cx: X(left + card.offsetWidth / 2), top: Y(lr.top + card.offsetTop - list.offsetTop), bottom: Y(lr.top + card.offsetTop - list.offsetTop + card.offsetHeight) };
      });
      const brow = section.querySelector<HTMLElement>('.eyebrow')!.getBoundingClientRect();
      return { cards, left: X(lr.left), right: X(lr.right), mark: { x: X(brow.left) + 3, y: Y(brow.top + brow.height / 2) } };
    });
    if (!sets.length) return;
    const closing = document.querySelector<HTMLElement>('.closing h2')?.getBoundingClientRect();

    const path = (d: string, cls: string) => g.append(el('path', { d, class: cls }));
    const node = (x: number, y: number, cls = 'tr-node', r = 3.2) => g.append(el('circle', { cx: x, cy: y, r, class: cls }));

    // The left spine: down from the hero, a branch into each heading marker, ending at the closing
    const sx = Math.max(14, sets[0].left - 34);
    const stops = sets.map((s) => s.mark);
    if (closing) stops.push({ x: X(closing.left) - 4, y: Y(closing.top + closing.height / 2) });
    path(`M${sx} 0 V${stops[stops.length - 1].y}`, 'tr-spine');
    stops.forEach((s, i) => {
      path(`M${sx} ${s.y} H${s.x - (i < sets.length ? 9 : 10)}`, 'tr-branch');
      node(sx, s.y);
    });

    // The right spine, quieter: nodes level with the top and bottom of each set of steps
    const rx = Math.min(box.width - 14, sets[0].right + 34);
    const last = sets[sets.length - 1];
    path(`M${rx} 0 V${last.cards[0].bottom}`, 'tr-spine tr-quiet');
    sets.forEach((s) => {
      node(rx, s.cards[0].top + 28, 'tr-node tr-quiet');
      node(rx, s.cards[0].bottom - 28, 'tr-node tr-quiet');
    });

    // Short lines fall from the hero above each step of the first set and fade
    sets[0].cards.forEach((c, i) => {
      const end = 58 + ((i * 37) % 4) * 18;
      path(`M${c.cx} 0 V${end}`, 'tr-drop');
      node(c.cx, end, 'tr-dot', 2);
    });

    // Each set of steps is fed from the spine: a line branches off just above the cards and drops
    // into the top of each one. The first set's cards then join back into the spine below them,
    // so the path runs on to the second set.
    sets.forEach((s, k) => {
      const lastX = s.cards[s.cards.length - 1].cx;
      const inY = s.cards[0].top - 30;
      path(`M${sx} ${inY} H${lastX}`, 'tr-bus');
      node(sx, inY, 'tr-node', 2.6);
      s.cards.forEach((c) => {
        path(`M${c.cx} ${inY} V${c.top}`, 'tr-stub');
        node(c.cx, c.top, 'tr-dot', 2.4);
      });
      if (k < sets.length - 1) {
        const outY = s.cards[0].bottom + 44;
        path(`M${lastX} ${outY} H${sx}`, 'tr-bus');
        node(sx, outY, 'tr-node', 2.6);
        s.cards.forEach((c) => {
          path(`M${c.cx} ${c.bottom} V${outY}`, 'tr-stub');
          node(c.cx, c.bottom, 'tr-dot', 2.4);
        });
      }
    });
  }

  function initTraces() {
    const host = document.querySelector<HTMLElement>('[data-traces]');
    if (!host || host.dataset.ready) return;
    host.dataset.ready = '1';
    let raf = 0;
    const soon = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(drawTraces);
    };
    drawTraces();
    document.fonts?.ready.then(soon);
    if ('ResizeObserver' in window) new ResizeObserver(soon).observe(host);
    window.addEventListener('resize', soon, { passive: true });
  }
  initTraces();
  document.addEventListener('spockhart:view', initTraces);
</script>

<style>
  .traces {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    --tr: 27 42 61;
    --tr-ground: var(--paper);
    /* A light grid of dots, a little stronger near the hero */
    background-image: radial-gradient(circle, rgb(var(--tr) / 0.1) 1px, transparent 1.4px);
    background-size: 28px 28px;
    background-position: 14px 6px;
    -webkit-mask-image: linear-gradient(180deg, #000 0, rgb(0 0 0 / 0.5) 22%, rgb(0 0 0 / 0.35) 80%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0, rgb(0 0 0 / 0.5) 22%, rgb(0 0 0 / 0.35) 80%, transparent 100%);
  }
  @media (prefers-color-scheme: dark) {
    .traces { --tr: 238 243 248; --tr-ground: #111930; background-image: radial-gradient(circle, rgb(var(--tr) / 0.06) 1px, transparent 1.4px); }
  }
  .traces svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .traces :global(path) { fill: none; stroke-width: 1; }
  .traces :global(.tr-spine) { stroke: rgb(var(--tr) / 0.28); }
  .traces :global(.tr-branch) { stroke: rgb(var(--tr) / 0.34); }
  .traces :global(.tr-quiet) { stroke-opacity: 0.55; }
  .traces :global(.tr-drop) { stroke: rgb(var(--tr) / 0.3); }
  .traces :global(.tr-bus) { stroke: rgb(var(--tr) / 0.2); }
  .traces :global(.tr-stub) { stroke: rgb(var(--tr) / 0.28); }
  .traces :global(.tr-node) { fill: var(--tr-ground); stroke: rgb(var(--tr) / 0.5); stroke-width: 1; }
  .traces :global(.tr-node.tr-quiet) { stroke: rgb(var(--tr) / 0.28); }
  .traces :global(.tr-dot) { fill: rgb(var(--tr) / 0.45); }
</style>
