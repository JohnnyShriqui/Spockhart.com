---
/**
 * Approach, below the hero: a fine line runs down the left margin out of the dark hero, like a
 * circuit, drawn to fit the layout, and runs the whole way down to the footer. It feeds each set of
 * steps through a line that drops into the top of every card.
 * A light grid of dots sits behind it all. Decorative, behind the content.
 * The first time a set of steps comes into view on a visit, its line draws itself: across from the
 * left line, dropping into each card as it reaches it, and each card rises as its line lands
 * (the cards' timing is in Timeline.astro).
 */
---

<div class="traces" aria-hidden="true" data-traces>
  <svg><g data-traces-draw></g></svg>
</div>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  // Drawing schedule, in ms from when a set starts showing. The line reaches card k at
  // LEAD + k * STEP, then drops into it over DROP. Timeline.astro starts card k at
  // LEAD + k * STEP + 120, so it rises as the line lands.
  const LEAD = 250;
  const STEP = 450;
  const DROP = 220;
  const TOTAL = LEAD + 3 * STEP + DROP + 400;

  const el = (name: string, attrs: Record<string, string | number>) => {
    const n = document.createElementNS(NS, name);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    return n;
  };

  function drawTraces() {
    const host = document.querySelector<HTMLElement>('[data-traces]');
    const g = host?.querySelector<SVGGElement>('[data-traces-draw]');
    if (!host || !g) return;
    const svg = g.ownerSVGElement!;
    g.replaceChildren();
    if (window.matchMedia('(max-width: 900px)').matches) return;

    const box = host.getBoundingClientRect();
    svg.setAttribute('viewBox', `0 0 ${box.width.toFixed(0)} ${box.height.toFixed(0)}`);
    const X = (x: number) => +(x - box.left).toFixed(1);
    const Y = (y: number) => +(y - box.top).toFixed(1);

    // Card positions from the (unmoving) lists, so a card still rising into place is measured
    // where it will settle
    const sets = Array.from(document.querySelectorAll<HTMLElement>('.engagement')).map((section) => {
      const list = section.querySelector<HTMLElement>('.phases')!;
      const lr = list.getBoundingClientRect();
      const cards = Array.from(list.children).map((c) => {
        const card = c as HTMLElement;
        const left = lr.left + card.offsetLeft - list.offsetLeft;
        return { cx: X(left + card.offsetWidth / 2), top: Y(lr.top + card.offsetTop - list.offsetTop), bottom: Y(lr.top + card.offsetTop - list.offsetTop + card.offsetHeight) };
      });
      const head = section.querySelector<HTMLElement>('.section-head')!.getBoundingClientRect();
      return { list, cards, left: X(lr.left), right: X(lr.right), headBottom: Y(head.bottom) };
    });
    if (!sets.length) return;

    const path = (d: string, cls: string, to: Element = g) => {
      const n = el('path', { d, class: cls, pathLength: 1 });
      to.append(n);
      return n;
    };
    const node = (x: number, y: number, cls = 'tr-node', r = 3.2, to: Element = g) => {
      const n = el('circle', { cx: x, cy: y, r, class: cls });
      to.append(n);
      return n;
    };
    const time = (n: Element, delay: number, dur: number, elapsed: number) =>
      n.setAttribute('style', `animation-delay:${(delay - elapsed).toFixed(0)}ms;animation-duration:${dur}ms`);

    // The left spine: down from the hero to the line that feeds the last set of steps
    const sx = Math.max(16, sets[0].left - 46);
    // The left line runs the whole way down, to the footer
    path(`M${sx} 0 V${box.height.toFixed(0)}`, 'tr-spine');

    // Each set of steps is fed from the spine: a line branches off just above the cards and drops
    // into the top of each one
    sets.forEach((s) => {
      // Halfway between the heading and the cards, so it has room on both sides
      const inY = +((s.headBottom + s.cards[0].top) / 2).toFixed(1);
      // Waiting to be reached: nothing yet. Just reached: draw it. Otherwise it is simply there.
      const waiting = s.list.classList.contains('is-waiting');
      const showAt = Number(s.list.dataset.showAt || 0);
      const elapsed = showAt ? performance.now() - showAt : Infinity;
      const drawing = !waiting && s.list.classList.contains('is-showing') && elapsed < TOTAL;
      const set = el('g', { class: `tr-set${waiting ? ' is-waiting' : drawing ? ' is-drawing' : ''}` });
      g.append(set);
      // The line runs across in pieces, card to card, so it can turn down into each as it passes
      let fromX = sx;
      s.cards.forEach((c, k) => {
        const reach = LEAD + k * STEP;
        const bus = path(`M${fromX} ${inY} H${c.cx}`, 'tr-bus', set);
        const stub = path(`M${c.cx} ${inY} V${c.top}`, 'tr-stub', set);
        const dot = node(c.cx, c.top, 'tr-dot', 3, set);
        if (drawing) {
          const start = k === 0 ? 0 : LEAD + (k - 1) * STEP;
          time(bus, start, reach - start, elapsed);
          time(stub, reach, DROP, elapsed);
          time(dot, reach + DROP - 30, 320, elapsed);
        }
        fromX = c.cx;
      });
      // Where the line leaves the left line: always there
      node(sx, inY, 'tr-node', 3.4);
    });
  }

  function initTraces() {
    const host = document.querySelector<HTMLElement>('[data-traces]');
    if (!host || host.dataset.ready) return;
    host.dataset.ready = '1';
    let raf = 0;
    const soon = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(drawTraces);
    };
    drawTraces();
    document.fonts?.ready.then(soon);
    // Redraw when a set of steps starts waiting or showing
    if ('MutationObserver' in window) {
      const mo = new MutationObserver(soon);
      document.querySelectorAll('[data-phases]').forEach((list) => mo.observe(list, { attributes: true, attributeFilter: ['class'] }));
    }
    if ('ResizeObserver' in window) new ResizeObserver(soon).observe(host);
    window.addEventListener('resize', soon, { passive: true });
  }
  initTraces();
  document.addEventListener('spockhart:view', initTraces);
</script>

<style>
  .traces {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* The line in the hero's own deep indigo */
    --tr-line: #131a33;
    --tr-ground: var(--paper);
    --tr-dots: rgb(27 42 61 / 0.1);
  }
  /* A light grid of dots, a little stronger near the hero; only the dots fade, not the line */
  .traces::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--tr-dots) 1px, transparent 1.4px);
    background-size: 28px 28px;
    background-position: 14px 6px;
    -webkit-mask-image: linear-gradient(180deg, #000 0, rgb(0 0 0 / 0.5) 22%, rgb(0 0 0 / 0.35) 80%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 0, rgb(0 0 0 / 0.5) 22%, rgb(0 0 0 / 0.35) 80%, transparent 100%);
  }
  .traces svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .traces :global(path) { fill: none; stroke: var(--tr-line); stroke-width: 1.6; stroke-linecap: round; }
  .traces :global(.tr-node) { fill: var(--tr-ground); stroke: var(--tr-line); stroke-width: 1.6; }
  .traces :global(.tr-dot) { fill: var(--tr-line); }
  /* Drawing in: each piece of line runs from its start to its end, then the dot lands */
  .traces :global(.tr-set.is-waiting) { opacity: 0; }
  .traces :global(.is-drawing path) {
    stroke-dasharray: 1;
    animation-name: tr-draw;
    animation-timing-function: linear;
    animation-fill-mode: both;
  }
  .traces :global(.is-drawing .tr-stub) { animation-timing-function: cubic-bezier(0.4, 0, 0.6, 1); }
  .traces :global(.is-drawing .tr-dot) {
    transform-box: fill-box;
    transform-origin: center;
    animation-name: tr-land;
    animation-timing-function: cubic-bezier(0.3, 1.5, 0.5, 1);
    animation-fill-mode: both;
  }
  @keyframes tr-draw {
    0% { stroke-dashoffset: 1; opacity: 0; }
    1% { opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 1; }
  }
  @keyframes tr-land {
    from { transform: scale(0); }
    to { transform: scale(1); }
  }
</style>
