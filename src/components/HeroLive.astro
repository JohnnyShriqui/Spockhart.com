---
/**
 * Home hero, bottom right: a small, quiet neon readout of the Costs vs revenue chart from
 * further down the page. No labels but the caption. Costs (red) are cut a slice at a time, new
 * revenue (blue) flickers in a slice at a time, the new margin locks in, it holds, and it runs
 * again. Below, the same chart is broken down case study by case study.
 * Decorative; still on its finished frame with reduced motion; hidden on small screens.
 */
const VB_W = 560;
const VB_H = 440;
const BASE = 410;
const W = 60;
const before = { rev: 92, cost: 160 };
const after = { rev: 330, cost: 398 };
const REV = 230;
const COST = 216;
const ADD = 46;
const CUT = 26;
const NB = 3;
const NC = 4;
const revTop = BASE - REV;
const costTop = BASE - COST;
const newTop = revTop - ADD * NB;
const costAfterTop = costTop + CUT * NC;
const grid = [50, 122, 194, 266, 338];

/* One loop, in percent of LOOP seconds */
const LOOP = 18;
const cutAt = (i: number) => 22 + i * 5; // when each cost slice is targeted
const addAt = (k: number) => 46 + k * 5; // when each new revenue slice arrives (C, then B, then A)
const LOCK = 62; // the new margin locks in
const RESET = 91; // everything eases back to Before

const pct = (n: number) => `${Math.max(0, Math.min(100, n)).toFixed(2)}%`;
const kf = (name: string, stops: [number, string][]) => `@keyframes ${name}{${stops.map(([p, v]) => `${pct(p)}{${v}}`).join('')}}`;

let css = '';
/* The cost bar steps down as each slice is cut */
css += kf('hl-cost', [
  [0, 'transform:scaleY(1)'],
  ...Array.from({ length: NC }, (_, i) => [
    [cutAt(i) + 2.4, `transform:scaleY(${((COST - CUT * i) / COST).toFixed(4)})`] as [number, string],
    [cutAt(i) + 3.4, `transform:scaleY(${((COST - CUT * (i + 1)) / COST).toFixed(4)})`] as [number, string],
  ]).flat(),
  [RESET, `transform:scaleY(${((COST - CUT * NC) / COST).toFixed(4)})`],
  [RESET + 4, 'transform:scaleY(1)'],
  [100, 'transform:scaleY(1)'],
]);
for (let i = 0; i < NC; i++) {
  const a = cutAt(i);
  /* Targeted: a bright outline blinks, then it settles to the dashed outline of a cost removed */
  css += kf(`hl-cut-${i}`, [
    [0, 'opacity:0'],
    [a + 3, 'opacity:0'],
    [a + 4, 'opacity:1'],
    [RESET, 'opacity:1'],
    [RESET + 3, 'opacity:0'],
    [100, 'opacity:0'],
  ]);
}
for (let k = 0; k < NB; k++) {
  const b = addAt(k);
  /* Arrives like it is being rendered: a few quick flickers, then holds */
  css += kf(`hl-add-${k}`, [
    [0, 'opacity:0'],
    [b - 0.01, 'opacity:0'],
    [b, 'opacity:0.9'],
    [b + 0.4, 'opacity:0.1'],
    [b + 0.8, 'opacity:0.8'],
    [b + 1.2, 'opacity:0.25'],
    [b + 1.8, 'opacity:1'],
    [RESET, 'opacity:1'],
    [RESET + 3, 'opacity:0'],
    [100, 'opacity:0'],
  ]);
}
css += kf('hl-lock', [
  [0, 'stroke-dashoffset:1;opacity:1'],
  [LOCK, 'stroke-dashoffset:1;opacity:1'],
  [LOCK + 4, 'stroke-dashoffset:0;opacity:1'],
  [RESET, 'stroke-dashoffset:0;opacity:1'],
  [RESET + 3, 'stroke-dashoffset:0;opacity:0'],
  [100, 'stroke-dashoffset:1;opacity:0'],
]);
/* The status light: a slow, calm pulse */
css += kf('hl-status', [
  [0, 'opacity:0.35'],
  [50, 'opacity:1'],
  [100, 'opacity:0.35'],
]);
const style = `<style>${css}
.hl-cost-after{animation:hl-cost ${LOOP}s linear infinite}
${Array.from({ length: NC }, (_, i) => `.hl-cut-${i}{animation:hl-cut-${i} ${LOOP}s linear infinite}`).join('')}
${Array.from({ length: NB }, (_, k) => `.hl-add-${k}{animation:hl-add-${k} ${LOOP}s linear infinite}`).join('')}
.hl-lock{animation:hl-lock ${LOOP}s ease-in-out infinite}
.hl-status{animation:hl-status 4.5s ease-in-out infinite}
</style>`;
---

<figure class="live" aria-hidden="true">
  <figcaption class="live-cap">
    <span class="live-status hl-status"></span>
    Costs vs revenue<span class="live-caret"></span>
  </figcaption>
  <svg viewBox={`0 0 ${VB_W} ${VB_H}`} class="live-svg">
    <defs>
      <pattern id="hl-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" class="hl-hatch-line" />
      </pattern>
    </defs>

    {grid.map((y) => <line x1="24" x2="536" y1={y} y2={y} class="hl-grid" />)}
    <line x1="24" x2="536" y1={BASE} y2={BASE} class="hl-axis" />
    <line x1="280" x2="280" y1="30" y2={BASE + 20} class="hl-divider" />

    <!-- Before -->
    <rect x={before.rev} y={revTop} width={W} height={REV} rx="2" class="hl-rev" />
    <rect x={before.cost} y={costTop} width={W} height={COST} rx="2" class="hl-cost" />
    <path d={`M${before.rev - 10} ${revTop} h-5 V${costTop} h5`} class="hl-bracket" />

    <!-- After: costs cut, then new revenue -->
    <rect x={after.rev} y={revTop} width={W} height={REV} rx="2" class="hl-rev" />
    <rect x={after.cost} y={costTop} width={W} height={COST} rx="2" class="hl-cost hl-cost-after" />
    {
      Array.from({ length: NC }, (_, i) => {
        const y = costTop + CUT * i;
        return (
          <g>
            <rect x={after.cost + 0.75} y={y + 0.75} width={W - 1.5} height={CUT - 1.5} class={`hl-cut hl-cut-${i}`} />
          </g>
        );
      })
    }
    {
      Array.from({ length: NB }, (_, k) => {
        /* C (the lowest) arrives first, then B, then A */
        const y = revTop - ADD * (k + 1);
        return (
          <g>
            <rect x={after.rev} y={y} width={W} height={ADD} class={`hl-add hl-add-${k}`} />
          </g>
        );
      })
    }
    <path d={`M${after.rev - 10} ${newTop} h-5 V${costAfterTop} h5`} pathLength="1" class="hl-bracket hl-bracket-new hl-lock" />

  </svg>
</figure>

<Fragment set:html={style} />

<style>
  /* Small, in the corner, and quiet: lightsaber blue for revenue, deep red for costs */
  .live {
    --blue: #3fd0ff;
    --red: #ff2a4d;
    position: absolute;
    z-index: 1;
    right: max(var(--gutter), calc((100% - var(--max)) / 2));
    bottom: clamp(2.5rem, 1.5rem + 5vh, 5rem);
    width: clamp(170px, 15vw, 230px);
    margin: 0;
    pointer-events: none;
  }
  .live-cap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid rgb(63 208 255 / 0.18);
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgb(150 225 255 / 0.7);
  }
  .live-status { width: 4px; height: 4px; border-radius: 50%; background: var(--blue); box-shadow: 0 0 6px var(--blue); }
  .live-caret { width: 0.5em; height: 1.05em; margin-left: 0.1em; background: var(--blue); box-shadow: 0 0 6px var(--blue); opacity: 0.85; }
  .live-svg { display: block; width: 100%; height: auto; margin-top: 0.6rem; overflow: visible; }

  .hl-grid { stroke: rgb(63 208 255 / 0.06); stroke-width: 1; }
  .hl-axis { stroke: rgb(63 208 255 / 0.3); stroke-width: 1.5; }
  .hl-divider { stroke: rgb(63 208 255 / 0.08); stroke-width: 1; stroke-dasharray: 2 4; }
  .hl-rev { fill: rgb(63 208 255 / 0.1); stroke: var(--blue); stroke-width: 2.5; filter: drop-shadow(0 0 5px rgb(63 208 255 / 0.75)); }
  .hl-cost { fill: rgb(255 42 77 / 0.1); stroke: var(--red); stroke-width: 2.5; filter: drop-shadow(0 0 5px rgb(255 42 77 / 0.75)); }
  .hl-cost-after { transform-box: fill-box; transform-origin: bottom; }
  .hl-bracket { fill: none; stroke: rgb(150 225 255 / 0.35); stroke-width: 2; }
  .hl-bracket-new { stroke: var(--blue); stroke-dasharray: 1 1; filter: drop-shadow(0 0 4px rgb(63 208 255 / 0.8)); }
  .hl-hatch-line { stroke: rgb(255 42 77 / 0.3); stroke-width: 1.5; }
  .hl-cut { fill: url(#hl-hatch); stroke: rgb(255 42 77 / 0.55); stroke-width: 2; stroke-dasharray: 5 4; }
  .hl-add { fill: rgb(63 208 255 / 0.2); stroke: var(--blue); stroke-width: 2.5; filter: drop-shadow(0 0 6px rgb(63 208 255 / 0.85)); }

  @media (prefers-reduced-motion: no-preference) {
    .live-caret { animation: hl-caret 1.1s steps(1) infinite; }
    @keyframes hl-caret { 50% { opacity: 0; } }
  }
  /* Reduced motion: the finished chart, still */
  @media (prefers-reduced-motion: reduce) {
    .live :is(.hl-cut, .hl-add) { opacity: 1 !important; animation: none !important; }
    .live .hl-cost-after { animation: none !important; transform: scaleY(0.5185); }
    .live .hl-bracket-new { animation: none !important; stroke-dashoffset: 0; }
  }
  @media (max-width: 960px) {
    .live { display: none; }
  }
</style>
