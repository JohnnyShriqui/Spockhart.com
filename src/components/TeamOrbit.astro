---
/**
 * Team hero: Spockhart as a solar system, seen at an angle. The firm is the sun. Our founder and
 * the advisory board sit at the front as planets, the capabilities sit further back, and the
 * sectors our team's experience covers circle slowly on the outer orbit. Each orbit is drawn in
 * two halves, so its back passes behind the sun and its front passes in front of it.
 *
 * Laptops get the full system with names and titles. Phones get the same system without labels,
 * with the names listed underneath.
 */
import { advisors } from '../data/advisors';
import { founder } from '../data/team';
import { site } from '../config/site';
import { initials } from '../lib/format';

type Geo = { W: number; H: number; cx: number; cy: number; k: number; R: number[]; sun: number };
const desk: Geo = { W: 1200, H: 560, cx: 600, cy: 262, k: 0.36, R: [190, 315, 445, 560], sun: 88 };
const phone: Geo = { W: 400, H: 300, cx: 200, cy: 142, k: 0.42, R: [72, 114, 152, 186], sun: 46 };

const point = (g: Geo, ring: number, deg: number) => {
  const a = (deg * Math.PI) / 180;
  const s = Math.sin(a);
  return { x: g.cx + g.R[ring] * Math.cos(a), y: g.cy + g.R[ring] * g.k * s, d: s };
};
/** Position, size and depth for a body on an orbit: further back is smaller, fainter, and behind the sun */
const place = (g: Geo, ring: number, deg: number) => {
  const p = point(g, ring, deg);
  const z = p.d < 0 ? (ring === 3 ? 2 : 3) : ring === 3 ? 8 : 7;
  return `left:${((p.x / g.W) * 100).toFixed(3)}%;top:${((p.y / g.H) * 100).toFixed(3)}%;--s:${(0.78 + (0.22 * (p.d + 1)) / 2).toFixed(3)};--o:${(0.55 + (0.45 * (p.d + 1)) / 2).toFixed(3)};z-index:${z}`;
};
/* Each orbit as its back (upper) and front (lower) halves */
const half = (g: Geo, ring: number, back: boolean) => {
  const R = g.R[ring];
  const ry = R * g.k;
  return `M${g.cx - R} ${g.cy} A${R} ${ry} 0 0 ${back ? 1 : 0} ${g.cx + R} ${g.cy}`;
};

const board = advisors.filter((a) => a.confirmed || site.previewTeam);
const boardAngles: Record<number, number[]> = { 1: [140], 2: [140, 40], 3: [148, 32, 90], 4: [150, 30, 118, 62] };
const people = [
  { name: founder.name, role: founder.role, photo: founder.photo, ring: 0, deg: 90, lead: true },
  ...board.map((a, i) => ({ name: a.name, role: a.short, photo: a.photo, ring: 1, deg: (boardAngles[board.length] ?? boardAngles[4])[i % 4], lead: false })),
];

const capabilities = [
  { label: 'Engineering', deg: 200, d: 'M8.5 7 3.5 12l5 5M15.5 7l5 5-5 5' },
  { label: 'Data and AI', deg: 250, d: 'M12 3.5c.7 4.4 3.6 7.3 8.5 8.5-4.9 1.2-7.8 4.1-8.5 8.5-.7-4.4-3.6-7.3-8.5-8.5 4.9-1.2 7.8-4.1 8.5-8.5z' },
  { label: 'Automation', deg: 290, d: 'M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 4v4.5h-4.5M20 12a8 8 0 0 1-13.7 5.6L4 15.5M4 20v-4.5h4.5' },
  { label: 'Product design', deg: 340, d: 'M4 20l1.2-4.6L15.6 5a2.1 2.1 0 0 1 3 3L8.2 18.4 4 20zM13.6 7l3 3' },
];
const sectors = ['Construction', 'Real estate', 'Technology', 'Manufacturing', 'Supply chain', 'Nonprofits'];
/* The outer orbit turns once every two and a half minutes */
const SECTOR_SPEED = 2.4;
/* Small moons on the inner orbits, for a sense of motion */
const moons = [
  { ring: 0, a0: 200, v: 9 },
  { ring: 1, a0: 300, v: -6 },
  { ring: 1, a0: 120, v: -6 },
  { ring: 2, a0: 20, v: 4 },
  { ring: 2, a0: 160, v: 4 },
];
const ringTags = ['Leadership', 'Advisory board', 'Capabilities', 'Sectors'];
const geoAttr = (g: Geo) => JSON.stringify({ W: g.W, H: g.H, cx: g.cx, cy: g.cy, k: g.k, R: g.R });
---

<figure
  class="orbit"
  aria-label={`Spockhart, drawn as a solar system. At the centre, the firm. Closest in, our founder, ${founder.name}. Then the advisory board: ${board.map((a) => `${a.name}, ${a.short}`).join('; ')}. Then our capabilities: ${capabilities.map((c) => c.label.toLowerCase()).join(', ')}. And on the outer orbit, the sectors our team's experience covers: ${sectors.map((s) => s.toLowerCase()).join(', ')}.`}
>
  {
    [
      { g: desk, key: 'desk' },
      { g: phone, key: 'phone' },
    ].map(({ g, key }) => (
      <div class={`orbit-stage stage-${key}`} data-orbit={geoAttr(g)} style={`aspect-ratio:${g.W} / ${g.H}`} aria-hidden="true">
        <!-- Behind the sun: the plane the system sits on, its shadow, and the back of each orbit -->
        <svg class="orbit-back" viewBox={`0 0 ${g.W} ${g.H}`}>
          <defs>
            <radialGradient id={`plane-${key}`} cx="50%" cy="50%" r="50%">
              <stop offset="0" stop-color="#ffffff" stop-opacity="0.95" />
              <stop offset="0.55" stop-color="#eef4fa" stop-opacity="0.7" />
              <stop offset="1" stop-color="#dfe9f3" stop-opacity="0" />
            </radialGradient>
            <filter id={`soft-${key}`} x="-20%" y="-200%" width="140%" height="500%">
              <feGaussianBlur stdDeviation={key === 'desk' ? 16 : 7} />
            </filter>
          </defs>
          <ellipse cx={g.cx} cy={g.cy + g.R[3] * g.k + (key === 'desk' ? 34 : 18)} rx={g.R[3] * 0.78} ry={key === 'desk' ? 22 : 10} class="orbit-shadow" filter={`url(#soft-${key})`} />
          <ellipse cx={g.cx} cy={g.cy} rx={g.R[3] + (key === 'desk' ? 46 : 14)} ry={(g.R[3] + (key === 'desk' ? 46 : 14)) * g.k} fill={`url(#plane-${key})`} />
          {[3, 2, 1, 0].map((r) => <ellipse cx={g.cx} cy={g.cy} rx={g.R[r]} ry={g.R[r] * g.k} class={`band band-${r}`} />)}
          {[0, 1, 2, 3].map((r) => <path d={half(g, r, true)} class={`arc arc-back arc-${r}`} />)}
        </svg>

        <div class="sun" style={`width:${((g.sun * 2) / g.W) * 100}%;left:${(g.cx / g.W) * 100}%;top:${(g.cy / g.H) * 100}%`}>
          <span class="sun-word">Spockhart</span>
        </div>

        <!-- In front of the sun: the front of each orbit, and its name -->
        <svg class="orbit-front" viewBox={`0 0 ${g.W} ${g.H}`}>
          {[0, 1, 2, 3].map((r) => <path d={half(g, r, false)} class={`arc arc-front arc-${r}`} />)}
          {
            key === 'desk' &&
              ringTags.map((t, r) => {
                const p = point(g, r, 6);
                return (
                  <text x={p.x + 10} y={p.y + 4} class="ring-tag">
                    {t}
                  </text>
                );
              })
          }
        </svg>

        {
          people.map((p) => (
            <div class:list={['body', 'person', { lead: p.lead }]} style={place(g, p.ring, p.deg)}>
              <div class="body-in">
                <span class="planet">
                  {p.photo ? <img src={p.photo} alt="" /> : <span class="planet-initials">{initials(p.name)}</span>}
                </span>
                {key === 'desk' && (
                  <span class="ptag">
                    <span class="ptag-name">{p.name}</span>
                    <span class="ptag-role">{p.role}</span>
                  </span>
                )}
              </div>
            </div>
          ))
        }

        {
          capabilities.map((c) => (
            <div class="body cap" style={place(g, 2, c.deg)}>
              <div class="body-in">
                <span class="planet">
                  <svg viewBox="0 0 24 24">
                    <path d={c.d} />
                  </svg>
                </span>
                {key === 'desk' && <span class="cap-label">{c.label}</span>}
              </div>
            </div>
          ))
        }

        {
          sectors.map((s, i) => {
            const a0 = 270 + i * 60;
            return (
              <div class="body sector" style={place(g, 3, a0)} data-r="3" data-a0={a0} data-v={SECTOR_SPEED}>
                <div class="body-in">
                  <span class="moon-dot" />
                  {key === 'desk' && <span class="sector-label">{s}</span>}
                </div>
              </div>
            );
          })
        }

        {
          moons.map((m) => (
            <div class="body moon" style={place(g, m.ring, m.a0)} data-r={m.ring} data-a0={m.a0} data-v={m.v}>
              <div class="body-in">
                <span class="moon-dot" />
              </div>
            </div>
          ))
        }
      </div>
    ))
  }

  <!-- Phones: the names, under the system -->
  <div class="orbit-key">
    <ul class="key-people">
      {
        people.map((p) => (
          <li>
            <span class:list={['key-av', { lead: p.lead }]}>{initials(p.name)}</span>
            <span>
              <strong>{p.name}</strong>
              <span>{p.lead ? p.role : `Advisory board · ${p.role}`}</span>
            </span>
          </li>
        ))
      }
    </ul>
    <p class="key-row"><span>Capabilities</span>{capabilities.map((c) => c.label).join(' · ')}</p>
    <p class="key-row"><span>Sectors</span>{sectors.join(' · ')}</p>
  </div>
</figure>

<script>
  // The outer orbit and the moons keep turning while the system is on screen
  function initOrbit() {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((stage) => {
      if (stage.dataset.ready) return;
      stage.dataset.ready = '1';
      if (still) return;
      const g = JSON.parse(stage.dataset.orbit || '{}') as { W: number; H: number; cx: number; cy: number; k: number; R: number[] };
      const movers = Array.from(stage.querySelectorAll<HTMLElement>('[data-a0]'));
      if (!movers.length) return;
      const start = performance.now();
      let onScreen = true;
      let raf = 0;
      const frame = (now: number) => {
        raf = 0;
        if (!onScreen || stage.offsetParent === null) return;
        const t = (now - start) / 1000;
        for (const m of movers) {
          const r = Number(m.dataset.r);
          const a = ((Number(m.dataset.a0) + Number(m.dataset.v) * t) * Math.PI) / 180;
          const s = Math.sin(a);
          const x = g.cx + g.R[r] * Math.cos(a);
          const y = g.cy + g.R[r] * g.k * s;
          m.style.left = `${((x / g.W) * 100).toFixed(3)}%`;
          m.style.top = `${((y / g.H) * 100).toFixed(3)}%`;
          m.style.setProperty('--s', (0.78 + (0.22 * (s + 1)) / 2).toFixed(3));
          m.style.setProperty('--o', (0.55 + (0.45 * (s + 1)) / 2).toFixed(3));
          m.style.zIndex = s < 0 ? (r === 3 ? '2' : '3') : r === 3 ? '8' : '7';
        }
        raf = requestAnimationFrame(frame);
      };
      const run = () => {
        if (!raf) raf = requestAnimationFrame(frame);
      };
      new IntersectionObserver(([e]) => {
        onScreen = e.isIntersecting;
        if (onScreen) run();
      }).observe(stage);
      window.addEventListener('resize', run, { passive: true });
      run();
    });
  }
  initOrbit();
  document.addEventListener('spockhart:view', initOrbit);
</script>

<style>
  .orbit { margin: 0; width: 100%; }
  .orbit-stage {
    position: relative;
    width: 100%;
    max-width: 1240px;
    margin-inline: auto;
    container-type: inline-size;
  }
  .orbit-back, .orbit-front { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .orbit-back { z-index: 1; }
  .orbit-front { z-index: 6; pointer-events: none; }

  .orbit-shadow { fill: rgb(13 27 43 / 0.09); }
  .band { fill: rgb(74 138 186 / 0.035); }
  .band-0 { fill: rgb(74 138 186 / 0.09); }
  .arc { fill: none; stroke-linecap: round; }
  .arc-back { stroke: rgb(31 77 111 / 0.2); stroke-width: 1.2; }
  .arc-front { stroke: rgb(31 77 111 / 0.5); stroke-width: 1.5; }
  .arc-back.arc-0 { stroke: rgb(44 95 138 / 0.4); }
  .arc-front.arc-0 { stroke: var(--accent); stroke-width: 2; }
  .arc-front.arc-1 { stroke: rgb(44 95 138 / 0.62); }
  .arc-3 { stroke-dasharray: 1 7; stroke-width: 2; }
  .arc-front.arc-3 { stroke: rgb(31 77 111 / 0.42); }
  .ring-tag {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--ink-3);
    paint-order: stroke;
    stroke: #f4f7fb;
    stroke-width: 5px;
    stroke-linejoin: round;
  }

  /* The sun: the firm at the centre, a navy sphere with a soft steel glow */
  .sun {
    position: absolute;
    z-index: 5;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: radial-gradient(circle at 34% 28%, #4f7fa8 0%, #24496c 32%, #152c43 66%, #0c1a29 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      inset -10px -14px 30px rgb(0 0 0 / 0.25),
      0 26px 50px -18px rgb(12 26 41 / 0.6),
      0 0 0 10px rgb(74 138 186 / 0.08),
      0 0 70px 18px rgb(74 138 186 / 0.28);
  }
  .sun-word {
    font-family: var(--font-wordmark);
    font-size: 0.98cqi;
    letter-spacing: 0.26em;
    margin-right: -0.26em;
    text-transform: uppercase;
    color: #fff;
    line-height: 1;
    white-space: nowrap;
  }

  /* Every body is a point on its orbit; what it shows is centred on that point and scaled by depth */
  .body { position: absolute; width: 0; height: 0; }
  .body-in {
    position: absolute;
    left: 0;
    top: 0;
    transform: scale(var(--s, 1));
    transform-origin: 0 0;
    opacity: var(--o, 1);
  }
  .planet {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    border-radius: 50%;
    overflow: hidden;
  }
  .planet img { width: 100%; height: 100%; object-fit: cover; }

  /* People: solid planets with their name and title beneath */
  .person .planet {
    width: 5.4cqi;
    height: 5.4cqi;
    background: radial-gradient(circle at 34% 28%, #ffffff 0%, #e6eef6 42%, #c2d4e6 100%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9), 0 14px 26px -12px rgb(31 77 111 / 0.55);
  }
  .person.lead .planet {
    width: 6.4cqi;
    height: 6.4cqi;
    background: radial-gradient(circle at 34% 28%, #6a9cc6 0%, #2c5f8a 45%, #1b3b5a 100%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25), 0 0 0 0.5cqi rgb(255 255 255 / 0.85), 0 16px 30px -12px rgb(12 26 41 / 0.6);
  }
  .planet-initials { font-family: var(--font-display); font-size: 1.6cqi; font-weight: 500; color: var(--ink); letter-spacing: 0.02em; }
  .lead .planet-initials { color: #fff; font-size: 1.9cqi; }
  .ptag {
    position: absolute;
    left: 0;
    top: 3.6cqi;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.1em;
    padding: 0.5em 1em 0.55em;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 1px 2px rgb(27 42 61 / 0.05), 0 12px 24px -14px rgb(31 77 111 / 0.45);
    white-space: nowrap;
    font-size: max(11px, 1.15cqi);
  }
  .lead .ptag { top: 4.2cqi; }
  .ptag-name { font-weight: 700; color: var(--ink); font-size: 1.08em; letter-spacing: -0.005em; }
  .ptag-role { font-size: 0.86em; color: var(--accent); font-weight: 600; }

  /* Capabilities: smaller planets, an icon each */
  .cap .planet {
    width: 4cqi;
    height: 4cqi;
    background: radial-gradient(circle at 34% 28%, #ffffff 0%, #eef3f8 50%, #d3e0ec 100%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9), 0 10px 20px -10px rgb(31 77 111 / 0.5);
  }
  .cap .planet svg { width: 45%; height: 45%; fill: none; stroke: var(--accent); stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .cap-label {
    position: absolute;
    left: 0;
    top: 2.6cqi;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: max(11px, 1.12cqi);
    font-weight: 700;
    color: var(--ink);
    text-shadow: 0 0 6px #f4f7fb, 0 0 3px #f4f7fb, 0 0 2px #f4f7fb;
  }

  /* Sectors and moons */
  .moon-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 1.05cqi;
    height: 1.05cqi;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle at 34% 28%, #7aa6cc, #2c5f8a 60%, #1b3b5a);
    box-shadow: 0 3px 6px -2px rgb(12 26 41 / 0.4);
  }
  .moon .moon-dot { width: 0.6cqi; height: 0.6cqi; background: radial-gradient(circle at 34% 28%, #a9c7e2, #4a8aba); }
  .sector-label {
    position: absolute;
    left: 1.2cqi;
    top: 0;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: max(11px, 1.08cqi);
    font-weight: 600;
    color: var(--ink-2);
    text-shadow: 0 0 6px #f4f7fb, 0 0 3px #f4f7fb, 0 0 2px #f4f7fb;
  }

  /* On load: the sun rises, the orbits open, and the bodies arrive inner to outer */
  @media (prefers-reduced-motion: no-preference) {
    .sun { animation: orbit-sun 1100ms var(--ease-out) 100ms both; }
    .orbit-back, .orbit-front { animation: orbit-open 1300ms var(--ease-out) 250ms both; }
    .body { animation: orbit-in 800ms var(--ease-out) both; animation-delay: 700ms; }
    .person { animation-delay: 650ms; }
    .person.lead { animation-delay: 500ms; }
    .cap { animation-delay: 900ms; }
    .sector, .moon { animation-delay: 1150ms; }
  }
  @keyframes orbit-sun { from { opacity: 0; transform: translate(-50%, -46%) scale(0.85); } to { opacity: 1; transform: translate(-50%, -50%); } }
  @keyframes orbit-open { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: none; } }
  @keyframes orbit-in { from { opacity: 0; } to { opacity: 1; } }

  /* ---------- Phones: the system without labels, names underneath ---------- */
  .stage-phone, .orbit-key { display: none; }
  @media (max-width: 760px) {
    .stage-desk { display: none; }
    .stage-phone { display: block; }
    .orbit-key { display: grid; }
    .stage-phone .sun-word { display: none; }
    .stage-phone .person .planet { width: 10cqi; height: 10cqi; }
    .stage-phone .person.lead .planet { width: 12cqi; height: 12cqi; box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25), 0 0 0 1cqi rgb(255 255 255 / 0.85), 0 10px 20px -10px rgb(12 26 41 / 0.6); }
    .stage-phone .planet-initials { font-size: 3.4cqi; }
    .stage-phone .lead .planet-initials { font-size: 4cqi; }
    .stage-phone .cap .planet { width: 8cqi; height: 8cqi; }
    .stage-phone .moon-dot { width: 2.4cqi; height: 2.4cqi; }
    .stage-phone .moon .moon-dot { width: 1.4cqi; height: 1.4cqi; }
  }
  .orbit-key {
    gap: 0.9rem;
    margin-top: 0.75rem;
    padding: 1.1rem 1.1rem 1.2rem;
    border-radius: 16px;
    background: rgb(255 255 255 / 0.8);
    border: 1px solid rgb(27 42 61 / 0.07);
    box-shadow: 0 20px 40px -30px rgb(31 77 111 / 0.5);
  }
  .key-people { list-style: none; margin: 0; padding: 0 0 0.9rem; display: grid; gap: 0.7rem; border-bottom: 1px solid var(--rule); }
  .key-people li { display: flex; align-items: center; gap: 0.75rem; }
  .key-people strong { display: block; font-size: 1rem; color: var(--ink); }
  .key-people li > span:last-child > span { font-size: 0.875rem; color: var(--accent); font-weight: 600; }
  .key-av {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--ink);
    background: radial-gradient(circle at 34% 28%, #ffffff 0%, #e6eef6 42%, #c2d4e6 100%);
    box-shadow: 0 6px 12px -6px rgb(31 77 111 / 0.5);
  }
  .key-av.lead { color: #fff; background: radial-gradient(circle at 34% 28%, #6a9cc6 0%, #2c5f8a 45%, #1b3b5a 100%); }
  .key-row { font-size: 0.9375rem; color: var(--ink); line-height: 1.5; }
  .key-row span {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
</style>
