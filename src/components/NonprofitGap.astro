---
/**
 * Nonprofits: how the same resources go further. The gap chart from the top of the page, drawn
 * still and in full: demand keeps rising, resources stay flat, and the Spockhart line rises
 * above resources because it is built from three things, each a band you can read off the chart.
 * An illustration, not data. Nothing moves.
 */

const X0 = 40;
const X1 = 468;
const BASE = 330;
const START = 150; // where the work begins
const N = 48;

const xs = Array.from({ length: N + 1 }, (_, i) => X0 + ((X1 - X0) * i) / N);
const u = (x: number) => (x - X0) / (X1 - X0);
const resources = (x: number) => 286 - 12 * u(x);
const demand = (x: number) => 262 - 196 * Math.pow(u(x), 1.55);
const ramp = (x: number) => {
  const p = Math.min(1, Math.max(0, (x - START) / (X1 - START)));
  return p * p * (3 - 2 * p);
};
const LIFT = 168; // how far above resources the Spockhart line ends
const shares = [0.46, 0.32, 0.22];
/* Top of each band: resources plus the bands beneath it */
const top = (k: number) => (x: number) => resources(x) - LIFT * ramp(x) * shares.slice(0, k + 1).reduce((a, b) => a + b, 0);
const line = (f: (x: number) => number) => xs.map((x, i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${f(x).toFixed(1)}`).join(' ');
const back = (f: (x: number) => number) => [...xs].reverse().map((x) => `L${x.toFixed(1)} ${f(x).toFixed(1)}`).join(' ');
const band = (k: number) => `${line(top(k))} ${back(k ? top(k - 1) : resources)} Z`;
const us = top(2);
const gapArea = `${line(demand)} ${back(us)} Z`;

/* Where each band's number sits: in the middle of the band, near the right */
const LX = X1 - 42;
/* "The gap" sits where the gap is widest */
const GX = xs.reduce((best, x) => (us(x) - demand(x) > us(best) - demand(best) ? x : best), xs[0]);
const LABEL_X = X1 + 12;
const mid = (k: number) => ((k ? top(k - 1)(LX) : resources(LX)) + top(k)(LX)) / 2;

const builds = [
  {
    n: '1',
    title: 'More mission per dollar',
    body: 'Staff hours move from paperwork back to programs, so the same budget delivers more.',
  },
  {
    n: '2',
    title: 'Cleaner proof of impact',
    body: 'Funder and board reporting built from data you already collect, ready when someone asks.',
  },
  {
    n: '3',
    title: 'Systems that outlast us',
    body: 'Documented, owned by your team, and running without heroics after we hand over.',
  },
];
---

<section class="np" aria-labelledby="np-title">
  <div class="wrap">
    <h2 id="np-title" class="np-title">The same team, with more time for the mission.</h2>

    <div class="np-grid">
      <figure class="np-chart" aria-label="Illustration: demand keeps rising while resources stay flat. With Spockhart, the same resources reach much further, built from three things listed beside the chart.">
        <svg viewBox="0 0 600 372" aria-hidden="true">
          <defs>
            <pattern id="np-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <path d="M0 0V8" class="np-hatch-line" />
            </pattern>
          </defs>

          <path d={`M${X0} 24V${BASE}H${X1 + 6}`} class="np-axis" />
          <text x={X1 + 6} y={BASE + 24} class="np-axis-label" text-anchor="end">Time</text>
          <text x={X0 + 8} y="34" class="np-axis-label">Capacity</text>

          <path d={gapArea} class="np-gap" />
          {shares.map((_, k) => <path d={band(k)} class={`np-band np-band-${k + 1}`} />)}

          <path d={line(resources)} class="np-line np-res" />
          <path d={line(demand)} class="np-line np-demand" />
          <path d={line(us)} class="np-line np-us" />

          <line x1={START} x2={START} y1={resources(START) + 6} y2={BASE} class="np-start" />
          <text x={START} y={BASE + 24} class="np-start-label" text-anchor="middle">We start</text>

          {shares.map((_, k) => (
            <g>
              <circle cx={LX} cy={mid(k)} r="11" class="np-key" />
              <text x={LX} y={mid(k) + 4.5} class="np-key-n" text-anchor="middle">{k + 1}</text>
            </g>
          ))}

          <circle cx={X1} cy={demand(X1)} r="4" class="np-dot np-dot-demand" />
          <circle cx={X1} cy={us(X1)} r="4.5" class="np-dot np-dot-us" />
          <circle cx={X1} cy={resources(X1)} r="4" class="np-dot np-dot-res" />
          <text x={LABEL_X} y={demand(X1) + 5} class="np-label np-label-demand">Demand</text>
          <text x={LABEL_X} y={us(X1) + 5} class="np-label np-label-us">With</text>
          <text x={LABEL_X} y={us(X1) + 22} class="np-label np-label-us">Spockhart</text>
          <text x={LABEL_X} y={resources(X1) + 5} class="np-label np-label-res">Resources</text>
          <text x={LABEL_X} y={resources(X1) + 22} class="np-note">Same team,</text>
          <text x={LABEL_X} y={resources(X1) + 37} class="np-note">same budget</text>
          <text x={GX} y={(demand(GX) + us(GX)) / 2 + 6} class="np-gap-label" text-anchor="middle">The gap</text>
        </svg>
      </figure>

      <div class="np-builds">
        <p class="np-builds-head">What the line is built on</p>
        <ol class="np-list">
          {builds.map((b, k) => (
            <li class={`np-item np-item-${k + 1}`}>
              <span class="np-n" aria-hidden="true">{b.n}</span>
              <div>
                <h3>{b.title}</h3>
                <p>{b.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .np { padding-block: clamp(3rem, 2rem + 3vw, 5rem); background: var(--paper-2); }
  .np-title { font-size: var(--step-4); text-align: center; text-wrap: balance; max-width: 22ch; margin: 0 auto var(--s-7); }

  .np-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center; }

  /* Light, still, drawn on paper: no window, nothing moves */
  .np-chart { margin: 0; padding: clamp(1rem, 0.6rem + 1.2vw, 1.75rem); border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); }
  .np-chart svg { display: block; width: 100%; height: auto; overflow: visible; }
  .np-axis { fill: none; stroke: var(--rule-2); stroke-width: 1.2; }
  .np-axis-label { font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; fill: var(--ink-3); }
  .np-hatch-line { stroke: rgb(27 42 61 / 0.14); stroke-width: 1.4; }
  .np-gap { fill: url(#np-hatch); }
  .np-band-1 { fill: #7fb0d8; }
  .np-band-2 { fill: #a9cbe6; }
  .np-band-3 { fill: #d0e3f2; }
  .np-line { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .np-demand { stroke: var(--ink); stroke-width: 2.6; }
  .np-res { stroke: var(--ink-3); stroke-width: 2.4; }
  .np-us { stroke: var(--brand); stroke-width: 3; }
  .np-start { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 4; }
  .np-start-label { font-family: var(--font-body); font-size: 11px; font-weight: 600; fill: var(--ink-3); }
  .np-key { fill: var(--surface); stroke: var(--brand); stroke-width: 1.5; }
  .np-key-n { font-family: var(--font-body); font-size: 12px; font-weight: 700; fill: var(--brand); }
  .np-label { font-family: var(--font-body); font-size: 14px; font-weight: 700; }
  .np-label-demand { fill: var(--ink); }
  .np-label-us { fill: var(--brand); }
  .np-label-res { fill: var(--ink-3); }
  .np-dot { stroke: var(--surface); stroke-width: 2; }
  .np-dot-demand { fill: var(--ink); }
  .np-dot-us { fill: var(--brand); }
  .np-dot-res { fill: var(--ink-3); }
  .np-note { font-family: var(--font-body); font-size: 12px; font-weight: 600; fill: var(--ink-2); }
  .np-gap-label { font-family: var(--font-display); font-size: 17px; fill: var(--ink-2); }

  /* What the line is built on: numbered to match the bands */
  .np-builds { display: grid; gap: var(--s-4); }
  .np-builds-head { font-family: var(--font-display); font-size: 1.25rem; color: var(--ink); padding-bottom: var(--s-3); border-bottom: 1px solid var(--rule-2); }
  .np-list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s-5); }
  .np-item { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-4); align-items: start; }
  .np-n {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--brand);
    border: 1.5px solid var(--brand);
  }
  .np-item-1 .np-n { background: #7fb0d8; }
  .np-item-2 .np-n { background: #a9cbe6; }
  .np-item-3 .np-n { background: #d0e3f2; }
  .np-item h3 { font-size: 1.3125rem; line-height: 1.2; margin-bottom: 0.3rem; }
  .np-item p { font-family: var(--font-text); color: var(--ink-2); font-size: 1.0625rem; line-height: 1.5; }

  @media (max-width: 960px) {
    .np-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .np-title { font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.5rem); margin-bottom: var(--s-5); }
    .np-chart { padding: 0.75rem; }
    .np-label { font-size: 17px; }
    .np-note, .np-start-label, .np-axis-label { font-size: 14px; }
    .np-gap-label { font-size: 20px; }
    .np-item h3 { font-size: 1.1875rem; }
    .np-list { gap: var(--s-4); }
  }
</style>
