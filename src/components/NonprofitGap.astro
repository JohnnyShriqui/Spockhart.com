---
/**
 * Nonprofits: how the same resources go further. Drawn in the same style as the chart on the
 * home page: a navy chart window on the left, the three things the Spockhart line is built on
 * on the right, each band joined to its explanation by a line. An illustration, not data.
 * Nothing moves.
 */

const X0 = 34;
const X1 = 452;
const BASE = 340;
const START = 140; // where the work begins
const N = 60;

const xs = Array.from({ length: N + 1 }, (_, i) => X0 + ((X1 - X0) * i) / N);
const u = (x: number) => (x - X0) / (X1 - X0);
const resources = (x: number) => 304 - 16 * u(x);
const demand = (x: number) => 272 - 226 * Math.pow(u(x), 1.55);
const ramp = (x: number) => {
  const p = Math.min(1, Math.max(0, (x - START) / (X1 - START)));
  return p * p * (3 - 2 * p);
};
const LIFT = 196;
const shares = [0.44, 0.32, 0.24];
const top = (k: number) => (x: number) => resources(x) - LIFT * ramp(x) * shares.slice(0, k + 1).reduce((a, b) => a + b, 0);
const line = (f: (x: number) => number) => xs.map((x, i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${f(x).toFixed(1)}`).join(' ');
const back = (f: (x: number) => number) => [...xs].reverse().map((x) => `L${x.toFixed(1)} ${f(x).toFixed(1)}`).join(' ');
const band = (k: number) => `${line(top(k))} ${back(k ? top(k - 1) : resources)} Z`;
const us = top(2);
const gapArea = `${line(demand)} ${back(us)} Z`;
const below = (k: number) => (k ? top(k - 1) : resources);
/* Each band's key sits in the band, a little in from the right edge */
const KX = X1 - 30;
const keyY = (k: number) => (below(k)(KX) + top(k)(KX)) / 2;
/* "The gap" sits where the gap is widest, a little to the left so it clears the rising line */
const GX = xs.reduce((best, x) => (us(x) - demand(x) > us(best) - demand(best) ? x : best), xs[0]) - 34;
const grid = [64, 124, 184, 244, 304];

const builds = [
  { n: '1', title: 'More mission per dollar', body: 'Staff hours move from paperwork back to programs, so the same budget delivers more.' },
  { n: '2', title: 'Cleaner proof of impact', body: 'Funder and board reporting built from data you already collect, ready when someone asks.' },
  { n: '3', title: 'Systems that outlast us', body: 'Documented, owned by your team, and running without heroics after we hand over.' },
];
---

<section class="np" aria-labelledby="np-title" data-np>
  <div class="wrap">
    <h2 id="np-title" class="np-title">The same team, with more time for the mission.</h2>

    <div class="np-stage" data-np-stage>
      <svg class="np-links" aria-hidden="true" data-np-links></svg>

      <figure class="np-chart" aria-label="Illustration: demand keeps rising while resources stay flat. With Spockhart, the same resources reach much further, built from the three things listed beside the chart.">
        <div class="np-win">
          <div class="np-win-bar"><span class="np-dots"><i></i><i></i><i></i></span>Demand vs resources</div>
          <svg viewBox="0 0 560 372" class="np-svg" data-np-svg aria-hidden="true">
            <defs>
              <pattern id="np-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="7" class="np-hatch-line" />
              </pattern>
            </defs>

            {grid.map((y) => <line x1={X0} x2={X1} y1={y} y2={y} class="np-grid" />)}
            <line x1={X0} x2={X1} y1={BASE} y2={BASE} class="np-axis" />

            <path d={gapArea} class="np-gap" />
            {shares.map((_, k) => <path d={band(k)} class={`np-band np-band-${k + 1}`} data-band={k + 1} />)}

            <path d={line(resources)} class="np-line np-res" />
            <path d={line(us)} class="np-line np-us" />
            <path d={line(demand)} class="np-line np-demand" />

            <line x1={START} x2={START} y1={resources(START) + 8} y2={BASE} class="np-start" />
            <text x={START} y={BASE + 22} class="np-axis-label" text-anchor="middle">We start</text>
            <text x={X1} y={BASE + 22} class="np-axis-label" text-anchor="end">Time</text>

            {/* numbered from the top band down, to match the list beside the chart */}
            {shares.map((_, k) => (
              <g>
                <rect x={KX - 11} y={keyY(k) - 11} width="22" height="22" rx="4" class="np-key" data-key={shares.length - k} />
                <text x={KX} y={keyY(k) + 4.5} class="np-key-n" text-anchor="middle">{shares.length - k}</text>
              </g>
            ))}

            <text x={X1 + 12} y={demand(X1) + 5} class="np-end np-end-demand">Demand</text>
            <text x={X1 + 12} y={us(X1) + 5} class="np-end np-end-us">With</text>
            <text x={X1 + 12} y={us(X1) + 21} class="np-end np-end-us">Spockhart</text>
            <text x={X1 + 12} y={resources(X1) + 5} class="np-end np-end-res">Resources</text>
            <text x={GX} y={(demand(GX) + us(GX)) / 2 + 4} class="np-gap-label" text-anchor="middle">The gap</text>
          </svg>
        </div>
      </figure>

      <div class="np-builds" data-np-list>
        <p class="np-set-head">
          <span class="np-set-title">What the line is built on</span>
          <span class="np-set-note">Same team, same budget</span>
        </p>
        <ol class="np-list">
          {builds.map((b) => (
            <li class="np-card" data-card={b.n}>
              <span class="np-k">{b.n}</span>
              <span class="np-text">
                <span class="np-t">{b.title}</span>
                <span class="np-b">{b.body}</span>
              </span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  // Lines from each band out to its explanation (laptops). Drawn once, and again on resize.
  function initNp() {
    document.querySelectorAll<HTMLElement>('[data-np]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const stage = root.querySelector<HTMLElement>('[data-np-stage]')!;
      const chart = root.querySelector<SVGSVGElement>('[data-np-svg]')!;
      const links = root.querySelector<SVGSVGElement>('[data-np-links]')!;
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
      const wide = window.matchMedia('(min-width: 1100px)');
      const ns = 'http://www.w3.org/2000/svg';
      const draw = () => {
        links.replaceChildren();
        if (!wide.matches) return;
        const box = stage.getBoundingClientRect();
        links.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
        const m = chart.getScreenCTM();
        if (!m) return;
        for (const card of cards) {
          const key = chart.querySelector<SVGRectElement>(`[data-key="${card.dataset.card}"]`);
          if (!key) continue;
          const b = key.getBBox();
          const sx = m.a * (b.x + b.width) + m.e - box.left + 3;
          const sy = m.d * (b.y + b.height / 2) + m.f - box.top;
          const c = card.getBoundingClientRect();
          const ex = c.left - box.left - 8;
          const ey = c.top + c.height / 2 - box.top;
          const dx = Math.max(30, (ex - sx) * 0.5);
          const path = document.createElementNS(ns, 'path');
          path.setAttribute('d', `M${sx.toFixed(1)} ${sy.toFixed(1)} C${(sx + dx).toFixed(1)} ${sy.toFixed(1)} ${(ex - dx).toFixed(1)} ${ey.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`);
          path.setAttribute('class', 'np-link');
          links.append(path);
        }
      };
      requestAnimationFrame(draw);
      window.addEventListener('resize', () => requestAnimationFrame(draw));
      document.fonts?.ready.then(() => requestAnimationFrame(draw));
    });
  }
  initNp();
  document.addEventListener('spockhart:view', initNp);
</script>

<style>
  .np { padding-block: clamp(3rem, 2rem + 3vw, 5rem); background: var(--paper-2); overflow-x: clip; }
  .np-title { font-size: clamp(2.25rem, 1.6rem + 1.6vw, 3.25rem); text-align: center; text-wrap: balance; margin: 0 auto var(--s-6); max-width: 24ch; }

  .np-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    column-gap: clamp(4.5rem, 2rem + 5vw, 7.5rem);
    align-items: center;
  }
  .np-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  :global(.np-link) { fill: none; stroke: #4a8aba; stroke-width: 1.25; stroke-linecap: round; opacity: 0.6; }

  /* ---------- The chart window, as on the home page ---------- */
  .np-chart {
    position: relative;
    margin: 0;
    padding: clamp(0.85rem, 0.5rem + 0.9vw, 1.25rem);
    border-radius: var(--radius-lg);
    background: var(--brand);
    overflow: hidden;
    isolation: isolate;
  }
  .np-chart::before {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.2), transparent 70%);
    z-index: -1;
  }
  .np-win { border-radius: 10px; background: #173f5c; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 24px 48px -28px rgb(4 18 30 / 0.7); overflow: hidden; }
  .np-win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: #133650;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9fb6cb;
  }
  .np-dots { display: flex; gap: 5px; }
  .np-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / 0.18); }
  .np-svg { display: block; width: 100%; height: auto; padding: 0.75rem 0.25rem 0.5rem; box-sizing: border-box; overflow: visible; }

  .np-grid { stroke: rgb(255 255 255 / 0.06); stroke-width: 1; }
  .np-axis { stroke: rgb(255 255 255 / 0.28); stroke-width: 1; }
  .np-axis-label { font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: #9fb6cb; }
  .np-start { stroke: rgb(255 255 255 / 0.25); stroke-width: 1; stroke-dasharray: 2 4; }
  .np-hatch-line { stroke: rgb(255 255 255 / 0.1); stroke-width: 2; }
  .np-gap { fill: url(#np-hatch); }
  .np-gap-label { font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: #9fb6cb; }
  .np-band { stroke: #173f5c; stroke-width: 2; stroke-linejoin: round; }
  .np-band-1 { fill: #6f9fc6; }
  .np-band-2 { fill: #8bb9df; }
  .np-band-3 { fill: #a9d1ee; }
  .np-line { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .np-res { stroke: #9fb6cb; stroke-width: 2; }
  .np-us { stroke: #ffffff; stroke-width: 2.4; }
  .np-demand { stroke: #e1eef8; stroke-width: 2; stroke-dasharray: 5 4; }
  .np-key { fill: #f9fbfd; }
  .np-key-n { font-family: var(--font-body); font-size: 12px; font-weight: 700; fill: #133650; }
  .np-end { font-family: var(--font-body); font-size: 13px; font-weight: 600; }
  .np-end-demand { fill: #e1eef8; }
  .np-end-us { fill: #ffffff; }
  .np-end-res { fill: #9fb6cb; }

  /* ---------- What the line is built on, set like the home page list ---------- */
  .np-builds { position: relative; z-index: 2; display: grid; gap: 0.6rem; }
  .np-set-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); padding-bottom: 0.3rem; border-bottom: 1px solid var(--rule-2); }
  .np-set-title { font-family: var(--font-display); font-size: 1.125rem; color: var(--ink); }
  .np-set-note { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .np-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .np-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 0.95rem 1.1rem 1rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .np-k {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-top: 0.1rem;
    border-radius: 6px;
    background: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
  }
  .np-text { display: grid; gap: 0.2rem; }
  .np-t { font-family: var(--font-display); font-size: 1.1875rem; line-height: 1.2; color: var(--ink); }
  .np-b { font-size: 0.9375rem; line-height: 1.45; color: var(--ink-2); }

  @media (max-width: 1099px) {
    .np-stage { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-6); }
    .np-links { display: none; }
  }
  @media (max-width: 640px) {
    .np-title { font-size: clamp(1.875rem, 1.5rem + 1.5vw, 2.5rem); margin-bottom: var(--s-5); }
    .np-chart { padding: 0.6rem; }
    .np-axis-label, .np-gap-label { font-size: 15px; }
    .np-end { font-size: 17px; }
    .np-key-n { font-size: 14px; }
    .np-t { font-size: 1.0625rem; }
    .np-set-note { display: none; }
    .np-b { font-size: 0.875rem; }
  }
</style>
