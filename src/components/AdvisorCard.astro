---
/**
 * One advisor on the Team page. With a photo, the portrait fills the plate; without one, the plate
 * carries their initials on a soft wash in one of four brand tones, so a row reads as a set.
 */
import type { Advisor } from '../data/advisors';
import { initials } from '../lib/format';
import { site } from '../config/site';

interface Props {
  advisor: Advisor;
  /** Position in the row, to pick the plate's tone */
  index?: number;
}
const { advisor, index = 0 } = Astro.props;
const tone = index % 4;
const pending = !advisor.confirmed && site.previewTeam;
---

<article class:list={['advisor', `tone-${tone}`]}>
  <div class="plate">
    {
      advisor.photo ? (
        <img src={advisor.photo} alt={`Portrait of ${advisor.name}`} width="800" height="1000" loading="lazy" decoding="async" />
      ) : (
        <span class="plate-initials" aria-hidden="true">{initials(advisor.name)}</span>
      )
    }
    {pending && <span class="pending"><span class="pending-long">Awaiting confirmation</span><span class="pending-short">Pending</span></span>}
  </div>
  <div class="advisor-text">
    <h3>{advisor.name}</h3>
    <p class="advisor-title">{advisor.title}</p>
    {advisor.experience.length > 0 && (
      <ul class="advisor-tags" aria-label="Experience">
        {advisor.experience.map((t) => <li>{t}</li>)}
      </ul>
    )}
    <p class="advisor-focus"><span>Advises on</span>{advisor.focus}</p>
    {
      advisor.linkedin && (
        <a class="advisor-link" href={advisor.linkedin} target="_blank" rel="noopener">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .advisor {
    --wash-a: #dbe7f2;
    --wash-b: #f3f7fb;
    --wash-glow: rgb(74 138 186 / 0.35);
    display: grid;
    grid-template-columns: minmax(150px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    align-items: stretch;
    min-width: 0;
    padding: clamp(0.9rem, 0.6rem + 0.8vw, 1.25rem);
    border-radius: 18px;
    background: var(--card-bg, #fff);
    border: 1px solid rgb(27 42 61 / 0.07);
    box-shadow: 0 1px 2px rgb(27 42 61 / 0.04), 0 30px 60px -44px rgb(31 77 111 / 0.45);
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out);
  }
  .advisor:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgb(27 42 61 / 0.04), 0 36px 64px -40px rgb(31 77 111 / 0.55); }
  .tone-1 { --wash-a: #e1def4; --wash-b: #f5f4fb; --wash-glow: rgb(120 112 196 / 0.3); }
  .tone-2 { --wash-a: #d6e9e8; --wash-b: #f2f8f8; --wash-glow: rgb(44 128 128 / 0.26); }
  .tone-3 { --wash-a: #dde3ea; --wash-b: #f4f6f9; --wash-glow: rgb(88 107 128 / 0.3); }

  .plate {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    place-items: center;
    background:
      radial-gradient(90% 70% at 85% 0%, var(--wash-glow), transparent 70%),
      linear-gradient(165deg, var(--wash-a) 0%, var(--wash-b) 100%);
    border: 1px solid rgb(27 42 61 / 0.07);
    transition: transform 600ms var(--ease-out), box-shadow 600ms var(--ease-out);
  }
  /* Fine grain, like good paper */
  .plate::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 200px;
    opacity: 0.08;
    mix-blend-mode: multiply;
  }
  /* A hairline frame inset from the edge */
  .plate::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: 1;
    border: 1px solid rgb(255 255 255 / 0.65);
    border-radius: 6px;
    pointer-events: none;
  }
  .plate img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.2) contrast(1.02); }
  .plate-initials {
    font-family: var(--font-display);
    font-weight: 350;
    font-size: clamp(3.25rem, 2.4rem + 2.6vw, 5rem);
    letter-spacing: 0.04em;
    color: rgb(27 42 61 / 0.82);
    line-height: 1;
    transition: transform 700ms var(--ease-out), letter-spacing 700ms var(--ease-out);
  }
  .advisor:hover .plate-initials { letter-spacing: 0.1em; }

  .pending {
    position: absolute;
    top: 18px;
    left: 18px;
    z-index: 2;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #8a6418;
    background: rgb(255 248 230 / 0.92);
    border: 1px solid rgb(181 132 36 / 0.35);
  }

  .pending-short { display: none; }
  /* The "Advises on" lines sit level across a row, however long each title runs */
  .advisor-text { display: grid; gap: 0.5rem; grid-template-rows: auto auto 1fr auto; align-content: start; padding-block: 0.5rem; }
  .advisor-title { align-self: start; }
  .advisor h3 { font-size: var(--step-3); font-weight: 450; line-height: 1.1; letter-spacing: -0.01em; }
  .advisor-tags { list-style: none; margin: 0.25rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; align-self: start; }
  .advisor-tags li {
    padding: 0.25rem 0.6rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    border-radius: 999px;
    background: rgb(74 138 186 / 0.1);
  }
  .advisor-title { color: var(--ink-2); font-size: 1rem; line-height: 1.5; }
  .advisor-focus {
    margin-top: 0.6rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .advisor-focus span {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.2rem;
  }
  .advisor-link { margin-top: 0.4rem; font-size: 0.875rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .advisor-link:hover { text-decoration: underline; }

  /* Phones: a compact row, the plate beside the name */
  @media (max-width: 560px) {
    .advisor { grid-template-columns: 96px minmax(0, 1fr); gap: 1rem; align-items: start; padding: 0.85rem; border-radius: 14px; }
    .advisor-text { padding-block: 0.1rem; gap: 0.35rem; }
    .advisor-tags li { font-size: 0.75rem; padding: 0.2rem 0.5rem; }
    .plate { aspect-ratio: 4 / 5; border-radius: 10px; }
    .plate::before { inset: 6px; border-radius: 5px; }
    .plate-initials { font-size: 2rem; }
    .pending { top: auto; bottom: 9px; left: 50%; transform: translateX(-50%); font-size: 0.5625rem; padding: 0.15rem 0.45rem; }
    .pending-long { display: none; }
    .pending-short { display: inline; }
    .advisor h3 { font-size: 1.3125rem; }
    .advisor-title { font-size: 0.875rem; }
    .advisor-focus { margin-top: 0.35rem; padding-top: 0.5rem; font-size: 0.875rem; }
  }
</style>
