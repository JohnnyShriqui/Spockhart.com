---
/**
 * An engagement on a day scale. Phases and their spans live here.
 * track 'fix' removes waste; track 'grow' finds and launches new revenue. Same scale, same rhythm.
 */
import { site } from '../config/site';
import PhaseGraphic from './PhaseGraphic.astro';

interface Props {
  /** Scale and phase names only, for the home page. */
  compact?: boolean;
  track?: 'fix' | 'grow';
}
const { compact = false, track = 'fix' } = Astro.props;

const SCALE = 120; // days covered by the scale (the four-month minimum)
const fixPhases = [
  {
    n: '01',
    name: 'Diagnose',
    brief: 'Map the system, find the bottlenecks.',
    when: 'Weeks 1 to 2',
    start: 0,
    end: 14,
    body: 'We work alongside your team to map how work gets done, uncover bottlenecks and duplication, and identify where better processes and technology can make the biggest difference.',
  },
  {
    n: '02',
    name: 'Prototype',
    brief: 'Build it around your workflows, prove it works.',
    when: `By day ${site.offer.prototypeDays}`,
    start: 14,
    end: site.offer.prototypeDays,
    body: 'A working prototype that demonstrates the proposed solution, built around your team’s actual workflows and requirements.',
  },
  {
    n: '03',
    name: 'Build and embed',
    brief: 'Harden it, connect your systems, train your team.',
    when: `Months 2 to ${site.offer.minimumMonths}`,
    start: site.offer.prototypeDays,
    end: SCALE,
    body: 'We harden it, connect it to your systems and train the people who will own it.',
  },
  {
    n: '04',
    name: 'Hand over',
    brief: 'Document everything, hand over the keys.',
    when: `Month ${site.offer.minimumMonths}`,
    start: SCALE,
    end: null,
    body: 'Everything we built is yours: documented, running and owned by your team.',
  },
];

/* The engineering method, for revenue: assess where the money is, engineer the best option
   into a prototype, develop it with real customers, then deploy it */
const growPhases = [
  {
    n: '01',
    name: 'Assess',
    brief: 'Find the untapped revenue.',
    when: 'Weeks 1–2',
    start: 0,
    end: 14,
    body: 'We examine your customers, market, existing capabilities, and business model to uncover unmet needs and untapped revenue opportunities.',
  },
  {
    n: '02',
    name: 'Engineer',
    brief: 'Rank the options, prototype the best.',
    when: `By day ${site.offer.prototypeDays}`,
    start: 14,
    end: site.offer.prototypeDays,
    body: 'We evaluate opportunities by market potential, customer demand, and feasibility. Then we design the strongest concept and turn it into a working prototype.',
  },
  {
    n: '03',
    name: 'Develop',
    brief: 'Test with real customers, refine what sells.',
    when: `Months 2–${site.offer.minimumMonths}`,
    start: site.offer.prototypeDays,
    end: SCALE,
    body: 'We put the solution in front of real customers, test demand, measure adoption, and refine the offering until there’s a clear path to generating revenue.',
  },
  {
    n: '04',
    name: 'Deploy',
    brief: 'Take it to market, hand it over.',
    when: `Month ${site.offer.minimumMonths}`,
    start: SCALE,
    end: null,
    body: 'We bring the offering to market, establish pricing and sales processes, and hand over a revenue-generating operation your team can own and grow.',
  },
];
const phases = track === 'grow' ? growPhases : fixPhases;
const tail = track === 'grow' ? 'Yours to grow' : 'Yours to run';
const ticks = [0, 14, 30, 60, 90, 120];
/* Where each phase sits on the scale, in days (the hand-over runs into the tail) */
const spans = [
  [0, 14],
  [14, site.offer.prototypeDays],
  [site.offer.prototypeDays, SCALE],
  [SCALE, SCALE],
];
const pct = (d: number) => `${(d / SCALE) * 100}%`;
---

<div class:list={['timeline', { compact }]} data-reveal data-timeline>
  <div class="scale" aria-hidden="true">
    <div class="scale-track">
      <div class="axis"></div>
      {
        phases
          .filter((p) => p.end !== null)
          .map((p, i) => (
            <div class={`seg seg-${i + 1}`} style={`left:${pct(p.start)};width:${pct((p.end as number) - p.start)}`}>
              <span class="seg-label">{p.name}</span>
              <span class="seg-n">{i + 1}</span>
            </div>
          ))
      }
      <div class="milestone" style={`left:${pct(site.offer.prototypeDays)}`}>
        <span class="milestone-dot"></span>
        <span class="milestone-label">Working prototype</span>
      </div>
      {
        ticks.map((t) => (
          <span class="tick" style={`left:${pct(t)}`}>
            <span>Day {t}</span>
          </span>
        ))
      }
    </div>
    <div class="scale-tail">
      <span class="seg-label">{tail}</span>
      <span class="seg-n">4</span>
    </div>
    <div class="scale-cover"></div>
    <div class="scale-now"><i></i></div>
  </div>
  <ol class="scale-key" aria-hidden="true">
    {
      phases.map((p, i) => (
        <li class={`key-${i + 1}`}>
          <span class="key-n">{i + 1}</span>
          <span class="key-name">{p.name}</span>
          <span class="key-when">{p.when}</span>
        </li>
      ))
    }
  </ol>

  <ol class="phases" data-reveal="stagger" data-scene-group="(min-width: 901px)" data-hover="(min-width: 901px) and (hover: hover) and (pointer: fine)" data-rate="1.05" data-gap="350">
    {
      phases.map((p, i) => (
        <li
          class={`phase phase-${i + 1}`}
          data-scene
          data-loop="6.5"
          data-still="6.2"
          data-from={spans[i][0]}
          data-to={spans[i][1]}
          data-tail={i === 3 ? '1' : undefined}
          style="--loop:6.5;--still:6.2"
        >
          <p class="phase-meta">
            <span class="tabular">{p.n}</span>
            <span aria-hidden="true">·</span>
            {p.when}
          </p>
          <h3>{p.name}</h3>
          {!compact && <p class="phase-body">{p.body}</p>}
          {!compact && <p class="phase-brief">{p.brief}</p>}
          {!compact && <PhaseGraphic phase={i as 0 | 1 | 2 | 3} track={track} />}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline { display: grid; gap: var(--s-7); }

  .scale {
    --track: 86;
    --tail: 14;
    /* Room above the bar for the milestone, and the bar's height */
    --above: 2.6rem;
    --bar: 44px;
    /* Where the marker is: set by the script below as phases play; rests at the end */
    --pos: 100%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 86fr) minmax(0, 14fr);
    padding-top: var(--above);
    padding-bottom: 2rem;
  }
  /* Everything to the right of the marker is still ahead */
  .scale-cover {
    position: absolute;
    top: var(--above);
    height: var(--bar);
    left: var(--pos);
    right: 0;
    background: rgb(228 234 241 / 0.72);
    pointer-events: none;
  }
  .scale-now {
    position: absolute;
    top: calc(var(--above) - 12px);
    height: calc(var(--bar) + 24px);
    left: var(--pos);
    width: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease);
  }
  .scale-now::before { content: ''; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: var(--ink); border-radius: 1px; }
  .scale-now i {
    position: absolute;
    left: -8px;
    top: -9px;
    width: 16px;
    height: 18px;
    background: var(--ink);
    clip-path: var(--hex);
  }
  .scale-now i::after { content: ''; position: absolute; inset: 5px 4px; background: var(--paper); clip-path: var(--hex); }
  .scale-track { position: relative; height: var(--bar); }
  .axis {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    height: 1px;
    background: var(--rule-2);
  }
  .seg {
    position: absolute;
    top: 0;
    height: 100%;
    border-right: 2px solid var(--paper);
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    overflow: hidden;
    transform-origin: left center;
  }
  .seg-1 { background: var(--mist-1); }
  .seg-2 { background: var(--accent); }
  .seg-3 { background: var(--brand); }
  .seg-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #ffffff;
    white-space: nowrap;
  }
  .seg-1 .seg-label { color: var(--navy); }
  .scale-tail {
    position: relative;
    height: var(--bar);
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border: 1px dashed var(--rule-2);
    border-left: 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: repeating-linear-gradient(-45deg, transparent 0 6px, var(--accent-wash) 6px 7px);
  }
  .scale-tail .seg-label { color: var(--ink-2); }

  .tick {
    position: absolute;
    bottom: -16px;
    width: 1px;
    height: 7px;
    background: var(--rule-2);
  }
  .tick span {
    position: absolute;
    top: 12px;
    left: 0;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tick:first-of-type span { transform: none; }

  .milestone { position: absolute; top: -2.4rem; bottom: 0; width: 0; }
  .milestone::before {
    content: '';
    position: absolute;
    left: -0.5px;
    top: 1.35rem;
    bottom: -4px;
    width: 1px;
    background: var(--accent-soft);
  }
  .milestone-dot {
    position: absolute;
    left: -6px;
    top: 1rem;
    width: 12px;
    height: 12px;
    background: var(--accent-soft);
    clip-path: var(--hex);
  }
  .milestone-label {
    position: absolute;
    left: 12px;
    top: 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .phases {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .phase {
    --t: var(--still, 6);
    --pad: var(--s-5);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--pad);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    cursor: default;
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease), border-color 400ms var(--ease), opacity 300ms var(--ease), filter 300ms var(--ease);
  }
  .phase.is-active {
    border-color: rgb(44 95 138 / 0.55);
    transform: translateY(-6px);
    box-shadow: 0 26px 44px -30px rgb(27 42 61 / 0.6);
  }
  /* Time running through the phase that is playing */
  .phase::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--accent-soft);
    transform-origin: left center;
    transform: scaleX(calc(var(--t) / var(--loop)));
    opacity: 0;
    transition: opacity 300ms var(--ease);
  }
  .phase.is-playing::after { opacity: 1; }
  /* Each card carries its segment's colour from the chart above */
  .phase::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--seg); }
  .phase-1 { --seg: var(--mist-1); }
  .phase-2 { --seg: var(--accent); }
  .phase-3 { --seg: var(--brand); }
  .phase-4 { --seg: repeating-linear-gradient(90deg, var(--rule-2) 0 6px, transparent 6px 10px); }
  .phase-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .phase h3 { font-size: 1.5rem; line-height: 1.15; }
  .phase-body { color: var(--ink-2); font-size: 1rem; line-height: 1.55; }
  /* Phones only: one short line in place of the description */
  .phase-brief { display: none; }
  .compact { gap: var(--s-6); }

  /* Laptops: the title, the bar and all four phases fit on one screen */
  @media (min-width: 901px) {
    .timeline:not(.compact) { gap: var(--s-5); }
    .timeline:not(.compact) .scale { --above: 2.2rem; --bar: 38px; padding-bottom: 1.7rem; }
    .phases { gap: var(--s-4); }
    .phase { --pad: 1.15rem; gap: 0.3rem; }
    .phase h3 { font-size: 1.375rem; }
    .phase-body { font-size: 0.9375rem; line-height: 1.5; }
  }


  @media (prefers-reduced-motion: no-preference) {
    /* The marker only pulses while a phase is playing; otherwise the page holds still */
    .timeline:has(.phase.is-active) .scale-now i { animation: now-pulse 1.6s ease-in-out infinite; }
    @keyframes now-pulse { 50% { transform: scale(1.18); } }
  }

  @media (max-width: 900px) {
    .phases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .seg-n, .scale-key { display: none; }

  /* Phones and tablets: the phases loop on their own, so the bar holds still */
  @media (max-width: 900px) {
    .scale-cover, .scale-now { display: none; }
  }

  /* Phones: the bar is too narrow for names, so each part is numbered and a key sits below.
     Each phase keeps its heading and graphic; the description is left for larger screens.
     The phases become full-width bands that alternate in colour, like the projects on Our Work. */
  @media (max-width: 640px) {
    .phase-body { display: none; }
    .phase-brief { display: block; margin-top: -0.15rem; color: var(--ink-2); font-size: 1rem; line-height: 1.45; }
    .phases { gap: 0; margin: var(--s-6) calc(var(--gutter) * -1) 0; }
    .phase,
    .phase.is-active {
      padding: 2.5rem var(--gutter) 2.75rem;
      border: 0;
      border-radius: 0;
      background: var(--paper);
      box-shadow: none;
      transform: none;
    }
    .phase:nth-child(even) { background: var(--paper-2); }
    .phase h3 { font-size: 1.625rem; }
    .timeline { gap: var(--s-5); }
    .scale { --track: 72; --tail: 28; grid-template-columns: minmax(0, 72fr) minmax(0, 28fr); padding-bottom: 1.9rem; }
    .seg, .scale-tail { justify-content: center; padding-inline: 0; }
    .seg-label, .scale-tail .seg-label { display: none; }
    .seg-n { display: block; font-size: 0.8125rem; font-weight: 700; color: #fff; }
    .seg-1 .seg-n { color: var(--navy); }
    .scale-tail .seg-n { color: var(--ink-2); }
    .scale-key {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.6rem 1rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .scale-key li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0 0.5rem; align-items: center; }
    .key-n {
      grid-row: span 2;
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 700;
      color: #fff;
    }
    .key-1 .key-n { background: var(--mist-1); color: var(--navy); }
    .key-2 .key-n { background: var(--accent); }
    .key-3 .key-n { background: var(--brand); }
    .key-4 .key-n { background: repeating-linear-gradient(-45deg, var(--paper) 0 6px, var(--accent-wash) 6px 7px); border: 1px dashed var(--rule-2); color: var(--ink-2); }
    .key-name { font-size: 0.875rem; font-weight: 600; line-height: 1.2; color: var(--ink); }
    .key-when { font-size: 0.75rem; line-height: 1.2; color: var(--ink-3); }
    .tick:not(:first-of-type):not(:nth-of-type(3)):not(:last-of-type) span { display: none; }
    .phases { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { initScenes } from '../scripts/scenes';
  import { focusOn } from '../scripts/focus';
  initScenes();
  document.addEventListener('spockhart:view', initScenes);

  // On larger screens, the marker on the scale follows whichever phase is playing.
  function followPhases() {
    document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((tl) => {
      if (tl.dataset.follow) return;
      tl.dataset.follow = '1';
      const scale = tl.querySelector<HTMLElement>('.scale');
      if (!scale) return;
      tl.querySelectorAll<HTMLElement>('[data-scene]').forEach((phase) => {
        const from = Number(phase.dataset.from);
        const to = Number(phase.dataset.to);
        const tail = phase.dataset.tail === '1';
        // Laptops: pointing at a phase plays it and the rest of the page steps back
        phase.addEventListener('pointerenter', () => {
          if (phase.closest<HTMLElement>('[data-scene-group]')?.dataset.mode === 'hover') focusOn(phase);
        });
        phase.addEventListener('pointerleave', () => {
          if (phase.closest<HTMLElement>('[data-scene-group]')?.dataset.mode !== 'hover') return;
          scale.style.removeProperty('--pos');
          focusOn(null);
        });
        phase.addEventListener('scene:frame', (e) => {
          // On phones the phases loop on their own, so the marker rests at the end.
          if (phase.closest<HTMLElement>('[data-scene-group]')?.dataset.mode === 'free') {
            scale.style.removeProperty('--pos');
            return;
          }
          const { t, loop } = (e as CustomEvent<{ t: number; loop: number }>).detail;
          const css = getComputedStyle(scale);
          const track = parseFloat(css.getPropertyValue('--track')) || 86;
          const rest = parseFloat(css.getPropertyValue('--tail')) || 14;
          const p = Math.min(1, t / (loop * 0.85));
          const pos = tail ? track + rest * p : (track * (from + (to - from) * p)) / 120;
          scale.style.setProperty('--pos', `${pos.toFixed(2)}%`);
        });
      });
    });
  }
  followPhases();
  document.addEventListener('spockhart:view', followPhases);
</script>
