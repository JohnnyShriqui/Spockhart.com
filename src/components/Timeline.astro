---
/**
 * An engagement on a day scale. Phases and their spans live here.
 * track 'fix' removes waste; track 'grow' finds and launches new revenue. Same scale, same rhythm.
 */
import { site } from '../config/site';
import PhaseGraphic from './PhaseGraphic.astro';

interface Props {
  /** Scale and phase names only, for the home page. */
  compact?: boolean;
  track?: 'fix' | 'grow';
}
const { compact = false, track = 'fix' } = Astro.props;

const SCALE = 120; // days covered by the scale (the four-month minimum)
const fixPhases = [
  {
    n: '01',
    name: 'Diagnose',
    brief: 'Map the system, find the bottlenecks.',
    when: 'Weeks 1 to 2',
    start: 0,
    end: 14,
    body: 'We map your workflows, identify bottlenecks, and uncover opportunities for improvement.',
  },
  {
    n: '02',
    name: 'Prototype',
    brief: 'Build it around your workflows, prove it works.',
    when: `By day ${site.offer.prototypeDays}`,
    start: 14,
    end: site.offer.prototypeDays,
    body: 'We design and build a working prototype around your team’s needs and requirements.',
  },
  {
    n: '03',
    name: 'Build and embed',
    brief: 'Harden it, connect your systems, train your team.',
    when: `Months 2 to ${site.offer.minimumMonths}`,
    start: site.offer.prototypeDays,
    end: SCALE,
    body: 'We develop the solution, integrate it with your systems, and prepare your team to use it.',
  },
  {
    n: '04',
    name: 'Hand over',
    brief: 'Document everything, hand over the keys.',
    when: `Month ${site.offer.minimumMonths}`,
    start: SCALE,
    end: null,
    body: 'We deliver a fully documented solution, ready for your team to own and operate.',
  },
];

/* The engineering method, for revenue: assess where the money is, engineer the best option
   into a prototype, develop it with real customers, then deploy it */
const growPhases = [
  {
    n: '01',
    name: 'Assess',
    brief: 'Find the untapped revenue.',
    when: 'Weeks 1–2',
    start: 0,
    end: 14,
    body: 'We examine your customers, market, and capabilities to uncover untapped opportunities.',
  },
  {
    n: '02',
    name: 'Engineer',
    brief: 'Rank the options, prototype the best.',
    when: `By day ${site.offer.prototypeDays}`,
    start: 14,
    end: site.offer.prototypeDays,
    body: 'We evaluate opportunities and turn the strongest concept into a working prototype.',
  },
  {
    n: '03',
    name: 'Develop',
    brief: 'Test with real customers, refine what sells.',
    when: `Months 2–${site.offer.minimumMonths}`,
    start: site.offer.prototypeDays,
    end: SCALE,
    body: 'We test with real customers, measure demand, and refine the offering.',
  },
  {
    n: '04',
    name: 'Deploy',
    brief: 'Take it to market, hand it over.',
    when: `Month ${site.offer.minimumMonths}`,
    start: SCALE,
    end: null,
    body: 'We bring the offering to market and equip your team to operate and grow it.',
  },
];
const phases = track === 'grow' ? growPhases : fixPhases;
/* Where each phase sits on the scale, in days (the hand-over runs into the tail) */
const spans = [
  [0, 14],
  [14, site.offer.prototypeDays],
  [site.offer.prototypeDays, SCALE],
  [SCALE, SCALE],
];
---

<div class:list={['timeline', { compact }]} data-timeline>
  <ol class="phases" data-scene-group data-always data-gap="600" data-rate="0.54" data-phases={track}>
    {
      phases.map((p, i) => (
        <li
          class={`phase phase-${i + 1}`}
          data-scene
          data-loop="6.5"
          data-still="6.2"
          data-from={spans[i][0]}
          data-to={spans[i][1]}
          data-tail={i === 3 ? '1' : undefined}
          style={`--loop:6.5;--still:6.2;--n:${i}`}
        >
          <div class="phase-head">
            <p class="phase-meta">
              <span class="tabular">{p.n}</span>
              <span aria-hidden="true">·</span>
              {p.when}
            </p>
            <h3>{p.name}</h3>
            {!compact && <p class="phase-body">{p.body}</p>}
            {!compact && <p class="phase-brief">{p.brief}</p>}
          </div>
          {!compact && <PhaseGraphic phase={i as 0 | 1 | 2 | 3} track={track} />}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline { display: grid; gap: var(--s-7); }

  .phases {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .phase {
    --t: var(--still, 6);
    --pad: var(--s-5);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--pad);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    cursor: default;
    transition: opacity 300ms var(--ease), filter 300ms var(--ease);
  }
  /* Each card's heading block is painted in its segment's colour from the bar above, so the eye
     goes bar, then heading, then (on pointing) the graphic */
  .phase-head {
    display: grid;
    gap: 0.4rem;
    margin: calc(var(--pad) * -1) calc(var(--pad) * -1) 0;
    padding: var(--pad);
    background: var(--seg);
    color: var(--seg-ink);
  }
  .phase-1 { --seg: var(--mist-1); --seg-ink: var(--navy); --seg-ink-2: #2f4760; --seg-meta: var(--brand); }
  .phase-2 { --seg: var(--accent); --seg-ink: #fff; --seg-ink-2: rgb(255 255 255 / 0.86); --seg-meta: rgb(255 255 255 / 0.72); }
  .phase-3 { --seg: var(--brand); --seg-ink: #fff; --seg-ink-2: rgb(255 255 255 / 0.86); --seg-meta: rgb(255 255 255 / 0.72); }
  /* The headings deepen from left to right, so the hand over is the darkest */
  .phase-4 { --seg: #142a40; --seg-ink: #fff; --seg-ink-2: rgb(255 255 255 / 0.86); --seg-meta: rgb(255 255 255 / 0.72); }
  .phase-head h3 { color: var(--seg-ink); }
  .phase-head .phase-body,
  .phase-head .phase-brief { color: var(--seg-ink-2); }
  .phase-head .phase-meta { color: var(--seg-meta); }
  .phase :global(.pg) { padding-top: 0; }
  /* First visit: the phases wait, then appear one at a time, 1 to 4 */
  .phases.is-waiting .phase { opacity: 0; transform: translateY(28px); }
  .phases.is-showing .phase {
    animation: phase-in 900ms var(--ease-out) both;
    animation-delay: calc(var(--n) * 450ms);
  }
  @keyframes phase-in {
    from { opacity: 0; transform: translateY(28px); }
    to { opacity: 1; transform: none; }
  }
  .phase-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .phase h3 { font-size: 1.5rem; line-height: 1.15; }
  .phase-body { color: var(--ink-2); font-size: 1rem; line-height: 1.55; }
  /* Phones only: one short line in place of the description */
  .phase-brief { display: none; }
  .compact { gap: var(--s-6); }

  /* Laptops: the title, the bar and all four phases fit on one screen */
  @media (min-width: 901px) {
    .timeline:not(.compact) { gap: var(--s-5); }
    .phases { gap: var(--s-4); }
    .phase { --pad: 1.35rem; gap: 0; }
    .phase h3 { font-size: 1.625rem; }
    .phase-body { font-size: 1.0625rem; line-height: 1.5; }
  }


  @media (prefers-reduced-motion: no-preference) {
    /* The marker only pulses while a phase is playing; otherwise the page holds still */
  }

  @media (max-width: 900px) {
    .phases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Phones and tablets: the phases loop on their own, so the bar holds still */
  @media (max-width: 900px) {
  }

  /* Phones: the bar is too narrow for names, so each part is numbered and a key sits below.
     Each phase keeps its heading and graphic; the description is left for larger screens.
     The phases become full-width bands that alternate in colour, like the projects on Our Work. */
  @media (max-width: 640px) {
    .phase-body { display: none; }
    .phase-brief { display: block; margin-top: -0.15rem; font-size: 1rem; line-height: 1.45; }
    .phase-head { margin: 0; padding: 1.1rem 1.15rem 1.2rem; border-radius: var(--radius-lg); }
    .phases { gap: var(--s-4); margin-top: var(--s-5); }
    .phase { padding: 1rem 1rem 1.15rem; }
    .phase h3 { font-size: 1.625rem; }
    .timeline { gap: var(--s-5); }
    .phases { grid-template-columns: minmax(0, 1fr); }
  }

  /* ==========================================================================
     Dark (when the device is in dark mode): the phases sit on the page's dark ground as quiet cards. The graphics read the same
     colour names, set dark here; each heading block keeps its own tint, from the lightest in
     phase 1 to the deepest in phase 3.
     ========================================================================== */
</style>

<script>
  // The phases take turns, 1 to 4 and round again, from the moment the page opens and
  // whether or not they are on screen (scripts/scenes.ts)
  import { initScenes } from '../scripts/scenes';
  initScenes();
  document.addEventListener('spockhart:view', initScenes);

  // The first time someone reaches a set of phases, they appear one at a time, 1 to 4. After
  // that they are simply there, on this visit and every later one (remembered in this browser).
  const seenKey = (track: string) => `spockhart:phases-seen:${track}`;
  const seen = (track: string) => {
    try {
      return localStorage.getItem(seenKey(track)) === '1';
    } catch {
      return false;
    }
  };
  const remember = (track: string) => {
    try {
      localStorage.setItem(seenKey(track), '1');
    } catch {
      /* private window: they will simply appear again next time */
    }
  };
  function revealPhases() {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);
    document.querySelectorAll<HTMLElement>('[data-phases]').forEach((list) => {
      if (list.dataset.revealReady) return;
      list.dataset.revealReady = '1';
      const track = list.dataset.phases || 'fix';
      if (still || seen(track)) return;
      list.classList.add('is-waiting');
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          remember(track);
          list.classList.add('is-showing');
          list.classList.remove('is-waiting');
        },
        { threshold: 0.25 },
      );
      io.observe(list);
    });
  }
  revealPhases();
  document.addEventListener('spockhart:view', revealPhases);
</script>
