---
/**
 * The engagement on a day scale. Phases and their spans live here.
 */
import { site } from '../config/site';
import PhaseGraphic from './PhaseGraphic.astro';

interface Props {
  /** Scale and phase names only, for the home page. */
  compact?: boolean;
}
const { compact = false } = Astro.props;

const SCALE = 120; // days covered by the scale (the four-month minimum)
const phases = [
  {
    n: '01',
    name: 'Diagnose',
    when: 'Weeks 1 to 2',
    start: 0,
    end: 14,
    body: 'We work alongside your team to map how work gets done, uncover bottlenecks and duplication, and identify where better processes and technology can make the biggest difference.',
  },
  {
    n: '02',
    name: 'Prototype',
    when: `By day ${site.offer.prototypeDays}`,
    start: 14,
    end: site.offer.prototypeDays,
    body: 'A working prototype that demonstrates the proposed solution, built around your team’s actual workflows and requirements.',
  },
  {
    n: '03',
    name: 'Build and embed',
    when: `Months 2 to ${site.offer.minimumMonths}`,
    start: site.offer.prototypeDays,
    end: SCALE,
    body: 'We harden it, connect it to your systems and train the people who will own it.',
  },
  {
    n: '04',
    name: 'Hand over',
    when: `Month ${site.offer.minimumMonths}`,
    start: SCALE,
    end: null,
    body: 'Everything we built is yours: documented, running and owned by your team.',
  },
];
const ticks = [0, 14, 30, 60, 90, 120];
/* Where each phase sits on the scale, in days (the hand-over runs into the tail) */
const spans = [
  [0, 14],
  [14, site.offer.prototypeDays],
  [site.offer.prototypeDays, SCALE],
  [SCALE, SCALE],
];
const pct = (d: number) => `${(d / SCALE) * 100}%`;
---

<div class:list={['timeline', { compact }]} data-reveal data-timeline>
  <div class="scale" aria-hidden="true">
    <div class="scale-track">
      <div class="axis"></div>
      {
        phases
          .filter((p) => p.end !== null)
          .map((p, i) => (
            <div class={`seg seg-${i + 1}`} style={`left:${pct(p.start)};width:${pct((p.end as number) - p.start)}`}>
              <span class="seg-label">{p.name}</span>
            </div>
          ))
      }
      <div class="milestone" style={`left:${pct(site.offer.prototypeDays)}`}>
        <span class="milestone-dot"></span>
        <span class="milestone-label">Working prototype</span>
      </div>
      {
        ticks.map((t) => (
          <span class="tick" style={`left:${pct(t)}`}>
            <span>Day {t}</span>
          </span>
        ))
      }
    </div>
    <div class="scale-tail">
      <span class="seg-label">Yours to run</span>
    </div>
    <div class="scale-cover"></div>
    <div class="scale-now"><i></i></div>
  </div>

  <ol class="phases" data-reveal="stagger" data-scene-group>
    {
      phases.map((p, i) => (
        <li
          class={`phase phase-${i + 1}`}
          data-scene
          data-loop="6.5"
          data-still="6.2"
          data-from={spans[i][0]}
          data-to={spans[i][1]}
          data-tail={i === 3 ? '1' : undefined}
          style="--loop:6.5;--still:6.2"
        >
          <p class="phase-meta">
            <span class="tabular">{p.n}</span>
            <span aria-hidden="true">·</span>
            {p.when}
          </p>
          <h3>{p.name}</h3>
          {!compact && <p class="phase-body">{p.body}</p>}
          {!compact && <PhaseGraphic phase={i as 0 | 1 | 2 | 3} />}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .timeline { display: grid; gap: var(--s-7); }

  .scale {
    --track: 86;
    --tail: 14;
    /* Where the marker is: set by the script below as phases play; rests at the end */
    --pos: 100%;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 86fr) minmax(0, 14fr);
    padding-top: 2.6rem;
    padding-bottom: 2rem;
  }
  /* Everything to the right of the marker is still ahead */
  .scale-cover {
    position: absolute;
    top: 2.6rem;
    height: 44px;
    left: var(--pos);
    right: 0;
    background: rgb(228 234 241 / 0.72);
    pointer-events: none;
  }
  .scale-now {
    position: absolute;
    top: calc(2.6rem - 12px);
    height: calc(44px + 24px);
    left: var(--pos);
    width: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease);
  }
  .scale-now::before { content: ''; position: absolute; left: -1px; top: 0; bottom: 0; width: 2px; background: var(--ink); border-radius: 1px; }
  .scale-now i {
    position: absolute;
    left: -8px;
    top: -9px;
    width: 16px;
    height: 18px;
    background: var(--ink);
    clip-path: var(--hex);
  }
  .scale-now i::after { content: ''; position: absolute; inset: 5px 4px; background: var(--paper); clip-path: var(--hex); }
  .scale-track { position: relative; height: 44px; }
  .axis {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10px;
    height: 1px;
    background: var(--rule-2);
  }
  .seg {
    position: absolute;
    top: 0;
    height: 100%;
    border-right: 2px solid var(--paper);
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    overflow: hidden;
    transform-origin: left center;
  }
  .seg-1 { background: var(--mist-1); }
  .seg-2 { background: var(--accent); }
  .seg-3 { background: var(--brand); }
  .seg-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #ffffff;
    white-space: nowrap;
  }
  .seg-1 .seg-label { color: var(--navy); }
  .scale-tail {
    position: relative;
    height: 44px;
    display: flex;
    align-items: center;
    padding-inline: 0.75rem;
    border: 1px dashed var(--rule-2);
    border-left: 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    background: repeating-linear-gradient(-45deg, transparent 0 6px, var(--accent-wash) 6px 7px);
  }
  .scale-tail .seg-label { color: var(--ink-2); }

  .tick {
    position: absolute;
    bottom: -16px;
    width: 1px;
    height: 7px;
    background: var(--rule-2);
  }
  .tick span {
    position: absolute;
    top: 12px;
    left: 0;
    transform: translateX(-50%);
    font-size: 0.75rem;
    color: var(--ink-3);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tick:first-of-type span { transform: none; }

  .milestone { position: absolute; top: -2.4rem; bottom: 0; width: 0; }
  .milestone::before {
    content: '';
    position: absolute;
    left: -0.5px;
    top: 1.35rem;
    bottom: -4px;
    width: 1px;
    background: var(--accent-soft);
  }
  .milestone-dot {
    position: absolute;
    left: -6px;
    top: 1rem;
    width: 12px;
    height: 12px;
    background: var(--accent-soft);
    clip-path: var(--hex);
  }
  .milestone-label {
    position: absolute;
    left: 12px;
    top: 0.65rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .phases {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-5);
  }
  .phase {
    --t: var(--still, 6);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    overflow: hidden;
    cursor: default;
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease), border-color 400ms var(--ease);
  }
  .phase.is-active {
    border-color: rgb(44 95 138 / 0.55);
    transform: translateY(-6px);
    box-shadow: 0 26px 44px -30px rgb(27 42 61 / 0.6);
  }
  /* Time running through the phase that is playing */
  .phase::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--accent-soft);
    transform-origin: left center;
    transform: scaleX(calc(var(--t) / var(--loop)));
    opacity: 0;
    transition: opacity 300ms var(--ease);
  }
  .phase.is-playing::after { opacity: 1; }
  /* Each card carries its segment's colour from the chart above */
  .phase::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--seg); }
  .phase-1 { --seg: var(--mist-1); }
  .phase-2 { --seg: var(--accent); }
  .phase-3 { --seg: var(--brand); }
  .phase-4 { --seg: repeating-linear-gradient(90deg, var(--rule-2) 0 6px, transparent 6px 10px); }
  .phase-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .phase h3 { font-size: 1.5rem; line-height: 1.15; }
  .phase-body { color: var(--ink-2); font-size: 1rem; line-height: 1.55; }
  .compact { gap: var(--s-6); }

  @media (prefers-reduced-motion: no-preference) {
    .scale-now i { animation: now-pulse 1.6s ease-in-out infinite; }
    @keyframes now-pulse { 50% { transform: scale(1.18); } }
  }

  @media (max-width: 900px) {
    .phases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .scale { --track: 72; --tail: 28; grid-template-columns: minmax(0, 72fr) minmax(0, 28fr); }
    .scale-tail { padding-inline: 0.5rem; }
    .scale-tail .seg-label { font-size: 0.75rem; }
    .seg-label { display: none; }
    .scale-tail .seg-label { display: inline; }
    .tick:not(:first-of-type):not(:nth-of-type(3)):not(:last-of-type) span { display: none; }
    .phases { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { initScenes } from '../scripts/scenes';
  initScenes();
  document.addEventListener('spockhart:view', initScenes);

  // The marker on the scale follows whichever phase is playing.
  function followPhases() {
    document.querySelectorAll<HTMLElement>('[data-timeline]').forEach((tl) => {
      if (tl.dataset.follow) return;
      tl.dataset.follow = '1';
      const scale = tl.querySelector<HTMLElement>('.scale');
      if (!scale) return;
      tl.querySelectorAll<HTMLElement>('[data-scene]').forEach((phase) => {
        const from = Number(phase.dataset.from);
        const to = Number(phase.dataset.to);
        const tail = phase.dataset.tail === '1';
        phase.addEventListener('scene:frame', (e) => {
          const { t, loop } = (e as CustomEvent<{ t: number; loop: number }>).detail;
          const css = getComputedStyle(scale);
          const track = parseFloat(css.getPropertyValue('--track')) || 86;
          const rest = parseFloat(css.getPropertyValue('--tail')) || 14;
          const p = Math.min(1, t / (loop * 0.85));
          const pos = tail ? track + rest * p : (track * (from + (to - from) * p)) / 120;
          scale.style.setProperty('--pos', `${pos.toFixed(2)}%`);
        });
      });
    });
  }
  followPhases();
  document.addEventListener('spockhart:view', followPhases);
</script>
