---
/**
 * Fix what's broken. Build what's missing.
 *
 * One chart, Before and After. After, revenue rises by three new slices (A to C) and costs fall
 * by four slices (1 to 4). Each slice is a real result our team delivered, drawn out to its case
 * study on the right. The After builds itself on a loop while the chart is on screen.
 *
 * Laptops: pointing at a case study (and resting there for a moment) lights up its slice and
 * opens the case study in place: it grows toward the chart and downward, pushing the others
 * down, with its graphic playing on the left and the words on the right.
 * Phones and tablets: the chart, then two rows to swipe; each graphic plays as it comes into view.
 *
 * The chart is illustrative: the bars show direction, not client figures.
 */
import { getCollection } from 'astro:content';
import ResultVisual from './ResultVisual.astro';
import { iconFor, headline } from '../lib/work';

// The client line and headline from each case study on Our Work, shown when one is opened
const work = Object.fromEntries((await getCollection('work')).map((e) => [e.id, e.data]));

interface Item {
  k: string;
  id: string;
  value: string;
  label: string;
}

const build: Item[] = [
  { k: 'A', id: 'sales-performance-system', value: '+$316K a month', label: 'In average sales, after a new sales analytics system' },
  { k: 'B', id: 'digital-practice-growth', value: '$150K → $1M', label: 'New services grew a consulting practice in under a year' },
  { k: 'C', id: 'project-feasibility-platform', value: 'A new market', label: 'A feasibility tool that became a lead-generation engine' },
];
const fix: Item[] = [
  { k: '1', id: 'commission-automation', value: 'Excel → Automated', label: 'Commissions for a $1.2B manufacturer, live January 2027' },
  { k: '2', id: 'project-feasibility-platform', value: '12 months → Minutes', label: 'Feasibility assessments, from $100K+ each to $0' },
  { k: '3', id: 'momentum-exchange-prototype', value: 'Up to 83% more cargo', label: 'Per trip on the same fuel, shown on a working prototype' },
  { k: '4', id: 'subcontractor-financing-marketplace', value: '6+ months → Weeks', label: 'Financing approvals for subcontractors' },
];

/* Chart geometry (viewBox 0 0 560 470). Heights are illustrative. */
const VB_H = 470;
const BASE = 410;
const W = 60;
const before = { rev: 92, cost: 160 };
const after = { rev: 330, cost: 398 };
const REV = 230; // revenue, before
const COST = 216; // costs, before: just under revenue
const ADD = 46; // each new revenue slice
const CUT = 26; // each cost slice removed
const revTop = BASE - REV;
const costTop = BASE - COST;
const newTop = revTop - ADD * build.length;
const costAfterTop = costTop + CUT * fix.length;
const grid = [50, 122, 194, 266, 338];

const sets = [
  { key: 'build', title: 'Revenue Development', note: 'Revenue up', items: build },
  { key: 'fix', title: 'Operations Efficiency', note: 'Costs down', items: fix },
];
---

<section class="fb" aria-labelledby="fb-title" data-fb>
  <div class="wrap">
    <h2 id="fb-title" class="fb-title" data-reveal>Better Operations. New Opportunities.</h2>

    <div class="fb-stage" data-fb-stage>
      <svg class="fb-links" aria-hidden="true" data-fb-links></svg>

      <!-- The chart, in the same window style as the case studies -->
      <figure class="fb-chart" aria-label="Before, costs are just under revenue. After, revenue is up three slices and costs are down four.">
        <div class="fb-win">
          <div class="fb-win-bar"><span class="fb-dots"><i></i><i></i><i></i></span>Costs vs revenue</div>
          <svg viewBox={`0 0 560 ${VB_H}`} class="fb-svg" data-fb-svg aria-hidden="true" preserveAspectRatio="xMidYMid meet">
            <defs>
              <pattern id="fb-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="7" class="fb-hatch-line" />
              </pattern>
            </defs>

            {grid.map((y) => <line x1="24" x2="536" y1={y} y2={y} class="fb-grid" />)}
            <line x1="24" x2="536" y1={BASE} y2={BASE} class="fb-axis" />
            <line x1="280" x2="280" y1="30" y2={BASE + 44} class="fb-divider" />

            <!-- Before: profitable, barely -->
            <rect x={before.rev} y={revTop} width={W} height={REV} rx="2" class="fb-rev" />
            <rect x={before.cost} y={costTop} width={W} height={COST} rx="2" class="fb-cost" />
            <path d={`M${before.rev - 10} ${revTop} h-5 V${costTop} h5`} class="fb-bracket" />
            <text x={before.rev - 20} y={revTop + 4} text-anchor="end" class="fb-ann">Thin</text>
            <text x={before.rev - 20} y={revTop + 18} text-anchor="end" class="fb-ann">margin</text>
            <text x={before.rev + W / 2} y={BASE + 22} text-anchor="middle" class="fb-axis-label">Revenue</text>
            <text x={before.cost + W / 2} y={BASE + 22} text-anchor="middle" class="fb-axis-label">Costs</text>
            <text x={(before.rev + before.cost + W) / 2} y={BASE + 48} text-anchor="middle" class="fb-group">Before</text>

            <!-- After: revenue up by A to C, costs down by 1 to 4 -->
            <rect x={after.rev} y={revTop} width={W} height={REV} rx="2" class="fb-rev" />
            {
              build.map((b, i) => {
                const y = revTop - ADD * (build.length - i);
                return (
                  <g class="fb-slice fb-add" data-slice={b.k} style={`--i:${i}`}>
                    <rect x={after.rev} y={y} width={W} height={ADD} class="fb-add-rect" data-slice-rect />
                    <text x={after.rev + W / 2} y={y + ADD / 2 + 5} text-anchor="middle" class="fb-key-add">
                      {b.k}
                    </text>
                  </g>
                );
              })
            }
            <rect
              x={after.cost}
              y={costTop}
              width={W}
              height={COST}
              rx="2"
              class="fb-cost fb-cost-after"
              style={`--cost-after:${((COST - CUT * fix.length) / COST).toFixed(4)}`}
            />
            {
              fix.map((f, i) => {
                const y = costTop + CUT * i;
                return (
                  <g class="fb-slice fb-cut" data-slice={f.k} style={`--i:${i}`}>
                    <rect x={after.cost + 0.75} y={y + 0.75} width={W - 1.5} height={CUT - 1.5} class="fb-cut-rect" data-slice-rect />
                    <text x={after.cost + W / 2} y={y + CUT / 2 + 4} text-anchor="middle" class="fb-key-cut">
                      {f.k}
                    </text>
                  </g>
                );
              })
            }
            <g class="fb-wide">
              <path d={`M${after.rev - 10} ${newTop} h-5 V${costAfterTop} h5`} class="fb-bracket fb-bracket-after" />
              <text x={after.rev - 20} y={(newTop + costAfterTop) / 2 - 3} text-anchor="end" class="fb-ann fb-ann-hot">Wider</text>
              <text x={after.rev - 20} y={(newTop + costAfterTop) / 2 + 12} text-anchor="end" class="fb-ann fb-ann-hot">margin</text>
            </g>
            <text x={after.rev + W / 2} y={BASE + 22} text-anchor="middle" class="fb-axis-label">Revenue</text>
            <text x={after.cost + W / 2} y={BASE + 22} text-anchor="middle" class="fb-axis-label">Costs</text>
            <text x={(after.rev + after.cost + W) / 2} y={BASE + 48} text-anchor="middle" class="fb-group">After</text>
          </svg>
        </div>
      </figure>

      <!-- The case studies, grouped the way they sit on the chart -->
      <div class="fb-cards" data-fb-cards>
        <p class="eyebrow fb-eyebrow">Real Case Studies</p>
        {
          sets.map((set) => (
            <div class:list={['fb-set', `fb-set-${set.key}`]}>
              <p class="fb-set-head">
                <span class="fb-set-title">{set.title}</span>
                <span class="fb-set-note">{set.note}</span>
              </p>
              <div class="fb-row">
                {set.items.map((it) => (
                  <div class:list={['fb-card', `fb-card-${set.key}`]} tabindex="0" data-card={it.k}>
                    <div class="fb-media" aria-hidden="true">
                      <div class="fb-live" data-manual data-live>
                        <ResultVisual id={it.id} />
                      </div>
                    </div>
                    <div class="fb-body">
                      <span class="fb-key">{it.k}</span>
                      <span class="fb-text">
                        <span class="fb-v">{it.value}</span>
                        <span class="fb-l">{it.label}</span>
                        <span class="fb-cs">
                          <span class="fb-client">
                            <span class="fb-client-mark" aria-hidden="true">
                              <svg viewBox="0 0 24 24">
                                <path d={iconFor(it.id)} />
                              </svg>
                            </span>
                            {work[it.id]?.client}
                          </span>
                          <span class="fb-headline">
                            {headline(work[it.id]?.title ?? '').map((part, n) => (n % 2 ? <span class="hl">{part}</span> : part))}
                          </span>
                        </span>
                      </span>
                    </div>
                    <span class="fb-caret" aria-hidden="true">
                      <svg viewBox="0 0 16 16">
                        <path d="M3.5 6l4.5 4.5L12.5 6" />
                      </svg>
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initScenes, sceneController, scenesCanAnimate } from '../scripts/scenes';
  import { focusOn } from '../scripts/focus';

  const LIVE_W = 640; // the width each case study graphic is laid out at before scaling

  function initFixBuild() {
    initScenes();
    document.querySelectorAll<HTMLElement>('[data-fb]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const stage = root.querySelector<HTMLElement>('[data-fb-stage]')!;
      const chart = root.querySelector<SVGSVGElement>('[data-fb-svg]')!;
      const links = root.querySelector<SVGSVGElement>('[data-fb-links]')!;
      const cardsBox = root.querySelector<HTMLElement>('[data-fb-cards]')!;
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
      const wide = window.matchMedia('(min-width: 1100px)');
      const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const ns = 'http://www.w3.org/2000/svg';
      const animate = scenesCanAnimate();

      const slice = (k: string) => chart.querySelector<SVGGElement>(`[data-slice="${k}"]`);
      const control = (card: Element, how: 'play' | 'loop' | 'pause' | 'stop') => {
        const sc = card.querySelector<HTMLElement>('[data-live] [data-scene]');
        const ctrl = sc ? sceneController(sc) : undefined;
        if (ctrl && (how === 'stop' || animate)) ctrl[how]();
      };

      /* ---------- Lines from each slice out to its case study (laptops) ---------- */
      const draw = () => {
        links.replaceChildren();
        if (!wide.matches) return;
        const box = stage.getBoundingClientRect();
        links.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
        const m = chart.getScreenCTM();
        if (!m) return;
        for (const card of cards) {
          const k = card.dataset.card!;
          const rect = slice(k)?.querySelector<SVGRectElement>('[data-slice-rect]');
          if (!rect) continue;
          const on = card.classList.contains('is-on');
          const b = rect.getBBox();
          const sx = m.a * (b.x + b.width) + m.e - box.left + 4;
          const sy = m.d * (b.y + b.height / 2) + m.f - box.top;
          const c = card.getBoundingClientRect();
          const ex = c.left - box.left - 9;
          const ey = on ? c.top - box.top + 40 : c.top + c.height / 2 - box.top;
          const dx = Math.max(24, (ex - sx) * 0.55);
          const kind = /\d/.test(k) ? 'fix' : 'build';
          const g = document.createElementNS(ns, 'g');
          g.setAttribute('class', `fb-link-g fb-link-g-${kind}${on ? ' is-on' : ''}`);
          const path = document.createElementNS(ns, 'path');
          path.setAttribute('d', `M${sx.toFixed(1)} ${sy.toFixed(1)} C${(sx + dx).toFixed(1)} ${sy.toFixed(1)} ${(ex - dx).toFixed(1)} ${ey.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`);
          path.setAttribute('pathLength', '1');
          path.setAttribute('class', `fb-link fb-link-${kind}`);
          g.append(path);
          links.append(g);
        }
      };
      // Keep the lines attached while cards open, close and move
      let follow = 0;
      const track = (ms = 600) => {
        const until = performance.now() + ms;
        cancelAnimationFrame(follow);
        const step = () => {
          draw();
          if (performance.now() < until) follow = requestAnimationFrame(step);
        };
        follow = requestAnimationFrame(step);
      };

      /* ---------- Thumbnails: each graphic, scaled down to a still frame ---------- */
      const chartFig = root.querySelector<HTMLElement>('.fb-chart')!;
      // Laptops lay each graphic out at 640px wide and scale it down; phones at 400px, scaled
      // to fit a box of the same height on every card, so every card is the same size.
      const PHONE_W = 400;
      const size = () => {
        // Phones: every card as tall as the tallest; the graphic takes whatever space the
        // words leave, so nothing is left blank
        cards.forEach((c) => c.style.removeProperty('min-height'));
        if (!wide.matches) {
          const tallest = Math.max(...cards.map((c) => c.offsetHeight));
          cards.forEach((c) => (c.style.minHeight = `${tallest}px`));
        }
        for (const card of cards) {
          const media = card.querySelector<HTMLElement>('.fb-media')!;
          const live = card.querySelector<HTMLElement>('[data-live]')!;
          const natW = wide.matches ? LIVE_W : PHONE_W;
          const natH = live.offsetHeight;
          card.dataset.h = String(natH);
          const bw = media.clientWidth;
          const bh = media.clientHeight;
          const sc = wide.matches ? bw / natW : Math.min(bw / natW, bh / natH);
          card.style.setProperty('--s', sc.toFixed(4));
          card.style.setProperty('--ox', wide.matches ? '0px' : `${((bw - natW * sc) / 2).toFixed(1)}px`);
          card.style.setProperty('--oy', wide.matches ? '0px' : `${((bh - natH * sc) / 2).toFixed(1)}px`);
        }
        if (wide.matches) {
          // The chart is exactly as tall as the list of case studies, measured with all closed
          if (!active) chartFig.style.height = `${cardsBox.offsetHeight}px`;
        } else {
          chartFig.style.removeProperty('height');
        }
      };

      /* ---------- The chart: Before turns into After, over and over ---------- */
      let shown = false;
      let timer = 0;
      let active: HTMLElement | null = null;
      const toAfter = () => {
        root.classList.remove('fb-pre');
        timer = window.setTimeout(toBefore, 8500);
      };
      const toBefore = () => {
        if (!shown || active) return;
        root.classList.add('fb-pre');
        timer = window.setTimeout(toAfter, 1600);
      };
      const loop = (delay: number) => {
        clearTimeout(timer);
        if (animate && shown && !active) timer = window.setTimeout(toBefore, delay);
      };

      /* ---------- Open one in place: toward the chart and downward ---------- */
      const close = () => {
        if (!active) return;
        active.classList.remove('is-on');
        control(active, 'stop');
        active = null;
        root.classList.remove('has-active');
        focusOn(null);
        chart.querySelectorAll('[data-slice]').forEach((s) => s.classList.remove('is-on'));
        track();
        loop(3500);
      };
      const open = (card: HTMLElement) => {
        if (active === card) return;
        close();
        // Reach toward the chart, overlapping its empty right edge a little
        const reach = Math.max(0, card.getBoundingClientRect().left - chartFig.getBoundingClientRect().right + 80);
        const width = card.offsetWidth + reach;
        // Every opened case study is the same size: the graphic is fitted into one box
        const OPEN_H = 280;
        const natural = Number(card.dataset.h || 480);
        const mw = Math.round(width * 0.5);
        const s = Math.min(mw / LIVE_W, OPEN_H / natural);
        card.style.setProperty('--reach', `${reach}px`);
        card.style.setProperty('--mw', `${mw}px`);
        card.style.setProperty('--mh', `${OPEN_H}px`);
        card.style.setProperty('--s-on', s.toFixed(4));
        card.style.setProperty('--ox-on', `${((mw - LIVE_W * s) / 2).toFixed(1)}px`);
        card.style.setProperty('--oy-on', `${((OPEN_H - natural * s) / 2).toFixed(1)}px`);
        card.classList.add('is-on');
        active = card;
        root.classList.add('has-active');
        // Everything else on the page steps back
        focusOn(card);
        // Hold the chart on the After while a case study is open
        clearTimeout(timer);
        root.classList.remove('fb-pre');
        chart.querySelectorAll<SVGGElement>('[data-slice]').forEach((el) => el.classList.toggle('is-on', el.dataset.slice === card.dataset.card));
        control(card, 'play');
        track();
      };

      // A short pause before opening, so passing over a case study does not open it. An open case
      // study stays open until another one is chosen or the pointer leaves the list, so nothing
      // jumps around under the pointer.
      let wait = 0;
      let leave = 0;
      cards.forEach((card) => {
        card.addEventListener('pointerenter', () => {
          if (!wide.matches || !pointer.matches) return;
          clearTimeout(wait);
          if (active === card) return;
          wait = window.setTimeout(() => open(card), 260);
        });
        card.addEventListener('pointerleave', () => clearTimeout(wait));
        card.addEventListener('focus', () => wide.matches && open(card));
        card.addEventListener('blur', () => active === card && close());
      });
      cardsBox.addEventListener('pointerenter', () => clearTimeout(leave));
      cardsBox.addEventListener('pointerleave', () => {
        clearTimeout(wait);
        clearTimeout(leave);
        leave = window.setTimeout(close, 200);
      });

      /* ---------- Phones and tablets: each graphic plays while it is on screen ---------- */
      const each = new IntersectionObserver(
        (entries) => {
          if (wide.matches) return;
          for (const e of entries) control(e.target, e.isIntersecting ? 'loop' : 'pause');
        },
        { threshold: 0.4 },
      );
      cards.forEach((card) => each.observe(card));

      if (animate && 'IntersectionObserver' in window) {
        root.classList.add('fb-pre');
        new IntersectionObserver(
          (entries) => {
            const now = entries.some((e) => e.isIntersecting);
            if (now === shown) return;
            shown = now;
            clearTimeout(timer);
            if (shown) timer = window.setTimeout(toAfter, 300);
          },
          { threshold: 0.3 },
        ).observe(chart);
      }

      const refresh = () => {
        size();
        requestAnimationFrame(draw);
      };
      refresh();
      window.addEventListener('resize', () => {
        close();
        refresh();
      });
      document.fonts?.ready.then(refresh);
      wide.addEventListener('change', () => {
        close();
        cards.forEach((card) => control(card, 'stop'));
        refresh();
      });
    });
  }
  initFixBuild();
  document.addEventListener('spockhart:view', initFixBuild);
</script>

<style>
  .fb { padding-block: clamp(3rem, 2rem + 2.5vw, 4.5rem); background: var(--paper-2); overflow-x: clip; }
  .fb-title { font-size: clamp(2.25rem, 1.6rem + 1.6vw, 3.25rem); text-align: center; text-wrap: balance; margin: 0 auto var(--s-6); }

  .fb-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    column-gap: clamp(4.5rem, 2rem + 5vw, 7.5rem);
    align-items: start;
  }
  .fb-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }

  /* ---------- The chart window ---------- */
  .fb-chart {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(0.85rem, 0.5rem + 0.9vw, 1.25rem);
    border-radius: var(--radius-lg);
    background: var(--brand);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .fb-chart::before {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.2), transparent 70%);
    z-index: -1;
  }
  .fb-win { flex: 1; min-height: 0; display: flex; flex-direction: column; border-radius: 10px; background: #173f5c; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 24px 48px -28px rgb(4 18 30 / 0.7); overflow: hidden; }
  .fb-win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: #133650;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9fb6cb;
  }
  .fb-dots { display: flex; gap: 5px; }
  .fb-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / 0.18); }
  .fb-svg { display: block; flex: 1; min-height: 0; width: 100%; height: auto; padding: 0.5rem 0.25rem; box-sizing: border-box; overflow: visible; }

  .fb-grid { stroke: rgb(255 255 255 / 0.06); stroke-width: 1; }
  .fb-axis { stroke: rgb(255 255 255 / 0.28); stroke-width: 1; }
  .fb-divider { stroke: rgb(255 255 255 / 0.08); stroke-width: 1; stroke-dasharray: 2 4; }
  .fb-axis-label { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: #9fb6cb; }
  .fb-group { font-family: var(--font-display); font-size: 20px; fill: #fff; }
  .fb-ann { font-family: var(--font-body); font-size: 12px; fill: #9fb6cb; }
  .fb-ann-hot { fill: #d9e6f2; font-weight: 600; }
  .fb-bracket { fill: none; stroke: rgb(255 255 255 / 0.35); stroke-width: 1; }
  .fb-bracket-after { stroke: rgb(255 255 255 / 0.6); }

  .fb-rev { fill: #6f9fc6; }
  .fb-cost { fill: #b0605a; }
  .fb-cost-after { transform-box: fill-box; transform-origin: bottom; transform: scaleY(var(--cost-after)); }
  .fb-add-rect { fill: #a9d1ee; stroke: #173f5c; stroke-width: 2; }
  .fb-key-add { font-family: var(--font-body); font-size: 13px; font-weight: 700; fill: #133650; }
  .fb-cut-rect { fill: url(#fb-hatch); stroke: #d98a82; stroke-width: 1; stroke-dasharray: 3 2.5; }
  .fb-hatch-line { stroke: rgb(217 138 130 / 0.28); stroke-width: 2; }
  .fb-key-cut { font-family: var(--font-body); font-size: 12px; font-weight: 700; fill: #e7a59e; }
  .fb-add { transform-box: fill-box; transform-origin: bottom; }

  /* One case study open: everything else steps back */
  .fb-slice text, .fb-slice rect { transition: fill 250ms var(--ease), stroke 250ms var(--ease), opacity 250ms var(--ease); }
  .has-active .fb-slice:not(.is-on) rect, .has-active .fb-slice:not(.is-on) text { opacity: 0.35; }
  .fb-add.is-on .fb-add-rect { fill: #fff; }
  .fb-cut.is-on .fb-cut-rect { fill: rgb(217 138 130 / 0.35); stroke: #f1b8b2; stroke-dasharray: none; stroke-width: 1.5; }
  .fb-cut.is-on .fb-key-cut { fill: #fff; }

  /* ---------- Lines from slices to case studies ---------- */
  :global(.fb-link) { fill: none; stroke-width: 1.25; stroke-linecap: round; opacity: 0.55; transition: opacity 250ms var(--ease), stroke-width 250ms var(--ease); }
  :global(.fb-link-build) { stroke: #4a8aba; }
