---
/**
 * Fix what's broken. Build what's missing.
 *
 * One chart, Before and After. After, revenue rises by three new slices (A to C) and costs fall
 * by four slices (1 to 4). Each slice is a real result our team delivered, drawn out to its case
 * study on the right. The After builds itself on a loop while the chart is on screen.
 *
 * Laptops: each case study opens like a dropdown when clicked, with its words on top and its
 * graphic underneath, playing. Pointing at one only tints it slightly.
 * Phones and tablets: the chart, then two rows to swipe; each graphic plays as it comes into view.
 *
 * The chart is illustrative: the bars show direction, not client figures.
 */
import { getCollection } from 'astro:content';
import ResultVisual from './ResultVisual.astro';
import TypeLine from './TypeLine.astro';
import { iconFor, headline } from '../lib/work';

// The client line and headline from each case study on Our Work, shown when one is opened
const work = Object.fromEntries((await getCollection('work')).map((e) => [e.id, e.data]));

interface Item {
  k: string;
  id: string;
  /** Each case study is one line: the result (bright) and how we got it (quieter). On the
      smaller-screen cards only the result shows, since the card carries the headline. */
  value: string;
  rest: string;
}

const build: Item[] = [
  { k: 'A', id: 'sales-performance-system', value: '+$316K a month', rest: ' with a new sales intelligence system' },
  { k: 'B', id: 'digital-practice-growth', value: '$150K to $1M revenue', rest: ' by scaling a digital services practice' },
  { k: 'C', id: 'lead-generation-engine', value: 'A $1B+ market opened', rest: ' through a new digital service' },
];
const fix: Item[] = [
  { k: '1', id: 'commission-automation', value: '80% less time', rest: ' processing commissions for a $1.2B manufacturer' },
  { k: '2', id: 'project-feasibility-platform', value: '12 months → minutes', rest: ', eliminating $100K+ assessment costs' },
  { k: '3', id: 'momentum-exchange-prototype', value: '83% greater fuel efficiency', rest: ' with a new momentum-transfer system' },
  { k: '4', id: 'subcontractor-financing-marketplace', value: '6+ months → weeks', rest: ' for subcontractor financing approvals' },
];

/* Chart geometry. The same chart is drawn twice: tall beside the list of case studies on laptops
   (from the first case study to the last), and in its original proportions above the cards on
   phones and tablets.
   Heights are illustrative. */
const W = 60;
const before = { rev: 92, cost: 160 };
const after = { rev: 330, cost: 398 };
const chartFor = (key: 'wide' | 'narrow') => {
  const S = key === 'wide' ? 0.85 : 1; // the laptop drawing is shaped to sit beside the bars
  const REV = 230 * S; // revenue, before
  const COST = 216 * S; // costs, before: just under revenue
  const ADD = 46 * S; // each new revenue slice
  const CUT = 26 * S; // each cost slice removed
  const TOP = 42;
  const BASE = TOP + REV + ADD * build.length;
  const lab = 22; // axis labels below the base line
  const grp = 48; // Before / After
  const line = 14; // between the two lines of a note
  const revTop = BASE - REV;
  const costTop = BASE - COST;
  const newTop = revTop - ADD * build.length;
  const costAfterTop = costTop + CUT * fix.length;
  const x2 = key === 'wide' ? 523 : 536; // the laptop panel reaches further right, and so do its lines
  return {
    key, REV, COST, ADD, CUT, BASE, lab, grp, line, revTop, costTop, newTop, costAfterTop, x2,
    H: BASE + 60,
    grid: [1, 2, 3, 4, 5].map((k) => BASE - 72 * S * k),
    // The drawing itself, from the top of the new revenue to the Before and After labels
    crop: `20 ${newTop} 460 ${BASE + grp + 8 - newTop}`,
  };
};
const charts = [chartFor('wide'), chartFor('narrow')];

const sets = [
  { key: 'build', title: 'Revenue Development', note: 'Revenue up', items: build },
  { key: 'fix', title: 'Operations Efficiency', note: 'Costs down', items: fix },
];
---

<section class="fb" id="results" aria-labelledby="fb-title" data-fb>
  <div class="wrap">
    <h2 id="fb-title" class="fb-title" data-reveal>Better Operations. New Opportunities.</h2>

    <div class="fb-stage" data-fb-stage>
      <svg class="fb-links" aria-hidden="true" data-fb-links></svg>

      <!-- The chart, in the same window style as the case studies -->
      <figure class="fb-chart" aria-label="Before, costs are just under revenue. After, revenue is up three slices and costs are down four.">
        <div class="fb-win">
          <div class="fb-win-bar"><span class="fb-dots"><i></i><i></i><i></i></span>Costs vs revenue</div>
          {
            charts.map((c) => (
              <svg
                viewBox={`0 0 560 ${c.H}`}
                class:list={['fb-svg', `fb-svg-${c.key}`]}
                data-fb-svg={c.key}
                data-crop={c.key === 'wide' ? c.crop : undefined}
                aria-hidden="true"
                preserveAspectRatio="xMidYMid meet"
              >
                <defs>
                  <pattern id={`fb-hatch-${c.key}`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="7" class="fb-hatch-line" />
                  </pattern>
                </defs>

                {c.grid.map((y) => <line x1="24" x2={c.x2} y1={y} y2={y} class="fb-grid" />)}
                <line x1="24" x2={c.x2} y1={c.BASE} y2={c.BASE} class="fb-axis" />
                <line x1="280" x2="280" y1={c.newTop - 12} y2={c.BASE + c.grp - 4} class="fb-divider" />

                <!-- Before: profitable, barely -->
                <rect x={before.rev} y={c.revTop} width={W} height={c.REV} rx="2" class="fb-rev" />
                <rect x={before.cost} y={c.costTop} width={W} height={c.COST} rx="2" class="fb-cost" />
                <path d={`M${before.rev - 10} ${c.revTop} h-5 V${c.costTop} h5`} class="fb-bracket" />
                <text x={before.rev - 20} y={c.revTop + 4} text-anchor="end" class="fb-ann">
                  <tspan x={before.rev - 20}>Old</tspan>
                  <tspan x={before.rev - 20} dy={c.line}>margin</tspan>
                </text>
                <g class="fb-under">
                  <text x={before.rev + W / 2} y={c.BASE + c.lab} text-anchor="middle" class="fb-axis-label">Revenue</text>
                  <text x={before.cost + W / 2} y={c.BASE + c.lab} text-anchor="middle" class="fb-axis-label">Costs</text>
                  <text x={(before.rev + before.cost + W) / 2} y={c.BASE + c.grp} text-anchor="middle" class="fb-group">Before</text>
                </g>

                <!-- After: revenue up by A to C, costs down by 1 to 4 -->
                <rect x={after.rev} y={c.revTop} width={W} height={c.REV} rx="2" class="fb-rev fb-rev-after" />
                {
                  build.map((b, i) => {
                    const y = c.revTop - c.ADD * (build.length - i);
                    return (
                      <g class="fb-slice fb-add" data-slice={b.k} style={`--i:${i}`}>
                        <rect x={after.rev} y={y} width={W} height={c.ADD} class="fb-add-rect" data-slice-rect />
                        <text x={after.rev + W / 2} y={y + c.ADD / 2 + 4.5} text-anchor="middle" class="fb-key-add">
                          {b.k}
                        </text>
                      </g>
                    );
                  })
                }
                <rect
                  x={after.cost}
                  y={c.costTop}
                  width={W}
                  height={c.COST}
                  rx="2"
                  class="fb-cost fb-cost-after"
                  style={`--cost-after:${((c.COST - c.CUT * fix.length) / c.COST).toFixed(4)}`}
                />
                {
                  fix.map((f, i) => {
                    const y = c.costTop + c.CUT * i;
                    return (
                      <g class="fb-slice fb-cut" data-slice={f.k} style={`--i:${i}`}>
                        <rect
                          x={after.cost + 0.75}
                          y={y + 0.75}
                          width={W - 1.5}
                          height={c.CUT - 1.5}
                          class="fb-cut-rect"
                          fill={`url(#fb-hatch-${c.key})`}
                          data-slice-rect
                        />
                        <text x={after.cost + W / 2} y={y + c.CUT / 2 + 4} text-anchor="middle" class="fb-key-cut">
                          {f.k}
                        </text>
                      </g>
                    );
                  })
                }
                <g class="fb-wide">
                  <path d={`M${after.rev - 10} ${c.newTop} h-5 V${c.costAfterTop} h5`} class="fb-bracket fb-bracket-after" />
                  <text x={after.rev - 20} y={(c.newTop + c.costAfterTop) / 2 - 3} text-anchor="end" class="fb-ann fb-ann-hot">
                    <tspan x={after.rev - 20}>New</tspan>
                    <tspan x={after.rev - 20} dy={c.line + 1}>margin</tspan>
                  </text>
                </g>
                <g class="fb-under">
                  <text x={after.rev + W / 2} y={c.BASE + c.lab} text-anchor="middle" class="fb-axis-label">Revenue</text>
                  <text x={after.cost + W / 2} y={c.BASE + c.lab} text-anchor="middle" class="fb-axis-label">Costs</text>
                  <text x={(after.rev + after.cost + W) / 2} y={c.BASE + c.grp} text-anchor="middle" class="fb-group">After</text>
                </g>
              </svg>
            ))
          }
        </div>
      </figure>

      <!-- The case studies, grouped the way they sit on the chart -->
      <div class="fb-cards" data-fb-cards>
        <div class="fb-eyebrow"><TypeLine text="Our case studies" /></div>
        {
          sets.map((set) => (
            <div class:list={['fb-set', `fb-set-${set.key}`]}>
              <p class="fb-set-head">
                <span class="fb-set-title">{set.title}</span>
                <span class="fb-set-note">{set.note}</span>
              </p>
              <div class="fb-row">
                {set.items.map((it) => (
                  <div class:list={['fb-card', `fb-card-${set.key}`]} data-card={it.k}>
                    <div class="fb-head" role="button" tabindex="0" aria-expanded="false" aria-controls={`fb-panel-${it.k}`} data-head>
                      <div class="fb-media" aria-hidden="true">
                        <div class:list={['fb-live', { 'fb-after': set.key === 'build' }]} data-manual data-thumb>
                          <ResultVisual id={it.id} wide={set.key === 'build'} />
                        </div>
                      </div>
                      <div class="fb-body">
                        <span class="fb-note">Our Work</span>
                        <span class="fb-text">
                          <span class="fb-line"><span class="fb-v">{it.value}</span><span class="fb-l">{it.rest}</span></span>
                        </span>
                      </div>
                      <span class="fb-caret" aria-hidden="true">
                        <svg viewBox="0 0 16 16">
                          <path d="M3.5 6l4.5 4.5L12.5 6" />
                        </svg>
                      </span>
                    </div>
                    <div class="fb-panel" id={`fb-panel-${it.k}`} data-panel>
                      <div class="fb-panel-inner">
                        <div class="fb-panel-body">
                          <span class="fb-pnote">Our Work</span>
                          <div class="fb-cs">
                            <p class="fb-client">
                              <span class="fb-client-mark" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                  <path d={iconFor(it.id)} />
                                </svg>
                              </span>
                              {work[it.id]?.client}
                            </p>
                            <p class="fb-headline">
                              {headline(work[it.id]?.title ?? '').map((part, n) => (n % 2 ? <span class="hl">{part}</span> : part))}
                            </p>
                          </div>
                          <div class="fb-graphic" aria-hidden="true">
                            <div class:list={['fb-graphic-live', { 'fb-after': set.key === 'build' }]} data-manual data-full>
                              <ResultVisual id={it.id} wide={set.key === 'build'} />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { initScenes, sceneController, scenesCanAnimate } from '../scripts/scenes';


  function initFixBuild() {
    initScenes();
    document.querySelectorAll<HTMLElement>('[data-fb]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const stage = root.querySelector<HTMLElement>('[data-fb-stage]')!;
      const chart = root.querySelector<SVGSVGElement>('[data-fb-svg="wide"]')!;
      const chartFig = root.querySelector<HTMLElement>('.fb-chart')!;
      const links = root.querySelector<SVGSVGElement>('[data-fb-links]')!;
      const cardsBox = root.querySelector<HTMLElement>('[data-fb-cards]')!;
      const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
      const wide = window.matchMedia('(min-width: 1100px)');
      const ns = 'http://www.w3.org/2000/svg';
      const animate = scenesCanAnimate();

      let open: HTMLElement | null = null;
      const slice = (k: string) => chart.querySelector<SVGGElement>(`[data-slice="${k}"]`);
      const headOf = (card: HTMLElement) => card.querySelector<HTMLElement>('[data-head]')!;
      const panelOf = (card: HTMLElement) => card.querySelector<HTMLElement>('[data-panel]')!;
      const control = (card: Element, which: 'thumb' | 'full', how: 'play' | 'loop' | 'pause' | 'stop') => {
        const sc = card.querySelector<HTMLElement>(`[data-${which}] [data-scene]`);
        const ctrl = sc ? sceneController(sc) : undefined;
        if (ctrl && (how === 'stop' || animate)) ctrl[how]();
      };

      /* ---------- Lines from each slice out to its case study (laptops) ----------
         Each line is made once and only its path is updated, so nothing flickers or restarts
         while a case study opens or closes. */
      const lines = new Map<HTMLElement, { g: SVGGElement; path: SVGPathElement }>();
      const lineFor = (card: HTMLElement) => {
        let l = lines.get(card);
        if (!l) {
          const kind = /\d/.test(card.dataset.card!) ? 'fix' : 'build';
          const g = document.createElementNS(ns, 'g') as SVGGElement;
          const path = document.createElementNS(ns, 'path') as SVGPathElement;
          path.setAttribute('pathLength', '1');
          path.setAttribute('class', `fb-link fb-link-${kind}`);
          g.append(path);
          links.append(g);
          l = { g, path };
          lines.set(card, l);
        }
        return l;
      };
      const draw = () => {
        links.style.display = wide.matches ? '' : 'none';
        if (!wide.matches) return;
        const box = stage.getBoundingClientRect();
        links.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
        const m = chart.getScreenCTM();
        if (!m) return;
        for (const card of cards) {
          const rect = slice(card.dataset.card!)?.querySelector<SVGRectElement>('[data-slice-rect]');
          if (!rect) continue;
          const b = rect.getBBox();
          const sx = m.a * (b.x + b.width) + m.e - box.left + 4;
          const sy = m.d * (b.y + b.height / 2) + m.f - box.top;
          // End just short of the case study's bar, level with its middle
          const head = headOf(card).getBoundingClientRect();
          const ex = head.left - box.left - 6;
          const ey = head.top + head.height / 2 - box.top;
          // Each line curves straight out of its slice to its case study
          const dx = Math.max(24, (ex - sx) * 0.55);
          const { g, path } = lineFor(card);
          g.setAttribute('class', `fb-link-g${card === open ? ' is-open' : ''}`);
          path.setAttribute('d', `M${sx.toFixed(1)} ${sy.toFixed(1)} C${(sx + dx).toFixed(1)} ${sy.toFixed(1)} ${(ex - dx).toFixed(1)} ${ey.toFixed(1)} ${ex.toFixed(1)} ${ey.toFixed(1)}`);
        }
      };
      // While a case study opens or closes, the lines follow their case studies frame by frame
      let follow = 0;
      const track = (ms = 600) => {
        const until = performance.now() + ms;
        cancelAnimationFrame(follow);
        const step = () => {
          draw();
          if (performance.now() < until) follow = requestAnimationFrame(step);
        };
        follow = requestAnimationFrame(step);
      };

      /* ---------- The drawing is as tall as the list (laptops) ----------
         The tall drawing is cropped to itself, from the top of the new revenue down to the
         Before and After labels, and stretched from the first case study to the last. */
      // Where a slice's middle sits on screen (from its geometry, so the build-up does not move it)
      const sliceMid = (k: string) => {
        const r = slice(k)?.querySelector<SVGRectElement>('[data-slice-rect]');
        const m = chart.getScreenCTM();
        if (!r || !m) return 0;
        const b = r.getBBox();
        return m.d * (b.y + b.height / 2) + m.f;
      };
      const centre = () => {
        if (!wide.matches) return 0;
        chart.setAttribute('viewBox', chart.dataset.crop!);
        const first = cards[0].getBoundingClientRect();
        const last = cards[cards.length - 1].getBoundingClientRect();
        chart.style.marginTop = '0px';
        chart.style.height = `${(last.bottom - first.top).toFixed(1)}px`;
        const top = first.top - chart.getBoundingClientRect().top;
        chart.style.marginTop = `${top.toFixed(1)}px`;
        // Then down a little, so every new revenue slice sits below its case study (its line rises
        // to it) and every cost slice above its own (its line falls to it)
        const card = cards.filter((c) => !/\d/.test(c.dataset.card!)).pop();
        if (!card) return 0;
        const r = headOf(card).getBoundingClientRect();
        const drop = Math.max(0, r.top + r.height / 2 - sliceMid(card.dataset.card!) + 30);
        chart.style.marginTop = `${(top + drop).toFixed(1)}px`;
        return drop;
      };

      /* ---------- Thumbnails: each graphic, scaled down to a still frame ---------- */
      const size = () => {
        // Phones: every card as tall as the tallest; the graphic takes whatever space the
        // words leave, so nothing is left blank
        cards.forEach((c) => c.style.removeProperty('min-height'));
        if (!wide.matches) {
          const tallest = Math.max(...cards.map((c) => c.offsetHeight));
          cards.forEach((c) => (c.style.minHeight = `${tallest}px`));
        }
        for (const card of cards) {
          const media = card.querySelector<HTMLElement>('.fb-media')!;
          const live = card.querySelector<HTMLElement>('[data-thumb]')!;
          const natW = live.offsetWidth;
          const natH = live.offsetHeight;
          const bw = media.clientWidth;
          const bh = media.clientHeight;
          const sc = wide.matches ? bw / natW : Math.min(bw / natW, bh / natH);
          card.style.setProperty('--s', sc.toFixed(4));
          card.style.setProperty('--ox', wide.matches ? '0px' : `${((bw - natW * sc) / 2).toFixed(1)}px`);
          card.style.setProperty('--oy', wide.matches ? '0px' : `${((bh - natH * sc) / 2).toFixed(1)}px`);
        }
        // Dropdown graphics are laid out at the width they have on Our Work, then scaled to fit
        if (wide.matches) {
          for (const card of cards) {
            const box = card.querySelector<HTMLElement>('.fb-graphic')!;
            const live = card.querySelector<HTMLElement>('[data-full]')!;
            const gs = box.clientWidth / live.offsetWidth;
            box.style.setProperty('--gs', gs.toFixed(4));
            box.style.height = `${(live.offsetHeight * gs).toFixed(1)}px`;
          }
        }
        if (wide.matches) {
          // The chart is exactly as tall as the list of case studies with all of them closed,
          // and stays that size
          if (!open) {
            chartFig.style.height = `${cardsBox.offsetHeight}px`;
            const drop = centre();
            // The chart now reaches a little below the last case study; the section makes room
            if (drop) chartFig.style.height = `${(cardsBox.offsetHeight + drop).toFixed(1)}px`;
          }
        } else {
          chartFig.style.removeProperty('height');
          centre();
        }
      };

      /* ---------- Dropdowns (laptops): one case study open at a time ---------- */
      const setOpen = (card: HTMLElement, on: boolean) => {
        card.classList.toggle('is-open', on);
        headOf(card).setAttribute('aria-expanded', String(on));
        panelOf(card).inert = !on;
        control(card, 'full', on ? 'play' : 'stop');
      };
      const toggle = (card: HTMLElement) => {
        if (!wide.matches) return;
        if (open && open !== card) setOpen(open, false);
        const next = open !== card;
        setOpen(card, next);
        open = next ? card : null;
        root.classList.toggle('has-open', Boolean(open));
        hold(Boolean(open));
        track(700);
      };
      const mode = () => {
        cards.forEach((card) => {
          const head = headOf(card);
          head.tabIndex = wide.matches ? 0 : -1;
          panelOf(card).inert = wide.matches && !card.classList.contains('is-open');
        });
      };
      cards.forEach((card) => {
        const head = headOf(card);
        head.addEventListener('click', () => toggle(card));
        head.addEventListener('keydown', (e) => {
          if (e.key !== 'Enter' && e.key !== ' ') return;
          e.preventDefault();
          toggle(card);
        });
      });

      /* ---------- The chart: Before turns into After, over and over, while every case
         study is closed. With one open, it holds still on the finished After. ---------- */
      let shown = false;
      let timer = 0;
      const toAfter = () => {
        root.classList.remove('fb-pre');
        timer = window.setTimeout(toBefore, 9000);
      };
      const toBefore = () => {
        if (!shown || open) return;
        root.classList.add('fb-pre');
        timer = window.setTimeout(toAfter, 1600);
      };
      function hold(on: boolean) {
        window.clearTimeout(timer);
        if (on) {
          root.classList.add('fb-hold');
          root.classList.remove('fb-pre');
          return;
        }
        // Let the snap to the finished frame settle before the transitions come back
        requestAnimationFrame(() => root.classList.remove('fb-hold'));
        if (animate && shown) timer = window.setTimeout(toBefore, 4000);
      }

      /* ---------- Phones and tablets: each graphic plays while it is on screen ---------- */
      const each = new IntersectionObserver(
        (entries) => {
          if (wide.matches) return;
          for (const e of entries) control(e.target, 'thumb', e.isIntersecting ? 'loop' : 'pause');
        },
        { threshold: 0.4 },
      );
      cards.forEach((card) => each.observe(card));

      if (animate && 'IntersectionObserver' in window) {
        root.classList.add('fb-pre');
        new IntersectionObserver(
          (entries) => {
            const now = entries.some((e) => e.isIntersecting);
            if (now === shown) return;
            shown = now;
            clearTimeout(timer);
            if (shown && !open) timer = window.setTimeout(toAfter, 300);
          },
          { threshold: 0.3 },
        ).observe(chart);
      }

      const refresh = () => {
        size();
        requestAnimationFrame(draw);
      };
      mode();
      refresh();
      window.addEventListener('resize', refresh);
      document.fonts?.ready.then(refresh);
      // Anything that shifts the list (a label typing in, fonts arriving) redraws the lines
      if ('ResizeObserver' in window) new ResizeObserver(() => requestAnimationFrame(draw)).observe(cardsBox);
      wide.addEventListener('change', () => {
        if (open) setOpen(open, false);
        open = null;
        root.classList.remove('has-open');
        hold(false);
        cards.forEach((card) => control(card, 'thumb', 'stop'));
        mode();
        refresh();
      });
    });
  }
  initFixBuild();
  document.addEventListener('spockhart:view', initFixBuild);
</script>

<style>
  .fb { padding-block: clamp(3.5rem, 2.5rem + 2.5vw, 5rem) clamp(2rem, 1.25rem + 1.4vw, 2.75rem); background: var(--paper-2); overflow-x: clip; }
  .fb-title { font-size: clamp(2.25rem, 1.6rem + 1.6vw, 3.25rem); text-align: center; text-wrap: balance; margin: 0 auto clamp(2.25rem, 1.5rem + 1.6vw, 3.25rem); }

  .fb-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    column-gap: clamp(4.5rem, 2rem + 5vw, 7.5rem);
    align-items: start;
  }
  .fb-links { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }

  /* ---------- The chart window ---------- */
  .fb-chart {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: clamp(0.85rem, 0.5rem + 0.9vw, 1.25rem);
    border-radius: var(--radius-lg);
    background: var(--brand);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .fb-chart::before {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.2), transparent 70%);
    z-index: -1;
  }
  .fb-win { flex: 1; min-height: 0; display: flex; flex-direction: column; border-radius: 10px; background: #173f5c; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 24px 48px -28px rgb(4 18 30 / 0.7); overflow: hidden; }
  .fb-win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: #133650;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9fb6cb;
  }
  .fb-dots { display: flex; gap: 5px; }
  .fb-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / 0.18); }
  .fb-svg { display: block; flex: 1; min-height: 0; width: 100%; height: auto; padding: 0.5rem 0.25rem; box-sizing: border-box; overflow: visible; }

  .fb-grid { stroke: rgb(255 255 255 / 0.06); stroke-width: 1; }
  .fb-axis { stroke: rgb(255 255 255 / 0.28); stroke-width: 1; }
  .fb-divider { stroke: rgb(255 255 255 / 0.08); stroke-width: 1; stroke-dasharray: 2 4; }
  .fb-axis-label { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: #9fb6cb; }
  .fb-group { font-family: var(--font-display); font-size: 20px; fill: #fff; }
  .fb-ann { font-family: var(--font-body); font-size: 12px; fill: #9fb6cb; }
  .fb-ann-hot { fill: #d9e6f2; font-weight: 600; }
  .fb-bracket { fill: none; stroke: rgb(255 255 255 / 0.35); stroke-width: 1; }
  .fb-bracket-after { stroke: rgb(255 255 255 / 0.6); }

  .fb-rev { fill: #6f9fc6; }
  .fb-cost { fill: #b0605a; }
  .fb-cost-after { transform-box: fill-box; transform-origin: bottom; transform: scaleY(var(--cost-after)); }
  .fb-add-rect { fill: #a9d1ee; stroke: #173f5c; stroke-width: 2; }
  .fb-key-add { font-family: var(--font-body); font-size: 13px; font-weight: 700; fill: #133650; }
  .fb-cut-rect { stroke: #d98a82; stroke-width: 1; stroke-dasharray: 3 2.5; }
  .fb-hatch-line { stroke: rgb(217 138 130 / 0.28); stroke-width: 2; }
  .fb-key-cut { font-family: var(--font-body); font-size: 12px; font-weight: 700; fill: #e7a59e; }
  .fb-add { transform-box: fill-box; transform-origin: bottom; }

  /* ---------- Lines from slices to case studies ---------- */
  :global(.fb-link) { fill: none; stroke-width: 1.25; stroke-linecap: butt; opacity: 0.55; transition: opacity 250ms var(--ease), stroke-width 250ms var(--ease); }
  :global(.fb-link-build) { stroke: #4a8aba; }
  :global(.fb-link-fix) { stroke: #c0726b; }
  :global(.fb-link-g) { transition: opacity 250ms var(--ease); }
  /* With a case study open, only its own line shows */
  .has-open :global(.fb-link-g:not(.is-open)) { opacity: 0; }

  /* ---------- The case studies ---------- */
  .fb-cards { position: relative; display: grid; gap: 0.55rem; }
  .fb-eyebrow { margin-bottom: calc(var(--s-2) * -1); }
  .fb-eyebrow, .fb-set-head { transition: opacity 300ms var(--ease), filter 300ms var(--ease); }
  .fb-set { display: grid; gap: 0.35rem; }
  .fb-set + .fb-set { margin-top: 0.25rem; }
  .fb-set-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); padding-bottom: 0.2rem; border-bottom: 1px solid var(--rule-2); }
  .fb-set-title { font-family: var(--font-display); font-size: 1.0625rem; color: var(--ink); }
  .fb-set-note { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .fb-set-build .fb-set-note { color: var(--accent); }
  .fb-set-fix .fb-set-note { color: #a04f48; }
  .fb-row { display: grid; gap: 0.35rem; }

  .fb-card {
    position: relative;
    z-index: 2;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    transition: border-color 250ms var(--ease);
  }
  .fb-card.is-open { border-color: var(--rule-2); }
  .fb-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
    cursor: pointer;
    transition: background-color 200ms var(--ease);
  }
  /* The only hover: a slight change in colour, so it reads as something to open */
  .fb-head:hover { background: #edf2f7; }
  .fb-head:focus-visible { outline: 2px solid var(--accent-soft); outline-offset: -2px; }

  /* The real graphic, shrunk to a still frame */
  .fb-media {
    position: relative;
    width: 80px;
    height: 48px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--brand);
  }
  .fb-live {
    position: absolute;
    left: 0;
    top: 0;
    width: 640px;
    transform: translate(var(--ox, 0px), var(--oy, 0px)) scale(var(--s, 0.125));
    transform-origin: 0 0;
    pointer-events: none;
  }

  .fb-body { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.75rem; align-items: center; min-width: 0; }
  .fb-key {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: lining-nums;
    color: #fff;
  }
  .fb-card-build .fb-key { background: var(--accent); }
  .fb-card-fix .fb-key { background: #a04f48; }
  /* Opened (and on phones) the letter gives way to a note that this is our team's own work */
  .fb-note {
    display: none;
    justify-self: start;
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
  }
  .fb-card-build .fb-note { color: var(--accent); background: var(--accent-wash); }
  .fb-card-fix .fb-note { color: #a04f48; background: rgb(160 79 72 / 0.1); }
  .fb-text { display: grid; gap: 0.1rem; min-width: 0; }
  .fb-v { font-family: var(--font-display); font-size: 1.125rem; line-height: 1.15; color: var(--ink); font-variant-numeric: lining-nums; }
  /* A chevron says there is more to see; it turns when the case study opens */
  .fb-caret { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; color: var(--ink-3); transition: transform 420ms var(--ease-out), color 250ms var(--ease); }
  .fb-caret svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .fb-head:hover .fb-caret { color: var(--accent); }
  .fb-card.is-open .fb-caret { transform: rotate(180deg); color: var(--accent); }
  /* Revenue Development, on the home page: each graphic shows only its After, so it can be drawn
     larger. Operations Efficiency and Our Work keep the full Before and After. */
  @media (min-width: 1100px) {
    .fb-live.fb-after, .fb-graphic-live.fb-after { width: 440px; }
  }
  .fb-after :global(.scene > .lane:first-child) { display: none; }
  .fb-after :global(.lane + .lane) { border: 0; }
  .fb-after :global(.panes) { grid-template-columns: minmax(0, 1fr); }
  /* Sales: the team's sales trend top right, beside the tag; the reps run the full width below */
  .fb-after :global(.rv-sales-performance-system .panes > .lane) {
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: 1.5rem;
    row-gap: 0.85rem;
  }
  .fb-after :global(.rv-sales-performance-system .lane-head) { display: contents; }
  .fb-after :global(.rv-sales-performance-system .readout) { display: none; }
  .fb-after :global(.rv-sales-performance-system .tag) { grid-column: 1; grid-row: 1; align-self: start; }
  .fb-after :global(.rv-sales-performance-system .spark) { grid-column: 2; grid-row: 1; margin: 0; }
  .fb-after :global(.rv-sales-performance-system .board) { grid-column: 1 / -1; grid-row: 2; }
  /* New market: just the network of builders, developers and organizations, larger */
  .fb-after :global(.rv-lead-generation-engine .spark) { display: none; }
  .fb-after :global(.rv-lead-generation-engine .panes > .lane) { grid-template-rows: auto auto; }
  .fb-after :global(.rv-lead-generation-engine .pane-svg) { max-height: 220px; }
  /* The practice: its growth chart across the full width, the services listed underneath */
  .fb-after :global(.rv-digital-practice-growth .panes > .lane) { grid-template-rows: auto auto auto; }
  .fb-after :global(.rv-digital-practice-growth .legend) { padding-top: 0.75rem; }
  /* On the home page the graphics drop their number rows; the words carry the numbers */
  .fb-live :global(.rv-split) { display: none; }
  .fb-live :global(.rv) { padding: 14px; gap: 0; }

  /* The dropdown: the client line and headline from Our Work on top, the graphic underneath */
  .fb-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 420ms var(--ease-out); }
  .fb-card.is-open .fb-panel { grid-template-rows: 1fr; }
  .fb-panel-inner { min-height: 0; overflow: hidden; }
  .fb-panel-body { display: grid; gap: 0.8rem; justify-items: start; padding: 0.95rem 1rem 1rem; border-top: 1px solid var(--rule); text-align: left; }
  .fb-pnote {
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .fb-card-build .fb-pnote { color: var(--accent); background: var(--accent-wash); }
  .fb-card-fix .fb-pnote { color: #a04f48; background: rgb(160 79 72 / 0.1); }
  .fb-cs { display: grid; gap: 0.5rem; }
  .fb-graphic { position: relative; width: 100%; overflow: hidden; border-radius: var(--radius-lg); }
  .fb-graphic-live { position: absolute; left: 0; top: 0; width: 640px; transform: scale(var(--gs, 0.8)); transform-origin: 0 0; }
  .fb-graphic :global(.rv-split) { display: none; }
  .fb-graphic :global(.rv) { gap: 0; }
  .fb-client { display: flex; align-items: center; gap: 0.6rem; font-family: var(--font-display); font-size: 1rem; line-height: 1.2; color: var(--ink); }
  .fb-client-mark { position: relative; flex: none; display: grid; place-items: center; width: 28px; height: 32px; }
  .fb-client-mark::before { content: ''; position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .fb-client-mark svg { position: relative; width: 14px; height: 14px; fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .fb-headline { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.25; color: var(--ink); }
  .fb-headline .hl { color: var(--accent); }

  /* The After builds itself, over and over: costs drop, the cut slices appear, new revenue
     stacks up, then the lines draw out to the case studies */
  @media (prefers-reduced-motion: no-preference) {
    .fb-cost-after { transition: transform 1300ms var(--ease-out) 200ms; }
    .fb-cut { transition: opacity 600ms var(--ease) calc(850ms + var(--i) * 180ms); }
    .fb-add { transition: opacity 550ms var(--ease) calc(1550ms + (2 - var(--i)) * 250ms), transform 800ms var(--ease-out) calc(1550ms + (2 - var(--i)) * 250ms); }
    .fb-wide { transition: opacity 600ms var(--ease) 2450ms; }
    :global(.fb-link) { stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1100ms var(--ease-out) 2650ms, opacity 250ms var(--ease), stroke-width 250ms var(--ease); }

    /* A case study is open: the chart sits still on its finished After */
    .fb-hold .fb-cost-after, .fb-hold .fb-cut, .fb-hold .fb-add, .fb-hold .fb-wide, .fb-hold :global(.fb-link) { transition: none !important; }

    /* Back to Before, quickly and together */
    .fb-pre .fb-cost-after { transform: scaleY(1); transition: transform 700ms var(--ease); }
    .fb-pre .fb-cut { opacity: 0; transition: opacity 400ms var(--ease); }
    .fb-pre .fb-add { opacity: 0; transform: translateY(18px); transition: opacity 400ms var(--ease), transform 500ms var(--ease); }
    .fb-pre .fb-wide { opacity: 0; transition: opacity 300ms var(--ease); }
    .fb-pre :global(.fb-link) { stroke-dashoffset: 1; transition: stroke-dashoffset 400ms var(--ease), opacity 250ms var(--ease); }
  }

  /* ---------- Tablets and phones: chart first, then two rows to swipe ---------- */
  @media (max-width: 1099px) {
    .fb-title { margin-bottom: var(--s-7); }
    .fb-stage { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-6); }
    .fb-links { display: none; }
    .fb-cards { gap: var(--s-5); }
    .fb-set-fix { order: 1; }
    .fb-set-build { order: 2; }
    .fb-row {
      grid-auto-flow: column;
      grid-auto-columns: min(86%, 440px);
      gap: var(--s-3);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0.25rem var(--gutter) 0.5rem;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }
    .fb-row::-webkit-scrollbar { display: none; }
    /* Phones and tablets: every card shows its case study, no dropdowns. The head and the
       dropdown open up into the card itself, so the pieces stack: words, then the graphic. */
    .fb-card { scroll-snap-align: start; display: flex; flex-direction: column; gap: 0.6rem; padding: 0.85rem; }
    .fb-head, .fb-panel, .fb-panel-inner, .fb-panel-body { display: contents; }
    .fb-head { cursor: default; }
    .fb-body { order: 1; align-items: start; grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
    .fb-key { display: none; }
    .fb-note { display: block; }
    .fb-text { gap: 0; }
    .fb-v { font-size: 1.0625rem; }
    .fb-cs { order: 2; gap: 0.35rem; margin-top: 0.4rem; padding-top: 0.5rem; border-top: 1px solid var(--rule); }
    .fb-media { order: 3; flex: 1; width: 100%; height: auto; min-height: 210px; border-radius: var(--radius); }
    .fb-live { width: 400px; }
    .fb-client { font-size: 0.875rem; gap: 0.5rem; }
    .fb-client-mark { width: 22px; height: 25px; }
    .fb-client-mark svg { width: 12px; height: 12px; }
    .fb-headline { font-size: 0.9375rem; line-height: 1.25; }
    .fb-caret, .fb-pnote, .fb-graphic { display: none; }
  }
  @media (max-width: 640px) {
    .fb-title { font-size: clamp(2rem, 1.55rem + 1.5vw, 3rem); }
    /* The chart's labels, sized for a phone screen */
    .fb-axis-label { font-size: 13.5px; letter-spacing: 0; }
    .fb-ann { font-size: 17px; }
    .fb-group { font-size: 28px; }
    .fb-key-add, .fb-key-cut { font-size: 18px; }
    .fb-row { grid-auto-columns: 88%; }
    .fb-set-title { font-size: 1.0625rem; }
    .fb-set-note { font-size: 0.625rem; letter-spacing: 0.1em; white-space: nowrap; }
    .fb-card { padding: 0.75rem 0.65rem; }
  }

  /* ==========================================================================
     Dark and refined, in the same language as the Nonprofits page: no frames, thin lines,
     soft light, and a typographic list. Light, or dark with the device (.page-body tokens).
     ========================================================================== */
  .fb { background: transparent; padding-block: clamp(4rem, 3rem + 3vw, 6.5rem) clamp(2.5rem, 1.5rem + 3vw, 5rem); }
  .fb-title {
    text-align: left;
    margin-left: 0;
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: clamp(2.5rem, 1.75rem + 2.5vw, 4.25rem);
  }

  /* The chart, unframed */
  .fb-chart { padding: 0; border-radius: 0; background: none; overflow: visible; }
  .fb-chart::before { display: none; }
  .fb-win { background: none; border: 0; border-radius: 0; box-shadow: none; overflow: visible; }
  .fb-win-bar {
    padding: 0 0 0.85rem;
    background: none;
    border-bottom: 1px solid rgb(var(--hair) / 0.1);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .fb-dots { display: none; }
  .fb-svg { padding: 1rem 0 0; }
  .fb-grid { stroke: rgb(var(--hair) / 0.07); }
  .fb-axis { stroke: rgb(var(--hair) / 0.3); }
  .fb-divider { stroke: rgb(var(--hair) / 0.07); }
  .fb-axis-label { font-size: 10.5px; letter-spacing: 0.18em; fill: var(--muted); }
  .fb-group { font-size: 19px; fill: var(--ink); }
  .fb-ann { fill: var(--muted); }
  .fb-ann-hot { fill: var(--hot); font-weight: 500; }
  .fb-bracket { stroke: rgb(var(--hair) / 0.3); }
  .fb-bracket-after { stroke: rgb(var(--hair) / 0.5); }
  .fb-rev { fill: var(--c-rev-dull); }
  .fb-cost { fill: rgb(var(--c-cost) / 0.5); }
  .fb-add-rect { fill: rgb(var(--hl-rgb) / 0.2); stroke: rgb(var(--hl-rgb) / 0.65); stroke-width: 1; }
  .fb-key-add { font-size: 12px; font-weight: 600; fill: var(--hot); }
  .fb-cut-rect { stroke: rgb(var(--warm-rgb) / 0.6); stroke-width: 1; }
  .fb-hatch-line { stroke: rgb(var(--warm-rgb) / 0.24); stroke-width: 1; }
  .fb-key-cut { font-size: 11px; font-weight: 600; fill: var(--warm); }
  .fb-add.is-on .fb-add-rect { fill: rgb(var(--hl-rgb) / 0.45); }
  :global(.fb-link) { stroke-width: 1; opacity: 0.5; }
  :global(.fb-link-build) { stroke: var(--hl); }
  :global(.fb-link-fix) { stroke: var(--warm); }

  /* The case studies: hairline-ruled rows, one line each, no boxes */
  .fb-eyebrow { margin-bottom: 0.35rem; }
  .fb-set-head { border-bottom-color: rgb(var(--hair) / 0.22); }
  .fb-set-title { color: var(--ink); }
  .fb-set-build .fb-set-note { color: var(--hl); }
  .fb-set-fix .fb-set-note { color: var(--warm); }
  .fb-key {
    position: relative;
    width: auto;
    height: auto;
    padding-left: 1.6rem;
    border-radius: 0;
    background: none !important;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--ink-3);
  }
  .fb-key::before { content: ''; position: absolute; left: 0; top: 50%; width: 1.1rem; height: 2px; border-radius: 1px; background: var(--c); }
  .fb-card-build { --c: var(--hl); }
  .fb-card-fix { --c: var(--warm); }
  .fb-v { color: var(--ink); font-weight: 400; }
  .fb-caret { color: var(--ink-3); }
  .fb-head:hover { background: rgb(var(--hair) / 0.035); }
  .fb-head:hover .fb-caret, .fb-card.is-open .fb-caret { color: var(--hl); }
  .fb-panel-body { border-top-color: rgb(var(--hair) / 0.1); }
  .fb-card-build .fb-pnote { color: var(--hl); background: rgb(var(--hl-rgb) / 0.12); }
  .fb-card-fix .fb-pnote { color: var(--warm); background: rgb(var(--warm-rgb) / 0.12); }
  .fb-client { color: var(--ink); }
  .fb-client-mark::before { background: var(--ink); }
  .fb-client-mark svg { stroke: var(--on-ink); }
  .fb-headline { color: var(--ink); font-weight: 400; }
  .fb-headline .hl { color: var(--hl); }

  @media (min-width: 1100px) {
    .fb-row { gap: 0; }
    .fb-card { border: 0; border-bottom: 1px solid rgb(var(--hair) / 0.1); border-radius: 0; background: none; }
    .fb-card.is-open { border-color: rgb(var(--hair) / 0.1); }
    .fb-head { grid-template-columns: minmax(0, 1fr) auto; padding: 0.85rem 0.5rem 0.85rem 0; }
    .fb-v { font-size: 1.3125rem; }
    /* The words carry each row; the graphic opens in the dropdown */
    .fb-media { display: none; }
    .fb-panel-body { padding: 0.25rem 0 1.25rem; border-top: 0; }
  }
  /* Phones and tablets: the swipe cards, quiet on the dark ground */
  @media (max-width: 1099px) {
    .fb-card { border: 1px solid rgb(var(--hair) / 0.1); background: var(--card-bg); }
    .fb-key { display: block; }
    .fb-note { display: none; }
    .fb-cs { border-top-color: rgb(var(--hair) / 0.1); }
  }
  /* Restrained, like a printed annual report: flat colour, hairlines, no glow. Before is muted;
     the After bars start just as muted and fill to full colour once our work is built on them
     (costs once the cuts land, revenue once the new slices stack up). */
  /* The chart sits on its own dark panel, in the hero's colours, in light and dark mode alike.
     Before and After bars share the same quiet colours; what our work adds or cuts is drawn in
     the hero's lightsaber blue and red, with the same soft glow. */
  .fb {
    --c-rev: 156 200 234;
    --c-cost: 214 84 96;
    --c-rev-dull: rgb(110 160 205 / 0.5);
    --saber-blue: 63 208 255;
    --saber-red: 255 42 77;
  }
  .fb-chart {
    --ink: #eef3f8;
