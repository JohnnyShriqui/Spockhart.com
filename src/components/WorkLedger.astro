---
/** Our Work, opening: each project's headline result, typeset as a ledger. Each line opens its details below. */
const rows = [
  { value: '$1.2B', label: 'Manufacturer’s commissions, automated', id: 'commission-automation' },
  { value: '1yr → 30min', label: 'Project feasibility assessments', id: 'project-feasibility-platform' },
  { value: '6mth → 3wk', label: 'Subcontractor financing approvals', id: 'subcontractor-financing-marketplace' },
  { value: '↑ $316K', label: 'Average monthly sales, 16 reps', id: 'sales-performance-system' },
  { value: '+$850K', label: 'Practice revenue in under a year', id: 'digital-practice-growth' },
  { value: '183%', label: 'Cargo per trip on the same fuel', id: 'momentum-exchange-prototype' },
  { value: 'Global', label: 'Supplier network mapped, scored and ranked', id: 'supply-chain-assessment' },
];
---

<ol class="ledger">
  {
    rows.map((r, i) => (
      <li>
        <a href={`/work/#${r.id}`}>
          <span class="l-n">{String(i + 1).padStart(2, '0')}</span>
          <span class="l-v">{r.value}</span>
          <span class="l-k">{r.label}</span>
          <span class="l-go" aria-hidden="true">→</span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .ledger { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--ink); }
  .ledger a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 9.5rem) minmax(0, 1fr) auto;
    gap: var(--s-4);
    align-items: baseline;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--rule-2);
    color: inherit;
    text-decoration: none;
    transition: background-color 200ms var(--ease), padding 300ms var(--ease-out);
  }
  .ledger a:hover { background: var(--surface); padding-inline: 0.75rem 0.5rem; }
  .l-n { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--ink-3); }
  .l-v { font-family: var(--font-display); font-size: 1.375rem; font-weight: 650; letter-spacing: -0.025em; color: var(--ink); white-space: nowrap; font-variant-numeric: lining-nums proportional-nums; }
  .l-k { font-family: var(--font-text); font-size: 1.0625rem; line-height: 1.35; color: var(--ink-2); }
  .l-go { color: var(--ink-3); transition: transform 200ms var(--ease), color 200ms var(--ease); }
  .ledger a:hover .l-go { transform: translateX(3px); color: var(--accent); }
  .ledger a:hover .l-v { color: var(--accent); }
</style>
