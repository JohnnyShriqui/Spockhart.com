---
/**
 * A small live graphic for each phase of the engagement (Approach page).
 * The phase card it sits in is the scene: scripts/scenes.ts writes the time to
 * --t on the card and these styles turn it into motion. Process names, records
 * and roles rotate each time a graphic plays, so more teams see their own work.
 * Everything shown is an illustration, not client data.
 */
interface Props {
  phase: 0 | 1 | 2 | 3;
  /** 'fix' removes waste (Diagnose to Hand over); 'grow' finds new revenue (Assess to Deploy) */
  track?: 'fix' | 'grow';
}
const { phase, track = 'fix' } = Astro.props;
const fix = track === 'fix';
const grow = track === 'grow';
import { upperPath, lowerPath } from '../lib/logo';

/* 1. Diagnose: one process, mapped, with its waste found */
const processes = [
  { name: 'Order to invoice', steps: ['Order in', 'Typed in CRM', 'Typed in books', 'Manager OK', 'Invoice sent'] },
  { name: 'Donation to receipt', steps: ['Gift arrives', 'Into a sheet', 'Into the CRM', 'Finance check', 'Receipt sent'] },
  { name: 'Intake to case file', steps: ['Client calls', 'Paper form', 'Re-typed', 'Review', 'Case opened'] },
  { name: 'Offer to first day', steps: ['Offer signed', 'HR form', 'Payroll form', 'IT request', 'Day one'] },
];
const boxes = [
  { x: 8, y: 46 },
  { x: 92, y: 46 },
  { x: 176, y: 46 },
  { x: 176, y: 112 },
  { x: 92, y: 112 },
];
const BW = 76;
const BH = 30;

/* 2. Prototype: a working tool on real records */
const apps = [
  { name: 'Invoice approvals', status: 'Approved', rows: [['INV-1042', '$4,280'], ['INV-1043', '$960'], ['INV-1044', '$12,400'], ['INV-1045', '$2,115']] },
  { name: 'Donor receipts', status: 'Receipted', rows: [['Gift 2201', '$250'], ['Gift 2202', '$1,000'], ['Gift 2203', '$75'], ['Gift 2204', '$500']] },
  { name: 'Intake tracker', status: 'Assigned', rows: [['Case 318', 'New'], ['Case 319', 'Urgent'], ['Case 320', 'Follow-up'], ['Case 321', 'New']] },
  { name: 'Shift scheduler', status: 'Filled', rows: [['Sat AM', '6 of 6'], ['Sat PM', '5 of 5'], ['Sun AM', '6 of 6'], ['Sun PM', '4 of 4']] },
];
const rowY = [40, 66, 92, 118];

/* 3. Build and embed: connected to the tools already in use, and the team trained */
const tools = [
  { name: 'Email', x: 8, y: 10 },
  { name: 'Accounting', x: 182, y: 10 },
  { name: 'CRM', x: 8, y: 96 },
  { name: 'Calendar', x: 182, y: 96 },
];
const hub = { x: 130, y: 64 };
const roles = ['Finance', 'Operations', 'Admin'];

/* 4. Hand over: the kit, and the keys */
const kit = ['Source code', 'Documentation', 'Admin access', 'Training notes'];

/* ---------- Growth track ---------- */

/* Few words on purpose: shapes carry the meaning, like the case-study graphics on Our Work */

/* 1. Assess: four lenses on the business, adding up to untapped revenue */
const lensX = [36, 98, 160, 222];
const lensLabels = ['Customers', 'Market', 'Capabilities', 'Business model'];
const LENS_Y = 60;
const gear = (cx: number, cy: number, rIn: number, rOut: number, n = 8) => {
  const pts: string[] = [];
  const w = (Math.PI * 2) / n;
  for (let i = 0; i < n; i++) {
    const a = w * i;
    for (const [r, f] of [[rIn, 0], [rOut, 0.15], [rOut, 0.5], [rIn, 0.65]] as const) {
      pts.push(`${(cx + Math.cos(a + f * w) * r).toFixed(1)},${(cy + Math.sin(a + f * w) * r).toFixed(1)}`);
    }
  }
  return pts.join(' ');
};

/* 2. Engineer: options pass three tests, one survives and becomes a prototype */
const gates = [
  { x: 58, label: 'Market', a: 0.8 },
  { x: 106, label: 'Demand', a: 1.5 },
  { x: 154, label: 'Feasibility', a: 2.2 },
];
const optionHexes = [
  ...[64, 88, 112].flatMap((y) => [20, 40].map((x) => ({ x, y, a: 0.2 }))),
  ...[76, 100].flatMap((y) => [74, 90].map((x) => ({ x, y, a: 1.1 }))),
  { x: 130, y: 76, a: 1.8 },
  { x: 130, y: 100, a: 1.8 },
];

/* 3. Develop: real customers use it; each version does better */
const versions = [
  { x: 60, y: 114, a: 1.2, label: 'v1' },
  { x: 130, y: 92, a: 2.3, label: 'v2' },
  { x: 200, y: 58, a: 3.3, label: 'v3' },
];

/* 4. Deploy: priced, a sales process, launched, and handed to the team */
const bars = [14, 22, 32, 44, 58, 72, 86];
const tag = 'M2 2H10L17 9L9 17L2 10Z';
const funnel = 'M2 3H16L11 9.5V15L7 17V9.5Z';

const hex = (cx: number, cy: number, r: number) =>
  [0, 1, 2, 3, 4, 5]
    .map((k) => {
      const a = (Math.PI / 3) * k - Math.PI / 2;
      return `${(cx + Math.cos(a) * r).toFixed(1)},${(cy + Math.sin(a) * r).toFixed(1)}`;
    })
    .join(' ');
const person = 'M2.8 4.2a3.2 3.2 0 1 0 6.4 0a3.2 3.2 0 1 0 -6.4 0zM0.6 16c0-3.6 2.4-6.2 5.4-6.2s5.4 2.6 5.4 6.2z';
const tick = (x: number, y: number, s = 1) => `M${x - 3.5 * s} ${y}l${2.4 * s} ${2.4 * s} ${4.8 * s}-5`;
---

<div class="pg" aria-hidden="true">
  {
    fix && phase === 0 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Mapping</text>
        <g class="cycle" data-cycle>
          {processes.map((p, i) => (
            <text x="58" y="16" class:list={['title', { on: i === 0 }]}>
              {p.name}
            </text>
          ))}
        </g>

        {/* arrows between steps */}
        <g class="ap" style="--a:1.4">
          <path d={`M${8 + BW} 61 H92`} class="arrow" />
          <path d={`M${92 + BW} 61 H176`} class="arrow" />
          <path d={`M214 ${46 + BH} V112`} class="arrow" />
          <path d={`M176 127 H${92 + BW}`} class="arrow" />
        </g>

        {boxes.map((b, k) => (
          <g class="pop" style={`--a:${(0.2 + k * 0.28).toFixed(2)}`}>
            <rect x={b.x} y={b.y} width={BW} height={BH} rx="5" class:list={['step', { 'step-dup': k === 1 || k === 2, 'step-slow': k === 3 }]} />
            <g class="cycle" data-cycle>
              {processes.map((p, i) => (
                <text x={b.x + BW / 2} y={b.y + 19} class:list={['step-label', { on: i === 0 }]} text-anchor="middle">
                  {p.steps[k]}
                </text>
              ))}
            </g>
          </g>
        ))}

        {/* duplication */}
        <g class="flag" style="--a:2.2">
          <rect x="88" y="42" width="168" height="38" rx="7" class="flag-ring" />
          <rect x="120" y="26" width="104" height="14" rx="7" class="flag-tag" />
          <text x="172" y="36" class="flag-text" text-anchor="middle">Same data, twice</text>
        </g>

        {/* bottleneck: work piling up */}
        {[0, 1, 2].map((i) => (
          <rect x={209} y={80 + i * 9} width="10" height="7" rx="1.5" class="queue pop" style={`--a:${(3 + i * 0.25).toFixed(2)}`} />
        ))}
        <g class="flag" style="--a:3.5">
          <rect x="172" y="146" width="84" height="14" rx="7" class="flag-tag" />
          <text x="214" y="156" class="flag-text" text-anchor="middle">Bottleneck</text>
        </g>

        <g class="pop" style="--a:4.3">
          <rect x="8" y="170" width="186" height="20" rx="10" class="found" />
          <text x="20" y="184" class="found-text">
            2 issues, priced in hours and dollars
          </text>
        </g>
      </svg>
    )
  }

  {
    fix && phase === 1 && (
      <svg viewBox="0 0 260 196">
        <rect x="6" y="6" width="248" height="150" rx="7" class="win" />
        <path d="M6 13a7 7 0 0 1 7-7h234a7 7 0 0 1 7 7v15H6z" class="win-bar" />
        <circle cx="17" cy="17" r="2.6" class="win-dot" />
        <circle cx="26" cy="17" r="2.6" class="win-dot" />
        <circle cx="35" cy="17" r="2.6" class="win-dot" />
        <g class="cycle" data-cycle>
          {apps.map((a, i) => (
            <text x="46" y="21" class:list={['win-title', { on: i === 0 }]}>
              {a.name}
            </text>
          ))}
        </g>
        <text x="246" y="21" class="win-day tabular" text-anchor="end" data-count="0.2 14, 5 30" data-fmt="Day {}">
          Day 30
        </text>

        {rowY.map((y, r) => {
          const a = 1.6 + r * 0.45;
          return (
            <g>
              {/* wireframe first */}
              <g class="sk" style={`--a:${(0.3 + r * 0.15).toFixed(2)};--d:${a.toFixed(2)}`}>
                <rect x="16" y={y + 6} width="56" height="9" rx="2" />
                <rect x="88" y={y + 6} width="40" height="9" rx="2" />
                <rect x="186" y={y + 4} width="58" height="13" rx="6.5" />
              </g>
              {/* then the real records */}
              <g class="ap" style={`--a:${a.toFixed(2)}`}>
                <g class="cycle" data-cycle>
                  {apps.map((app, i) => (
                    <g class:list={{ on: i === 0 }}>
                      <text x="16" y={y + 14} class="cell cell-id">{app.rows[r][0]}</text>
                      <text x="88" y={y + 14} class="cell">{app.rows[r][1]}</text>
                    </g>
                  ))}
                </g>
                <line x1="16" x2="244" y1={y + 22} y2={y + 22} class="row-rule" />
              </g>
              <g class="pop" style={`--a:${(a + 0.3).toFixed(2)}`}>
                <rect x="186" y={y + 4} width="58" height="13" rx="6.5" class="pill" />
                <path d={tick(194, y + 10.5, 0.8)} class="pill-tick" />
                <g class="cycle" data-cycle>
                  {apps.map((app, i) => (
                    <text x="200" y={y + 13.5} class:list={['pill-text', { on: i === 0 }]}>
                      {app.status}
                    </text>
                  ))}
                </g>
              </g>
            </g>
          );
        })}

        <g class="pop" style="--a:4.4">
          <rect x="6" y="168" width="176" height="22" rx="11" class="live" />
          <circle cx="20" cy="179" r="3.5" class="live-dot" />
          <text x="30" y="183" class="live-text">Working on your real data</text>
        </g>
        <g data-move="230 120 150 182 3.6 4.3" transform="translate(150 182)" class="ap" style="--a:3.5">
          <path d="M0 0 L0 13 L3.6 9.6 L6.4 15.4 L8.6 14.4 L5.8 8.8 L10.4 8.6 Z" class="cursor" />
        </g>
      </svg>
    )
  }

  {
    fix && phase === 2 && (
      <svg viewBox="0 0 260 196">
        {tools.map((t, i) => (
          <g>
            <path d={`M${t.x + 35} ${t.y + 12} L${hub.x} ${hub.y}`} class="link" style={`--a:${(0.5 + i * 0.25).toFixed(2)}`} />
            <path d={`M${t.x + 35} ${t.y + 12} L${hub.x} ${hub.y}`} class="link-flow" />
          </g>
        ))}
        {tools.map((t, i) => (
          <g class="pop" style={`--a:${(0.2 + i * 0.15).toFixed(2)}`}>
            <rect x={t.x} y={t.y} width="70" height="24" rx="12" class="tool" />
            <text x={t.x + 35} y={t.y + 16} class="tool-text" text-anchor="middle">{t.name}</text>
          </g>
        ))}
        <polygon points={hex(hub.x, hub.y, 26)} class="hub" />
        <path d={`M${hub.x - 9} ${hub.y - 7}h18M${hub.x - 9} ${hub.y}h18M${hub.x - 9} ${hub.y + 7}h11`} class="hub-lines" />
        <g class="pop" style="--a:2.3">
          <rect x="92" y="98" width="76" height="18" rx="9" class="shield" />
          <path d={`M101 102.5l5-2 5 2v3.4c0 3-2.2 4.6-5 5.6-2.8-1-5-2.6-5-5.6z`} class="shield-icon" />
          <text x="115" y="111" class="shield-text">Hardened</text>
        </g>

        <line x1="8" x2="252" y1="134" y2="134" class="divider" />
        <text x="8" y="160" class="cap">Your team</text>
        {roles.map((r, i) => {
          const x = 104 + i * 54;
          return (
            <g>
              <circle cx={x} cy="154" r="13" class="face" />
              <path d={person} transform={`translate(${x - 6.6} ${145}) scale(1.1)`} class="face-icon" />
              <g class="pop" style={`--a:${(3.1 + i * 0.45).toFixed(2)}`}>
                <circle cx={x + 10} cy="144" r="6" class="trained" />
                <path d={tick(x + 10, 144.5, 0.7)} class="trained-tick" />
              </g>
              <text x={x} y="183" class="role" text-anchor="middle">{r}</text>
            </g>
          );
        })}
        <text x="8" y="178" class="trained-word ap" style="--a:4.5">Trained</text>
      </svg>
    )
  }

  {
    fix && phase === 3 && (
      <svg viewBox="0 0 260 196">
        <rect x="34" y="6" width="192" height="104" rx="7" class="kit" />
        <text x="48" y="25" class="kit-title">Handover kit</text>
        {kit.map((k, i) => {
          const y = 42 + i * 17;
          return (
            <g>
              <rect x="48" y={y - 8} width="10" height="10" rx="2.5" class="box" />
              <g class="pop" style={`--a:${(0.4 + i * 0.45).toFixed(2)}`}>
                <rect x="48" y={y - 8} width="10" height="10" rx="2.5" class="box-on" />
                <path d={tick(53, y - 3, 0.6)} class="box-tick" />
              </g>
              <text x="66" y={y + 1} class="kit-item">{k}</text>
            </g>
          );
        })}

        <polygon points={hex(40, 148, 17)} class="us" />
        <g transform="translate(40 148) scale(0.075)" class="us-mark">
          <path d={upperPath} />
          <path d={lowerPath} />
        </g>
        <text x="40" y="182" class="who" text-anchor="middle">Spockhart</text>
        <g>
          {[0, 1, 2].map((i) => (
            <g>
              <circle cx={200 + i * 16} cy="148" r="11" class:list={['team', `team-${i}`]} />
              <path d={person} transform={`translate(${200 + i * 16 - 5.4} ${140.5}) scale(0.9)`} class="face-icon" />
            </g>
          ))}
        </g>
        <text x="216" y="182" class="who who-hot" text-anchor="middle">Your team</text>
        <path d="M62 148 H186" class="handoff" />

        {/* the keys change hands */}
        <g data-move="66 148 168 148 2.3 3.6" transform="translate(168 148)">
          <g class="pop" style="--a:2.1">
            <circle cx="-4" cy="0" r="5.5" class="key" />
            <circle cx="-4" cy="0" r="2" class="key-hole" />
            <path d="M1.5 0 H13 M9 0 v4 M12 0 v3" class="key-shaft" />
          </g>
        </g>

        <g class="pop" style="--a:4">
          <rect x="70" y="120" width="120" height="18" rx="9" class="owned" />
          <circle cx="82" cy="129" r="3" class="live-dot" />
          <text x="90" y="133" class="owned-text">Yours to run</text>
        </g>
      </svg>
    )
  }
  {
    grow && phase === 0 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Assessing</text>

        {lensX.map((x, i) => (
          <g class="pop" style={`--a:${(0.2 + i * 0.4).toFixed(2)}`}>
            <polygon points={hex(x, LENS_Y, 24)} class="lens-hex" />
            {i === 0 && (
              <g>
                <path d={person} transform={`translate(${x - 11} ${LENS_Y - 8}) scale(0.95)`} class="lens-icon" />
                <path d={person} transform={`translate(${x + 0.5} ${LENS_Y - 8}) scale(0.95)`} class="lens-icon" />
              </g>
            )}
            {i === 1 && <path d={`M${x - 9} ${LENS_Y + 9}H${x + 10}M${x - 7} ${LENS_Y + 6}V${LENS_Y + 1}M${x} ${LENS_Y + 6}V${LENS_Y - 4}M${x + 7} ${LENS_Y + 6}V${LENS_Y - 9}`} class="lens-bars" />}
            {i === 2 && (
              <g>
                <polygon points={gear(x, LENS_Y, 7.5, 10.5)} class="lens-gear" />
                <circle cx={x} cy={LENS_Y} r="3.4" class="lens-hole" />
              </g>
            )}
            {i === 3 && (
              <g>
                <circle cx={x} cy={LENS_Y} r="10" class="lens-coin" />
                <text x={x} y={LENS_Y + 4.5} class="lens-dollar" text-anchor="middle">$</text>
              </g>
            )}
            <text x={x} y={LENS_Y + 42} class="lens-label" text-anchor="middle">{lensLabels[i]}</text>
          </g>
        ))}

        {/* Feedback from each lens flows down one shared line into an idea */}
        <g class="ap" style="--a:2.1">
          {lensX.map((x) => (
            <path d={`M${x} ${LENS_Y + 50}V122`} class="merge" />
          ))}
          <path d={`M${lensX[0]} 122H${lensX[3]}`} class="merge" />
          <path d="M129 122V129" class="merge" />
          <path d="M125.5 126.5L129 130.5L132.5 126.5" class="merge" />
        </g>
        {/* one stream per stretch of line, all flowing toward the idea */}
        <g>
          {lensX.map((x) => (
            <path d={`M${x} ${LENS_Y + 50}V122`} class="feed" />
          ))}
          <path d={`M${lensX[0]} 122H129`} class="feed" />
          <path d={`M${lensX[3]} 122H129`} class="feed" />
        </g>

        <g class="pop" style="--a:2.6">
          <polygon points={hex(129, 148, 16)} class="found-hex" />
          {/* a lightbulb */}
          <path d="M129 138.2a6.3 6.3 0 0 0-3.6 11.5c.7.5 1 1.2 1 2v.8h5.2v-.8c0-.8.3-1.5 1-2a6.3 6.3 0 0 0-3.6-11.5z" class="bulb" />
          <path d="M126.6 154.6h4.8M127.3 156.8h3.4" class="bulb-base" />
        </g>
        <text x="129" y="189" class="headline ap" text-anchor="middle" style="--a:3">Untapped opportunity</text>
      </svg>
    )
  }

  {
    grow && phase === 1 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Evaluating</text>

        {gates.map((g) => (
          <g class="ap" style={`--a:${g.a}`}>
            <text x={g.x} y="44" class="gate-label" text-anchor="middle">{g.label}</text>
            <path d={`M${g.x} 52V124`} class="gate" />
          </g>
        ))}

        {optionHexes.map((o) => (
          <polygon points={hex(o.x, o.y, 7.5)} class="opt-hex pop" style={`--a:${o.a}`} />
        ))}
        <g class="pop" style="--a:2.6">
          <polygon points={hex(172, 88, 10)} class="opt-best" />
        </g>
        <path d="M184 88H192" class="arrow ap" style="--a:2.9" />

        <g class="pop" style="--a:3.1">
          <rect x="194" y="58" width="58" height="60" rx="6" class="win" />
          <path d="M194 64a6 6 0 0 1 6-6h46a6 6 0 0 1 6 6v6H194z" class="win-bar" />
          <circle cx="201" cy="65" r="1.8" class="win-dot" />
          <circle cx="207" cy="65" r="1.8" class="win-dot" />
          <circle cx="213" cy="65" r="1.8" class="win-dot" />
          {[80, 94, 108].map((y, r) => (
            <g>
              <rect x="201" y={y - 3} width="26" height="6" rx="2" class="mini-row" />
              <g class="pop" style={`--a:${(3.4 + r * 0.25).toFixed(2)}`}>
                <circle cx="240" cy={y} r="5" class="pill" />
                <path d={tick(240, y + 0.4, 0.55)} class="pill-tick" />
              </g>
            </g>
          ))}
        </g>

        <text x="8" y="166" class="headline ap" style="--a:3.8">Best idea, built by day 30</text>
      </svg>
    )
  }

  {
    grow && phase === 2 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Testing</text>
        <text x="252" y="17" class="counter tabular" text-anchor="end" data-count="0.3 12, 4.2 46" data-fmt="{} orders a week">
          46 orders a week
        </text>

        <path d="M10 96 H250 M10 60 H250" class="quad-line" />
        <path d="M10 132 H250" class="axis-line" />
        <path d="M14 126 C40 122 50 116 60 114 S100 104 130 92 S180 64 200 58 S236 46 246 44 V132 H14 Z" class="trend-area" />
        <path d="M14 126 C40 122 50 116 60 114 S100 104 130 92 S180 64 200 58 S236 46 246 44" class="trend-line" pathLength="1" />

        {versions.map((v) => (
          <g class="pop" style={`--a:${v.a}`}>
            <circle cx={v.x} cy={v.y} r="4" class="ver-dot" />
            <rect x={v.x - 10} y={v.y - 22} width="20" height="13" rx="6.5" class="flag-tag" />
            <text x={v.x} y={v.y - 12.5} class="flag-text" text-anchor="middle">{v.label}</text>
          </g>
        ))}

        {[0, 1, 2, 3, 4, 5].map((i) => {
          const x = 18 + i * 22;
          return (
            <g>
              <circle cx={x} cy="150" r="8.5" class="face" />
              <path d={person} transform={`translate(${x - 4.8} ${144}) scale(0.8)`} class="face-icon" />
              <g class="pop" style={`--a:${(0.6 + i * 0.55).toFixed(2)}`}>
                <circle cx={x + 6.5} cy="143" r="4.5" class="trained" />
                <path d={tick(x + 6.5, 143.4, 0.5)} class="trained-tick" />
              </g>
            </g>
          );
        })}

        <text x="8" y="184" class="headline ap" style="--a:4">A clear path to revenue</text>
      </svg>
    )
  }

  {
    grow && phase === 3 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">In market</text>

        {[tag, funnel].map((d, i) => {
          const y = 34 + i * 44;
          return (
            <g class="pop" style={`--a:${(0.3 + i * 0.5).toFixed(2)}`}>
              <rect x="8" y={y} width="34" height="34" rx="8" class="tile" />
              <path d={d} transform={`translate(15.5 ${y + 7.5})`} class="tile-icon" />
              {i === 0 && <circle cx="21.5" cy={y + 13.5} r="1.6" class="tile-hole" />}
              <circle cx="40" cy={y + 2} r="5" class="trained" />
              <path d={tick(40, y + 2.4, 0.55)} class="trained-tick" />
            </g>
          );
        })}

        <path d="M58 30V124" class="launch-line ap" style="--a:1.4" />
        <g class="pop" style="--a:1.6">
          <rect x="62" y="26" width="52" height="16" rx="8" class="owned" />
          <circle cx="72" cy="34" r="2.8" class="live-dot" />
          <text x="79" y="37.5" class="owned-text">Live</text>
        </g>

        <line x1="58" x2="250" y1="124" y2="124" class="axis-line" />
        {bars.map((h, i) => (
          <rect
            x={70 + i * 25}
            y={124 - h}
            width="16"
            height={h}
            rx="2.5"
            class:list={['bar', { 'bar-hot': i >= 4 }]}
            style={`--a:${(1.9 + i * 0.3).toFixed(2)}`}
          />
        ))}

        {[0, 1, 2].map((i) => (
          <g>
            <circle cx={20 + i * 16} cy="160" r="11" class:list={['team', `team-${i}`]} />
            <path d={person} transform={`translate(${20 + i * 16 - 5.4} ${152.5}) scale(0.9)`} class="face-icon" />
          </g>
        ))}
        <text x="72" y="166" class="headline ap" style="--a:4.2">Yours to own and grow</text>
      </svg>
    )
  }
</div>

<style>
  /* Runs edge to edge along the bottom of the phase card */
  .pg {
    margin: auto calc(var(--pad, var(--s-5)) * -1) calc(var(--pad, var(--s-5)) * -1);
    padding-top: var(--s-4);
  }
  .pg svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    background: var(--paper-2);
    border-top: 1px solid var(--rule);
    padding: 8px 6px;
    box-sizing: border-box;
  }
  /* Laptops: a little shorter, so all four phases fit on one screen */
  @media (min-width: 901px) {
    .pg { padding-top: var(--s-3); }
    .pg svg { max-height: 220px; }
  }

  /* Phones: the phase is a full-width band, so the graphic sits in its own frame */
  @media (max-width: 640px) {
    .pg { margin: var(--s-4) 0 0; padding: 0; }
    .pg svg { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius-lg); padding: 10px 8px; }
  }

  /* Timing helpers (--t comes from the phase card) */
  .ap { opacity: clamp(0, (var(--t) - var(--a, 0)) * 6, 1); }
  .pop {
    opacity: clamp(0, (var(--t) - var(--a)) * 6, 1);
    transform: scale(calc(0.6 + 0.4 * clamp(0, (var(--t) - var(--a)) * 5, 1)));
    transform-box: fill-box;
    transform-origin: center;
  }
  .flag { opacity: clamp(0, (var(--t) - var(--a)) * 5, 1); }
  .cycle > *:not(.on) { display: none; }

  text { font-family: var(--font-body); }
  .cap { font-size: 9px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; fill: var(--ink-3); }
  .title { font-size: 11px; font-weight: 600; fill: var(--ink); }

  /* 1. Diagnose */
  .arrow { fill: none; stroke: var(--ink-3); stroke-width: 1.4; marker-end: none; }
  .step { fill: var(--surface); stroke: var(--rule-2); stroke-width: 1.2; }
  .step-dup { stroke: var(--accent-soft); fill: rgb(74 138 186 / calc(0.04 + 0.12 * clamp(0, (var(--t) - 2.2) * 4, 1))); }
  .step-slow { fill: rgb(27 42 61 / calc(0.02 + 0.08 * clamp(0, (var(--t) - 3.5) * 4, 1))); }
  .step-label { font-size: 9.5px; font-weight: 600; fill: var(--ink); }
  .flag-ring { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .flag-tag { fill: var(--accent); }
  .flag-text { font-size: 8.5px; font-weight: 700; fill: #fff; letter-spacing: 0.02em; }
  .queue { fill: var(--accent); }
  .found { fill: var(--brand); }
  .found-text { font-size: 9.5px; font-weight: 600; fill: #fff; }

  /* 2. Prototype */
  .win { fill: var(--surface); stroke: var(--rule-2); stroke-width: 1; }
  .win-bar { fill: #e9eef4; }
  .win-dot { fill: var(--rule-2); }
  .win-title { font-size: 10px; font-weight: 700; fill: var(--ink); }
  .win-day { font-family: var(--font-display); font-size: 11px; font-weight: 600; fill: var(--accent); font-variant-numeric: lining-nums tabular-nums; }
  .sk rect { fill: #dfe6ee; }
  .sk { opacity: calc(clamp(0, (var(--t) - var(--a)) * 6, 1) * clamp(0, (var(--d) - var(--t)) * 6, 1)); }
  .cell { font-size: 9.5px; fill: var(--ink-2); }
  .cell-id { font-weight: 600; fill: var(--ink); }
  .row-rule { stroke: var(--rule); stroke-width: 1; }
  .pill { fill: rgb(63 154 107 / 0.14); }
  .pill-tick { fill: none; stroke: #2f7d55; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .pill-text { font-size: 8.5px; font-weight: 700; fill: #2f7d55; }
  .live { fill: var(--ink); }
  .live-dot { fill: #4cbf86; }
  .live-text { font-size: 9.5px; font-weight: 600; fill: #fff; }
  .cursor { fill: var(--ink); stroke: #fff; stroke-width: 1; stroke-linejoin: round; }

  /* 3. Build and embed */
  .link {
    fill: none;
    stroke: var(--rule-2);
    stroke-width: 1.5;
    opacity: clamp(0, (var(--t) - var(--a)) * 4, 1);
  }
  .link-flow {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
