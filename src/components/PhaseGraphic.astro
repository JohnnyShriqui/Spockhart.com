---
/**
 * A small live graphic for each phase of the engagement (Approach page).
 * The phase card it sits in is the scene: scripts/scenes.ts writes the time to
 * --t on the card and these styles turn it into motion. Shapes carry the meaning,
 * with a few one-word labels and one line each, like the graphics on Our Work.
 * Everything shown is an illustration, not client data.
 */
interface Props {
  phase: 0 | 1 | 2 | 3;
  /** 'fix' removes waste (Diagnose to Hand over); 'grow' finds new revenue (Assess to Deploy) */
  track?: 'fix' | 'grow';
}
const { phase, track = 'fix' } = Astro.props;
const fix = track === 'fix';
const grow = track === 'grow';
import { upperPath, lowerPath } from '../lib/logo';

/* Few words on purpose: shapes carry the meaning, like the case-study graphics on Our Work */

/* 1. Diagnose: one process mapped; the same entry done twice, and work stuck waiting */
const stepX = [26, 78, 130, 182, 234];
const STEP_Y = 62;
const stepLabels = ['Order', 'Entry', 'Entry', 'Approval', 'Invoice'];
const envelope = (x: number, y: number) => `M${x - 8} ${y - 6}h16v12h-16zM${x - 8} ${y - 6}l8 6.5 8-6.5`;
const keyboard = (x: number, y: number) =>
  `M${x - 9} ${y - 5.5}h18v11h-18zM${x - 5.5} ${y - 2}h1.5M${x - 0.75} ${y - 2}h1.5M${x + 4} ${y - 2}h1.5M${x - 5.5} ${y + 2}h11`;
const plane = (x: number, y: number) => `M${x - 8} ${y}L${x + 8} ${y - 7}L${x + 3} ${y + 8}L${x} ${y + 1.5}ZM${x} ${y + 1.5}L${x + 8} ${y - 7}`;
const clock = (x: number, y: number, r: number) => `M${x} ${y - r * 0.55}V${y}H${x + r * 0.45}`;

/* 2. Prototype: a working tool, records going through it */
const protoRows = [
  { y: 60, w: 70, a: 1.4 },
  { y: 80, w: 52, a: 1.9 },
  { y: 100, w: 80, a: 2.4 },
  { y: 120, w: 60, a: 2.9 },
];

/* 3. Build and embed: hardened, connected to the tools in use, and the team trained */
const hubPt = { x: 130, y: 62 };
const toolPts = [
  { x: 40, y: 38 },
  { x: 220, y: 38 },
  { x: 40, y: 88 },
  { x: 220, y: 88 },
];
const shield = (x: number, y: number) => `M${x} ${y - 11}l9 3.6v6.2c0 6-4 9.2-9 11.2c-5-2-9-5.2-9-11.2v-6.2z`;

/* 4. Hand over: code, documents, running; then the keys change hands */
const docIcon = (x: number, y: number) => `M${x - 6} ${y - 8}h8l4 4v12h-12zM${x - 3} ${y - 1}h6M${x - 3} ${y + 3}h6`;
const codeIcon = (x: number, y: number) => `M${x - 4} ${y - 5}L${x - 9} ${y}L${x - 4} ${y + 5}M${x + 4} ${y - 5}L${x + 9} ${y}L${x + 4} ${y + 5}M${x + 1.5} ${y - 7}L${x - 1.5} ${y + 7}`;

/* ---------- Growth track ---------- */

/* 1. Assess: four lenses on the business, adding up to untapped revenue */
const lensX = [34, 94, 158, 224];
const lensLabels = ['Customers', 'Market', 'Capabilities', 'Business model'];
const LENS_Y = 60;
const gear = (cx: number, cy: number, rIn: number, rOut: number, n = 8) => {
  const pts: string[] = [];
  const w = (Math.PI * 2) / n;
  for (let i = 0; i < n; i++) {
    const a = w * i;
    for (const [r, f] of [[rIn, 0], [rOut, 0.15], [rOut, 0.5], [rIn, 0.65]] as const) {
      pts.push(`${(cx + Math.cos(a + f * w) * r).toFixed(1)},${(cy + Math.sin(a + f * w) * r).toFixed(1)}`);
    }
  }
  return pts.join(' ');
};

/* 2. Engineer: options pass three tests, one survives and becomes a prototype */
const gates = [
  { x: 58, label: 'Market', a: 0.8 },
  { x: 106, label: 'Demand', a: 1.5 },
  { x: 154, label: 'Feasibility', a: 2.2 },
];
const optionHexes = [
  ...[64, 88, 112].flatMap((y) => [20, 40].map((x) => ({ x, y, a: 0.2 }))),
  ...[76, 100].flatMap((y) => [74, 90].map((x) => ({ x, y, a: 1.1 }))),
  { x: 130, y: 76, a: 1.8 },
  { x: 130, y: 100, a: 1.8 },
];

/* 3. Develop: real customers use it; each version does better */
const versions = [
  { x: 60, y: 114, a: 1.2, label: 'v1' },
  { x: 130, y: 92, a: 2.3, label: 'v2' },
  { x: 200, y: 58, a: 3.3, label: 'v3' },
];

/* 4. Deploy: priced, a sales process, launched, and handed to the team */
const bars = [14, 22, 32, 44, 58, 72, 86];
const tag = 'M2 2H10L17 9L9 17L2 10Z';
const funnel = 'M2 3H16L11 9.5V15L7 17V9.5Z';

const hex = (cx: number, cy: number, r: number) =>
  [0, 1, 2, 3, 4, 5]
    .map((k) => {
      const a = (Math.PI / 3) * k - Math.PI / 2;
      return `${(cx + Math.cos(a) * r).toFixed(1)},${(cy + Math.sin(a) * r).toFixed(1)}`;
    })
    .join(' ');
const person = 'M2.8 4.2a3.2 3.2 0 1 0 6.4 0a3.2 3.2 0 1 0 -6.4 0zM0.6 16c0-3.6 2.4-6.2 5.4-6.2s5.4 2.6 5.4 6.2z';
const tick = (x: number, y: number, s = 1) => `M${x - 3.5 * s} ${y}l${2.4 * s} ${2.4 * s} ${4.8 * s}-5`;
---

<div class="pg" aria-hidden="true">
  {
    fix && phase === 0 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Mapping</text>

        {/* the same entry, done twice */}
        <g class="flag" style="--a:2.2">
          <rect x="56" y={STEP_Y - 22} width="96" height="58" rx="10" class="flag-ring" />
          <rect x="91" y={STEP_Y - 29} width="26" height="14" rx="7" class="flag-tag" />
          <text x="104" y={STEP_Y - 19} class="flag-text" text-anchor="middle">×2</text>
        </g>

        <g class="ap" style="--a:1.4">
          {stepX.slice(0, -1).map((x) => <path d={`M${x + 19} ${STEP_Y}H${x + 33}`} class="arrow" />)}
        </g>

        {stepX.map((x, k) => (
          <g class="pop" style={`--a:${(0.2 + k * 0.28).toFixed(2)}`}>
            <rect x={x - 15} y={STEP_Y - 15} width="30" height="30" rx="7" class:list={['tile', { 'tile-slow': k === 3 }]} />
            {k === 0 && <path d={envelope(x, STEP_Y)} class="tile-icon" />}
            {(k === 1 || k === 2) && <path d={keyboard(x, STEP_Y)} class="tile-icon" />}
            {k === 3 && <path d={person} transform={`translate(${x - 6} ${STEP_Y - 8})`} class="lens-icon" />}
            {k === 4 && <path d={plane(x, STEP_Y)} class="tile-icon" />}
            <text x={x} y={STEP_Y + 30} class="lens-label" text-anchor="middle">{stepLabels[k]}</text>
          </g>
        ))}

        {/* work piling up, waiting */}
        {[0, 1, 2].map((i) => (
          <rect x="177" y={36 - i * 8} width="10" height="6" rx="1.5" class="queue pop" style={`--a:${(3 + i * 0.25).toFixed(2)}`} />
        ))}
        <g class="pop" style="--a:3.6">
          <circle cx="197" cy={STEP_Y - 15} r="6.5" class="clock-badge" />
          <path d={clock(197, STEP_Y - 15, 6.5)} class="clock-hands" />
        </g>

        <path d="M104 104 C104 128 76 128 66 145" class="merge ap" style="--a:4" />
        <path d="M182 104 C182 136 96 124 72 148" class="merge ap" style="--a:4.1" />
        <g class="pop" style="--a:4.4">
          <polygon points={hex(60, 160, 17)} class="found-hex" />
          <circle cx="60" cy="160" r="7.5" class="hex-clock" />
          <path d={clock(60, 160, 7.5)} class="hex-clock" />
        </g>
        <text x="86" y="166" class="headline ap" style="--a:4.7">Where the hours go</text>
      </svg>
    )
  }

  {
    fix && phase === 1 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Prototyping</text>
        <text x="252" y="17" class="counter tabular" text-anchor="end" data-count="0.2 1, 3.4 30" data-fmt="Day {}">
          Day 30
        </text>

        <rect x="20" y="28" width="220" height="108" rx="8" class="win" />
        <path d="M20 36a8 8 0 0 1 8-8h204a8 8 0 0 1 8 8v8H20z" class="win-bar" />
        <circle cx="30" cy="36" r="2.4" class="win-dot" />
        <circle cx="38" cy="36" r="2.4" class="win-dot" />
        <circle cx="46" cy="36" r="2.4" class="win-dot" />

        {protoRows.map((r, i) => (
          <g>
            <g class="ap" style={`--a:${(0.3 + i * 0.2).toFixed(2)}`}>
              <rect x="34" y={r.y - 6} width="12" height="12" rx="3" class="row-icon" />
              <rect x="54" y={r.y - 3.5} width={r.w} height="7" rx="3.5" class="mini-row" />
              <rect x="146" y={r.y - 3.5} width="30" height="7" rx="3.5" class="mini-row" />
            </g>
            <g class="pop" style={`--a:${r.a}`}>
              <circle cx="214" cy={r.y} r="7" class="trained" />
              <path d={tick(214, r.y + 0.5, 0.7)} class="trained-tick" />
            </g>
          </g>
        ))}
        <g data-move="246 160 218 128 1.6 2.8" transform="translate(218 128)" class="ap" style="--a:1.4">
          <path d="M0 0 L0 13 L3.6 9.6 L6.4 15.4 L8.6 14.4 L5.8 8.8 L10.4 8.6 Z" class="cursor" />
        </g>

        <text x="8" y="166" class="headline ap" style="--a:3.6">Built around your real work</text>
      </svg>
    )
  }

  {
    fix && phase === 2 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Connecting</text>

        {toolPts.map((t, i) => (
          <g>
            <path d={`M${t.x} ${t.y} L${hubPt.x} ${hubPt.y}`} class="link" style={`--a:${(0.5 + i * 0.25).toFixed(2)}`} />
            <path d={`M${t.x} ${t.y} L${hubPt.x} ${hubPt.y}`} class="link-flow" />
          </g>
        ))}
        {toolPts.map((t, i) => (
          <g class="pop" style={`--a:${(0.2 + i * 0.15).toFixed(2)}`}>
            <circle cx={t.x} cy={t.y} r="15" class="tile" />
            {i === 0 && <path d={envelope(t.x, t.y)} class="tile-icon" />}
            {i === 1 && <text x={t.x} y={t.y + 5} class="lens-dollar" text-anchor="middle">$</text>}
            {i === 2 && <path d={person} transform={`translate(${t.x - 6} ${t.y - 8})`} class="lens-icon" />}
            {i === 3 && <path d={`M${t.x - 8} ${t.y - 5}h16v12h-16zM${t.x - 8} ${t.y - 1}h16M${t.x - 4} ${t.y - 8}v4M${t.x + 4} ${t.y - 8}v4`} class="tile-icon" />}
          </g>
        ))}
        <polygon points={hex(hubPt.x, hubPt.y, 26)} class="hub" />
        <g class="pop" style="--a:2.3">
          <path d={shield(hubPt.x, hubPt.y)} class="hub-shield" />
          <path d={tick(hubPt.x, hubPt.y + 1, 0.85)} class="hub-shield" />
        </g>

        {[0, 1, 2].map((i) => {
          const x = 18 + i * 22;
          return (
            <g>
              <circle cx={x} cy="160" r="11" class="face" />
              <path d={person} transform={`translate(${x - 5.4} ${152.5}) scale(0.9)`} class="face-icon" />
              <g class="pop" style={`--a:${(3.1 + i * 0.45).toFixed(2)}`}>
                <circle cx={x + 8} cy="151" r="5" class="trained" />
                <path d={tick(x + 8, 151.4, 0.55)} class="trained-tick" />
              </g>
            </g>
          );
        })}
        <text x="80" y="166" class="headline ap" style="--a:4.4">Connected, team trained</text>
      </svg>
    )
  }

  {
    fix && phase === 3 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Handing over</text>

        {[0, 1, 2].map((i) => {
          const x = 90 + i * 40;
          const y = 46;
          return (
            <g class="pop" style={`--a:${(0.3 + i * 0.45).toFixed(2)}`}>
              <rect x={x - 15} y={y - 15} width="30" height="30" rx="7" class="tile" />
              {i === 0 && <path d={codeIcon(x, y)} class="tile-icon" />}
              {i === 1 && <path d={docIcon(x, y)} class="tile-icon" />}
              {i === 2 && (
                <g>
                  <polygon points={gear(x, y, 5.5, 8)} class="lens-gear" />
                  <circle cx={x} cy={y} r="2.6" class="lens-hole" />
                </g>
              )}
              <circle cx={x + 14} cy={y - 14} r="5" class="trained" />
              <path d={tick(x + 14, y - 13.6, 0.55)} class="trained-tick" />
            </g>
          );
        })}

        <polygon points={hex(36, 110, 16)} class="us" />
        <g transform="translate(36 110) scale(0.07)" class="us-mark">
          <path d={upperPath} />
          <path d={lowerPath} />
        </g>
        <text x="36" y="140" class="lens-label" text-anchor="middle">Spockhart</text>
        <text x="220" y="140" class="lens-label" text-anchor="middle">Your team</text>
        <path d="M58 110 H190" class="handoff" />
        {[0, 1, 2].map((i) => (
          <g>
            <circle cx={204 + i * 16} cy="110" r="11" class:list={['team', `team-${i}`]} />
            <path d={person} transform={`translate(${204 + i * 16 - 5.4} ${102.5}) scale(0.9)`} class="face-icon" />
          </g>
        ))}

        {/* the keys change hands */}
        <g data-move="64 110 174 110 2.1 3.4" transform="translate(174 110)">
          <g class="pop" style="--a:1.9">
            <circle cx="-4" cy="0" r="5.5" class="key" />
            <circle cx="-4" cy="0" r="2" class="key-hole" />
            <path d="M1.5 0 H13 M9 0 v4 M12 0 v3" class="key-shaft" />
          </g>
        </g>

        <text x="8" y="166" class="headline ap" style="--a:3.8">Yours to run</text>
      </svg>
    )
  }

  {
    grow && phase === 0 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Assessing</text>

        {lensX.map((x, i) => (
          <g class="pop" style={`--a:${(0.2 + i * 0.4).toFixed(2)}`}>
            <polygon points={hex(x, LENS_Y, 24)} class="lens-hex" />
            {i === 0 && (
              <g>
                <path d={person} transform={`translate(${x - 11} ${LENS_Y - 8}) scale(0.95)`} class="lens-icon" />
                <path d={person} transform={`translate(${x + 0.5} ${LENS_Y - 8}) scale(0.95)`} class="lens-icon" />
              </g>
            )}
            {i === 1 && <path d={`M${x - 9} ${LENS_Y + 9}H${x + 10}M${x - 7} ${LENS_Y + 6}V${LENS_Y + 1}M${x} ${LENS_Y + 6}V${LENS_Y - 4}M${x + 7} ${LENS_Y + 6}V${LENS_Y - 9}`} class="lens-bars" />}
            {i === 2 && (
              <g>
                <polygon points={gear(x, LENS_Y, 7.5, 10.5)} class="lens-gear" />
                <circle cx={x} cy={LENS_Y} r="3.4" class="lens-hole" />
              </g>
            )}
            {i === 3 && (
              <g>
                <circle cx={x} cy={LENS_Y} r="10" class="lens-coin" />
                <text x={x} y={LENS_Y + 4.5} class="lens-dollar" text-anchor="middle">$</text>
              </g>
            )}
            <text x={x} y={LENS_Y + 42} class="lens-label" text-anchor="middle">{lensLabels[i]}</text>
          </g>
        ))}

        {lensX.map((x, i) => (
          <path d={`M${x} ${LENS_Y + 50} C${x} 132 ${88 + (x - 88) * 0.2} 128 88 146`} class="merge ap" style={`--a:${(2.1 + i * 0.1).toFixed(2)}`} />
        ))}

        <g class="pop" style="--a:2.9">
          <polygon points={hex(88, 160, 17)} class="found-hex" />
          <text x="88" y="165.5" class="found-dollar" text-anchor="middle">$</text>
        </g>
        <text x="114" y="166" class="headline ap" style="--a:3.3">Untapped revenue</text>
      </svg>
    )
  }

  {
    grow && phase === 1 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Evaluating</text>

        {gates.map((g) => (
          <g class="ap" style={`--a:${g.a}`}>
            <text x={g.x} y="44" class="gate-label" text-anchor="middle">{g.label}</text>
            <path d={`M${g.x} 52V124`} class="gate" />
          </g>
        ))}

        {optionHexes.map((o) => (
          <polygon points={hex(o.x, o.y, 7.5)} class="opt-hex pop" style={`--a:${o.a}`} />
        ))}
        <g class="pop" style="--a:2.6">
          <polygon points={hex(172, 88, 10)} class="opt-best" />
        </g>
        <path d="M184 88H192" class="arrow ap" style="--a:2.9" />

        <g class="pop" style="--a:3.1">
          <rect x="194" y="58" width="58" height="60" rx="6" class="win" />
          <path d="M194 64a6 6 0 0 1 6-6h46a6 6 0 0 1 6 6v6H194z" class="win-bar" />
          <circle cx="201" cy="65" r="1.8" class="win-dot" />
          <circle cx="207" cy="65" r="1.8" class="win-dot" />
          <circle cx="213" cy="65" r="1.8" class="win-dot" />
          {[80, 94, 108].map((y, r) => (
            <g>
              <rect x="201" y={y - 3} width="26" height="6" rx="2" class="mini-row" />
              <g class="pop" style={`--a:${(3.4 + r * 0.25).toFixed(2)}`}>
                <circle cx="240" cy={y} r="5" class="pill" />
                <path d={tick(240, y + 0.4, 0.55)} class="pill-tick" />
              </g>
            </g>
          ))}
        </g>

        <text x="8" y="166" class="headline ap" style="--a:3.8">Best idea, built by day 30</text>
      </svg>
    )
  }

  {
    grow && phase === 2 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">Testing</text>
        <text x="252" y="17" class="counter tabular" text-anchor="end" data-count="0.3 12, 4.2 46" data-fmt="{} orders a week">
          46 orders a week
        </text>

        <path d="M10 96 H250 M10 60 H250" class="quad-line" />
        <path d="M10 132 H250" class="axis-line" />
        <path d="M14 126 C40 122 50 116 60 114 S100 104 130 92 S180 64 200 58 S236 46 246 44 V132 H14 Z" class="trend-area" />
        <path d="M14 126 C40 122 50 116 60 114 S100 104 130 92 S180 64 200 58 S236 46 246 44" class="trend-line" pathLength="1" />

        {versions.map((v) => (
          <g class="pop" style={`--a:${v.a}`}>
            <circle cx={v.x} cy={v.y} r="4" class="ver-dot" />
            <rect x={v.x - 10} y={v.y - 22} width="20" height="13" rx="6.5" class="flag-tag" />
            <text x={v.x} y={v.y - 12.5} class="flag-text" text-anchor="middle">{v.label}</text>
          </g>
        ))}

        {[0, 1, 2, 3, 4, 5].map((i) => {
          const x = 18 + i * 22;
          return (
            <g>
              <circle cx={x} cy="150" r="8.5" class="face" />
              <path d={person} transform={`translate(${x - 4.8} ${144}) scale(0.8)`} class="face-icon" />
              <g class="pop" style={`--a:${(0.6 + i * 0.55).toFixed(2)}`}>
                <circle cx={x + 6.5} cy="143" r="4.5" class="trained" />
                <path d={tick(x + 6.5, 143.4, 0.5)} class="trained-tick" />
              </g>
            </g>
          );
        })}

        <text x="8" y="184" class="headline ap" style="--a:4">A clear path to revenue</text>
      </svg>
    )
  }

  {
    grow && phase === 3 && (
      <svg viewBox="0 0 260 196">
        <text x="8" y="16" class="cap">In market</text>

        {[tag, funnel].map((d, i) => {
          const y = 34 + i * 44;
          return (
            <g class="pop" style={`--a:${(0.3 + i * 0.5).toFixed(2)}`}>
              <rect x="8" y={y} width="34" height="34" rx="8" class="tile" />
              <path d={d} transform={`translate(15.5 ${y + 7.5})`} class="tile-icon" />
              {i === 0 && <circle cx="21.5" cy={y + 13.5} r="1.6" class="tile-hole" />}
              <circle cx="40" cy={y + 2} r="5" class="trained" />
              <path d={tick(40, y + 2.4, 0.55)} class="trained-tick" />
            </g>
          );
        })}

        <path d="M58 30V124" class="launch-line ap" style="--a:1.4" />
        <g class="pop" style="--a:1.6">
          <rect x="62" y="26" width="52" height="16" rx="8" class="owned" />
          <circle cx="72" cy="34" r="2.8" class="live-dot" />
          <text x="79" y="37.5" class="owned-text">Live</text>
        </g>

        <line x1="58" x2="250" y1="124" y2="124" class="axis-line" />
        {bars.map((h, i) => (
          <rect
            x={70 + i * 25}
            y={124 - h}
            width="16"
            height={h}
            rx="2.5"
            class:list={['bar', { 'bar-hot': i >= 4 }]}
            style={`--a:${(1.9 + i * 0.3).toFixed(2)}`}
          />
        ))}

        {[0, 1, 2].map((i) => (
          <g>
            <circle cx={20 + i * 16} cy="160" r="11" class:list={['team', `team-${i}`]} />
            <path d={person} transform={`translate(${20 + i * 16 - 5.4} ${152.5}) scale(0.9)`} class="face-icon" />
          </g>
        ))}
