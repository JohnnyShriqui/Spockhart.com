  /* Revenue graphics: few words, one statement each */
  .headline { font-family: var(--font-display); font-size: 15px; font-weight: 600; fill: var(--ink); }

  /* Growth 1. Assess */
  .lens-hex { fill: var(--surface); stroke: var(--rule-2); stroke-width: 1.2; }
