  .kit-item { font-size: 10px; fill: var(--ink-2); }
  .us { fill: var(--ink); }
  .us-mark { fill: #fff; }
  .team { stroke: var(--paper-2); stroke-width: 2; }
  .team-0 { fill: var(--accent); }
