  /* 4. Hand over */
  .kit { fill: var(--surface); stroke: var(--rule-2); }
  .kit-title { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; fill: var(--ink); }
  .box { fill: none; stroke: var(--rule-2); stroke-width: 1.2; }
