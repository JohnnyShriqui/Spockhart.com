    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1.5 8;
    stroke-dashoffset: calc(var(--t) * -12px);
    opacity: clamp(0, (var(--t) - 2.4) * 3, 1);
  }
