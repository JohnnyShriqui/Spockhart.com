---
/** The soft ambient shapes from the original site. Decorative; drift slowly. */
---

<div class="mist" aria-hidden="true">
  <span class="m1"></span>
  <span class="m2"></span>
  <span class="m3"></span>
</div>

<style>
  .mist { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .mist span { position: absolute; border-radius: 50%; }
  .m1 {
    width: 640px;
    height: 640px;
    top: -26%;
    right: -14%;
    background: radial-gradient(circle, var(--mist-1) 0%, transparent 70%);
    opacity: 0.55;
  }
  .m2 {
    width: 460px;
    height: 460px;
    bottom: -30%;
    left: -12%;
    background: radial-gradient(circle, var(--mist-2) 0%, transparent 70%);
    opacity: 0.35;
  }
  .m3 {
    width: 320px;
    height: 320px;
    top: 38%;
    left: 52%;
    background: radial-gradient(circle, var(--mist-3) 0%, transparent 70%);
    opacity: 0.3;
  }
  @media (prefers-reduced-motion: no-preference) {
    .m1 { animation: drift-a 26s ease-in-out infinite alternate; }
    .m2 { animation: drift-b 32s ease-in-out infinite alternate; }
    .m3 { animation: drift-c 22s ease-in-out infinite alternate; }
    @keyframes drift-a { to { transform: translate(-40px, 30px) scale(1.05); } }
    @keyframes drift-b { to { transform: translate(36px, -24px) scale(1.04); } }
    @keyframes drift-c { to { transform: translate(-30px, -36px); } }
  }
  @media (max-width: 640px) {
    .m1 { width: 420px; height: 420px; }
    .m3 { display: none; }
  }
</style>
