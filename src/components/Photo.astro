---
/**
 * A real photo, optimised by Astro. Until a photo is supplied, it shows a
 * labelled placeholder describing the shot that belongs there.
 * Photos live in src/assets/photos/ and are wired up in src/data/photos.ts.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt: string;
  /** What the shot should be, shown on the placeholder */
  brief: string;
  /** Aspect ratio, e.g. '4 / 3' */
  ratio?: string;
  caption?: string;
  /** Sizes hint for the browser */
  sizes?: string;
  class?: string;
  eager?: boolean;
}
const { src, alt, brief, ratio = '4 / 3', caption, sizes = '(min-width: 1000px) 50vw, 100vw', class: className = '', eager = false } = Astro.props;
---

<figure class:list={['photo', className]} style={`--ratio:${ratio}`}>
  {
    src ? (
      <Image
        src={src}
        alt={alt}
        widths={[480, 800, 1200, 1600, 2000]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="photo-img"
      />
    ) : (
      <div class="photo-ph" role="img" aria-label={`Photo to come: ${brief}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 8h3l1.6-2.4h6.8L17 8h3v11H4z" />
          <circle cx="12" cy="13.2" r="3.4" />
        </svg>
        <span class="ph-tag">Photo to come</span>
        <span class="ph-brief">{brief}</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo { margin: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; min-width: 0; }
  .photo-img, .photo-ph {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--paper-2);
  }
  .photo-ph {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.45rem;
    padding: var(--s-5);
    text-align: center;
    background:
      radial-gradient(120% 90% at 20% 15%, rgb(255 255 255 / 0.55), transparent 60%),
      linear-gradient(140deg, #c9d7e5, #a9bfd5 60%, #98b1ca);
    box-shadow: inset 0 0 0 1px rgb(27 42 61 / 0.08);
    color: var(--ink);
  }
  .photo-ph svg { width: 30px; height: 30px; fill: none; stroke: var(--brand); stroke-width: 1.4; stroke-linejoin: round; opacity: 0.8; }
  .ph-tag { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--brand); }
  .ph-brief { max-width: 34ch; font-size: 0.875rem; line-height: 1.45; color: var(--ink-2); }
  figcaption { font-size: 0.8125rem; color: var(--ink-3); }
</style>
