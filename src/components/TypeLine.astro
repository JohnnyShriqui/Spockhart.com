---
/**
 * A small label that types itself out the first time it scrolls into view, then keeps a
 * blinking cursor, like the readout in the home hero. The full text is there without JavaScript
 * and for screen readers.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: className = '' } = Astro.props;
---

<p class:list={['typeline', className]} data-typeline data-text={text} aria-label={text}>
  <span class="tl-dot" aria-hidden="true"></span>
  <span class="tl-text" aria-hidden="true">{text}</span><span class="tl-caret" aria-hidden="true"></span>
</p>

<script>
  function initTypeLines() {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window);
    document.querySelectorAll<HTMLElement>('[data-typeline]').forEach((el) => {
      if (el.dataset.ready || still) return;
      el.dataset.ready = '1';
      const out = el.querySelector<HTMLElement>('.tl-text')!;
      const text = el.dataset.text ?? '';
      out.textContent = '';
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          let n = 0;
          const tick = () => {
            n++;
            out.textContent = text.slice(0, n);
            if (n < text.length) window.setTimeout(tick, 45 + Math.random() * 55);
          };
          window.setTimeout(tick, 250);
        },
        { threshold: 0.6 },
      );
      io.observe(el);
    });
  }
  initTypeLines();
  document.addEventListener('spockhart:view', initTypeLines);
</script>

<style>
  .typeline {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    /* The same height empty or full, so typing never moves anything below it */
    line-height: 1.6;
    min-height: 1.6em;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--hot, #d9e6f2);
  }
  .tl-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; flex: none; }
  .tl-caret { width: 1.5px; height: 1.1em; margin-left: -0.3rem; background: currentColor; flex: none; }
  @media (prefers-reduced-motion: no-preference) {
    .tl-caret { animation: tl-blink 1.1s steps(1) infinite; }
    .tl-dot { animation: tl-pulse 4.5s ease-in-out infinite; }
    @keyframes tl-blink { 50% { opacity: 0; } }
    @keyframes tl-pulse { 50% { opacity: 0.35; } }
  }
</style>
