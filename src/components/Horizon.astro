---
/**
 * Nonprofits: the gap, as a card. The page opens light, like every other, with the problem in words
 * on the wall. Beneath them stands one card, cut to the exact shape of the chart: its top edge is
 * the demand line itself, climbing to the right, so the card is the silhouette of what is being
 * asked of a nonprofit. Inside it, resources run low along the bottom, the part of the card they
 * meet is lit blue, and the rest, the gap, is hatched red and measured.
 *
 * The scene holds still while you scroll through it. Demand eases down, so the card itself changes
 * shape, and its old silhouette stays behind as a dashed line; resources rise to fill it; and the
 * card turns from night, through first light, to day. Then "We exist to close that gap." comes in.
 *
 * Drawn to the card's own size. With reduced motion it opens on the finished picture, in daylight.
 * An illustration, not data.
 */
interface Props {
  /** The opening of the sentence, quieter */
  setup: string;
  /** Its end, in full: the problem itself */
  title: string;
}
const { setup, title } = Astro.props;
---

<section class="hz" data-hz aria-labelledby="hz-title">
  <div class="hz-stage">
    <div class="wrap hz-copy">
      <h1 id="hz-title" class="load-in" style="--i:1"><span class="hz-setup">{setup}</span> {title}</h1>
      <div class="accent-rule load-in" style="--i:2"></div>
      <!-- Comes in as the gap closes -->
      <p class="hz-state">
        <span class="hz-state-1">We exist to close that gap.</span>
      </p>
    </div>

    <div class="wrap hz-lane load-in" style="--i:3" aria-hidden="true">
      <div class="hz-box">
        <!-- The card's shadow on the floor -->
        <div class="hz-floor"></div>
        <div class="hz-card" data-tilt="3" data-tilt-depth="2400">
          <!-- The card's body, on a layer of its own, so its shadow is cast by the graphics card
               rather than redrawn with every frame -->
          <svg class="hz-svg hz-body">
            <defs>
              <linearGradient id="hz-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" data-hz-fill-top />
                <stop offset="1" data-hz-fill-low />
              </linearGradient>
            </defs>
            <path class="hz-shape" data-hz-shape />
          </svg>
          <svg class="hz-svg" data-hz-svg>
            <defs>
              <clipPath id="hz-clip"><path data-hz-clip /></clipPath>
              <radialGradient id="hz-glow" cx="0.8" cy="0.15" r="0.65">
                <stop offset="0" stop-color="#2e6898" stop-opacity="0.55" />
                <stop offset="1" stop-color="#2e6898" stop-opacity="0" />
              </radialGradient>
              <radialGradient id="hz-dawn" cx="0.72" cy="1" r="0.6">
                <stop offset="0" stop-color="#ffe9d2" stop-opacity="0.75" />
                <stop offset="0.5" stop-color="#fff2e4" stop-opacity="0.28" />
                <stop offset="1" stop-color="#fff6ee" stop-opacity="0" />
              </radialGradient>
              <pattern id="hz-grid" patternUnits="userSpaceOnUse" data-hz-grid>
                <path class="hz-grid-line" data-hz-grid-path />
              </pattern>
              <pattern id="hz-hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="8" class="hz-hatch-line" />
              </pattern>
              <linearGradient id="hz-gapfill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" class="hz-gapfill-top" />
                <stop offset="1" class="hz-gapfill-low" />
              </linearGradient>
              <linearGradient id="hz-metfill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" class="hz-metfill-top" />
                <stop offset="1" class="hz-metfill-low" />
              </linearGradient>
            </defs>

            <g clip-path="url(#hz-clip)">
              <rect class="hz-glow" width="100%" height="100%" fill="url(#hz-glow)" />
              <rect class="hz-dawn" data-hz-dawn fill="url(#hz-dawn)" />
              <rect class="hz-grid" data-hz-grid-rect fill="url(#hz-grid)" />
              <!-- What resources meet, and the gap above it -->
              <path class="hz-met" data-hz-met />
              <path class="hz-gap" data-hz-gap />
              <path class="hz-gap-hatch" data-hz-gap-hatch />
              <path class="hz-was hz-was-res" data-hz-was-res />
              <path class="hz-soft hz-res-soft" data-hz-res-soft />
              <path class="hz-soft hz-res-glow" data-hz-res-glow />
              <path class="hz-line hz-res" data-hz-res />
              <path class="hz-core" data-hz-res-core />
              <!-- Time, along the foot of the card -->
              <path class="hz-axis" data-hz-axis />
              <text class="hz-axis-label" text-anchor="end" data-hz-time>Time</text>
              <!-- By night, the gap measured -->
              <g class="hz-measure">
                <path class="hz-bracket" data-hz-bracket />
                <text class="hz-label-gap" text-anchor="end" data-hz-label-gap>The gap</text>
              </g>
              <path class="hz-move hz-move-up" data-hz-move-up />
            </g>
            <!-- The card's old silhouette, where demand was headed without us -->
            <path class="hz-was hz-was-demand" data-hz-was-demand />
            <path class="hz-move hz-move-down" data-hz-move-down />
            <!-- Its top edge: the demand line -->
            <path class="hz-soft hz-edge-soft" data-hz-edge-soft />
            <path class="hz-soft hz-edge-glow" data-hz-edge-glow />
            <path class="hz-edge" data-hz-edge />
            <path class="hz-core" data-hz-edge-core />
            <g class="hz-node hz-node-res">
              <circle class="hz-halo" r="12" data-hz-halo-res />
              <circle class="hz-dot" r="4.5" data-hz-dot-res />
            </g>
            <g class="hz-node hz-node-demand">
              <circle class="hz-halo" r="12" data-hz-halo-demand />
              <circle class="hz-dot" r="4.5" data-hz-dot-demand />
            </g>
          </svg>
          <span class="hz-chip hz-chip-demand" data-hz-chip-demand><i></i>Demand</span>
          <span class="hz-chip hz-chip-res" data-hz-chip-res><i></i>Resources</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
  const smooth = (a: number, b: number, v: number) => {
    const t = clamp((v - a) / (b - a));
    return t * t * (3 - 2 * t);
  };
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  /* The card's colour, top to foot, at each moment: night, the blue hour, morning, then day.
     Between them it blends smoothly, never through grey. */
  const CARD: [number, string, string][] = [
    [0, '#12253b', '#0a1622'],
    [0.42, '#16314f', '#2b5d8b'],
    [0.66, '#bcd1e4', '#e2ecf4'],
    [1, '#ffffff', '#f4f7fa'],
  ];
  const rgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const cardAt = (p: number) => {
    let k = 0;
    while (k < CARD.length - 2 && p > CARD[k + 1][0]) k++;
    const [a, b] = [CARD[k], CARD[k + 1]];
    const t = smooth(a[0], b[0], p);
    return [1, 2].map((i) => {
      const x = rgb(a[i] as string);
      const y = rgb(b[i] as string);
      return `rgb(${x.map((v, j) => Math.round(lerp(v, y[j], t))).join(' ')})`;
    });
  };

  /* Each line as a cubic across the card: four heights (0 at the foot line, 1 at the top of the
     drawing), at x = 0, 1/3, 2/3 and 1 of the width */
  type Curve = [number, number, number, number];
  const demand0: Curve = [0.2, 0.26, 0.5, 0.98];
  const res0: Curve = [0.1, 0.1, 0.12, 0.14];
  const demand1: Curve = [0.2, 0.25, 0.4, 0.6];
  const res1: Curve = [0.1, 0.14, 0.32, 0.5];

  // The cubic's control values between two points along it (its blossom), for drawing part of it
  const blossom = (c: number[], a: number, b: number, d: number) => {
    const l1 = [0, 1, 2].map((i) => lerp(c[i], c[i + 1], a));
    const l2 = [0, 1].map((i) => lerp(l1[i], l1[i + 1], b));
    return lerp(l2[0], l2[1], d);
  };

  function initHorizon() {
    const hz = document.querySelector<HTMLElement>('[data-hz]');
    if (!hz || hz.dataset.ready) return;
    hz.dataset.ready = '1';
    const svg = hz.querySelector<SVGSVGElement>('[data-hz-svg]')!;
    const q = <T extends Element>(k: string) => hz.querySelector<T>(`[data-hz-${k}]`)!;
    const el = {
      clip: q<SVGPathElement>('clip'),
      shape: q<SVGPathElement>('shape'),
      fillTop: q<SVGStopElement>('fill-top'),
      fillLow: q<SVGStopElement>('fill-low'),
      dawn: q<SVGRectElement>('dawn'),
      grid: q<SVGPatternElement>('grid'),
      gridPath: q<SVGPathElement>('grid-path'),
      gridRect: q<SVGRectElement>('grid-rect'),
      met: q<SVGPathElement>('met'),
      gap: q<SVGPathElement>('gap'),
      gapHatch: q<SVGPathElement>('gap-hatch'),
      wasRes: q<SVGPathElement>('was-res'),
      res: q<SVGPathElement>('res'),
      resGlow: q<SVGPathElement>('res-glow'),
      resSoft: q<SVGPathElement>('res-soft'),
      resCore: q<SVGPathElement>('res-core'),
      axis: q<SVGPathElement>('axis'),
      time: q<SVGTextElement>('time'),
      bracket: q<SVGPathElement>('bracket'),
      labelGap: q<SVGTextElement>('label-gap'),
      moveUp: q<SVGPathElement>('move-up'),
      wasDemand: q<SVGPathElement>('was-demand'),
      moveDown: q<SVGPathElement>('move-down'),
      edge: q<SVGPathElement>('edge'),
      edgeGlow: q<SVGPathElement>('edge-glow'),
      edgeSoft: q<SVGPathElement>('edge-soft'),
      edgeCore: q<SVGPathElement>('edge-core'),
      dotRes: q<SVGCircleElement>('dot-res'),
      haloRes: q<SVGCircleElement>('halo-res'),
      dotDemand: q<SVGCircleElement>('dot-demand'),
      haloDemand: q<SVGCircleElement>('halo-demand'),
      chipDemand: q<HTMLElement>('chip-demand'),
      chipRes: q<HTMLElement>('chip-res'),
    };

    let W = 0;
    let H = 0;
    let base = 0;
    let top = 0;
    let r = 22;
    let ex = 0;
    let phone = false;

    // The card's own size: its foot along the bottom, the top of the drawing just under its top
    const measure = () => {
      const b = svg.getBoundingClientRect();
      W = b.width;
      H = b.height;
      phone = W < 600;
      r = phone ? 16 : 22;
      base = H - (phone ? 30 : 40);
      top = phone ? 10 : 14;
      ex = W - Math.max(26, W * 0.05);
      svg.setAttribute('viewBox', `0 0 ${W.toFixed(0)} ${H.toFixed(0)}`);
      // Graph paper, ruled from the foot line up and from the end of the lines leftward
      const cell = phone ? 32 : 48;
      el.grid.setAttribute('width', String(cell));
      el.grid.setAttribute('height', String(cell));
      el.grid.setAttribute('x', (ex % cell).toFixed(1));
      el.grid.setAttribute('y', (base % cell).toFixed(1));
      el.gridPath.setAttribute('d', `M0 0.5 H${cell} M0.5 0 V${cell}`);
      el.gridRect.setAttribute('width', W.toFixed(0));
      el.gridRect.setAttribute('height', base.toFixed(1));
      el.dawn.setAttribute('width', W.toFixed(0));
      el.dawn.setAttribute('height', base.toFixed(1));
      // The foot line, with a tick under every other line of the grid
      let ticks = `M0 ${base} H${W}`;
      for (let x = ex % (cell * 2); x < W; x += cell * 2) ticks += ` M${x.toFixed(1)} ${base} V${base + 6}`;
      el.axis.setAttribute('d', ticks);
      el.time.setAttribute('x', ex.toFixed(1));
      el.time.setAttribute('y', (base + (phone ? 20 : 25)).toFixed(1));
    };

    const Y = (h: number) => base - (base - top) * h;
    const at = (c: Curve, x: number) => {
      const t = x / W;
      const s = 1 - t;
      return Y(s * s * s * c[0] + 3 * s * s * t * c[1] + 3 * s * t * t * c[2] + t * t * t * c[3]);
    };
    const curve = (c: Curve) => `M0 ${Y(c[0]).toFixed(1)} C${(W / 3).toFixed(1)} ${Y(c[1]).toFixed(1)} ${((2 * W) / 3).toFixed(1)} ${Y(c[2]).toFixed(1)} ${W.toFixed(1)} ${Y(c[3]).toFixed(1)}`;
    const back = (c: Curve) => `L${W.toFixed(1)} ${Y(c[3]).toFixed(1)} C${((2 * W) / 3).toFixed(1)} ${Y(c[2]).toFixed(1)} ${(W / 3).toFixed(1)} ${Y(c[1]).toFixed(1)} 0 ${Y(c[0]).toFixed(1)}`;
    // The part of a curve between x0 and x1, as one cubic (the curve's x runs evenly with t)
    const part = (c: Curve, x0: number, x1: number) => {
      const [a, b] = [x0 / W, x1 / W];
      const y = [blossom(c, a, a, a), blossom(c, a, a, b), blossom(c, a, b, b), blossom(c, b, b, b)].map(Y);
      const dx = (x1 - x0) / 3;
      return `C${(x0 + dx).toFixed(1)} ${y[1].toFixed(1)} ${(x0 + 2 * dx).toFixed(1)} ${y[2].toFixed(1)} ${x1.toFixed(1)} ${y[3].toFixed(1)}`;
    };
    const mix = (a: Curve, b: Curve, t: number) => a.map((v, i) => lerp(v, b[i], t)) as Curve;

    // The card: the demand line across its top, rounded where it meets the sides
    const card = (d: Curve) => {
      const y0 = at(d, 0);
      const y1 = at(d, W);
      return `M0 ${(H - r).toFixed(1)} V${(y0 + r).toFixed(1)} Q0 ${y0.toFixed(1)} ${r} ${at(d, r).toFixed(1)} ${part(d, r, W - r)} Q${W.toFixed(1)} ${y1.toFixed(1)} ${W.toFixed(1)} ${(y1 + r).toFixed(1)} V${(H - r).toFixed(1)} Q${W.toFixed(1)} ${H.toFixed(1)} ${(W - r).toFixed(1)} ${H.toFixed(1)} H${r} Q0 ${H.toFixed(1)} 0 ${(H - r).toFixed(1)} Z`;
    };
    // Its top edge alone, over the rounded corners
    const edge = (d: Curve) => {
      const y0 = at(d, 0);
      const y1 = at(d, W);
      return `M0 ${(y0 + r).toFixed(1)} Q0 ${y0.toFixed(1)} ${r} ${at(d, r).toFixed(1)} ${part(d, r, W - r)} Q${W.toFixed(1)} ${y1.toFixed(1)} ${W.toFixed(1)} ${(y1 + r).toFixed(1)}`;
    };

    // How far through the scene the page has scrolled, 0 to 1
    const scrolled = () => {
      if (reduce.matches) return 1;
      const b = hz.getBoundingClientRect();
      const run = b.height - window.innerHeight;
      return run > 0 ? clamp(-b.top / run) : 1;
    };

    const render = (p: number) => {
      // The lines move first; the card brightens with them; the lines and tags turn from their
      // night colours to their day ones together, quickly, as the card passes the middle
      const pl = smooth(0.06, 0.78, p);
      const ps = smooth(0.52, 0.66, p);
      const [cTop, cLow] = cardAt(p);
      el.fillTop.setAttribute('stop-color', cTop);
      el.fillLow.setAttribute('stop-color', cLow);
      hz.style.setProperty('--pl', pl.toFixed(3));
      hz.style.setProperty('--ps', ps.toFixed(3));
      hz.style.setProperty('--night', (1 - smooth(0.15, 0.5, p)).toFixed(3));
      // First light, from the foot of the card: it rises through the blue hour, then settles
      hz.style.setProperty('--dawn', (smooth(0.3, 0.56, p) * (1 - 0.7 * smooth(0.64, 0.96, p))).toFixed(3));
      // "We exist to close that gap." rises in over the last stretch of the lines' move
      hz.style.setProperty('--say', smooth(0.42, 0.86, pl).toFixed(3));
      // The gap's measure fades as it closes; the arrows showing what moved come in after it
      hz.style.setProperty('--measure', (1 - smooth(0.18, 0.5, pl)).toFixed(3));
      hz.style.setProperty('--moves', smooth(0.45, 0.85, pl).toFixed(3));

      const d = mix(demand0, demand1, pl);
      const s = mix(res0, res1, pl);
      const shape = card(d);
      el.shape.setAttribute('d', shape);
      el.clip.setAttribute('d', shape);
      const rim = edge(d);
      for (const e of [el.edge, el.edgeCore, el.edgeGlow, el.edgeSoft]) e.setAttribute('d', rim);
      const sPath = curve(s);
      for (const e of [el.res, el.resCore, el.resGlow, el.resSoft]) e.setAttribute('d', sPath);
      el.met.setAttribute('d', `${sPath} L${W.toFixed(1)} ${base} L0 ${base} Z`);
      el.gap.setAttribute('d', `${curve(d)} ${back(s)} Z`);
      el.gapHatch.setAttribute('d', `${curve(d)} ${back(s)} Z`);
      el.wasRes.setAttribute('d', curve(res0));
      // The old silhouette: where the top edge was headed, and down its right side to the card
      el.wasDemand.setAttribute('d', `${curve(demand0)} L${W.toFixed(1)} ${(at(d, W) + r).toFixed(1)}`);

      // The ends of the lines, and their names in small glass tags beside them
      const dy = at(d, ex);
      const sy = at(s, ex);
      for (const [c, y] of [[el.dotDemand, dy], [el.haloDemand, dy], [el.dotRes, sy], [el.haloRes, sy]] as const) {
        c.setAttribute('cx', ex.toFixed(1));
        c.setAttribute('cy', y.toFixed(1));
      }
      const off = phone ? 14 : 20;
      el.chipDemand.style.translate = `calc(${(ex - off).toFixed(1)}px - 100%) calc(${(dy - (phone ? 20 : 26)).toFixed(1)}px - 50%)`;
      el.chipRes.style.translate = `calc(${(ex - off).toFixed(1)}px - 100%) calc(${(sy + (phone ? 20 : 26)).toFixed(1)}px - 50%)`;

      // The gap, measured, as on a drawing: a dimension line between the two, with its name
      const gx = W * (phone ? 0.6 : 0.72);
      const gt = at(d, gx) + 8;
      const gb = at(s, gx) - 8;
      const cap = 6;
      el.bracket.setAttribute('d', gb - gt > 12 ? `M${gx - cap} ${gt} H${gx + cap} M${gx} ${gt} V${gb} M${gx - cap} ${gb} H${gx + cap}` : '');
      el.labelGap.setAttribute('x', (gx - 14).toFixed(1));
      el.labelGap.setAttribute('y', ((gt + gb) / 2 + 7).toFixed(1));

      // What moved, once it has: demand eased down from where it was headed, resources raised
      const mx = W * (phone ? 0.5 : 0.64);
      const arrow = (from: number, to: number) => {
        const dir = Math.sign(to - from);
        if (Math.abs(to - from) < 26) return '';
        const a = from + dir * 7;
        const b = to - dir * 7;
        return `M${mx} ${a.toFixed(1)} V${b.toFixed(1)} M${mx - 4.5} ${(b - dir * 6).toFixed(1)} L${mx} ${b.toFixed(1)} L${mx + 4.5} ${(b - dir * 6).toFixed(1)}`;
      };
      el.moveDown.setAttribute('d', arrow(at(demand0, mx), at(d, mx)));
      el.moveUp.setAttribute('d', arrow(at(res0, mx), at(s, mx)));
    };
    /* The scene follows the scroll with a little give: it glides to where the page has got to
       rather than jumping there, so a mouse wheel's steps become one continuous movement */
    let target = scrolled();
    let shown = target;
    let last = 0;
    let raf = 0;
    const frame = (now: number) => {
      const dt = last ? Math.min(64, now - last) : 16;
      last = now;
      shown += (target - shown) * (1 - Math.exp(-dt / 120));
      if (Math.abs(target - shown) < 0.0004) shown = target;
      render(shown);
      if (shown !== target) raf = requestAnimationFrame(frame);
      else {
        raf = 0;
        last = 0;
      }
    };
    const follow = () => {
      target = scrolled();
      if (!raf && target !== shown) raf = requestAnimationFrame(frame);
    };

    if (!reduce.matches) hz.classList.add('hz-live');
    measure();
    target = shown = scrolled();
    render(shown);
    hz.classList.add('hz-drawn');
    window.addEventListener('scroll', follow, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      render(shown);
      follow();
    }, { passive: true });
  }
  initHorizon();
  document.addEventListener('spockhart:view', initHorizon);
</script>

<style>
  .hz {
    --pl: 0;
    --ps: 0;
    --night: 1;
    --dawn: 0;
    --measure: 1;
    --moves: 0;
    position: relative;
    height: 100vh;
    height: 100svh;
  }
  /* Live: the scene holds on screen for a while as the page scrolls, and plays as it does */
  .hz.hz-live { height: calc(100svh + 120vh); }
  .hz-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    isolation: isolate;
  }
  /* A pool of light on the wall behind the card */
  .hz-stage::before {
    content: '';
    position: absolute;
    left: 10%;
    right: -6%;
    top: 30%;
    bottom: -8%;
    z-index: -2;
    background: radial-gradient(closest-side, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.4) 50%, transparent);
    pointer-events: none;
  }

  /* ---------- The words, on the wall ---------- */
  .hz-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    padding-top: clamp(7.5rem, 3rem + 10vh, 11rem);
  }
  /* One sentence: its opening quieter, then the problem itself in full */
  .hz-copy h1 {
    max-width: 11em;
    font-size: clamp(2.5rem, 1.5rem + 3.2vw, 4.75rem);
    line-height: 1.04;
    text-wrap: balance;
    color: #1b2a3d;
  }
  .hz-setup {
    display: block;
    margin-bottom: 0.5em;
    font-size: clamp(1.1875rem, 0.8rem + 1.1vw, 1.875rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: pretty;
    color: #5b6e83;
  }
  .hz-copy .accent-rule { background: #2c5f8a; }
  /* The answer, large, in the brand's blue: it rises into place as the gap closes */
  .hz-state {
    display: grid;
    margin-top: clamp(0.25rem, 0rem + 0.8vw, 1.25rem);
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 1.1rem + 2.6vw, 3.375rem);
    font-weight: 400;
    font-style: italic;
