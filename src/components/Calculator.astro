---
/**
 * Waste calculator. Three inputs on the left; on the right, one figure for what repetitive work
 * costs a year, set very large and glowing hotter as it grows, and one line for how many full-time
 * people that is. Runs entirely in the browser. Model and defaults: src/lib/calc.ts.
 */
import { inputs, compute, heat, WEEKS_PER_YEAR, type Values } from '../lib/calc';

interface Props {
  title?: string;
  resultLabel?: string;
  cta?: string;
}
const {
  title = 'How much time is your team losing?',
  resultLabel = 'Lost every year',
  cta = 'Get that time back',
} = Astro.props;

const start = Object.fromEntries(inputs.map((f) => [f.key, f.value])) as Values;
const r = compute(start);
const money = (n: number) =>
  new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }).format(n);
const fte = (n: number) => n.toFixed(n < 0.1 ? 2 : 1);
const fmt = (format: string, v: number) => (format === 'money' ? `$${v}` : format === 'hours' ? `${v} h` : String(v));
---

<section id="calculator" class="calc-section" aria-labelledby="calc-title">
  <div class="wrap">
    <div class="calc" data-calc style={`--heat:${heat(r.cost)};--len:${money(r.cost).length}`}>
      <div class="calc-left">
        <div class="calc-head">
          <p class="eyebrow">Waste calculator</p>
          <h2 id="calc-title">{title}</h2>
        </div>

        <form class="calc-inputs" data-calc-form onsubmit="return false" aria-label="Calculator inputs">
          {
            inputs.map((f) => (
              <div class="slider-field">
                <div class="slider-head">
                  <label for={`in-${f.key}`}>
                    <span class:list={[{ 't-desk': f.mobileLabel }]}>{f.label}</span>
                    {f.mobileLabel && <span class="t-mob">{f.mobileLabel}</span>}
                    <span class="slider-hint">{f.hint}</span>
                  </label>
                  <output for={`in-${f.key}`} class="tabular" data-display={f.key}>
                    {fmt(f.format, f.value)}
                  </output>
                </div>
                <input
                  type="range"
                  id={`in-${f.key}`}
                  name={f.key}
                  min={f.min}
                  max={f.max}
                  step={f.step}
                  value={f.value}
                  data-format={f.format}
                  style={`--p:${((f.value - f.min) / (f.max - f.min)) * 100}%`}
                />
              </div>
            ))
          }
        </form>
        <p class="calc-method">People × hours a week × {WEEKS_PER_YEAR} working weeks × hourly cost.</p>
      </div>

      <div class="calc-right">
        <p class="r-label"><span class="r-dot" aria-hidden="true"></span>{resultLabel}</p>
        <p class="r-big tabular"><span data-out="cost">{money(r.cost)}</span></p>
        <p class="r-line">
          That&rsquo;s <strong><span class="tabular" data-out="fte">{fte(r.fte)}</span> full-time people</strong> doing nothing else.
        </p>
        <a class="btn btn-on-brand" href="/contact/" data-calc-cta>{cta} <span class="arr" aria-hidden="true">→</span></a>
        <p class="visually-hidden" aria-live="polite" data-calc-summary></p>
      </div>
    </div>
  </div>
</section>

<script>
  import { initCalculator } from '../scripts/calculator';
  initCalculator();
</script>

<style>
  .calc-section {
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    scroll-margin-top: 64px;
  }
  .calc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 30px 60px -40px rgb(27 42 61 / 0.35);
  }

  /* Inputs */
  .calc-left { display: grid; gap: var(--s-5); align-content: start; padding: clamp(1.5rem, 1rem + 2vw, 2.5rem); }
  .calc-head { display: grid; gap: var(--s-2); }
  .calc-head h2 { font-size: clamp(1.625rem, 1.3rem + 1.1vw, 2.125rem); line-height: 1.1; max-width: 18ch; }
  .calc-intro { color: var(--ink-2); }
  .calc-inputs { display: grid; gap: var(--s-5); }
  .slider-field { display: grid; gap: 0.35rem; }
  .slider-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-4); }
  .slider-head label { font-weight: 600; font-size: 0.975rem; line-height: 1.3; }
  .slider-hint { display: block; font-weight: 400; font-size: 0.8125rem; color: var(--ink-3); margin-top: 0.1rem; }
  .slider-head output {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }
  .calc-method { font-size: 0.8125rem; color: var(--ink-3); }

  input[type='range'] {
    --p: 50%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 26px;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']:focus { outline: none; }
  input[type='range']::-webkit-slider-runnable-track {
    height: 4px;
    border-radius: 4px;
    background: linear-gradient(to right, var(--accent) 0 var(--p), var(--rule) var(--p) 100%);
  }
  input[type='range']::-moz-range-track { height: 4px; border-radius: 4px; background: var(--rule); }
  input[type='range']::-moz-range-progress { height: 4px; border-radius: 4px; background: var(--accent); }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -9px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--accent);
    box-shadow: 0 2px 6px rgb(27 42 61 / 0.18);
    transition: transform 200ms var(--ease), box-shadow 200ms var(--ease);
  }
  input[type='range']::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: var(--surface); border: 2px solid var(--accent); }
  input[type='range']:hover::-webkit-slider-thumb { transform: scale(1.1); }
  input[type='range']:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 6px var(--accent-wash); }
  input[type='range']:active::-webkit-slider-thumb { transform: scale(1.18); }

  /* Result */
  .calc-right {
    position: relative;
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--brand);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    container-type: inline-size;
  }
  .calc-right::before {
    content: '';
    position: absolute;
    width: 520px;
    height: 520px;
    right: -220px;
    top: -260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.22), transparent 70%);
    z-index: -1;
  }
  .r-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #bcd6ec;
  }
  .r-big {
    font-family: var(--font-display);
    /* Long dollar figures shrink to fit the panel */
    font-size: min(clamp(3.25rem, 2.2rem + 4vw, 5.25rem), 14cqi);
    font-weight: 450;
    white-space: nowrap;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-top: calc(var(--s-2) * -1);
  }
  .r-unit { font-size: 0.42em; letter-spacing: -0.01em; font-weight: 400; color: #d9e6f2; }

  .r-viz { display: grid; gap: 0.6rem; padding-top: var(--s-4); border-top: 1px solid rgb(255 255 255 / 0.16); }
  .r-line { font-size: 0.975rem; color: #d9e6f2; }
  .r-line strong { color: #fff; font-weight: 600; }

  .week { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .day {
    --f: 0;
    position: relative;
    height: 38px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.1);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .day-fill {
    position: absolute;
    inset: 0;
    background: #8ec0e6;
    transform-origin: right center;
    transform: scaleX(var(--f));
    transition: transform 450ms var(--ease-out);
  }
  .day-name { position: relative; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; color: #fff; mix-blend-mode: normal; }

  .team { display: flex; flex-wrap: wrap; gap: 6px 5px; }
  .person { --f: 0; position: relative; width: 19px; height: 25px; }
  .person svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: rgb(255 255 255 / 0.2); }
  .person .person-fill { fill: #8ec0e6; clip-path: inset(0 calc((1 - var(--f)) * 100%) 0 0); transition: clip-path 450ms var(--ease-out); }
  .team-key { font-size: 0.75rem; color: #bcd6ec; }

  .btn-on-brand { justify-self: start; margin-top: var(--s-2); background: #fff; color: var(--brand); border-color: #fff; }
  .btn-on-brand:hover { background: var(--paper); border-color: var(--paper); }

  @media (max-width: 960px) {
    .calc { grid-template-columns: minmax(0, 1fr); }
  }
  .r-tiles { display: none; }

  /* On phones: the title, the three sliders with their descriptions, then the result as one big number,
     three small figures and a full-width button. */
  @media (max-width: 640px) {
    .calc-left { gap: 0.9rem; padding: 1.1rem 1rem 1rem; }
    .calc-intro { display: none; }
    .slider-hint { font-size: 0.75rem; line-height: 1.35; }
    .calc-head h2 { font-size: 1.375rem; line-height: 1.15; }
    .calc-method { font-size: 0.6875rem; }
    .calc-inputs { gap: 0.55rem; }
    .slider-field { gap: 0.15rem; }
    .slider-head label { font-size: 0.875rem; }
    .slider-head output { font-size: 1.125rem; }

    .calc-right { gap: 0.5rem; padding: 1.1rem 1rem 1rem; }
    .r-label { font-size: 0.6875rem; letter-spacing: 0.14em; }
    .r-big { font-size: min(2.75rem, 14cqi); margin-top: 0; }
    .r-viz { display: none; }
    .r-tiles {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
      list-style: none;
      padding: 0;
      margin: 0.35rem 0 0.25rem;
    }
    .r-tiles li {
      display: grid;
      gap: 0.2rem;
      align-content: start;
      padding: 0.6rem 0.55rem;
      border-radius: 6px;
      background: rgb(255 255 255 / 0.1);
    }
    .tile-v { font-family: var(--font-display); font-size: 1.125rem; line-height: 1.1; color: #fff; }
    .tile-k { font-size: 0.6875rem; line-height: 1.25; color: #d9e6f2; }
    .btn-on-brand { justify-self: stretch; width: 100%; margin-top: 0.4rem; }
  }

  /* ==========================================================================
     Dark and powerful (on .page-dark): no box or panel. The controls glow lightsaber blue, the loss
     is one huge figure in red that burns brighter as it grows (--heat, 0 to 1), with one line under it.
     ========================================================================== */
  .calc-section { padding-block: clamp(2.5rem, 1.5rem + 3vw, 5rem); }
  .calc {
    --blue: #3fd0ff;
    --red: #ff3d5e;
    --heat: 0.5;
    --len: 8;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .calc-left { padding-left: 0; }
  .calc-head .eyebrow { color: var(--ink-3); }
  .calc-head .eyebrow::before { display: none; }
  .calc-head h2 { font-weight: 400; }
  .slider-head label { font-weight: 500; }
  .slider-head output { font-weight: 400; color: #eef3f8; }
  input[type='range']::-webkit-slider-runnable-track { height: 2px; background: linear-gradient(to right, var(--blue) 0 var(--p), rgb(255 255 255 / 0.12) var(--p) 100%); }
  input[type='range']::-moz-range-track { height: 2px; background: rgb(255 255 255 / 0.12); }
  input[type='range']::-moz-range-progress { height: 2px; background: var(--blue); box-shadow: 0 0 8px rgb(63 208 255 / 0.7); }
  input[type='range']::-webkit-slider-thumb {
    width: 16px;
    height: 16px;
    margin-top: -7px;
    background: #f2fbff;
    border: 0;
    box-shadow: 0 0 0 4px rgb(63 208 255 / 0.16), 0 0 14px rgb(63 208 255 / 0.65);
  }
  input[type='range']::-moz-range-thumb { width: 16px; height: 16px; background: #f2fbff; border: 0; box-shadow: 0 0 0 4px rgb(63 208 255 / 0.16), 0 0 14px rgb(63 208 255 / 0.65); }
  input[type='range']:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 6px rgb(63 208 255 / 0.28), 0 0 16px rgb(63 208 255 / 0.8); }

  .calc-right {
    align-content: center;
    gap: var(--s-4);
    background: none;
    border-left: 1px solid rgb(255 255 255 / 0.1);
    padding-right: 0;
    padding-left: clamp(1.5rem, 1rem + 3vw, 4rem);
    overflow: visible;
  }
  .calc-right::before { display: none; }
  .r-label {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--red);
    letter-spacing: 0.2em;
    text-shadow: 0 0 10px rgb(255 61 94 / 0.45);
  }
  .r-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--red); box-shadow: 0 0 8px var(--red); flex: none; }
  /* As big as the column allows for the figure's length, so long figures never spill */
  .r-big {
    font-size: min(clamp(3.5rem, 1.5rem + 6.5vw, 8rem), calc(165cqi / var(--len)));
    font-weight: 400;
    line-height: 0.92;
    letter-spacing: -0.035em;
    margin: 0;
    color: #ffe9ec;
    text-shadow:
      0 0 calc(4px + var(--heat) * 10px) rgb(255 61 94 / calc(0.35 + var(--heat) * 0.45)),
      0 0 calc(18px + var(--heat) * 46px) rgb(255 42 77 / calc(0.18 + var(--heat) * 0.42));
    transition: text-shadow 500ms var(--ease);
  }
  .r-line { font-size: clamp(1rem, 0.9rem + 0.35vw, 1.1875rem); line-height: 1.45; color: var(--ink-2); }
  .r-line strong { color: #eef3f8; font-weight: 500; }
  .btn-on-brand { margin-top: var(--s-3); background: #eef3f8; color: #14212f; border-color: #eef3f8; }
  .btn-on-brand:hover { background: #fff; border-color: #fff; box-shadow: 0 0 24px rgb(63 208 255 / 0.35); }
  @media (prefers-reduced-motion: no-preference) {
    .r-dot { animation: r-pulse 4.5s ease-in-out infinite; }
    @keyframes r-pulse { 50% { opacity: 0.35; } }
  }
  @media (max-width: 960px) {
    .calc-right { border-left: 0; border-top: 1px solid rgb(255 255 255 / 0.1); padding-left: 0; padding-block: clamp(2rem, 1.5rem + 3vw, 3rem); }
  }
  @media (max-width: 640px) {
    .calc-left, .calc-right { padding-inline: 0; }
    .calc-right { gap: 0.7rem; }
    .r-label { font-size: 0.6875rem; }
    .r-big { font-size: min(4rem, calc(165cqi / var(--len))); }
    .r-line { font-size: 0.975rem; }
  }
</style>
