---
import Logo from './Logo.astro';
import { footerNav, site } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer navy">
  <div class="wrap footer-top">
    <div class="footer-statement">
      <Logo size={30} class="footer-logo" />
      <p class="footer-tagline">{site.tagline}</p>
    </div>

    <nav class="footer-nav" aria-label="Footer">
      {
        footerNav.map((group) => (
          <div class="footer-col">
            <p class="footer-heading">{group.heading}</p>
            <ul>
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="wrap footer-bottom">
    <p>© {year} {site.legalName}. {site.city}, {site.country}.</p>
    <p class="footer-links">
      {site.linkedin && <a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    --mist-1: #2a5f8e;
    --mist-2: #23476e;
    --mist-3: #34508a;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #0a131e;
    border-top: 1px solid rgb(255 255 255 / 0.06);
    padding-top: clamp(4.5rem, 3rem + 5vw, 7rem);
    padding-bottom: calc(var(--s-6) + env(safe-area-inset-bottom, 0px));
  }
  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    padding-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }
  .footer-statement { display: grid; gap: var(--s-5); align-content: start; justify-items: start; }
  .footer-statement :global(.footer-logo) { color: var(--on-navy); margin-bottom: var(--s-3); }
  .footer-tagline {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 450;
    color: var(--on-navy);
    max-width: 12ch;
  }
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6);
    padding-top: var(--s-2);
  }
  .footer-heading {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-on-navy);
    margin-bottom: var(--s-4);
  }
  .footer-col ul { list-style: none; padding: 0; display: grid; gap: 0.65rem; }
  .footer-col a, .footer-links a {
    color: var(--on-navy-2);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .footer-col a:hover, .footer-links a:hover { color: var(--on-navy); }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    padding-top: var(--s-5);
    border-top: 1px solid var(--navy-rule);
    font-size: 0.875rem;
    color: var(--on-navy-2);
  }
  .footer-links { display: flex; gap: var(--s-5); }

  @media (max-width: 860px) {
    .footer-top { grid-template-columns: minmax(0, 1fr); gap: var(--s-7); }
  }
  /* Phones: a shorter footer with the three link columns side by side */
  @media (max-width: 640px) {
    .site-footer { padding-top: 2.5rem; }
    .footer-top { gap: var(--s-6); padding-bottom: var(--s-6); }
    .footer-statement { gap: var(--s-4); }
    .footer-statement :global(.footer-logo) { margin-bottom: 0; }
    .footer-tagline { font-size: 1.75rem; }
    .footer-nav { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); padding-top: 0; }
    .footer-heading { font-size: 0.6875rem; letter-spacing: 0.14em; margin-bottom: var(--s-2); }
    .footer-col ul { gap: 0.45rem; }
    .footer-col a { font-size: 0.875rem; line-height: 1.3; }
    .footer-bottom { padding-top: var(--s-4); font-size: 0.75rem; gap: var(--s-2) var(--s-4); }
    .footer-links { gap: var(--s-4); }
  }
</style>
