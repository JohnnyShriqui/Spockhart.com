---
/**
 * Nonprofits: more impact per dollar. One quiet chart of the gap closing from both sides,
 * and beside it the three ways it closes: resources go further, more funding comes in,
 * demand comes down.
 * An illustration, not data. Nothing moves.
 */

interface Dims {
  W: number;
  H: number;
  X0: number;
  X1: number;
  TOP: number;
  BASE: number;
  labels: boolean;
}

/* The three ways the gap closes. Each one names a bracket on the chart's right edge. */
const groups = [
  {
    key: 'further',
    name: 'Take resources further',
    body: 'We take the repetitive work off your team, like intake, scheduling and reporting, so the same staff and budget serve more people.',
  },
  {
    key: 'funding',
    name: 'Bring in more funding',
    body: 'We help you keep donors close with timely thank-yous and updates on what their gifts achieved, so more first-time donors become lasting supporters.',
  },
  {
    key: 'demand',
    name: 'Bring demand down',
    body: 'We help you add services beyond your core program that work upstream, so needs are met early and fewer people reach your door in crisis.',
  },
];

function draw(d: Dims) {
  const N = 90;
  const span = d.BASE - d.TOP;
  const S = 0.3; // where the work begins
  const xs = Array.from({ length: N + 1 }, (_, i) => d.X0 + ((d.X1 - d.X0) * i) / N);
  const u = (x: number) => (x - d.X0) / (d.X1 - d.X0);
  const y = (f: number) => d.TOP + span * f; // f: 0 at the top of the plot, 1 at the baseline
  const p = (x: number) => Math.min(1, Math.max(0, (u(x) - S) / (1 - S)));
  const smooth = (x: number) => p(x) * p(x) * (3 - 2 * p(x));
  /* Without us: demand accelerates, resources stay flat */
  const f0 = (x: number) => 0.74 - 0.64 * Math.pow(u(x), 1.6);
  const r0 = (x: number) => 0.86 - 0.05 * u(x);
  /* With us: demand is eased to a steady rise, and the gap that had opened by the start
     narrows to half of it, so resources rise alongside demand and never cross it */
  const xS = d.X0 + (d.X1 - d.X0) * S;
  const gapAtStart = r0(xS) - f0(xS);
  const fW = (x: number) => f0(x) + 0.24 * Math.pow(p(x), 1.5);
  const rW = (x: number) => (u(x) <= S ? r0(x) : fW(x) + gapAtStart * (1 - 0.5 * smooth(x)));
  const rEff = (x: number) => r0(x) - 0.72 * (r0(x) - rW(x));
  const demand0 = (x: number) => y(f0(x));
  const res0 = (x: number) => y(r0(x));
  const demandW = (x: number) => y(fW(x));
  const resW = (x: number) => y(rW(x));
  const resEff = (x: number) => y(rEff(x));

  const after = xs.filter((x) => x >= xS - 0.01);
  const pts = (f: (x: number) => number, set = xs) => set.map((x, i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${f(x).toFixed(1)}`).join(' ');
  const back = (f: (x: number) => number, set = xs) => [...set].reverse().map((x) => `L${x.toFixed(1)} ${f(x).toFixed(1)}`).join(' ');
  const area = (a: (x: number) => number, b: (x: number) => number) => `${pts(a, after)} ${back(b, after)} Z`;

  const end = d.X1;
  const bx = d.X1 + (d.labels ? 16 : 10);
  const seg = (key: string, a: number, b: number) => ({ key, y1: Math.min(a, b), y2: Math.max(a, b), mid: (a + b) / 2 });
  const brackets = [
    seg('demand', demand0(end), demandW(end)),
    seg('funding', resW(end), resEff(end)),
    seg('further', resEff(end), res0(end)),
  ];
  const names = Object.fromEntries(groups.map((g) => [g.key, g.name]));
  const grid = [0.2, 0.45, 0.7].map(y);

  return {
    ...d,
    xS,
    grid,
    regions: {
      demand: area(demand0, demandW),
      further: area(resEff, res0),
      funding: area(resW, resEff),
    },
    without: { demand: pts(demand0, after), res: pts(res0, after) },
    withUs: { demand: pts(demandW), res: pts(resW) },
    seam: pts(resEff, after),
    brackets: brackets.map((b) => ({ ...b, name: names[b.key], bx })),
    demandLabel: { x: d.X0, y: demand0(d.X0) - 14 },
    resLabel: { x: d.X0, y: res0(d.X0) + 21 },
  };
}

const charts = [
  { cls: 'npi-wide', ...draw({ W: 640, H: 430, X0: 10, X1: 452, TOP: 18, BASE: 380, labels: true }) },
  { cls: 'npi-narrow', ...draw({ W: 352, H: 320, X0: 6, X1: 326, TOP: 14, BASE: 272, labels: false }) },
];
---

<section class="npi" aria-labelledby="npi-title">
  <div class="wrap">
    <h2 id="npi-title" class="npi-title">More Impact per Dollar</h2>

    <div class="npi-grid">
      <figure
        class="npi-chart"
        aria-label="Illustration: demand keeps rising and resources stay flat. With Spockhart, resources go further and gain new funding while demand is brought down, so the gap between them narrows."
      >
        <figcaption class="npi-cap">
          <span class="npi-cap-title">Demand vs resources</span>
          <span class="npi-legend" aria-hidden="true">
            <span><i class="lg-with"></i>With Spockhart</span>
            <span><i class="lg-without"></i>Without</span>
          </span>
        </figcaption>

        {
          charts.map((c) => (
            <svg viewBox={`0 0 ${c.W} ${c.H}`} class:list={['npi-svg', c.cls]} aria-hidden="true">
              <defs>
                <pattern id={`npi-hatch-${c.cls}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <rect width="6" height="6" class="hatch-bg" />
                  <path d="M0 0V6" class="hatch-line" />
                </pattern>
              </defs>

              {c.grid.map((gy) => (
                <path d={`M${c.X0} ${gy}H${c.X1}`} class="grid" />
              ))}
              <path d={`M${c.X0} ${c.BASE}H${c.X1}`} class="axis" />
              <path d={`M${c.xS} ${c.TOP}V${c.BASE}`} class="start" />
              <text x={c.xS} y={c.BASE + 26} class="axis-label" text-anchor="middle">We start</text>
              <text x={c.X1} y={c.BASE + 26} class="axis-label" text-anchor="end">Time</text>

              <path d={c.regions.demand} fill={`url(#npi-hatch-${c.cls})`} />
              <path d={c.regions.further} class="r-further" />
              <path d={c.regions.funding} class="r-funding" />
              <path d={c.seam} class="seam" />

              <path d={c.without.demand} class="l-without" />
              <path d={c.without.res} class="l-without" />
              <path d={c.withUs.res} class="l-res" />
              <path d={c.withUs.demand} class="l-demand" />

              <text x={c.demandLabel.x} y={c.demandLabel.y} class="line-label">Demand</text>
              <text x={c.resLabel.x} y={c.resLabel.y} class="line-label">Resources</text>

              {c.brackets.map((b) => (
                <g class={`br br-${b.key}`}>
                  <path d={`M${b.bx - 4} ${b.y1 + 1}H${b.bx}V${b.y2 - 1}H${b.bx - 4}`} />
                  {c.labels && (
                    <text x={b.bx + 12} y={b.mid + 4.5} class="br-label">
                      {b.name}
                    </text>
                  )}
                </g>
              ))}
            </svg>
          ))
        }
      </figure>

      <ol class="npi-ledger">
        {
          groups.map((g) => (
            <li class:list={['npi-item', `g-${g.key}`]}>
              <h3 class="npi-item-title">{g.name}</h3>
              <p class="npi-item-body">{g.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .npi {
    --c-further: #2c5f8a;
    --c-funding: #6f9fc8;
    --c-demand: #7a8ca0;
    padding-block: clamp(2.5rem, 1.75rem + 2.2vw, 3.75rem);
    background: var(--paper-2);
  }
  .npi-title {
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3.5rem);
    text-align: center;
    margin: 0 auto clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
  }
  .npi-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* ---------- Chart ---------- */
  .npi-chart {
    padding: clamp(1rem, 0.7rem + 1vw, 1.5rem) clamp(1rem, 0.7rem + 1vw, 1.5rem) clamp(0.75rem, 0.5rem + 0.8vw, 1.1rem);
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(27 42 61 / 0.04), 0 24px 48px -32px rgb(27 42 61 / 0.28);
  }
  .npi-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-bottom: 0.9rem;
    margin-bottom: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .npi-cap-title { font-weight: 600; font-size: 0.9375rem; color: var(--ink); }
  .npi-legend { display: flex; gap: 1.25rem; font-size: 0.8125rem; color: var(--ink-2); }
  .npi-legend span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .npi-legend i { display: inline-block; width: 22px; height: 0; border-top: 2px solid var(--ink); }
  .npi-legend .lg-without { border-top: 1.5px dashed #9fb0c2; }

  .npi-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .npi-narrow { display: none; }

  .grid { stroke: #e7ecf2; stroke-width: 1; }
  .axis { stroke: var(--rule-2); stroke-width: 1; }
  .start { stroke: var(--rule-2); stroke-width: 1; stroke-dasharray: 2 4; }
  .axis-label { font-family: var(--font-body); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; fill: var(--ink-3); }

  .hatch-bg { fill: rgb(122 140 160 / 0.06); }
  .hatch-line { stroke: rgb(122 140 160 / 0.42); stroke-width: 1; }
  .r-further { fill: rgb(44 95 138 / 0.24); }
  .r-funding { fill: rgb(111 159 200 / 0.18); }
  .seam { fill: none; stroke: var(--surface); stroke-width: 1.5; }

  .l-without { fill: none; stroke: #9fb0c2; stroke-width: 1.5; stroke-dasharray: 4 4; }
  .l-demand,
  .l-res { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .l-demand { stroke: var(--ink); }
  .l-res { stroke: var(--c-further); }

  .line-label { font-family: var(--font-body); font-size: 13px; font-weight: 600; fill: var(--ink-2); }

  .br path { fill: none; stroke-width: 2; stroke-linejoin: round; }
  .br-further path { stroke: var(--c-further); }
  .br-funding path { stroke: var(--c-funding); }
  .br-demand path { stroke: var(--c-demand); }
  .br-label { font-family: var(--font-body); font-size: 13.5px; font-weight: 600; fill: var(--ink); }

  /* ---------- The three ways ---------- */
  .npi-ledger { list-style: none; padding: 0; display: grid; }
  .npi-item {
    position: relative;
    padding: clamp(1rem, 0.8rem + 0.6vw, 1.4rem) 0 clamp(1rem, 0.8rem + 0.6vw, 1.4rem) 1.25rem;
    border-top: 1px solid var(--rule-2);
  }
  .npi-item:last-child { border-bottom: 1px solid var(--rule-2); }
  /* The same mark as the item's bracket on the chart */
  .npi-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: clamp(1.15rem, 0.95rem + 0.6vw, 1.55rem);
    bottom: clamp(1.15rem, 0.95rem + 0.6vw, 1.55rem);
    width: 3px;
    border-radius: 2px;
    background: var(--c);
  }
  .g-further { --c: var(--c-further); }
  .g-funding { --c: var(--c-funding); }
  .g-demand { --c: var(--c-demand); }
  .npi-item-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.15rem + 0.5vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink);
  }
  .npi-item-body { margin-top: 0.4rem; font-size: 1rem; line-height: 1.55; color: var(--ink-2); max-width: 52ch; }

  @media (max-width: 1080px) {
    .npi-grid { grid-template-columns: minmax(0, 1fr); }
    .npi-chart { max-width: 720px; width: 100%; margin-inline: auto; }
    .npi-ledger { max-width: 720px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 640px) {
    .npi-wide { display: none; }
    .npi-narrow { display: block; }
    .npi-legend { font-size: 0.75rem; gap: 1rem; }
  }
</style>
