---
/**
 * Nonprofits: more impact per dollar. One line chart in the same window style as the chart on
 * the home page, told the same simple way as the gap chart in the hero:
 * without Spockhart, demand (red) runs away from resources (white). With Spockhart, our demand
 * line (blue) bends down and our resources line (blue) bends up, and the two blue areas between
 * them, both labelled "With Spockhart", are what we change. An illustration, not data.
 *
 * Like the home chart, it builds itself slowly on a loop while on screen: first the problem,
 * then Spockhart's lines and areas, and the result holds.
 */

interface Dims {
  W: number;
  H: number;
  X0: number;
  X1: number;
  TOP: number;
  BASE: number;
  /** how far in from the right edge the arrows sit */
  ax: number;
}

const ways = [
  {
    k: '1',
    name: 'Take Resources Further',
    body: 'We help you get more out of the people, time and funding you already have, so your organization can serve more people without needing to grow its resources at the same pace.',
  },
  {
    k: '2',
    name: 'Bring In More Funding',
    body: 'We help you uncover new opportunities to generate revenue and attract funding, creating more sustainable financial support for your mission.',
  },
  {
    k: '3',
    name: 'Bring Demand Down',
    body: 'We help you add services beyond your core program that work upstream, so needs are met early and fewer people reach your door in crisis.',
  },
];

function draw(d: Dims) {
  const N = 90;
  const span = d.BASE - d.TOP;
  const S = 0.3; // where Spockhart starts
  const xs = Array.from({ length: N + 1 }, (_, i) => d.X0 + ((d.X1 - d.X0) * i) / N);
  const u = (x: number) => (x - d.X0) / (d.X1 - d.X0);
  const y = (f: number) => d.TOP + span * f; // f: 0 at the top of the plot, 1 at the baseline
  const p = (x: number) => Math.min(1, Math.max(0, (u(x) - S) / (1 - S)));
  const smooth = (x: number) => p(x) * p(x) * (3 - 2 * p(x));
  const xS = d.X0 + (d.X1 - d.X0) * S;

  /* Without Spockhart: demand accelerates, resources stay flat */
  const f0 = (x: number) => 0.7 - 0.62 * Math.pow(u(x), 1.6);
  const r0 = (x: number) => 0.84 - 0.05 * u(x);
  /* With Spockhart: demand eases to a steady rise, and the gap narrows from where it stood
     when we started, so resources rise alongside demand and never cross it */
  const gapAtStart = r0(xS) - f0(xS);
  const fW = (x: number) => f0(x) + 0.24 * Math.pow(p(x), 1.5);
  const rW = (x: number) => (u(x) <= S ? r0(x) : fW(x) + gapAtStart * (1 - 0.42 * smooth(x)));

  const after = xs.filter((x) => x >= xS - 0.01);
  const pts = (f: (x: number) => number, set = xs) => set.map((x, i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y(f(x)).toFixed(1)}`).join(' ');
  const back = (f: (x: number) => number, set = xs) => [...set].reverse().map((x) => `L${x.toFixed(1)} ${y(f(x)).toFixed(1)}`).join(' ');
  const area = (a: (x: number) => number, b: (x: number) => number) => `${pts(a, after)} ${back(b, after)} Z`;

  const ax = d.X1 - d.ax;
  const gx = d.X0 + (d.X1 - d.X0) * 0.14;

  return {
    ...d,
    xS,
    grid: [0.15, 0.4, 0.65].map(y),
    demand: pts(f0),
    res: pts(r0),
    ours: { demand: pts(fW, after), res: pts(rW, after) },
    areas: { demand: area(f0, fW), res: area(rW, r0) },
    /* The middle of each area, for its label to follow */
    mids: { demand: pts((x) => (f0(x) + fW(x)) / 2, after), res: pts((x) => (rW(x) + r0(x)) / 2, after) },
    arrows: {
      down: { x: ax, y1: y(f0(ax)) + 6, y2: y(fW(ax)) - 7 },
      up: { x: ax, y1: y(r0(ax)) - 6, y2: y(rW(ax)) + 7 },
    },
    ends: { demand: y(f0(d.X1)), res: y(r0(d.X1)), ourDemand: y(fW(d.X1)), ourRes: y(rW(d.X1)) },
    gap: { x: gx, y: y((f0(gx) + r0(gx)) / 2) },
  };
}

const charts = [
  { cls: 'npi-wide', ...draw({ W: 560, H: 392, X0: 24, X1: 470, TOP: 24, BASE: 340, ax: 26 }) },
  { cls: 'npi-narrow', ...draw({ W: 352, H: 318, X0: 10, X1: 272, TOP: 18, BASE: 270, ax: 16 }) },
];
---

<section class="npi" aria-labelledby="npi-title" data-npi>
  <div class="wrap">
    <h2 id="npi-title" class="npi-title">More Impact per Dollar</h2>

    <div class="npi-grid">
      <figure
        data-npi-chart
        class="npi-chart"
        aria-label="Illustration: without Spockhart, demand (red) keeps rising and resources (white) stay flat, so the gap keeps growing. With Spockhart, demand is brought down and resources go up, so the gap narrows."
      >
        <div class="npi-win">
          <div class="npi-win-bar"><span class="npi-dots"><i></i><i></i><i></i></span>Demand vs resources</div>
          {
            charts.map((c) => (
              <svg viewBox={`0 0 ${c.W} ${c.H}`} class:list={['npi-svg', c.cls]} aria-hidden="true">
                {c.grid.map((gy) => (
                  <line x1={c.X0} x2={c.X1} y1={gy} y2={gy} class="grid" />
                ))}
                <line x1={c.X0} x2={c.X1} y1={c.BASE} y2={c.BASE} class="axis" />
                <line x1={c.xS} x2={c.xS} y1={c.TOP} y2={c.BASE + 6} class="start" />
                <text x={c.xS} y={c.BASE + 24} class="axis-label" text-anchor="middle">Spockhart starts</text>
                <text x={c.X1} y={c.BASE + 24} class="axis-label" text-anchor="end">Time</text>

                <!-- With Spockhart: the two blue areas -->
                <path d={c.areas.res} class="sweep area" style="--at:700ms;--dur:4000ms" />
                <path d={c.areas.demand} class="sweep area" style="--at:1600ms;--dur:4000ms" />

                <!-- Without Spockhart: demand in red, resources in white -->
                <path d={c.demand} class="l-demand" />
                <path d={c.res} class="l-res" />
                <circle cx={c.X1} cy={c.ends.demand} r="4.5" class="dot-demand" />
                <circle cx={c.X1} cy={c.ends.res} r="4.5" class="dot-res" />
                <text x={c.X1 + 10} y={c.ends.demand + 4.5} class="end-label end-demand">Demand</text>
                <text x={c.X1 + 10} y={c.ends.res + 4.5} class="end-label end-res">Resources</text>
                <text x={c.gap.x} y={c.gap.y + 4} class="gap-label" text-anchor="middle">The gap</text>

                <!-- With Spockhart: our demand comes down, our resources go up, both in blue -->
                <path d={c.ours.res} pathLength="1" class="draw l-ours" style="--at:700ms" />
                <path d={c.ours.demand} pathLength="1" class="draw l-ours" style="--at:1600ms" />
                <g class="fade" style="--at:4700ms">
                  <circle cx={c.X1} cy={c.ends.ourRes} r="4.5" class="dot-ours" />
                </g>
                <g class="fade" style="--at:5600ms">
                  <circle cx={c.X1} cy={c.ends.ourDemand} r="4.5" class="dot-ours" />
                </g>

                <path id={`npi-mid-res-${c.cls}`} d={c.mids.res} fill="none" />
                <path id={`npi-mid-demand-${c.cls}`} d={c.mids.demand} fill="none" />
                <g class="fade" style="--at:4700ms">
                  <text class="area-label" dy="0.35em">
                    <textPath href={`#npi-mid-res-${c.cls}`} startOffset="60%" text-anchor="middle">With Spockhart</textPath>
                  </text>
                  <line x1={c.arrows.up.x} x2={c.arrows.up.x} y1={c.arrows.up.y1} y2={c.arrows.up.y2} class="arrow" />
                  <path d={`M${c.arrows.up.x - 4.5} ${c.arrows.up.y2 + 5.5} L${c.arrows.up.x} ${c.arrows.up.y2} L${c.arrows.up.x + 4.5} ${c.arrows.up.y2 + 5.5}`} class="arrow" />
                </g>
                <g class="fade" style="--at:5600ms">
                  <text class="area-label" dy="0.35em">
                    <textPath href={`#npi-mid-demand-${c.cls}`} startOffset="68%" text-anchor="middle">With Spockhart</textPath>
                  </text>
                  <line x1={c.arrows.down.x} x2={c.arrows.down.x} y1={c.arrows.down.y1} y2={c.arrows.down.y2} class="arrow" />
                  <path d={`M${c.arrows.down.x - 4.5} ${c.arrows.down.y2 - 5.5} L${c.arrows.down.x} ${c.arrows.down.y2} L${c.arrows.down.x + 4.5} ${c.arrows.down.y2 - 5.5}`} class="arrow" />
                </g>
              </svg>
            ))
          }
        </div>
      </figure>

      <ol class="npi-ways">
        {
          ways.map((w) => (
            <li class="npi-way">
              <span class="npi-key" aria-hidden="true">{w.k}</span>
              <div>
                <h3 class="npi-way-title">{w.name}</h3>
                <p class="npi-way-body">{w.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Builds slowly on a loop while on screen, like the chart on the home page: the problem
  // first, then Spockhart's part, held for a while.
  function initImpact() {
    document.querySelectorAll<HTMLElement>('[data-npi]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const chart = root.querySelector<HTMLElement>('[data-npi-chart]')!;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

      let shown = false;
      let timer = 0;
      const toAfter = () => {
        root.classList.remove('npi-pre');
        timer = window.setTimeout(toBefore, 17000);
      };
      const toBefore = () => {
        if (!shown) return;
        root.classList.add('npi-pre');
        timer = window.setTimeout(toAfter, 3000);
      };

      root.classList.add('npi-pre');
      new IntersectionObserver(
        (entries) => {
          const now = entries.some((e) => e.isIntersecting);
          if (now === shown) return;
          shown = now;
          window.clearTimeout(timer);
          if (shown) timer = window.setTimeout(toAfter, 400);
        },
        { threshold: 0.3 },
      ).observe(chart);
    });
  }
  initImpact();
  document.addEventListener('spockhart:view', initImpact);
</script>

<style>
  .npi { padding-block: clamp(2.5rem, 1.75rem + 2.2vw, 3.75rem); background: var(--paper-2); }
  .npi-title {
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3.5rem);
    text-align: center;
    margin: 0 auto clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
  }
  .npi-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* ---------- The chart, in the home page's window ---------- */
  .npi-chart {
    position: relative;
    margin: 0;
    padding: clamp(0.85rem, 0.5rem + 0.9vw, 1.25rem);
    border-radius: var(--radius-lg);
    background: var(--brand);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .npi-chart::before {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.2), transparent 70%);
    z-index: -1;
  }
  .npi-win { border-radius: 10px; background: #173f5c; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 24px 48px -28px rgb(4 18 30 / 0.7); overflow: hidden; }
  .npi-win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: #133650;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9fb6cb;
  }
  .npi-dots { display: flex; gap: 5px; }
  .npi-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / 0.18); }
  .npi-svg { display: block; width: 100%; height: auto; padding: 0.75rem 0.5rem 0.6rem; box-sizing: border-box; overflow: visible; }
  .npi-narrow { display: none; }

  .grid { stroke: rgb(255 255 255 / 0.06); stroke-width: 1; }
  .axis { stroke: rgb(255 255 255 / 0.28); stroke-width: 1; }
  .start { stroke: rgb(255 255 255 / 0.3); stroke-width: 1; stroke-dasharray: 2 4; }
  .axis-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: #9fb6cb; }
  .gap-label { font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; fill: #9fb6cb; }

  /* Without Spockhart: demand red, resources white */
  .l-demand, .l-res, .l-ours { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .l-demand { stroke: #e5675d; }
  .l-res { stroke: #eef3f8; }
  .dot-demand { fill: #e5675d; }
  .dot-res { fill: #eef3f8; }
  .end-label { font-family: var(--font-body); font-size: 13.5px; font-weight: 700; }
  .end-demand { fill: #f0897f; }
  .end-res { fill: #eef3f8; }

  /* With Spockhart: blue lines, blue areas */
  .l-ours { stroke: #8ec0e6; }
  .dot-ours { fill: #8ec0e6; stroke: #173f5c; stroke-width: 2; }
  .area { fill: rgb(74 138 186 / 0.38); }
  .area-label { font-family: var(--font-body); font-size: 12.5px; font-weight: 700; letter-spacing: 0.01em; fill: #cfe6f8; }
  .arrow { fill: none; stroke: #b9dcf5; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* ---------- Motion ----------
     At rest (and with reduced motion) the chart shows the finished picture. On screen it starts
     from the problem, then builds Spockhart's part slowly, holds, and starts again. */
  @media (prefers-reduced-motion: no-preference) {
    .draw { stroke-dasharray: 1 1; stroke-dashoffset: 0; transition: stroke-dashoffset 4000ms var(--ease-out) var(--at); }
    .sweep { clip-path: inset(0 0 0 0); transition: clip-path var(--dur) var(--ease-out) var(--at); }
    .fade { opacity: 1; transition: opacity 900ms var(--ease) var(--at); }

    /* Back to the problem, quickly and together */
    .npi-pre .draw { stroke-dashoffset: 1; transition: stroke-dashoffset 700ms var(--ease); }
    .npi-pre .sweep { clip-path: inset(0 100% 0 0); transition: clip-path 700ms var(--ease); }
    .npi-pre .fade { opacity: 0; transition: opacity 500ms var(--ease); }
  }

  /* ---------- The three ways ---------- */
  .npi-ways { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .npi-way {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 1rem 1.15rem 1.05rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .npi-key {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-top: 0.1rem;
    border-radius: 6px;
    background: var(--accent);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: lining-nums;
  }
  .npi-way-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink);
  }
  .npi-way-body { margin-top: 0.3rem; font-size: 0.96875rem; line-height: 1.5; color: var(--ink-2); }

  @media (max-width: 1080px) {
    .npi-grid { grid-template-columns: minmax(0, 1fr); }
    .npi-chart, .npi-ways { max-width: 720px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 640px) {
    .npi-wide { display: none; }
    .npi-narrow { display: block; }
    .npi-chart { padding: 0.75rem; }
    .npi-svg { padding: 0.6rem 0.35rem 0.2rem; }
    .npi-win-bar { padding: 0.45rem 0.7rem; font-size: 0.6875rem; letter-spacing: 0.02em; }
    .npi-dots { display: none; }
    .area-label { font-size: 11px; }
    .npi-way { padding: 0.9rem 0.95rem; gap: 0.75rem; }
  }
</style>
