---
/**
 * Nonprofits: more impact per dollar. Drawn in the same quiet language as the gap chart in the
 * hero: thin lines on the dark ground, soft fills, small labels, no frame. One line chart in the same window style as the chart on
 * the home page. Each line keeps one colour all the way across: demand in coral (like costs),
 * resources in blue (like revenue). Each runs two ways from the start: dashed is where it goes
 * without us, solid is where it goes with us. A bracket marks the gap without us, then fades as our
 * lines come in, and a second bracket marks the reduced gap. Arrows show what we
 * do to each: demand pushed down, resources pushed up, in three numbered parts that match the
 * cards beside the chart. An illustration, not data.
 *
 * Like the gap chart in the hero, it plays slowly on a loop while on screen: first without us,
 * then with us, and the result holds.
 */

interface Dims {
  W: number;
  H: number;
  X0: number;
  X1: number;
  TOP: number;
  BASE: number;
}

const ways = [
  {
    k: '1',
    name: 'Take Resources Further',
    body: 'We help you get more out of the people, time and funding you already have, so your organization can serve more people without needing to grow its resources at the same pace.',
  },
  {
    k: '2',
    name: 'Bring In More Funding',
    body: 'We help you uncover new opportunities to generate revenue and attract funding, creating more sustainable financial support for your mission.',
  },
  {
    k: '3',
    name: 'Bring Demand Down',
    body: 'We help you add services beyond your core program that work upstream, so needs are met early and fewer people reach your door in crisis.',
  },
];

function draw(d: Dims) {
  const N = 90;
  const span = d.BASE - d.TOP;
  const S = 0; // both paths run from the very start
  const xs = Array.from({ length: N + 1 }, (_, i) => d.X0 + ((d.X1 - d.X0) * i) / N);
  const u = (x: number) => (x - d.X0) / (d.X1 - d.X0);
  const y = (f: number) => d.TOP + span * f; // f: 0 at the top of the plot, 1 at the baseline
  const p = (x: number) => Math.min(1, Math.max(0, (u(x) - S) / (1 - S)));
  const smooth = (x: number) => p(x) * p(x) * (3 - 2 * p(x));
  const xS = d.X0 + (d.X1 - d.X0) * S;

  /* Without Spockhart: demand accelerates, resources stay flat */
  const f0 = (x: number) => 0.7 - 0.62 * Math.pow(u(x), 1.6);
  const r0 = (x: number) => 0.84 - 0.05 * u(x);
  /* With Spockhart: demand eases to a steady rise, and the gap narrows to half of where it
     stood when we started, so resources rise alongside demand and never cross it */
  const gapAtStart = r0(xS) - f0(xS);
  const fW = (x: number) => f0(x) + 0.24 * Math.pow(p(x), 1.5);
  const rW = (x: number) => (u(x) <= S ? r0(x) : fW(x) + gapAtStart * (1 - 0.42 * smooth(x)));
  const rEff = (x: number) => r0(x) - 0.7 * (r0(x) - rW(x));

  const after = xs;
  const pts = (f: (x: number) => number, set = xs) => set.map((x, i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y(f(x)).toFixed(1)}`).join(' ');
  const back = (f: (x: number) => number, set = xs) => [...set].reverse().map((x) => `L${x.toFixed(1)} ${y(f(x)).toFixed(1)}`).join(' ');
  const area = (a: (x: number) => number, b: (x: number) => number) => `${pts(a, after)} ${back(b, after)} Z`;

  const kx = d.X1 - 40;
  const mid = (a: (x: number) => number, b: (x: number) => number) => y((a(kx) + b(kx)) / 2);

  /* The arrows: from where each line would be without us to where it is with us */
  const ax = d.X1 - 58;
  const sg = (x: number) => d.X0 + (d.X1 - d.X0) * x;
  const gapAt = sg(0.74);

  return {
    ...d,
    xS,
    grid: [0.15, 0.4, 0.65].map(y),
    regions: { further: area(rEff, r0), funding: area(rW, rEff), demand: area(f0, fW) },
    seam: pts(rEff, after),
    without: { demand: pts(f0, after), res: pts(r0, after) },
    withUs: { demand: pts(fW, after), res: pts(rW, after) },
    arrows: {
      down: { x: ax, y1: y(f0(ax)) + 6, y2: y(fW(ax)) - 7 },
      up: { x: ax, y1: y(r0(ax)) - 6, y2: y(rW(ax)) + 7 },
    },
    keys: [
      { k: '1', x: ax + 18, y: mid(rEff, r0), at: 13200 },
      { k: '2', x: ax + 18, y: mid(rW, rEff), at: 13600 },
      { k: '3', x: ax + 18, y: y((f0(ax) + fW(ax)) / 2), at: 14000 },
    ],
    ends: { demand: y(fW(d.X1)), res: y(rW(d.X1)), demand0: y(f0(d.X1)), res0: y(r0(d.X1)) },
    left: { demand: y(f0(d.X0)), res: y(r0(d.X0)) },
    smaller: { x: gapAt, y: y((fW(gapAt) + rW(gapAt)) / 2) },
  };
}

const charts = [
  { cls: 'npi-wide', ...draw({ W: 560, H: 356, X0: 22, X1: 452, TOP: 18, BASE: 308 }) },
  { cls: 'npi-narrow', ...draw({ W: 352, H: 304, X0: 8, X1: 262, TOP: 16, BASE: 262 }) },
];
---

<section class="npi" aria-labelledby="npi-title" data-npi>
  <div class="wrap">
    <h2 id="npi-title" class="npi-title">More Impact per Dollar</h2>

    <div class="npi-grid">
      <figure
        data-npi-chart
        class="npi-chart"
        aria-label="Illustration: without Spockhart, demand keeps rising and resources stay flat, so the gap keeps growing. With Spockhart, resources go further (1) and new funding comes in (2) while demand is brought down (3), so the gap narrows."
      >
        <figcaption class="npi-cap" aria-hidden="true">
          <span class="npi-cap-title">Demand vs resources</span>
          <span class="npi-legend">
            <span><i class="lg-with"></i>With Spockhart</span>
            <span><i class="lg-without"></i>Without</span>
          </span>
        </figcaption>
        {
          charts.map((c) => (
            <svg viewBox={`0 0 ${c.W} ${c.H}`} class:list={['npi-svg', c.cls]} aria-hidden="true">
              <defs>
                <pattern id={`npi-hatch-${c.cls}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                  <line x1="0" y1="0" x2="0" y2="6" class="hatch-line" />
                </pattern>
              </defs>

              <path d={`M${c.X0} ${c.TOP - 8} V${c.BASE} H${c.X1}`} class="axis" />
              <text x={c.X1} y={c.BASE + 22} class="axis-label" text-anchor="end">Time</text>

              <!-- First, without us: demand runs away from resources -->
              <g class="reveal" style="--at:300ms;--dur:3600ms">
                <path d={c.without.demand} class="l-without l-without-demand" />
                <path d={c.without.res} class="l-without l-without-res" />
              </g>
              <text x={c.X1 + 22} y={c.ends.demand0 + 4} class="fade end-label end-demand" style="--at:3600ms">Demand</text>
              <text x={c.X1 + 22} y={c.ends.res0 + 4} class="fade end-label end-res" style="--at:3600ms">Resources</text>
              <!-- The gap without us, marked the same way as the reduced gap later; it fades as our lines come in -->
              <g class="gap-then">
                <path d={`M${c.X1 + 10} ${c.ends.demand0 + 1} h4 V${c.ends.res0 - 1} h-4`} class="bracket" />
                <text x={c.X1 + 22} y={(c.ends.demand0 + c.ends.res0) / 2 + 4} class="bracket-label">The gap</text>
              </g>

              <!-- Then, with us: the lines and the light under them move together -->
              <g class="reveal" style="--at:8000ms;--dur:5600ms">
                <path d={c.regions.demand} fill={`url(#npi-hatch-${c.cls})`} />
                <path d={c.regions.further} class="r-further" />
                <path d={c.regions.funding} class="r-funding" />
                <path d={c.seam} class="seam" />
                <path d={c.withUs.res} class="l-res" />
                <path d={c.withUs.demand} class="l-demand" />
                <circle cx={c.X1} cy={c.ends.demand} r="3.5" class="dot-demand" />
                <circle cx={c.X1} cy={c.ends.res} r="3.5" class="dot-res" />
              </g>

              <!-- What changes: demand pushed down, resources pushed up -->
              <g class="fade" style="--at:13800ms">
                <path d={`M${c.arrows.up.x} ${c.arrows.up.y1} V${c.arrows.up.y2} M${c.arrows.up.x - 3.5} ${c.arrows.up.y2 + 4.5} L${c.arrows.up.x} ${c.arrows.up.y2} L${c.arrows.up.x + 3.5} ${c.arrows.up.y2 + 4.5}`} class="arrow" />
              </g>
              <g class="fade" style="--at:14400ms">
                <path d={`M${c.arrows.down.x} ${c.arrows.down.y1} V${c.arrows.down.y2} M${c.arrows.down.x - 3.5} ${c.arrows.down.y2 - 4.5} L${c.arrows.down.x} ${c.arrows.down.y2} L${c.arrows.down.x + 3.5} ${c.arrows.down.y2 - 4.5}`} class="arrow" />
              </g>
              {c.keys.map((k) => (
                <g class={`fade key key-${k.k}`} style={`--at:${k.at + 600}ms`}>
                  <circle cx={k.x} cy={k.y} r="8" />
                  <text x={k.x} y={k.y + 3.6} text-anchor="middle">{k.k}</text>
                </g>
              ))}

              <!-- The gap that is left -->
              <g class="fade" style="--at:14800ms">
                <path d={`M${c.X1 + 10} ${c.ends.demand + 1} h4 V${c.ends.res - 1} h-4`} class="bracket" />
                <text x={c.X1 + 22} y={(c.ends.demand + c.ends.res) / 2 + 4} class="bracket-label">Reduced gap</text>
              </g>
            </svg>
          ))
        }
      </figure>

      <ol class="npi-ways">
        {
          ways.map((w) => (
            <li class:list={['npi-way', `way-${w.k}`]}>
              <p class="npi-n">
                <i aria-hidden="true"></i>
                {w.k.padStart(2, '0')}
              </p>
              <h3 class="npi-way-title">{w.name}</h3>
              <p class="npi-way-body">{w.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Plays slowly on a loop while on screen, like the gap chart in the hero: without us first,
  // then with us, held for a while.
  function initImpact() {
    document.querySelectorAll<HTMLElement>('[data-npi]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const chart = root.querySelector<HTMLElement>('[data-npi-chart]')!;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

      let shown = false;
      let timer = 0;
      const toAfter = () => {
        root.classList.remove('npi-pre');
        timer = window.setTimeout(toBefore, 27000);
      };
      const toBefore = () => {
        if (!shown) return;
        root.classList.add('npi-pre');
        timer = window.setTimeout(toAfter, 1800);
      };

      root.classList.add('npi-pre');
      new IntersectionObserver(
        (entries) => {
          const now = entries.some((e) => e.isIntersecting);
          if (now === shown) return;
          shown = now;
          window.clearTimeout(timer);
          if (shown) timer = window.setTimeout(toAfter, 400);
        },
        { threshold: 0.3 },
      ).observe(chart);
    });
  }
  initImpact();
  document.addEventListener('spockhart:view', initImpact);
</script>

<style>
  /* Sits on the page's dark ground, straight on from the hero */
  .npi {
    --c-demand: #e2a39a;
    --c-res: #9cc8ea;
    --c-further: #6ea0cd;
    padding-block: clamp(3rem, 2.25rem + 2.75vw, 5.25rem) clamp(2.5rem, 1.5rem + 2.75vw, 4.5rem);
  }
  .npi-title {
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.75rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: clamp(2rem, 1.4rem + 2vw, 3.25rem);
  }
  .npi-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2.75rem, 1rem + 4.5vw, 6rem);
    align-items: center;
  }

  /* ---------- The chart, unframed ---------- */
  .npi-chart { margin: 0; }
  .npi-cap {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .npi-cap-title { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-3); }
  .npi-legend { display: flex; gap: 1.25rem; font-size: 0.8125rem; color: var(--ink-2); }
  .npi-legend span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .npi-legend i { display: inline-block; width: 18px; height: 0; border-top: 2px solid #d9e6f2; border-radius: 1px; }
  .npi-legend .lg-without { border-top: 1.5px dashed rgb(217 230 242 / 0.6); }

  .npi-svg { display: block; width: 100%; height: auto; overflow: visible; }
  .npi-narrow { display: none; }

  .axis { fill: none; stroke: rgb(255 255 255 / 0.18); stroke-width: 1; }
  .axis-label { font-family: var(--font-body); font-size: 10.5px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; fill: #8fa1b4; }

  /* Without: thin and dashed. With: solid, with soft light under it */
  .l-without { fill: none; stroke-width: 1.5; stroke-dasharray: 4 5; stroke-linecap: round; }
  .l-without-demand { stroke: rgb(226 163 154 / 0.55); }
  .l-without-res { stroke: rgb(156 200 234 / 0.5); }
  .l-demand, .l-res { fill: none; stroke-width: 2.25; stroke-linecap: round; stroke-linejoin: round; }
  .l-demand { stroke: var(--c-demand); }
  .l-res { stroke: var(--c-res); }
  .dot-demand { fill: var(--c-demand); }
  .dot-res { fill: var(--c-res); }
  .r-further { fill: rgb(110 160 205 / 0.3); }
  .r-funding { fill: rgb(156 200 234 / 0.16); }
  .seam { fill: none; stroke: rgb(156 200 234 / 0.45); stroke-width: 1; }
  .hatch-line { stroke: rgb(226 163 154 / 0.24); stroke-width: 1; }

  .end-label { font-family: var(--font-body); font-size: 12.5px; font-weight: 600; letter-spacing: 0.01em; }
  .end-demand { fill: var(--c-demand); }
  .end-res { fill: var(--c-res); }
  .arrow { fill: none; stroke: rgb(238 243 248 / 0.55); stroke-width: 1; stroke-linecap: round; stroke-linejoin: round; }
  .key circle { fill: #121b2b; stroke: rgb(238 243 248 / 0.35); stroke-width: 1; }
  .key text { font-family: var(--font-body); font-size: 10px; font-weight: 600; fill: #d9e6f2; }
  .bracket { fill: none; stroke: rgb(238 243 248 / 0.45); stroke-width: 1; }
  .bracket-label { font-family: var(--font-body); font-size: 12px; font-weight: 500; fill: #d9e6f2; }

  /* ---------- Motion ----------
     At rest (and with reduced motion) the chart shows the finished picture. On screen it plays
     slowly, like the gap chart in the hero: without us first, then with us, holds, and starts
     again. Each part is revealed left to right, so a line and the light under it move together. */
  @media (prefers-reduced-motion: no-preference) {
    .reveal { clip-path: inset(-20px -20px -20px -20px); transition: clip-path var(--dur) cubic-bezier(0.45, 0, 0.4, 1) var(--at); }
    .fade { opacity: 1; transition: opacity 1200ms var(--ease) var(--at); }
    .npi-pre .reveal { clip-path: inset(-20px calc(100% + 20px) -20px -20px); transition: clip-path 900ms var(--ease); }
    .npi-pre .fade { opacity: 0; transition: opacity 700ms var(--ease); }
    /* The first gap: eases in once the lines without us reach the end, holds about three seconds,
       then fades slowly as ours come in */
    .gap-then { animation: npi-gap-then 6200ms var(--ease) 3800ms both; }
    .npi-pre .gap-then { animation: none; opacity: 0; }
    @keyframes npi-gap-then {
      0% { opacity: 0; }
      19%, 68% { opacity: 1; }
      100% { opacity: 0; }
    }
  }
  /* At rest the chart shows the finished picture, so the first gap is not there */
  .gap-then { opacity: 0; }

  /* ---------- The three ways: typographic, hairline-ruled, keyed to the chart ---------- */
  .npi-ways { list-style: none; padding: 0; display: grid; }
  .npi-way { padding-block: clamp(1.05rem, 0.85rem + 0.65vw, 1.5rem); border-top: 1px solid rgb(255 255 255 / 0.12); }
  .npi-way:last-child { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .npi-n {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink-3);
  }
  .npi-n i { width: 18px; height: 2px; border-radius: 1px; background: var(--c); }
  .way-1 { --c: var(--c-further); }
  .way-2 { --c: var(--c-res); }
  .way-3 { --c: var(--c-demand); }
  .npi-way-title {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.75rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--ink);
  }
  .npi-way-body { margin-top: 0.4rem; font-size: 1rem; line-height: 1.55; color: var(--ink-2); max-width: 54ch; }

  @media (max-width: 1080px) {
    .npi-grid { grid-template-columns: minmax(0, 1fr); }
    .npi-chart, .npi-ways { max-width: 720px; width: 100%; }
  }
  @media (max-width: 640px) {
    .npi-wide { display: none; }
    .npi-narrow { display: block; }
    .npi-cap { margin-bottom: 1rem; }
    .npi-legend { gap: 1rem; font-size: 0.75rem; }
  }
</style>
