---
/**
 * Nonprofits: more impact per dollar. One line chart in the same window style as the chart on
 * the home page. Everything without Spockhart is grey: the history up to the day we start, and
 * the dashed paths demand and resources would take without us. Everything Spockhart does is in
 * colour, inside the shaded "With Spockhart" period: resources in blue (like revenue), demand in
 * coral (like costs), and the three parts we add, numbered to match the cards beside the chart.
 * An illustration, not data.
 *
 * Like the home chart, it builds itself slowly on a loop while on screen: first the problem,
 * then Spockhart's period, lines and parts 1 to 3, and the result holds.
 */

interface Dims {
  W: number;
  H: number;
  X0: number;
  X1: number;
  TOP: number;
  BASE: number;
}

const ways = [
  {
    k: '1',
    name: 'Take Resources Further',
    body: 'We help you get more out of the people, time and funding you already have, so your organization can serve more people without needing to grow its resources at the same pace.',
  },
  {
    k: '2',
    name: 'Bring In More Funding',
    body: 'We help you uncover new opportunities to generate revenue and attract funding, creating more sustainable financial support for your mission.',
  },
  {
    k: '3',
    name: 'Bring Demand Down',
    body: 'We help you add services beyond your core program that work upstream, so needs are met early and fewer people reach your door in crisis.',
  },
];

function draw(d: Dims) {
  const N = 90;
  const span = d.BASE - d.TOP;
  const S = 0.3; // where Spockhart starts
  const xs = Array.from({ length: N + 1 }, (_, i) => d.X0 + ((d.X1 - d.X0) * i) / N);
  const u = (x: number) => (x - d.X0) / (d.X1 - d.X0);
  const y = (f: number) => d.TOP + span * f; // f: 0 at the top of the plot, 1 at the baseline
  const p = (x: number) => Math.min(1, Math.max(0, (u(x) - S) / (1 - S)));
  const smooth = (x: number) => p(x) * p(x) * (3 - 2 * p(x));
  const xS = d.X0 + (d.X1 - d.X0) * S;

  /* Without Spockhart: demand accelerates, resources stay flat */
  const f0 = (x: number) => 0.7 - 0.62 * Math.pow(u(x), 1.6);
  const r0 = (x: number) => 0.84 - 0.05 * u(x);
  /* With Spockhart: demand eases to a steady rise, and the gap narrows to half of where it
     stood when we started, so resources rise alongside demand and never cross it */
  const gapAtStart = r0(xS) - f0(xS);
  const fW = (x: number) => f0(x) + 0.24 * Math.pow(p(x), 1.5);
  const rW = (x: number) => (u(x) <= S ? r0(x) : fW(x) + gapAtStart * (1 - 0.5 * smooth(x)));
  const rEff = (x: number) => r0(x) - 0.7 * (r0(x) - rW(x));

  const after = xs.filter((x) => x >= xS - 0.01);
  const before = xs.filter((x) => x <= xS + 0.01);
  const pts = (f: (x: number) => number, set = xs) => set.map((x, i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y(f(x)).toFixed(1)}`).join(' ');
  const back = (f: (x: number) => number, set = xs) => [...set].reverse().map((x) => `L${x.toFixed(1)} ${y(f(x)).toFixed(1)}`).join(' ');
  const area = (a: (x: number) => number, b: (x: number) => number) => `${pts(a, after)} ${back(b, after)} Z`;

  const kx = d.X1 - 22;
  const mid = (a: (x: number) => number, b: (x: number) => number) => y((a(kx) + b(kx)) / 2);
  const gx = d.X0 + (d.X1 - d.X0) * 0.14;

  return {
    ...d,
    xS,
    grid: [0.15, 0.4, 0.65].map(y),
    regions: { further: area(rEff, r0), funding: area(rW, rEff), demand: area(f0, fW) },
    seam: pts(rEff, after),
    pre: { demand: pts(f0, before), res: pts(r0, before) },
    without: { demand: pts(f0, after), res: pts(r0, after) },
    withUs: { demand: pts(fW, after), res: pts(rW, after) },
    keys: [
      { k: '1', x: kx, y: mid(rEff, r0), at: 4900 },
      { k: '2', x: kx, y: mid(rW, rEff), at: 5800 },
      { k: '3', x: kx, y: mid(f0, fW), at: 7300 },
    ],
    ends: {
      demand: y(fW(d.X1)),
      res: y(rW(d.X1)),
      demand0: y(f0(d.X1)),
      res0: y(r0(d.X1)),
    },
    left: { demand: y(f0(d.X0)), res: y(r0(d.X0)) },
    gap: { x: gx, y: y((f0(gx) + r0(gx)) / 2) },
  };
}

const charts = [
  { cls: 'npi-wide', ...draw({ W: 560, H: 396, X0: 24, X1: 456, TOP: 34, BASE: 346 }) },
  { cls: 'npi-narrow', ...draw({ W: 352, H: 324, X0: 10, X1: 268, TOP: 30, BASE: 276 }) },
];
const hexPts = (cx: number, cy: number, r: number) =>
  [0, 1, 2, 3, 4, 5]
    .map((k) => {
      const a = (Math.PI / 3) * k - Math.PI / 2;
      return `${(cx + Math.cos(a) * r).toFixed(1)},${(cy + Math.sin(a) * r).toFixed(1)}`;
    })
    .join(' ');
---

<section class="npi" aria-labelledby="npi-title" data-npi>
  <div class="wrap">
    <h2 id="npi-title" class="npi-title">More Impact per Dollar</h2>

    <div class="npi-grid">
      <figure
        data-npi-chart
        class="npi-chart"
        aria-label="Illustration: without Spockhart, demand keeps rising and resources stay flat, so the gap keeps growing. With Spockhart, resources go further (1) and new funding comes in (2) while demand is brought down (3), so the gap narrows."
      >
        <div class="npi-win">
          <div class="npi-win-bar">
            <span class="npi-dots"><i></i><i></i><i></i></span>Demand vs resources
            <span class="npi-legend" aria-hidden="true">
              <span><i class="lg-with"></i>With Spockhart</span>
              <span><i class="lg-without"></i>Without Spockhart</span>
            </span>
          </div>
          {
            charts.map((c) => (
              <svg viewBox={`0 0 ${c.W} ${c.H}`} class:list={['npi-svg', c.cls]} aria-hidden="true">
                <defs>
                  <pattern id={`npi-hatch-${c.cls}`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line x1="0" y1="0" x2="0" y2="7" class="hatch-line" />
                  </pattern>
                </defs>

                <!-- The Spockhart period: shaded and labelled -->
                <g class="fade band" style="--at:300ms">
                  <rect x={c.xS} y={c.TOP - 30} width={c.X1 - c.xS} height={c.BASE - c.TOP + 30} class="band-fill" />
                  <polygon points={hexPts(c.xS + 15, c.TOP - 15, 6)} class="band-mark" />
                  <text x={c.xS + 27} y={c.TOP - 11} class="band-label">With Spockhart</text>
                </g>

                {c.grid.map((gy) => (
                  <line x1={c.X0} x2={c.X1} y1={gy} y2={gy} class="grid" />
                ))}
                <line x1={c.X0} x2={c.X1} y1={c.BASE} y2={c.BASE} class="axis" />
                <line x1={c.xS} x2={c.xS} y1={c.TOP - 30} y2={c.BASE + 6} class="start" />
                <text x={c.xS} y={c.BASE + 24} class="axis-label" text-anchor="middle">Spockhart starts</text>
                <text x={c.X1} y={c.BASE + 24} class="axis-label" text-anchor="end">Time</text>

                <!-- What Spockhart adds -->
                <path d={c.regions.demand} fill={`url(#npi-hatch-${c.cls})`} class="sweep" style="--at:3900ms;--dur:3400ms" />
                <path d={c.regions.further} class="sweep r-further" style="--at:900ms;--dur:4000ms" />
                <path d={c.regions.funding} class="sweep r-funding" style="--at:2400ms;--dur:3400ms" />
                <path d={c.seam} class="sweep seam" style="--at:2400ms;--dur:3400ms" />

                <!-- Without Spockhart: grey, and dashed from the day we start -->
                <path d={c.pre.demand} class="l-before" />
                <path d={c.pre.res} class="l-before" />
                <path d={c.without.demand} class="l-without" />
                <path d={c.without.res} class="l-without" />
                <text x={c.X0} y={c.left.demand - 12} class="side-label">Demand</text>
                <text x={c.X0} y={c.left.res + 22} class="side-label">Resources</text>
                <text x={c.gap.x} y={c.gap.y + 4} class="gap-label" text-anchor="middle">The gap</text>
                <text x={c.X1 + 8} y={c.ends.demand0 - 2} class="without-label">
                  <tspan x={c.X1 + 8}>Without</tspan>
                  <tspan x={c.X1 + 8} dy="13">Spockhart</tspan>
                </text>
                <text x={c.X1 + 8} y={c.ends.res0 - 2} class="without-label">
                  <tspan x={c.X1 + 8}>Without</tspan>
                  <tspan x={c.X1 + 8} dy="13">Spockhart</tspan>
                </text>

                <!-- With Spockhart: in colour -->
                <path d={c.withUs.res} pathLength="1" class="draw l-res" />
                <path d={c.withUs.demand} pathLength="1" class="draw l-demand" />
                <text x={c.X1 + 8} y={c.ends.demand + 4.5} class="fade end-label end-demand" style="--at:4900ms">Demand</text>
                <text x={c.X1 + 8} y={c.ends.res + 4.5} class="fade end-label end-res" style="--at:4900ms">Resources</text>

                {c.keys.map((k) => (
                  <text x={k.x} y={k.y + 4.5} text-anchor="middle" class={`fade key key-${k.k}`} style={`--at:${k.at}ms`}>
                    {k.k}
                  </text>
                ))}
              </svg>
            ))
          }
        </div>
      </figure>

      <ol class="npi-ways">
        {
          ways.map((w) => (
            <li class:list={['npi-way', `way-${w.k}`]}>
              <span class="npi-key" aria-hidden="true">{w.k}</span>
              <div>
                <h3 class="npi-way-title">{w.name}</h3>
                <p class="npi-way-body">{w.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  // Builds slowly on a loop while on screen, like the chart on the home page: the problem
  // first, then Spockhart's part, held for a while.
  function initImpact() {
    document.querySelectorAll<HTMLElement>('[data-npi]').forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = '1';
      const chart = root.querySelector<HTMLElement>('[data-npi-chart]')!;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;

      let shown = false;
      let timer = 0;
      const toAfter = () => {
        root.classList.remove('npi-pre');
        timer = window.setTimeout(toBefore, 17000);
      };
      const toBefore = () => {
        if (!shown) return;
        root.classList.add('npi-pre');
        timer = window.setTimeout(toAfter, 3000);
      };

      root.classList.add('npi-pre');
      new IntersectionObserver(
        (entries) => {
          const now = entries.some((e) => e.isIntersecting);
          if (now === shown) return;
          shown = now;
          window.clearTimeout(timer);
          if (shown) timer = window.setTimeout(toAfter, 400);
        },
        { threshold: 0.3 },
      ).observe(chart);
    });
  }
  initImpact();
  document.addEventListener('spockhart:view', initImpact);
</script>

<style>
  .npi { padding-block: clamp(2.5rem, 1.75rem + 2.2vw, 3.75rem); background: var(--paper-2); }
  .npi-title {
    font-size: clamp(2.25rem, 1.6rem + 1.8vw, 3.5rem);
    text-align: center;
    margin: 0 auto clamp(1.75rem, 1.25rem + 1.6vw, 2.75rem);
  }
  .npi-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* ---------- The chart, in the home page's window ---------- */
  .npi-chart {
    position: relative;
    margin: 0;
    padding: clamp(0.85rem, 0.5rem + 0.9vw, 1.25rem);
    border-radius: var(--radius-lg);
    background: var(--brand);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .npi-chart::before {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.2), transparent 70%);
    z-index: -1;
  }
  .npi-win { border-radius: 10px; background: #173f5c; border: 1px solid rgb(255 255 255 / 0.12); box-shadow: 0 24px 48px -28px rgb(4 18 30 / 0.7); overflow: hidden; }
  .npi-win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.9rem;
    background: #133650;
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #9fb6cb;
  }
  .npi-dots { display: flex; gap: 5px; }
  .npi-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgb(255 255 255 / 0.18); }
  .npi-legend { display: flex; gap: 1rem; margin-left: auto; font-weight: 600; letter-spacing: 0.02em; color: #9fb6cb; }
  .npi-legend span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .npi-legend i { display: inline-block; width: 20px; border-top: 3px solid #8ec0e6; border-radius: 2px; }
  .npi-legend .lg-without { border-top: 2px dashed rgb(255 255 255 / 0.45); }
  .npi-svg { display: block; width: 100%; height: auto; padding: 0.75rem 0.5rem 0.6rem; box-sizing: border-box; overflow: visible; }
  .npi-narrow { display: none; }

  .grid { stroke: rgb(255 255 255 / 0.06); stroke-width: 1; }
  .axis { stroke: rgb(255 255 255 / 0.28); stroke-width: 1; }
  .start { stroke: rgb(142 192 230 / 0.55); stroke-width: 1; stroke-dasharray: 2 4; }
  .axis-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; fill: #9fb6cb; }

  /* The Spockhart period */
  .band-fill { fill: rgb(142 192 230 / 0.08); }
  .band-mark { fill: #8ec0e6; }
  .band-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; fill: #8ec0e6; }

  /* Without Spockhart: grey */
  .l-before { fill: none; stroke: #b4c3d2; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .l-without { fill: none; stroke: rgb(255 255 255 / 0.42); stroke-width: 2; stroke-dasharray: 5 5; }
  .side-label { font-family: var(--font-body); font-size: 12.5px; font-weight: 600; fill: #b4c3d2; }
  .gap-label { font-family: var(--font-body); font-size: 11.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; fill: #9fb6cb; }
  .without-label { font-family: var(--font-body); font-size: 11px; font-weight: 600; fill: #9fb6cb; }

  /* With Spockhart: resources in the revenue blues, demand in the cost coral */
  .l-demand, .l-res { fill: none; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .l-demand { stroke: #e8958c; }
  .l-res { stroke: #e3f1fb; }
  .r-further { fill: #6f9fc6; }
  .r-funding { fill: #a9d1ee; }
  .seam { fill: none; stroke: #173f5c; stroke-width: 2; }
  .hatch-line { stroke: rgb(217 138 130 / 0.38); stroke-width: 2; }
  .end-label { font-family: var(--font-body); font-size: 13.5px; font-weight: 700; }
  .end-demand { fill: #f1b3ac; }
  .end-res { fill: #e3f1fb; }
  .key { font-family: var(--font-body); font-size: 14px; font-weight: 700; }
  .key-1, .key-2 { fill: #133650; }
  .key-3 { fill: #f1b3ac; }

  /* ---------- Motion ----------
     At rest (and with reduced motion) the chart shows the finished picture. On screen it starts
     from the problem, then builds Spockhart's part slowly, holds, and starts again. */
  @media (prefers-reduced-motion: no-preference) {
    .draw { stroke-dasharray: 1 1; stroke-dashoffset: 0; transition: stroke-dashoffset 4000ms var(--ease-out) 900ms; }
    .sweep { clip-path: inset(0 0 0 0); transition: clip-path var(--dur) var(--ease-out) var(--at); }
    .fade { opacity: 1; transition: opacity 900ms var(--ease) var(--at); }

    /* Back to the problem, quickly and together */
    .npi-pre .draw { stroke-dashoffset: 1; transition: stroke-dashoffset 700ms var(--ease); }
    .npi-pre .sweep { clip-path: inset(0 100% 0 0); transition: clip-path 700ms var(--ease); }
    .npi-pre .fade { opacity: 0; transition: opacity 500ms var(--ease); }
  }

  /* ---------- The three ways, keyed to the chart ---------- */
  .npi-ways { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .npi-way {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 1rem 1.15rem 1.05rem 1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .npi-key {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    margin-top: 0.1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    font-variant-numeric: lining-nums;
  }
  .way-1 .npi-key { background: #6f9fc6; color: #133650; }
  .way-2 .npi-key { background: #a9d1ee; color: #133650; }
  .way-3 .npi-key { background: #a04f48; color: #fff; }
  .npi-way-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--ink);
  }
  .npi-way-body { margin-top: 0.3rem; font-size: 0.96875rem; line-height: 1.5; color: var(--ink-2); }

  @media (max-width: 1080px) {
    .npi-grid { grid-template-columns: minmax(0, 1fr); }
    .npi-chart, .npi-ways { max-width: 720px; width: 100%; margin-inline: auto; }
  }
  @media (max-width: 640px) {
    .npi-wide { display: none; }
    .npi-narrow { display: block; }
    .npi-chart { padding: 0.75rem; }
    .npi-svg { padding: 0.6rem 0.35rem 0.2rem; }
    .npi-win-bar { flex-wrap: wrap; gap: 0.3rem 0.5rem; padding: 0.5rem 0.75rem; font-size: 0.6875rem; letter-spacing: 0.02em; }
    .npi-dots { display: none; }
    .npi-legend { width: 100%; margin-left: 0; gap: 1rem; }
    .npi-legend span { gap: 0.4rem; white-space: nowrap; }
    .npi-legend i { width: 14px; }
    .npi-way { padding: 0.9rem 0.95rem; gap: 0.75rem; }
  }
</style>
