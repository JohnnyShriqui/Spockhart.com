---
/**
 * Six places time and money leak most often. Each problem is one sentence, marked up
 * like an edit: the problem words are crossed out in red and the fix is typed in blue.
 */

/** Plain text, or [crossed out, written in]; leave the second empty to just cross out */
type Segment = string | readonly [string, string];

export interface Problem {
  key: string;
  name: string;
  line: readonly Segment[];
  /** 24x24 stroke icon path */
  icon: string;
}

interface Props {
  items?: readonly Problem[];
  more?: { label: string; href: string };
}

const defaultProblems = [
  {
    key: 'invoicing',
    name: 'Invoicing',
    line: ['I create every invoice ', ['manually', 'automatically'], ' and ', ['chase', 'track'], ' each payment ', ['one by one', 'in one place'], '.'],
    icon: 'M7 3h7l4 4v14H7zM14 3v4h4M12.5 10v8M14.5 11.3c-.4-.6-1.1-.9-2-.9-1.2 0-2 .6-2 1.5 0 2 4 1.1 4 3.1 0 .9-.9 1.5-2 1.5-.9 0-1.7-.4-2.1-1',
  },
  {
    key: 'data-entry',
    name: 'Data entry',
    line: ['I type the same details ', ['into every system', 'once'], ' and ', ['update them manually', 'they sync everywhere'], '.'],
    icon: 'M8 4h10a2 2 0 0 1 2 2v10M4 8h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM7 13h6M7 16h4',
  },
  {
    key: 'reporting',
    name: 'Reporting',
    line: ['My reports are ', ['built by hand', 'updated automatically'], ' from ', ['different spreadsheets', 'one live dashboard'], '.'],
    icon: 'M4 20h16M7 16v-4M12 16V8M17 16v-7M7 8.5l5-3.5 5 3',
  },
  {
    key: 'followups',
    name: 'Follow-ups',
    line: ['I ', ['lose track of', 'never miss'], ' leads, payments, and requests ', ['that slip through the cracks', ''], '.'],
    icon: 'M3 7l9 6 9-6M3 7v10a1 1 0 0 0 1 1h9M3 7a1 1 0 0 1 1-1h16a1 1 0 0 1 1 1v6M16 18h5M19 16l2 2-2 2',
  },
  {
    key: 'scheduling',
    name: 'Scheduling',
    line: ['I ', ['email back and forth', 'send one link'], ' to find a time, then ', ['confirm every meeting manually', 'bookings confirm automatically'], '.'],
    icon: 'M4 6h16v14H4zM4 10h16M8 3v4M16 3v4M8 14h2M12 14h2M16 14h0M8 17h2M12 17h2',
  },
  {
    key: 'reconciliation',
    name: 'Reconciliation',
    line: ['I ', ['manually', 'automatically'], ' match every transaction and ', ['check each line', 'only review what gets flagged'], '.'],
    icon: 'M3.5 4h6v16h-6zM14.5 4h6v16h-6zM9.5 9h5M13 7.5l1.5 1.5-1.5 1.5M14.5 15h-5M11 13.5L9.5 15l1.5 1.5',
  },
] as const;

const { items: problems = defaultProblems, more = { label: 'How we fix it', href: '/approach/' } } = Astro.props;
---

<section class="problems-section" aria-labelledby="problems-title">
  <div class="wrap">
    <div class="p-head" data-reveal>
      <h2 id="problems-title">Stop losing time and money to tedious, repetitive tasks.</h2>
    </div>
    <ul class="p-list" data-reveal="stagger">
      {
        problems.map((p) => (
          <li class="p-row">
            <span class="p-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d={p.icon} />
              </svg>
            </span>
            <div class="p-body">
              <h3>{p.name}</h3>
              <p class="p-line">
                <span class="p-warn" aria-hidden="true">
                  <svg viewBox="0 0 16 16">
                    <path d="M7.13 2.04a1 1 0 0 1 1.74 0l6.01 10.46a1 1 0 0 1-.87 1.5H1.99a1 1 0 0 1-.87-1.5z" />
                    <path class="p-warn-mark" d="M8 6.1v3.5M8 11.75v.01" />
                  </svg>
                </span>
                <span class="p-text">
                  {p.line.map((seg) =>
                    typeof seg === 'string' ? (
                      seg
                    ) : (
                      <>
                        <del>{seg[0]}</del>
                        {seg[1] && ' '}
                        {seg[1] && <ins>{seg[1]}</ins>}
                      </>
                    ),
                  )}
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <a class="arrow-link p-more" href={more.href}><span>{more.label}</span><span class="arr" aria-hidden="true">→</span></a>
  </div>
</section>

<style>
  .problems-section { padding-block: clamp(3rem, 2rem + 3vw, 5rem); background: var(--paper-2); }
  .p-head { margin-bottom: var(--s-6); }
  .p-head h2 { font-size: var(--step-4); max-width: 22ch; }

  /* Two columns of cards on laptops, one on phones */
  .p-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
  .p-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 1.1rem;
    align-items: center;
    padding: 1rem var(--s-5) 1.05rem var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .p-badge { position: relative; display: grid; place-items: center; width: 38px; height: 43px; }
  .p-badge::before { content: ''; position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .p-badge svg { position: relative; width: 19px; height: 19px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .p-body { display: grid; gap: 0.2rem; min-width: 0; }
  .p-body h3 { font-size: 1.0625rem; line-height: 1.3; }

  /* The sentence, edited: a red warning, the problem crossed out in red, the fix typed in blue */
  .p-line { display: flex; align-items: flex-start; gap: 0.5rem; color: var(--ink-2); font-size: 1rem; line-height: 1.55; }
  .p-warn { display: inline-flex; flex: none; margin-top: 0.25rem; color: var(--warn); }
  .p-warn svg { width: 15px; height: 15px; fill: currentColor; }
  .p-warn-mark { fill: none; stroke: #fff; stroke-width: 1.7; stroke-linecap: round; }
  .p-text { min-width: 0; }
  .p-line del {
    color: var(--warn-text);
    text-decoration: line-through;
    text-decoration-color: var(--warn);
    text-decoration-thickness: 2px;
  }
  .p-line ins { color: var(--accent); font-weight: 600; text-decoration: none; }
  .p-more { display: inline-flex; margin-top: var(--s-5); }

  @media (min-width: 901px) {
    .p-line del, .p-line ins { white-space: nowrap; }
  }
  @media (max-width: 1100px) {
    .p-list { grid-template-columns: minmax(0, 1fr); }
  }
  /* Phones: the list as one card */
  @media (max-width: 900px) {
    .p-head h2 { font-size: clamp(2rem, 1.55rem + 1.5vw, 3rem); max-width: 18ch; }
    .p-list { gap: 0; border: 1px solid var(--rule); border-radius: var(--radius-lg); background: var(--surface); overflow: hidden; }
    .p-row { gap: 0 0.85rem; align-items: start; padding: 0.85rem var(--s-4) 0.9rem; border: 0; border-radius: 0; background: none; }
    .p-row + .p-row { border-top: 1px solid var(--rule); }
    .p-badge { width: 30px; height: 34px; margin-top: 0.1rem; }
    .p-badge svg { width: 16px; height: 16px; }
    .p-line { font-size: 0.9375rem; gap: 0.4rem; }
    .p-warn { margin-top: 0.22rem; }
    .p-warn svg { width: 14px; height: 14px; }
  }
</style>
