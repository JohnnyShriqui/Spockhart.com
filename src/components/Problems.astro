---
/**
 * Six places time and money leak most often, beside the leaky bucket.
 * Each problem pairs with the outcome we deliver. Hovering one plugs its leak.
 */
import LeakyBucket from './LeakyBucket.astro';
import Mark from './Mark.astro';
import { problems as defaultProblems, type Problem } from '../data/problems';

export type { Problem };

interface Props {
  items?: readonly Problem[];
  inflow?: string;
  eyebrow?: string;
  more?: { label: string; href: string };
}

const {
  items: problems = defaultProblems,
  inflow = 'Revenue in',
  eyebrow = 'What we fix most often',
  more = { label: 'How we fix it', href: '/approach/' },
} = Astro.props;
---

<section class="problems-section" aria-labelledby="problems-title" data-problems>
  <div class="wrap p-layout">
    <div class="p-side">
      <div class="p-head" data-reveal>
        <p class="eyebrow">{eyebrow}</p>
        <h2 id="problems-title">Sound familiar?</h2>
      </div>
      <div class="p-figure" data-reveal>
        <LeakyBucket inflow={inflow} leaks={problems.map((p) => ({ key: p.key, label: ('short' in p && p.short) || p.name, side: p.side, y: p.y }))} />
      </div>
    </div>

    <div class="p-main">
      <ul class="p-list" data-reveal="stagger">
        {
          problems.map((p, i) => (
            <li class="p-row" data-leak-key={p.key} tabindex="0">
              <span class="p-badge" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d={p.icon} />
                </svg>
              </span>
              <div class="p-problem">
                <p class="p-num">Problem {String(i + 1).padStart(2, '0')}</p>
                <h3>{p.name}</h3>
                <p>{p.problem}</p>
              </div>
              <p class="p-fix">
                <span class="p-fix-tag">
                  <Mark size={14} tone="current" />
                  Fix
                </span>
                <span class="p-arrow" aria-hidden="true">→</span>
                <span class="p-fix-text">{p.fix}</span>
              </p>
            </li>
          ))
        }
      </ul>
      <a class="arrow-link p-more" href={more.href}><span>{more.label}</span><span class="arr" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<script>
  // Hovering or focusing a problem plugs its leak in the bucket.
  function initProblems() {
    document.querySelectorAll<HTMLElement>('[data-problems]').forEach((section) => {
      if (section.dataset.ready) return;
      section.dataset.ready = '1';
      const leaks = new Map<string, Element>();
      section.querySelectorAll('[data-leak]').forEach((g) => leaks.set((g as HTMLElement).dataset.leak!, g));
      const set = (key: string | null) => {
        leaks.forEach((g, k) => g.classList.toggle('is-fixed', k === key));
        section.querySelectorAll<HTMLElement>('[data-leak-key]').forEach((row) => row.classList.toggle('is-active', row.dataset.leakKey === key));
      };
      section.querySelectorAll<HTMLElement>('[data-leak-key]').forEach((row) => {
        const key = row.dataset.leakKey!;
        row.addEventListener('pointerenter', () => set(key));
        row.addEventListener('pointerleave', () => set(null));
        row.addEventListener('focus', () => set(key));
        row.addEventListener('blur', () => set(null));
      });
    });
  }
  initProblems();
  document.addEventListener('spockhart:view', initProblems);
</script>

<style>
  .problems-section { padding-block: clamp(3rem, 2rem + 3vw, 5rem); background: var(--paper-2); overflow: clip; }
  .p-layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: start;
  }
  .p-side { display: grid; gap: var(--s-6); position: sticky; top: 104px; }
  .p-head { display: grid; gap: var(--s-2); }
  .p-head h2 { font-size: var(--step-4); }
  .p-sub { color: var(--ink-2); font-size: var(--step-1); }
  .p-figure { display: grid; justify-items: center; }

  .p-main { display: grid; gap: var(--s-5); }
  .p-list { list-style: none; padding: 0; display: grid; gap: var(--s-3); }
  .p-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, 0.95fr);
    gap: var(--s-4) var(--s-5);
    align-items: center;
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
    outline: none;
    transition: border-color 300ms var(--ease), transform 400ms var(--ease-out), box-shadow 400ms var(--ease);
  }
  .p-row:hover, .p-row.is-active, .p-row:focus-visible {
    border-color: var(--rule-2);
    transform: translateX(-4px);
    box-shadow: 0 16px 32px -26px rgb(27 42 61 / 0.5);
  }
  .p-row:focus-visible { outline: 2px solid var(--accent-soft); outline-offset: 2px; }

  .p-badge { position: relative; display: grid; place-items: center; width: 42px; height: 48px; }
  .p-badge::before {
    content: '';
    position: absolute;
    inset: 0;
    clip-path: var(--hex);
    background: var(--ink);
    transition: background-color 300ms var(--ease), transform 600ms var(--ease-out);
  }
  .p-row.is-active .p-badge::before { background: var(--brand); transform: rotate(180deg); }
  .p-badge svg { position: relative; width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .p-problem { display: grid; gap: 0.1rem; }
  .p-problem h3 { font-size: 1.1875rem; line-height: 1.2; }
  .p-problem p { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.45; }
  .p-problem .p-num { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); line-height: 1.2; }

  .p-fix {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    padding-left: var(--s-5);
    border-left: 1px solid var(--rule);
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .p-fix-tag {
    --mark: currentColor;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.55rem 0.2rem 0.45rem;
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--brand);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .p-arrow { color: var(--accent-soft); transition: transform var(--dur) var(--ease); }
  .p-row.is-active .p-arrow { transform: translateX(3px); }
  .p-fix-text { flex-basis: 100%; color: var(--ink); font-family: var(--font-display); font-weight: 500; font-size: 1rem; line-height: 1.35; }
  .p-more { justify-self: start; }

  @media (max-width: 1100px) {
    .p-row { grid-template-columns: auto minmax(0, 1fr); }
    .p-fix { grid-column: 2; display: block; padding-left: 0; border-left: 0; }
    .p-fix-tag { vertical-align: 0.12em; margin-right: 0.3rem; }
    .p-arrow { margin-right: 0.3rem; }
  }
  @media (max-width: 900px) {
    .p-layout { grid-template-columns: minmax(0, 1fr); }
    .p-side { position: static; }
    .p-figure { max-width: 440px; margin-inline: auto; width: 100%; }
  }
  @media (max-width: 560px) {
    .p-row { padding: var(--s-4); gap: var(--s-2) var(--s-4); }
    .p-row:hover, .p-row.is-active { transform: none; }
    .p-badge { width: 36px; height: 41px; }
    .p-badge svg { width: 19px; height: 19px; }
  }
</style>
