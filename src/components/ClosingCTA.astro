---
import CopyEmail from './CopyEmail.astro';

interface Props {
  title?: string;
  primary?: { label: string; href: string };
  /** Kept so existing pages need no change; the section is short everywhere now */
  terse?: boolean;
}
const { title = 'Tell us where you’d like to improve.', primary = { label: 'Start a conversation', href: '/contact/' } } = Astro.props;
---

<section class="closing section">
  <div class="wrap closing-inner" data-reveal>
    <h2>{title}</h2>
    <div class="closing-actions">
      <a class="btn" href={primary.href}>{primary.label} <span class="arr" aria-hidden="true">→</span></a>
      <CopyEmail />
    </div>
  </div>
</section>

<style>
  /* Short: the heading on one line, the buttons directly underneath */
  .closing { border-top: 1px solid var(--rule); padding-block: clamp(2.25rem, 1.5rem + 2.25vw, 3.5rem); }
  .closing-inner { display: grid; gap: var(--s-5); justify-items: start; }
  .closing h2 { max-width: none; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem); line-height: 1.1; text-wrap: balance; }
  .closing-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: center; }
  @media (max-width: 640px) {
    .closing-inner { gap: var(--s-4); }
  }
</style>
