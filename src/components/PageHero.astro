---
import Mist from './Mist.astro';
interface Props {
  title: string;
  lead?: string;
  /** Each page's own hero colours (see "Hero themes" in global.css). */
  theme?: 'approach' | 'work' | 'security' | 'nonprofit' | 'quiet';
  /** A light hero in that page's colours (Approach) */
  light?: boolean;
  /** On phones, hide the lead and keep just the heading */
  terse?: boolean;
  /** On laptops, fill the screen (like the home hero) */
  full?: boolean;
  class?: string;
}
const { title, lead, theme = 'quiet', light = false, terse = false, full = false, class: className = '' } = Astro.props;
const hasFigure = Astro.slots.has('figure');
---

<section
  class:list={['page-hero', light ? `hero-light theme-${theme}-light` : `hero-dark theme-${theme}`, className, { 'with-figure': hasFigure, terse, 'hero-full': full }]}
  data-hero-dark={light ? undefined : ''}
>
  <Mist />
  <div class="wrap hero-layout">
    <div class="hero-text">
      <h1 class="load-in" style="--i:1" set:html={title} />
      <div class="accent-rule load-in" style="--i:2"></div>
      {lead && <p class="lead load-in" style="--i:2">{lead}</p>}
      {Astro.slots.has('default') && (
        <div class="load-in hero-extra" style="--i:3">
          <slot />
        </div>
      )}
    </div>
    {hasFigure && (
      <div class="hero-figure load-fade">
        <slot name="figure" />
      </div>
    )}
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; isolation: isolate; }
  .page-hero > .wrap { position: relative; z-index: 1; }
  .hero-text { display: grid; gap: var(--s-5); }
  .hero-extra { margin-top: var(--s-2); }
  .with-figure .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: center;
  }
  .hero-figure { width: 100%; max-width: 480px; justify-self: end; }
  /* Laptops: the hero fills the screen, its content centred below the header */
  @media (min-width: 961px) {
    .hero-full {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-top: calc(88px + clamp(1.5rem, 1rem + 2vw, 3rem));
      padding-bottom: clamp(3rem, 1.5rem + 6vh, 6rem);
    }
    .hero-full > .wrap { width: 100%; }
  }
  @media (max-width: 640px) {
    .terse .lead { display: none; }
  }
  @media (max-width: 960px) {
    .with-figure .hero-layout { grid-template-columns: minmax(0, 1fr); }
    .hero-figure { justify-self: start; max-width: 420px; }
  }
</style>
