<style>
  .rv {
    position: relative;
    /* Everything inside moves; keep its layout and repaints inside the graphic */
    contain: layout paint;
    display: grid;
    gap: var(--s-5);
    align-content: start;
    margin: 0;
    padding: clamp(1rem, 0.6rem + 1.6vw, 2rem);
    border-radius: var(--radius-lg);
    /* A page can tint these to match where they sit (--rv-frame, --rv-win, --rv-bar, --rv-hot);
       otherwise they are the brand blues */
    /* The Approach displays' frame: midnight, with the brand's steel light in one corner */
    --brand: var(--rv-frame, #10233a);
    background:
      radial-gradient(70% 55% at 0% 0%, rgb(46 104 152 / 0.42), transparent 70%),
      radial-gradient(50% 50% at 100% 100%, rgb(38 96 142 / 0.18), transparent 72%),
      linear-gradient(165deg, #0f2236 0%, #0a1625 100%);
    color: var(--fg-solid);
    overflow: hidden;
    isolation: isolate;
    /* The Approach palette: a luminous cyan for what's new, green for done, amber for waiting,
       red for waste, on quiet steel */
    --hot: var(--rv-hot, #6fd6ff);
    --glow: drop-shadow(0 0 4px rgb(63 208 255 / 0.55));
    --ok: #34d399;
    --ok-text: #7ff0c3;
    --wait: #ffb84d;
    --bad: #ff6b82;
    --dim: rgb(var(--fg) / 0.2);
    --soft: var(--rv-soft, #dcecf8);
    --muted: var(--rv-muted, rgb(170 195 220 / 0.75));
    /* Foreground: white on the dark graphics, navy when a page sets them light */
    --fg: var(--rv-fg, 255 255 255);
    --fg-solid: var(--rv-fg-solid, #fff);
    --hot-rgb: var(--rv-hot-rgb, 63 208 255);
  }
  .rv::before {
    content: '';
    position: absolute;
    width: 460px;
    height: 460px;
    right: -200px;
    top: -220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(184 204 224 / 0.2), transparent 70%);
    z-index: -1;
  }

  /* ---------- The window ---------- */
  /* As on the Approach cards: lit along its top, standing off the frame, on a fine dot grid */
  .win {
    border-radius: 14px;
    background: var(--rv-win, #14293f);
    border: 1px solid rgb(var(--fg) / 0.1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 24px 44px -24px rgb(0 0 0 / 0.75), 0 2px 6px rgb(0 0 0 / 0.2);
    overflow: hidden;
  }
  .win > .scene {
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.055) 1px, transparent 1.4px);
    background-size: 22px 22px;
  }
  .win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: var(--rv-bar, #112338);
    border-bottom: 1px solid rgb(var(--fg) / 0.08);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #c9d8e6;
  }
  .win-dots { display: flex; gap: 5px; }
  .win-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgb(var(--fg) / 0.18); }

  /* ---------- Scene timing helpers ---------- */
  .scene { --t: var(--still, 0); display: grid; }
  .ap { opacity: clamp(0, (var(--t) - var(--a, 0)) * 6, 1); }
  .ghost { opacity: calc(0.28 + 0.72 * clamp(0, (var(--d) - var(--t)) * 3, 1)); }
  .dn { opacity: clamp(0, (var(--d) - var(--t)) * 6, 1); }
  /* Everything that moves fades out just before the loop restarts */
  .ends { opacity: clamp(0, (var(--loop) - 0.3 - var(--t)) * 5, 1); }
  .pop {
    opacity: clamp(0, (var(--t) - var(--a)) * 6, 1);
    transform: scale(calc(0.4 + 0.6 * clamp(0, (var(--t) - var(--a)) * 5, 1)));
    transform-box: fill-box;
    transform-origin: center;
  }
  .grow {
    transform: scaleX(clamp(0, (var(--t) - var(--a)) / (var(--b) - var(--a)), 1));
    transform-box: fill-box;
    transform-origin: left center;
  }
  .swap { display: inline-grid; justify-items: end; }
  .swap > * { grid-area: 1 / 1; }

  /* ---------- Lanes ---------- */
  .lane { display: grid; gap: 0.75rem; align-content: start; padding: 1rem 1.1rem 1.1rem; min-width: 0; }
  .lane + .lane { border-top: 1px solid rgb(var(--fg) / 0.08); }
  .panes { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  /* Keep meters and sparklines level across the two panes */
  .panes .lane { grid-template-rows: auto 1fr auto; }
  .panes .lane + .lane { border-top: 0; border-left: 1px solid rgb(var(--fg) / 0.08); }
  .lane-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; min-height: 1.75rem; }
  /* Before: a quiet outlined pill. After: lit, in cyan. */
  .tag {
    flex: none;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    background: rgb(var(--fg) / 0.03);
    box-shadow: inset 0 0 0 1px rgb(var(--fg) / 0.2);
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .tag-hot {
    background: rgb(var(--hot-rgb) / 0.12);
    box-shadow: inset 0 0 0 1px rgb(var(--hot-rgb) / 0.55), 0 0 14px rgb(var(--hot-rgb) / 0.22);
    color: #8fe3ff;
  }
  .readout {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.005em;
    color: var(--muted);
