    inset: -1px;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1.5px #fff;
    opacity: calc(clamp(0, (var(--t) - var(--a) + 0.26) * 12, 1) * clamp(0, (var(--a) - var(--t)) * 12, 1));
  }
  .sheet-hot .sc { background: rgb(142 192 230 / calc(0.08 + 0.72 * clamp(0, (var(--t) - var(--a)) * 10, 1))); }
  .sheet-hot .sc::after { display: none; }

  /* ---------- Stats under the window ---------- */
  .rv-k { font-size: 0.8125rem; color: var(--soft); }
  .rv-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  .rv-split > div { display: grid; gap: 0.2rem; }
  .rv-num { font-family: var(--font-display); font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); line-height: 1.05; letter-spacing: -0.02em; font-variant-numeric: lining-nums; }
  .rv-num-sm { font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.875rem); white-space: nowrap; }
  .rv-num s { color: var(--soft); text-decoration-thickness: 2px; font-size: 0.7em; margin-right: 0.2em; }
  .rv-num small { font-family: var(--font-body); font-size: 0.875rem; letter-spacing: 0; color: var(--soft); }
  .rv-note { font-size: 0.75rem; color: #bcd6ec; }

  @media (prefers-reduced-motion: no-preference) {
    .bubble { animation: bob 2.4s ease-in-out infinite; animation-delay: calc(var(--i) * -0.4s); }
    @keyframes bob { 50% { transform: translateY(-3px); opacity: 0.6; } }
  }

  /* Phones: the same graphics, zoomed out. Tighter frames, shorter panes and the two
     results side by side. */
  @media (max-width: 640px) {
    .rv { padding: 0.75rem; gap: 0.9rem; }
    .win-bar { padding: 0.45rem 0.75rem; font-size: 0.6875rem; }
    .win-dots i { width: 6px; height: 6px; }
    .lane { padding: 0.7rem 0.8rem 0.8rem; gap: 0.55rem; }
    .lane-head { min-height: 1.5rem; }
    .tag { font-size: 0.625rem; padding: 0.15rem 0.5rem; }
    .readout { font-size: 0.95rem; }
    .lane-foot { font-size: 0.75rem; }
    .pane-svg { max-height: 150px; }
    .panes .meter { margin-top: 0.4rem; }
    .chips { gap: 0.3rem; }
    .chip { font-size: 0.6875rem; padding: 0.15rem 0.5rem; }
    .rv-split { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; }
    .rv-k { font-size: 0.75rem; line-height: 1.3; }
    .rv-num-sm { font-size: 1.25rem; white-space: normal; }
    .rv-num small { font-size: 0.75rem; }
  }
  @media (max-width: 560px) {
    .panes { grid-template-columns: minmax(0, 1fr); }
    .panes .lane + .lane { border-left: 0; border-top: 1px solid rgb(255 255 255 / 0.08); }
    .lane { padding: 0.85rem 0.9rem 1rem; }
    .readout { font-size: 1rem; }
    .cells { gap: 3px; }
    .cell { height: 28px; }
    .lane-svg .node-label { font-size: 17px; }
    .chain-svg .corner, .chain-svg .rank-n { font-size: 19px; }
    .stage { font-size: 0.75rem; padding-right: 0.55rem; }
  }
</style>
