---
/**
 * The display on each step of the process (Process.astro): a dark, screen-like panel where the
 * step's work is seen being done, as a short story that plays while it is on screen and loops.
 * Illustrations, not client data.
 *
 *   0 Diagnose   The lanes appear and the process is mapped, step by step. Then a piece of work
 *                runs through it, slows where the same data is typed twice, those steps turn red,
 *                and the waste is called out.
 *   1 Prototype  An empty window. Grey wireframe rows (the design), filled with real records
 *                (the build). Then it works: each invoice is approved in turn.
 *   2 Build      The hub assembles. The tools already in use arrive one at a time, each wired in
 *                and lit as data flows. The team arrives and is trained, one by one; it goes live.
 *   3 Handover   The kit is put together on a pass, item by item, then handed across to your
 *                team, and becomes theirs.
 *
 * Timed by the scene engine (scripts/scenes.ts), which writes the story's time to --t, unhurried
 * (a little over half speed), so the stories sit calmly beside the words. Each part
 * comes in at its moment (--a) and some leave at another (--b). With reduced motion, or before
 * the script runs, it rests on the finished picture.
 */
import { upperPath, lowerPath } from '../lib/logo';
interface Props {
  step: 0 | 1 | 2 | 3;
}
const { step } = Astro.props;

const LOOP = 12;
const STILL = 10.6;
/* Each story sits in a window, as the graphics on Our Work do: its title bar, then the picture,
   framed to what that story draws */
const titles = ['Order to invoice', 'Invoice approvals', 'Connected to your tools', 'Handover'];
const views = ['6 80 548 298', '40 108 482 232', '44 26 472 322', '50 58 506 284'];
const at = (a: number, b?: number, d?: number) => `--a:${a}${b !== undefined ? `;--b:${b}` : ''}${d !== undefined ? `;--d:${d}` : ''}`;

/* An arrowhead, landing at (x, y), pointing r, l, u or d */
const head = (x: number, y: number, dir: 'r' | 'l' | 'u' | 'd') => {
  const s = 5;
  const pts = {
    r: [[x, y], [x - s * 1.4, y - s], [x - s * 1.4, y + s]],
    l: [[x, y], [x + s * 1.4, y - s], [x + s * 1.4, y + s]],
    u: [[x, y], [x - s, y + s * 1.4], [x + s, y + s * 1.4]],
    d: [[x, y], [x - s, y - s * 1.4], [x + s, y - s * 1.4]],
  }[dir];
  return pts.map((p) => p.join(',')).join(' ');
};

/* 2. The app's records */
const rows = [
  ['INV-1042', 'Northline Supply', '$4,280'],
  ['INV-1043', 'Harbour Print', '$960'],
  ['INV-1044', 'Cedar Logistics', '$12,400'],
  ['INV-1045', 'Fieldstone Labs', '$2,115'],
];
const flips = [7.3, 7.9, 8.5, 9.1];

/* 3. The tools, around the hub */
const hub = { x: 280, y: 158 };
const tiles = [
  { x: 112, y: 80, label: 'Email', glyph: 'mail', a: 1.4 },
  { x: 448, y: 80, label: 'Accounting', glyph: 'ledger', a: 2.2 },
  { x: 112, y: 236, label: 'CRM', glyph: 'card', a: 3.0 },
  { x: 448, y: 236, label: 'Calendar', glyph: 'cal', a: 3.8 },
];
const team = [
  { x: 206, label: 'Finance', i: 'F', a: 5.1, c: 6.0 },
  { x: 280, label: 'Operations', i: 'O', a: 5.3, c: 6.6 },
  { x: 354, label: 'Admin', i: 'A', a: 5.5, c: 7.2 },
];

/* 4. The kit */
const kit = ['Source code', 'Documentation', 'Admin access', 'Training notes'];
---

<div class={`pv pv-${step}`} aria-hidden="true" data-pv data-scene data-loop={LOOP} data-still={STILL} data-rate="0.58" style={`--t:${STILL};--L:${LOOP}`}>
  <div class="pv-win">
  <div class="pv-bar">
    <span class="pv-dots"><i></i><i></i><i></i></span>
    <span class="pv-bar-title">{titles[step]}</span>
    {step === 0 && <span class="pv-bar-right pv-bar-tag">Process map</span>}
  </div>
  <div class="pv-body">
  <svg viewBox={views[step]} preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id={`pv-dots-${step}`} width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="rgb(255 255 255 / 0.06)"></circle>
      </pattern>
      <radialGradient id={`pv-glow-${step}`}>
        <stop offset="0" stop-color="#3fd0ff" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#3fd0ff" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`pv-hub-${step}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3b82c4"></stop>
        <stop offset="1" stop-color="#173a5a"></stop>
      </linearGradient>
      <linearGradient id={`pv-pass-${step}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2f6fa6"></stop>
        <stop offset="0.55" stop-color="#1f4d6f"></stop>
        <stop offset="1" stop-color="#14324d"></stop>
      </linearGradient>
      <linearGradient id={`pv-sheen-${step}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.24"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <clipPath id={`pv-passclip-${step}`}><rect x="120" y="86" width="320" height="232" rx="20"></rect></clipPath>
    </defs>

    <rect width="560" height="400" fill={`url(#pv-dots-${step})`}></rect>

    <g class="pv-stage">
      {
        step === 0 && (
          <g>

            {/* The lanes */}
            <path d="M24 84 H536 Q550 84 550 98 V358 Q550 372 536 372 H24 Q10 372 10 358 V98 Q10 84 24 84 Z" pathLength="1" class="pv-lanes draw" style={at(0.3, undefined, 1)}></path>
            <path d="M10 182 H550" pathLength="1" class="pv-lane-rule draw" style={at(0.8, undefined, 0.6)}></path>
            <path d="M36 84 V372" pathLength="1" class="pv-lane-rule draw" style={at(0.8, undefined, 0.6)}></path>
            <text transform="translate(27 133) rotate(-90)" text-anchor="middle" class="pv-lane-name in" style={at(1)}>Customer</text>
            <text transform="translate(27 277) rotate(-90)" text-anchor="middle" class="pv-lane-name in" style={at(1.1)}>Your team</text>

            {/* Mapped, step by step, as the work actually runs */}
            <circle cx="52" cy="137" r="8" class="pv-event pop" style={at(1.3)}></circle>
            <path d="M60 137 H66" pathLength="1" class="pv-seq draw" style={at(1.45, undefined, 0.2)}></path>
            <polygon points={head(70, 137, 'r')} class="pv-head in" style={at(1.6)}></polygon>
            <g class="pop" style={at(1.65)}>
              <rect x="70" y="120" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="110" y="141" text-anchor="middle" class="pv-task-text">Place order</text>
            </g>
            <path d="M110 154 V207" class="pv-msg in" style={at(2.0)}></path>
            <polyline points="105,201 110,209 115,201" class="pv-openhead in" style={at(2.1)}></polyline>
            <g class="pop" style={at(2.3)}>
              <rect x="70" y="213" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="110" y="234" text-anchor="middle" class="pv-task-text">Order in</text>
            </g>
            <path d="M150 230 H160" pathLength="1" class="pv-seq draw" style={at(2.6, undefined, 0.2)}></path>
            <polygon points={head(166, 230, 'r')} class="pv-head in" style={at(2.75)}></polygon>
            <g class="pop" style={at(2.85)}>
              <rect x="166" y="213" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="206" y="234" text-anchor="middle" class="pv-task-text">Typed in CRM</text>
            </g>
            <path d="M246 230 H256" pathLength="1" class="pv-seq draw" style={at(3.15, undefined, 0.2)}></path>
            <polygon points={head(262, 230, 'r')} class="pv-head in" style={at(3.3)}></polygon>
            <g class="pop" style={at(3.4)}>
              <rect x="262" y="213" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="302" y="234" text-anchor="middle" class="pv-task-text">Typed in books</text>
            </g>
            <path d="M342 230 H352" pathLength="1" class="pv-seq draw" style={at(3.7, undefined, 0.2)}></path>
            <polygon points={head(358, 230, 'r')} class="pv-head in" style={at(3.85)}></polygon>
            <g class="pop" style={at(3.95)}>
              <path d="M372 216 L386 230 L372 244 L358 230 Z" class="pv-gate"></path>
              <path d="M367 225 L377 235 M377 225 L367 235" class="pv-gate-x"></path>
            </g>
            <path d="M386 230 H398" pathLength="1" class="pv-seq draw" style={at(4.25, undefined, 0.2)}></path>
            <polygon points={head(404, 230, 'r')} class="pv-head in" style={at(4.4)}></polygon>
            <g class="pop" style={at(4.5)}>
              <rect x="404" y="213" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="444" y="234" text-anchor="middle" class="pv-task-text">Invoice sent</text>
            </g>
            <path d="M484 230 H500" pathLength="1" class="pv-seq draw" style={at(4.8, undefined, 0.25)}></path>
            <polygon points={head(506, 230, 'r')} class="pv-head in" style={at(5.0)}></polygon>
            <circle cx="514" cy="230" r="8" class="pv-event-end pop" style={at(5.1)}></circle>
            {/* The other way through the decision: a manager's approval */}
            <path d="M372 244 V302 Q372 310 380 310 H398" pathLength="1" class="pv-seq draw" style={at(4.6, undefined, 0.5)}></path>
            <polygon points={head(404, 310, 'r')} class="pv-head in" style={at(5.1)}></polygon>
            <g class="pop" style={at(5.2)}>
              <rect x="404" y="293" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="444" y="314" text-anchor="middle" class="pv-task-text">Manager OK</text>
            </g>
            <path d="M444 293 V253" pathLength="1" class="pv-seq draw" style={at(5.5, undefined, 0.3)}></path>
            <polygon points={head(444, 247, 'u')} class="pv-head in" style={at(5.8)}></polygon>
            {/* Back to the customer */}
            <path d="M444 213 V158" class="pv-msg in" style={at(5.9)}></path>
            <polyline points="439,162 444,154 449,162" class="pv-openhead in" style={at(6.0)}></polyline>
            <g class="pop" style={at(6.2)}>
              <rect x="404" y="120" width="80" height="34" rx="9" class="pv-task"></rect>
              <text x="444" y="141" text-anchor="middle" class="pv-task-text">Get invoice</text>
            </g>
            <path d="M484 137 H500" pathLength="1" class="pv-seq draw" style={at(6.5, undefined, 0.25)}></path>
            <polygon points={head(506, 137, 'r')} class="pv-head in" style={at(6.7)}></polygon>
            <circle cx="514" cy="137" r="8" class="pv-event-end pop" style={at(6.8)}></circle>

            {/* The waste found: as the work passes, the two typing steps turn red */}
            <g class="in" style={at(7.8)}>
              <rect x="166" y="213" width="80" height="34" rx="9" class="pv-task pv-task-waste"></rect>
              <text x="206" y="234" text-anchor="middle" class="pv-task-text pv-task-text-waste">Typed in CRM</text>
            </g>
            <g class="in" style={at(8.6)}>
              <rect x="262" y="213" width="80" height="34" rx="9" class="pv-task pv-task-waste"></rect>
              <text x="302" y="234" text-anchor="middle" class="pv-task-text pv-task-text-waste">Typed in books</text>
            </g>
            <rect x="166" y="213" width="176" height="34" rx="9" class="pv-waste-glow in" style={at(8.9)}></rect>
            <path d="M206 249 V276 M302 249 V276" class="pv-call in" style={at(9.1)}></path>
            <g transform="translate(254 290)">
              <g class="pop" style={at(9.3)}>
                <rect x="-84" y="-14" width="168" height="28" rx="14" class="pv-tag-red"></rect>
                <text x="0" y="4.5" text-anchor="middle" class="pv-tag-red-text">Same data, typed twice</text>
              </g>
            </g>

            {/* A piece of work running the process: it slows where it is done twice */}
            <path id="pv-run-0" d="M110 230 H444" fill="none" stroke="none"></path>
            <g data-along="#pv-run-0" data-keys="6.9 0, 7.5 0.17, 8.9 0.69, 9.5 1">
              <g class="inout" style={at(6.9, 9.7)}>
                <circle r="13" fill={`url(#pv-glow-0)`}></circle>
                <circle r="4.5" class="pv-pulse"></circle>
              </g>
            </g>
          </g>
        )
      }

      {
        step === 1 && (
          <g>
            <g class="in" style={at(1.0)}>
              <text x="62" y="126" class="pv-col">Invoice</text>
              <text x="178" y="126" class="pv-col">Supplier</text>
              <text x="372" y="126" text-anchor="end" class="pv-col">Amount</text>
              <text x="458" y="126" text-anchor="middle" class="pv-col">Status</text>
            </g>

            {/* The row being worked on, once it works */}
            <path id="pv-focus-1" d="M0 0 V144" fill="none" stroke="none"></path>
            <g data-along="#pv-focus-1" data-keys="7.0 0, 7.5 0, 7.8 0.3333, 8.4 0.6667, 9.0 1">
              <rect x="46" y="140" width="468" height="44" rx="11" class="pv-focus inout" style={at(6.95, 10.3)}></rect>
            </g>

            {rows.map((r, i) => (
              <g>
                {/* First the design: grey wireframe rows */}
                <g class="inout" style={at(1.3 + i * 0.18, 2.9 + i * 0.5)}>
                  <rect x="62" y={160 + i * 48} width="62" height="9" rx="4.5" class="pv-skel"></rect>
                  <rect x="178" y={160 + i * 48} width={88 - i * 8} height="9" rx="4.5" class="pv-skel"></rect>
                  <rect x={330 - (i % 2) * 10} y={160 + i * 48} width={42 + (i % 2) * 10} height="9" rx="4.5" class="pv-skel"></rect>
                  <rect x="416" y={153 + i * 48} width="84" height="22" rx="11" class="pv-skel pv-skel-soft"></rect>
                </g>
                {/* Then the build: real records */}
                {i < 3 && <line x1="54" y1={186 + i * 48} x2="506" y2={186 + i * 48} class="pv-hair pv-hair-soft in" style={at(1.3)}></line>}
                <g class="in" style={at(2.95 + i * 0.5)}>
                  <text x="62" y={167 + i * 48} class="pv-cell pv-cell-strong">{r[0]}</text>
                  <text x="178" y={167 + i * 48} class="pv-cell">{r[1]}</text>
                  <text x="372" y={167 + i * 48} text-anchor="end" class="pv-cell pv-cell-num">{r[2]}</text>
                </g>
                <g transform={`translate(458 ${162 + i * 48})`}>
                  <g class="inout" style={at(3.25 + i * 0.5, flips[i])}>
                    <rect x="-42" y="-13" width="84" height="26" rx="13" class="pv-pill-amber"></rect>
                    <text x="0" y="4.5" text-anchor="middle" class="pv-pill-amber-text">Pending</text>
                  </g>
                  {/* Then it works: approved, one by one */}
                  <g class="pop" style={at(flips[i])}>
                    <rect x="-42" y="-13" width="84" height="26" rx="13" class="pv-pill-green"></rect>
                    <text x="0" y="4.5" text-anchor="middle" class="pv-pill-green-text">Approved</text>
                  </g>
                </g>
              </g>
            ))}
          </g>
        )
      }

      {
        step === 2 && (
          <g>
            <circle cx={hub.x} cy={hub.y} r="96" fill={`url(#pv-glow-2)`} class="in" style={at(0.3)}></circle>
            <circle cx={hub.x} cy={hub.y} r="120" fill={`url(#pv-glow-2)`} class="in" style={at(7.8)}></circle>
            {/* Each tool, wired in, then lit as data flows to the hub */}
            {tiles.map((t, i) => (
              <g>
                <path d={`M${t.x} ${t.y} L${hub.x} ${hub.y}`} pathLength="1" class="pv-track draw" style={at(t.a + 0.3, undefined, 0.5)}></path>
                <path d={`M${t.x} ${t.y} L${hub.x} ${hub.y}`} class="pv-flow in" style={at(t.a + 0.85)}></path>
                <path id={`pv-wire-${i}`} d={`M${t.x} ${t.y} L${hub.x} ${hub.y}`} fill="none" stroke="none"></path>
                <g data-along={`#pv-wire-${i}`} data-speed="0.42" data-offset={String(i * 0.27)}>
                  <circle r="4" class="pv-pulse in" style={at(t.a + 0.9)}></circle>
                </g>
              </g>
            ))}
            {tiles.map((t) => (
              <g transform={`translate(${t.x} ${t.y})`}>
                <g class="pop" style={at(t.a)}>
                  <rect x="-30" y="-30" width="60" height="60" rx="17" class="pv-tile"></rect>
                  <rect x="-30" y="-30" width="60" height="60" rx="17" class="pv-tile-edge"></rect>
                  {t.glyph === 'mail' && (
                    <g class="pv-glyph">
                      <rect x="-13" y="-9.5" width="26" height="19" rx="3.5"></rect>
                      <path d="M-12 -7 L0 2 L12 -7"></path>
                    </g>
                  )}
                  {t.glyph === 'ledger' && (
                    <g class="pv-glyph">
                      <rect x="-11" y="-13" width="22" height="26" rx="3.5"></rect>
                      <path d="M-6 -6 H6 M-6 0 H6 M-6 6 H2"></path>
                    </g>
                  )}
                  {t.glyph === 'card' && (
                    <g class="pv-glyph">
                      <rect x="-14" y="-10" width="28" height="20" rx="3.5"></rect>
                      <circle cx="-5.5" cy="-1.5" r="3.5"></circle>
                      <path d="M-11 6.5 C-9.5 2.5 -1.5 2.5 0 6.5 M4 -3 H10 M4 2 H9"></path>
                    </g>
                  )}
                  {t.glyph === 'cal' && (
                    <g class="pv-glyph">
                      <rect x="-13" y="-11" width="26" height="24" rx="3.5"></rect>
                      <path d="M-13 -4 H13 M-6 -15 V-8 M6 -15 V-8"></path>
                      <circle cx="-5" cy="4" r="1.3" class="pv-glyph-fill"></circle>
                      <circle cx="0" cy="4" r="1.3" class="pv-glyph-fill"></circle>
                      <circle cx="5" cy="4" r="1.3" class="pv-glyph-fill"></circle>
                    </g>
                  )}
                  <text x="0" y="50" text-anchor="middle" class="pv-label">{t.label}</text>
                </g>
              </g>
            ))}
            {/* The hub assembles: the two halves of the mark come together */}
            <g transform={`translate(${hub.x} ${hub.y})`}>
              <g class="pop" style={at(0.3)}>
                <rect x="-46" y="-46" width="92" height="92" rx="26" fill={`url(#pv-hub-2)`} class="pv-hub"></rect>
                <rect x="-46" y="-46" width="92" height="92" rx="26" class="pv-tile-edge pv-hub-edge"></rect>
              </g>
              <g transform="scale(0.17)" class="pv-mark">
                <path d={upperPath} class="pv-half pv-half-up" style={at(0.6)}></path>
                <path d={lowerPath} class="pv-half pv-half-down" style={at(0.6)}></path>
              </g>
              {/* Live */}
              <g transform="translate(0 -66)">
                <g class="pop" style={at(7.8)}>
                  <rect x="-28" y="-12" width="56" height="24" rx="12" class="pv-live"></rect>
                  <circle cx="-14" cy="0" r="3.5" class="pv-live-dot"></circle>
                  <text x="5" y="4.2" text-anchor="middle" class="pv-live-text">Live</text>
                </g>
              </g>
            </g>
            {/* The team, arriving, then trained one by one */}
            <text x="280" y="268" text-anchor="middle" class="pv-kicker in" style={at(4.9)}>Your team</text>
            {team.map((m) => (
              <g transform={`translate(${m.x} 300)`}>
                <g class="pop" style={at(m.a)}>
                  <circle r="17" class="pv-person"></circle>
                  <text x="0" y="5" text-anchor="middle" class="pv-person-i">{m.i}</text>
                  <text x="0" y="36" text-anchor="middle" class="pv-label pv-label-sm">{m.label}</text>
                </g>
                <circle r="17" class="pv-person-ring in" style={at(m.c)}></circle>
                <g class="pop" style={at(m.c)}>
                  <circle cx="12" cy="-12" r="7.5" class="pv-badge-dot"></circle>
                  <path d="M8.6 -12 L11 -9.6 L15.4 -14.2" class="pv-badge-tick"></path>
                </g>
              </g>
            ))}
          </g>
        )
      }

      {
        step === 3 && (
          <g>
            {/* Your team, waiting on the right */}
            <text x="512" y="118" text-anchor="middle" class="pv-kicker in" style={at(4.6)}>Your team</text>
            {[0, 1, 2].map((k) => (
              <g transform={`translate(512 ${150 + k * 44})`}>
                <g class="pop" style={at(4.6 + k * 0.15)}>
                  <circle r="15" class="pv-person"></circle>
                  <text x="0" y="4.5" text-anchor="middle" class="pv-person-i">{['F', 'O', 'A'][k]}</text>
                </g>
                <circle r="15" class="pv-person-ring in" style={at(6.7 + k * 0.12)}></circle>
              </g>
            ))}

            {/* The pass: put together, then handed across */}
            <g data-move="-62 0 22 0 5.2 6.6">
              <g class="pop" style={at(0.2)}>
                <rect x="120" y="86" width="320" height="232" rx="20" class="pv-pass-shadow"></rect>
                <rect x="120" y="86" width="320" height="232" rx="20" fill={`url(#pv-pass-3)`}></rect>
                <rect x="120" y="86" width="320" height="232" rx="20" class="pv-tile-edge pv-pass-edge"></rect>
              </g>
              <g clip-path={`url(#pv-passclip-3)`}>
                <g data-move="-160 0 520 0 6.7 7.9">
                  <rect x="0" y="60" width="140" height="300" fill={`url(#pv-sheen-3)`} transform="skewX(-18)"></rect>
                </g>
              </g>
              <g class="in" style={at(0.7)}>
                <g transform="translate(150 118) scale(0.095)" class="pv-mark">
                  <path d={upperPath}></path>
                  <path d={lowerPath}></path>
                </g>
              </g>
              <text x="168" y="123" class="pv-pass-brand inout" style={at(0.7, 6.4)}>Spockhart</text>
