---
/**
 * The display on each step of the process (Process.astro): a dark, screen-like panel with one
 * luminous, minimal scene, moving slowly. Illustrations, not client data.
 *
 *   0 Diagnose       a process map in two lanes, the customer and your team, with the step where
 *                    the same data is typed twice called out; the work slows as it passes it
 *   1 Prototype      a working app: approvals turn from Pending to Approved, row by row
 *   2 Build          the tools already in use, as glass tiles, feeding one hub; the team below
 *   3 Handover       the handover kit as a pass that checks itself off and catches the light
 *
 * The motion is SVG animation; with reduced motion it is paused on a finished frame.
 */
import { upperPath, lowerPath } from '../lib/logo';
interface Props {
  step: 0 | 1 | 2 | 3;
}
const { step } = Astro.props;

/* 1. The process: five points along a gentle arc */
const nodes = [
  { x: 72, y: 262, label: 'Order in' },
  { x: 176, y: 206, label: 'Typed in CRM', waste: true },
  { x: 280, y: 190, label: 'Typed in books', waste: true },
  { x: 384, y: 206, label: 'Manager OK' },
  { x: 488, y: 262, label: 'Invoice sent' },
];
const flow = 'M72 262 C112 262 136 206 176 206 C216 206 240 190 280 190 C320 190 344 206 384 206 C424 206 448 262 488 262';

/* 2. The app */
const rows = [
  ['INV-1042', 'Northline Supply', '$4,280'],
  ['INV-1043', 'Harbour Print', '$960'],
  ['INV-1044', 'Cedar Logistics', '$12,400'],
  ['INV-1045', 'Fieldstone Labs', '$2,115'],
];

/* 3. The tools, around the hub */
const hub = { x: 280, y: 168 };
const tiles = [
  { x: 112, y: 86, label: 'Email', glyph: 'mail' },
  { x: 448, y: 86, label: 'Accounting', glyph: 'ledger' },
  { x: 112, y: 250, label: 'CRM', glyph: 'card' },
  { x: 448, y: 250, label: 'Calendar', glyph: 'cal' },
];
const team = [
  { x: 206, label: 'Finance', i: 'F' },
  { x: 280, label: 'Operations', i: 'O' },
  { x: 354, label: 'Admin', i: 'A' },
];

/* 4. The kit */
const kit = ['Source code', 'Documentation', 'Admin access', 'Training notes'];
---

<div class={`pv pv-${step}`} aria-hidden="true" data-pv>
  <svg viewBox="0 0 560 400" preserveAspectRatio="xMidYMid meet">
    <defs>
      <pattern id={`pv-dots-${step}`} width="22" height="22" patternUnits="userSpaceOnUse">
        <circle cx="1" cy="1" r="1" fill="rgb(255 255 255 / 0.06)"></circle>
      </pattern>
      <linearGradient id={`pv-cyan-${step}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#3fd0ff" stop-opacity="0.2"></stop>
        <stop offset="0.5" stop-color="#7fe0ff"></stop>
        <stop offset="1" stop-color="#3fd0ff" stop-opacity="0.2"></stop>
      </linearGradient>
      <radialGradient id={`pv-red-${step}`}>
        <stop offset="0" stop-color="#ff4d6a" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#ff4d6a" stop-opacity="0"></stop>
      </radialGradient>
      <radialGradient id={`pv-glow-${step}`}>
        <stop offset="0" stop-color="#3fd0ff" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="#3fd0ff" stop-opacity="0"></stop>
      </radialGradient>
      <linearGradient id={`pv-hub-${step}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#3b82c4"></stop>
        <stop offset="1" stop-color="#173a5a"></stop>
      </linearGradient>
      <linearGradient id={`pv-pass-${step}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#2f6fa6"></stop>
        <stop offset="0.55" stop-color="#1f4d6f"></stop>
        <stop offset="1" stop-color="#14324d"></stop>
      </linearGradient>
      <linearGradient id={`pv-sheen-${step}`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0"></stop>
        <stop offset="0.5" stop-color="#fff" stop-opacity="0.22"></stop>
        <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
      </linearGradient>
      <clipPath id={`pv-passclip-${step}`}><rect x="120" y="86" width="320" height="232" rx="20"></rect></clipPath>
    </defs>

    <rect width="560" height="400" fill={`url(#pv-dots-${step})`}></rect>

    {
      step === 0 && (
        <g>
          <defs>
            <marker id="pv-arrow-0" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 Z" class="pv-arrowhead"></path>
            </marker>
            <marker id="pv-open-0" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
              <path d="M1 1 L9 5 L1 9" class="pv-openhead"></path>
            </marker>
          </defs>
          <text x="12" y="40" class="pv-kicker">Process map</text>
          <text x="12" y="64" class="pv-title">Order to invoice</text>

          {/* Two lanes: the customer, and your team */}
          <rect x="10" y="84" width="540" height="288" rx="14" class="pv-lanes"></rect>
          <line x1="10" y1="182" x2="550" y2="182" class="pv-lane-rule"></line>
          <line x1="36" y1="84" x2="36" y2="372" class="pv-lane-rule"></line>
          <text transform="translate(27 133) rotate(-90)" text-anchor="middle" class="pv-lane-name">Customer</text>
          <text transform="translate(27 277) rotate(-90)" text-anchor="middle" class="pv-lane-name">Your team</text>

          {/* Messages between the lanes */}
          <path d="M110 154 V211" class="pv-msg" marker-end="url(#pv-open-0)"></path>
          <path d="M444 213 V156" class="pv-msg" marker-end="url(#pv-open-0)"></path>

          {/* The customer's side */}
          <circle cx="52" cy="137" r="8" class="pv-event"></circle>
          <path d="M60 137 H68" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <rect x="70" y="120" width="80" height="34" rx="9" class="pv-task"></rect>
          <text x="110" y="141" text-anchor="middle" class="pv-task-text">Place order</text>
          <rect x="404" y="120" width="80" height="34" rx="9" class="pv-task"></rect>
          <text x="444" y="141" text-anchor="middle" class="pv-task-text">Get invoice</text>
          <path d="M484 137 H504" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <circle cx="514" cy="137" r="8" class="pv-event-end"></circle>

          {/* Your team's side */}
          <rect x="70" y="213" width="80" height="34" rx="9" class="pv-task"></rect>
          <text x="110" y="234" text-anchor="middle" class="pv-task-text">Order in</text>
          <path d="M150 230 H164" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <rect x="166" y="213" width="80" height="34" rx="9" class="pv-task pv-task-waste"></rect>
          <text x="206" y="234" text-anchor="middle" class="pv-task-text pv-task-text-waste">Typed in CRM</text>
          <path d="M246 230 H260" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <rect x="262" y="213" width="80" height="34" rx="9" class="pv-task pv-task-waste"></rect>
          <text x="302" y="234" text-anchor="middle" class="pv-task-text pv-task-text-waste">Typed in books</text>
          <path d="M342 230 H356" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          {/* A decision: does it need a manager's approval? */}
          <path d="M372 216 L386 230 L372 244 L358 230 Z" class="pv-gate"></path>
          <path d="M367 225 L377 235 M377 225 L367 235" class="pv-gate-x"></path>
          <path d="M386 230 H402" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <rect x="404" y="213" width="80" height="34" rx="9" class="pv-task"></rect>
          <text x="444" y="234" text-anchor="middle" class="pv-task-text">Invoice sent</text>
          <path d="M484 230 H504" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <circle cx="514" cy="230" r="8" class="pv-event-end"></circle>
          {/* The other way out of the decision */}
          <path d="M372 244 V302 Q372 310 380 310 H402" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>
          <rect x="404" y="293" width="80" height="34" rx="9" class="pv-task"></rect>
          <text x="444" y="314" text-anchor="middle" class="pv-task-text">Manager OK</text>
          <path d="M444 293 V249" class="pv-seq" marker-end="url(#pv-arrow-0)"></path>

          {/* The waste, called out */}
          <rect x="166" y="213" width="176" height="34" rx="9" class="pv-waste-glow"></rect>
          <path d="M206 249 V276 M302 249 V276" class="pv-call"></path>
          <g transform="translate(254 290)">
            <rect x="-84" y="-14" width="168" height="28" rx="14" class="pv-tag-red"></rect>
            <text x="0" y="4.5" text-anchor="middle" class="pv-tag-red-text">Same data, typed twice</text>
          </g>

          {/* The work moving through: it slows where it is done twice */}
          <circle r="4.5" class="pv-pulse">
            <animateMotion dur="5.4s" repeatCount="indefinite" path="M110 230 H444" keyPoints="0;0.17;0.69;1" keyTimes="0;0.18;0.72;1" calcMode="linear"></animateMotion>
          </circle>
        </g>
      )
    }

    {
      step === 1 && (
        <g>
          {/* The app, in its window */}
          <rect x="34" y="44" width="492" height="316" rx="18" class="pv-window"></rect>
          <rect x="34" y="44" width="492" height="316" rx="18" class="pv-window-edge"></rect>
          <circle cx="60" cy="70" r="5" class="pv-dot"></circle>
          <circle cx="77" cy="70" r="5" class="pv-dot"></circle>
          <circle cx="94" cy="70" r="5" class="pv-dot"></circle>
          <text x="118" y="75.5" class="pv-app-title">Invoice approvals</text>
          <g transform="translate(468 70)">
            <rect x="-36" y="-13" width="72" height="26" rx="13" class="pv-tag-cyan"></rect>
            <text x="0" y="4.5" text-anchor="middle" class="pv-tag-cyan-text">Day 30</text>
          </g>
          <line x1="34" y1="96" x2="526" y2="96" class="pv-hair"></line>
          <text x="62" y="126" class="pv-col">Invoice</text>
          <text x="178" y="126" class="pv-col">Supplier</text>
          <text x="372" y="126" text-anchor="end" class="pv-col">Amount</text>
          <text x="458" y="126" text-anchor="middle" class="pv-col">Status</text>
          {/* The row being worked on, moving down the list */}
          <rect x="46" y="140" width="468" height="44" rx="11" class="pv-focus"></rect>
          {rows.map((r, i) => (
            <g class="pv-row" style={`--d:${(i * 1.1 - 1.5).toFixed(1)}s`}>
              {i < 3 && <line x1="54" y1={186 + i * 48} x2="506" y2={186 + i * 48} class="pv-hair pv-hair-soft"></line>}
              <text x="62" y={167 + i * 48} class="pv-cell pv-cell-strong">{r[0]}</text>
              <text x="178" y={167 + i * 48} class="pv-cell">{r[1]}</text>
              <text x="372" y={167 + i * 48} text-anchor="end" class="pv-cell pv-cell-num">{r[2]}</text>
              <g transform={`translate(458 ${162 + i * 48})`}>
                <g class="pv-pending">
                  <rect x="-42" y="-13" width="84" height="26" rx="13" class="pv-pill-amber"></rect>
                  <text x="0" y="4.5" text-anchor="middle" class="pv-pill-amber-text">Pending</text>
                </g>
                <g class="pv-approved">
                  <rect x="-42" y="-13" width="84" height="26" rx="13" class="pv-pill-green"></rect>
                  <text x="0" y="4.5" text-anchor="middle" class="pv-pill-green-text">Approved</text>
                </g>
              </g>
            </g>
          ))}
        </g>
      )
    }

    {
      step === 2 && (
        <g transform="translate(280 200) scale(1.08) translate(-280 -196)">
          {/* Each tool feeds the hub along a line of light */}
          {tiles.map((t, i) => (
            <g>
              <line x1={t.x} y1={t.y} x2={hub.x} y2={hub.y} class="pv-track"></line>
              <line x1={t.x} y1={t.y} x2={hub.x} y2={hub.y} class="pv-flow pv-flow-in" style={`--d:${i * 0.35}s`}></line>
              <circle r="4" class="pv-pulse">
                <animateMotion dur="2.8s" begin={`${i * 0.7}s`} repeatCount="indefinite" path={`M${t.x} ${t.y} L${hub.x} ${hub.y}`}></animateMotion>
              </circle>
            </g>
          ))}
          <circle cx={hub.x} cy={hub.y} r="90" fill="url(#pv-glow-2)" class="pv-breathe"></circle>
          {tiles.map((t) => (
            <g transform={`translate(${t.x} ${t.y})`}>
              <rect x="-30" y="-30" width="60" height="60" rx="17" class="pv-tile"></rect>
              <rect x="-30" y="-30" width="60" height="60" rx="17" class="pv-tile-edge"></rect>
              {t.glyph === 'mail' && (
                <g class="pv-glyph">
                  <rect x="-13" y="-9.5" width="26" height="19" rx="3.5"></rect>
                  <path d="M-12 -7 L0 2 L12 -7"></path>
                </g>
              )}
              {t.glyph === 'ledger' && (
                <g class="pv-glyph">
                  <rect x="-11" y="-13" width="22" height="26" rx="3.5"></rect>
                  <path d="M-6 -6 H6 M-6 0 H6 M-6 6 H2"></path>
                </g>
              )}
              {t.glyph === 'card' && (
                <g class="pv-glyph">
                  <rect x="-14" y="-10" width="28" height="20" rx="3.5"></rect>
                  <circle cx="-5.5" cy="-1.5" r="3.5"></circle>
                  <path d="M-11 6.5 C-9.5 2.5 -1.5 2.5 0 6.5 M4 -3 H10 M4 2 H9"></path>
                </g>
              )}
              {t.glyph === 'cal' && (
                <g class="pv-glyph">
                  <rect x="-13" y="-11" width="26" height="24" rx="3.5"></rect>
                  <path d="M-13 -4 H13 M-6 -15 V-8 M6 -15 V-8"></path>
                  <circle cx="-5" cy="4" r="1.3" class="pv-glyph-fill"></circle>
                  <circle cx="0" cy="4" r="1.3" class="pv-glyph-fill"></circle>
                  <circle cx="5" cy="4" r="1.3" class="pv-glyph-fill"></circle>
                </g>
              )}
              <text x="0" y="50" text-anchor="middle" class="pv-label">{t.label}</text>
            </g>
          ))}
          {/* The hub: the Spockhart mark */}
          <g transform={`translate(${hub.x} ${hub.y})`}>
            <rect x="-46" y="-46" width="92" height="92" rx="26" fill="url(#pv-hub-2)" class="pv-hub"></rect>
            <rect x="-46" y="-46" width="92" height="92" rx="26" class="pv-tile-edge pv-hub-edge"></rect>
            <g transform="scale(0.17)" class="pv-mark">
              <path d={upperPath}></path>
              <path d={lowerPath}></path>
            </g>
          </g>
          {/* The team, trained to run it */}
          <text x="280" y="268" text-anchor="middle" class="pv-kicker">Your team</text>
          {team.map((m, i) => (
            <g transform={`translate(${m.x} 300)`}>
              <circle r="17" class="pv-person"></circle>
              <text x="0" y="5" text-anchor="middle" class="pv-person-i">{m.i}</text>
              <g class="pv-badge" style={`--d:${0.6 + i * 0.5}s`}>
                <circle cx="12" cy="-12" r="7.5" class="pv-badge-dot"></circle>
                <path d="M8.6 -12 L11 -9.6 L15.4 -14.2" class="pv-badge-tick"></path>
              </g>
              <text x="0" y="36" text-anchor="middle" class="pv-label pv-label-sm">{m.label}</text>
            </g>
          ))}
        </g>
      )
    }

    {
      step === 3 && (
        <g transform="translate(280 200) scale(1.12) translate(-280 -196)">
          {/* A second pass behind, for depth */}
          <rect x="150" y="62" width="300" height="214" rx="20" class="pv-pass-back" transform="rotate(-5 300 170)"></rect>
          <rect x="120" y="86" width="320" height="232" rx="20" class="pv-pass-shadow"></rect>
          <rect x="120" y="86" width="320" height="232" rx="20" fill="url(#pv-pass-3)"></rect>
          <g clip-path="url(#pv-passclip-3)">
            <rect x="-120" y="60" width="140" height="300" fill="url(#pv-sheen-3)" class="pv-sheen" transform="skewX(-18)"></rect>
          </g>
          <rect x="120" y="86" width="320" height="232" rx="20" class="pv-tile-edge pv-pass-edge"></rect>
          <g transform="translate(150 118) scale(0.095)" class="pv-mark">
            <path d={upperPath}></path>
            <path d={lowerPath}></path>
          </g>
          <text x="168" y="123" class="pv-pass-brand">Spockhart</text>
          <text x="412" y="123" text-anchor="end" class="pv-pass-kicker">Handover kit</text>
          <line x1="144" y1="144" x2="416" y2="144" class="pv-pass-rule"></line>
          {kit.map((k, i) => (
            <g transform={`translate(150 ${172 + i * 30})`} class="pv-kit" style={`--d:${0.4 + i * 0.55}s`}>
              <circle cx="0" cy="-4" r="9" class="pv-kit-ring"></circle>
              <circle cx="0" cy="-4" r="9" class="pv-kit-fill"></circle>
              <path d="M-4 -4 L-1 -1 L4.5 -7" class="pv-kit-tick"></path>
              <text x="22" y="1" class="pv-kit-text">{k}</text>
            </g>
          ))}
          <line x1="144" y1="284" x2="416" y2="284" class="pv-pass-rule"></line>
          <text x="144" y="305" class="pv-pass-kicker">Yours to run</text>
          <g transform="translate(404 299)" class="pv-key">
            <circle cx="-6" cy="0" r="6"></circle>
            <path d="M0 0 H14 M10 0 V5 M14 0 V4"></path>
          </g>
        </g>
      )
    }
  </svg>
</div>

<script>
  // With reduced motion, every scene rests on a finished frame
  function stillScenes() {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<SVGSVGElement>('[data-pv] svg').forEach((s) => {
      s.pauseAnimations();
      s.setCurrentTime(2);
    });
  }
  stillScenes();
  document.addEventListener('spockhart:view', stillScenes);
</script>

<style>
  .pv { position: relative; width: 100%; height: 100%; display: grid; place-items: center; }
  .pv svg { display: block; width: 100%; height: 100%; max-height: 100%; overflow: visible; }
  .pv text { font-family: var(--font-body); }

  .pv-kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; fill: rgb(170 195 220 / 0.6); }
  .pv-title { font-size: 17px; font-weight: 600; fill: #eef3f8; }
  .pv-label { font-size: 13px; font-weight: 500; fill: rgb(220 232 244 / 0.82); }
  .pv-label-sm { font-size: 11.5px; fill: rgb(200 216 232 / 0.65); }
  .pv-hair { stroke: rgb(255 255 255 / 0.08); stroke-width: 1; }
  .pv-hair-soft { stroke: rgb(255 255 255 / 0.05); }

  /* Lines of light */
  .pv-track { stroke: rgb(142 192 230 / 0.22); stroke-width: 2; stroke-linecap: round; }
  .pv-flow {
    stroke: #3fd0ff;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 2 12;
    filter: drop-shadow(0 0 3px rgb(63 208 255 / 0.8));
    animation: pv-flow 1.6s linear infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes pv-flow { to { stroke-dashoffset: -28; } }
  .pv-pulse { fill: #ffffff; filter: drop-shadow(0 0 4px #3fd0ff) drop-shadow(0 0 10px rgb(63 208 255 / 0.7)); }

  /* 1. The process */
  .pv-node { fill: #0c1a2a; stroke: rgb(142 192 230 / 0.7); stroke-width: 1.75; }
  .pv-node-core { fill: #cfeeff; }
  .pv-node-waste { stroke: #ff6b82; }
  .pv-node-core-waste { fill: #ff8a9c; }
  .pv-call { stroke: rgb(255 107 130 / 0.55); stroke-width: 1.25; stroke-dasharray: 3 4; }
  .pv-tag-red { fill: rgb(255 77 106 / 0.12); stroke: rgb(255 107 130 / 0.5); stroke-width: 1; }
  .pv-tag-red-text { font-size: 12.5px; font-weight: 600; fill: #ffb3bf; }
  .pv-breathe { transform-box: fill-box; transform-origin: center; animation: pv-breathe 3.2s ease-in-out infinite; }
  .pv-late { animation-delay: 0.6s; }
  @keyframes pv-breathe { 50% { opacity: 0.45; scale: 0.86; } }

  /* 1. The map */
  .pv-lanes { fill: rgb(255 255 255 / 0.025); stroke: rgb(255 255 255 / 0.12); stroke-width: 1; }
  .pv-lane-rule { stroke: rgb(255 255 255 / 0.1); stroke-width: 1; }
  .pv-lane-name { font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; fill: rgb(170 195 220 / 0.65); }
  .pv-task { fill: rgb(255 255 255 / 0.07); stroke: rgb(255 255 255 / 0.2); stroke-width: 1; }
  .pv-task-waste { fill: rgb(255 77 106 / 0.12); stroke: #ff6b82; }
  .pv-task-text { font-size: 11.5px; font-weight: 600; fill: #e6eff8; }
  .pv-task-text-waste { fill: #ffd2d9; }
  .pv-waste-glow { fill: none; stroke: rgb(255 77 106 / 0.35); stroke-width: 10; filter: blur(9px); animation: pv-glow 3.2s ease-in-out infinite; }
  @keyframes pv-glow { 50% { opacity: 0.35; } }
  .pv-seq { fill: none; stroke: rgb(170 200 230 / 0.6); stroke-width: 1.4; }
  .pv-msg { fill: none; stroke: rgb(170 200 230 / 0.5); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .pv-arrowhead { fill: rgb(170 200 230 / 0.75); }
  .pv-openhead { fill: none; stroke: rgb(170 200 230 / 0.7); stroke-width: 1.4; stroke-linejoin: round; }
  .pv-event { fill: rgb(63 208 255 / 0.16); stroke: #8fe3ff; stroke-width: 1.6; }
  .pv-event-end { fill: rgb(255 255 255 / 0.04); stroke: #eef3f8; stroke-width: 3; }
  .pv-gate { fill: rgb(63 208 255 / 0.14); stroke: #6fd6ff; stroke-width: 1.4; }
  .pv-gate-x { stroke: #bdeeff; stroke-width: 1.6; stroke-linecap: round; }

  /* 2. The app */
  .pv-window { fill: #12233a; filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.45)); }
  .pv-window-edge, .pv-tile-edge { fill: none; stroke: rgb(255 255 255 / 0.09); stroke-width: 1; }
  .pv-dot { fill: rgb(255 255 255 / 0.16); }
