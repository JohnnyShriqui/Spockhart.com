---
/** Work page hero image: each project's headline result as a hexagon that opens its details below. */
const cells = [
  { value: '$1.2B', label: 'Manufacturer’s commissions, automated', id: 'commission-automation', tone: 'navy', x: 0.5, y: 0 },
  { value: '1yr → 30min', label: 'Project feasibility assessments', id: 'project-feasibility-platform', tone: 'brand', x: 1.5, y: 0, fs: 4.1 },
  { value: '6mth → 3wk', label: 'Subcontractor financing approvals', id: 'subcontractor-financing-marketplace', tone: 'accent', x: 0, y: 1, fs: 4.1 },
  { value: '↑ $316K', label: 'Average monthly sales, 16 reps', id: 'sales-performance-system', tone: 'mist', x: 1, y: 1 },
  { value: '+$850K', label: 'Practice revenue in under a year', id: 'digital-practice-growth', tone: 'navy', x: 2, y: 1 },
  { value: '183%', label: 'Cargo per trip on the same fuel', id: 'momentum-exchange-prototype', tone: 'brand', x: 0.5, y: 2 },
  { value: 'Global', label: 'Supplier network mapped, scored and ranked', id: 'supply-chain-assessment', tone: 'accent', x: 1.5, y: 2 },
];
---

<div class="comb">
  {
    cells.map((c, i) => (
      <a href={`/work/#${c.id}`} class={`cell ${c.tone}`} style={`--x:${c.x};--y:${c.y};--i:${i}${c.fs ? `;--fs:${c.fs}` : ''}`}>
        <span class="cell-value">{c.value}</span>
        <span class="cell-label">{c.label}</span>
      </a>
    ))
  }
</div>

<style>
  /* Pointy-top hexagons in a 2-3-2 cluster. Widths are in container units so text scales with the picture. */
  .comb {
    --w: 31.6;
    --gap: 2.6;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.945;
    container-type: inline-size;
  }
  .cell {
    position: absolute;
    left: calc(var(--x) * (var(--w) + var(--gap)) * 1cqw);
    top: calc(var(--y) * (var(--w) / 0.866 * 0.75 + var(--gap) * 0.6) * 1cqw);
    width: calc(var(--w) * 1cqw);
    aspect-ratio: 0.866;
    clip-path: var(--hex);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.8cqw;
    padding: 0 3cqw;
    text-align: center;
    text-decoration: none;
    color: #fff;
    transition: transform 500ms var(--ease-out), filter 400ms var(--ease);
  }
  .cell:hover { transform: translateY(-1.2cqw); filter: brightness(1.08); }
  .brand { background: var(--brand); }
  .accent { background: var(--accent); }
  .navy { background: var(--navy); }
  .mist { background: var(--mist-1); color: var(--navy); }
  .cell-value {
    font-family: var(--font-display);
    font-size: clamp(0.875rem, calc(var(--fs, 5.4) * 1cqw), 1.875rem);
    white-space: nowrap;
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cell-label { font-size: clamp(0.625rem, 2.4cqw, 0.75rem); line-height: 1.3; opacity: 0.88; max-width: 18ch; }
  @media (prefers-reduced-motion: no-preference) {
    .cell { animation: cell-in 900ms var(--ease-out) backwards; animation-delay: calc(250ms + var(--i) * 100ms); }
    @keyframes cell-in { from { opacity: 0; transform: translateY(3cqw) scale(0.94); } to { opacity: 1; transform: none; } }
  }
</style>
