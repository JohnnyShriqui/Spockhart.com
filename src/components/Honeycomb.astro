---
/** Work page hero image: the headline results, each a hexagon linking to its case study. */
const cells = [
  { value: 'Minutes', label: 'Project assessments, down from 12+ months', href: '/work/project-feasibility-platform/', tone: 'brand', x: 0, y: 0 },
  { value: 'Weeks', label: 'Financing approvals, down from 6+ months', href: '/work/subcontractor-financing-marketplace/', tone: 'accent', x: 1, y: 0 },
  { value: '$316K', label: 'Average monthly team sales, 16 reps', href: '/work/sales-performance-system/', tone: 'navy', x: 2, y: 0 },
  { value: '$1M', label: 'Practice revenue, up from $150K', href: '/work/digital-practice-growth/', tone: 'mist', x: 0.5, y: 1 },
  { value: '3 days', label: 'A week above production target', href: '/work/production-floor-redesign/', tone: 'brand', x: 1.5, y: 1 },
  { value: '+83%', label: 'Potential cargo per trip', href: '/work/momentum-exchange-prototype/', tone: 'accent', x: 2.5, y: 1 },
];
---

<div class="comb">
  {
    cells.map((c, i) => (
      <a href={c.href} class={`cell ${c.tone}`} style={`--x:${c.x};--y:${c.y};--i:${i}`}>
        <span class="cell-value">{c.value}</span>
        <span class="cell-label">{c.label}</span>
      </a>
    ))
  }
</div>

<style>
  /* Pointy-top hexagons, 3 over 3 offset. Widths are in container units so text scales with the picture. */
  .comb {
    --w: 26.8;
    --gap: 2.4;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.57;
    container-type: inline-size;
  }
  .cell {
    position: absolute;
    left: calc(var(--x) * (var(--w) + var(--gap)) * 1cqw);
    top: calc(var(--y) * (var(--w) / 0.866 * 0.75 + var(--gap) * 0.6) * 1cqw);
    width: calc(var(--w) * 1cqw);
    aspect-ratio: 0.866;
    clip-path: var(--hex);
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.8cqw;
    padding: 0 3cqw;
    text-align: center;
    text-decoration: none;
    color: #fff;
    transition: transform 500ms var(--ease-out), filter 400ms var(--ease);
  }
  .cell:hover { transform: translateY(-1.2cqw); filter: brightness(1.08); }
  .brand { background: var(--brand); }
  .accent { background: var(--accent); }
  .navy { background: var(--navy); }
  .mist { background: var(--mist-1); color: var(--navy); }
  .cell-value {
    font-family: var(--font-display);
    font-size: clamp(1rem, 5.2cqw, 1.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cell-label { font-size: clamp(0.625rem, 2.4cqw, 0.75rem); line-height: 1.3; opacity: 0.88; max-width: 18ch; }
  @media (prefers-reduced-motion: no-preference) {
    .cell { animation: cell-in 900ms var(--ease-out) backwards; animation-delay: calc(250ms + var(--i) * 100ms); }
    @keyframes cell-in { from { opacity: 0; transform: translateY(3cqw) scale(0.94); } to { opacity: 1; transform: none; } }
  }
</style>
