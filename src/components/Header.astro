---
import Logo from './Logo.astro';
import { primaryNav, site } from '../config/site';

interface Props {
  /** The page opens on a dark hero, so the header starts in its light-on-dark colours */
  overDark?: boolean;
}
const { overDark = false } = Astro.props;
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class:list={['site-header', { 'over-dark': overDark }]} data-header>
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <Logo size={26} mark={false} />
    </a>

    <div class="header-actions">
      <nav class="nav" aria-label="Primary">
        <ul>
          {
            primaryNav.map((item, i) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  <span class="nav-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="nav-l">{item.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <a class="header-cta" href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}><span class="cta-l">Start a conversation</span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="menu-label">Menu</span>
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <nav aria-label="Mobile">
      <ul>
        {
          primaryNav.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li style={`--i:${primaryNav.length}`}>
          <a href="/contact/" aria-current={isCurrent('/contact/') ? 'page' : undefined}>Contact</a>
        </li>
      </ul>
      <p class="mobile-meta">
        <span>{site.email}</span>
        <span>{site.city}, {site.country}</span>
      </p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: env(safe-area-inset-top, 0px);
    left: 0;
    right: 0;
    z-index: 50;
    padding-top: 0.75rem;
    transition: background-color 300ms var(--ease), box-shadow 300ms var(--ease), backdrop-filter 300ms var(--ease), padding-top 300ms var(--ease);
  }
  .site-header.is-scrolled, .site-header.is-open { padding-top: 0; }
  .site-header.is-scrolled,
  .site-header.is-open {
    background: var(--header-bg);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    backdrop-filter: saturate(1.4) blur(14px);
    box-shadow: 0 1px 0 var(--rule);
  }
  /* Over a dark hero: light text, and a dark glass once the page scrolls */
  .site-header.over-dark:not(.is-open) {
    --ink: #eef3f8;
    --ink-2: #c2d0dd;
    --ink-3: #8fa1b4;
    --accent: #b9dcf5;
    --mark: #eef3f8;
    --accent-soft: #8ec0e6;
    --btn-bg: #eef3f8;
    --btn-fg: #14212f;
    --btn-bg-hover: #ffffff;
  }
  .site-header.over-dark.is-scrolled:not(.is-open) {
    background: rgb(9 17 27 / 0.55);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.07);
  }
  /* backdrop-filter would make the header the containing block for the fixed menu panel */
  /* The open menu is dark, like every page */
  .site-header.is-open {
    --ink: #eef3f8;
    --ink-2: #c2d0dd;
    --ink-3: #8fa1b4;
    --rule: rgb(255 255 255 / 0.1);
    --accent: #8ec0e6;
    --mark: #eef3f8;
    background: #0d1826;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.07);
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    height: 76px;
    transition: height 300ms var(--ease);
  }
  .is-scrolled .header-inner { height: 64px; }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    flex: none;
  }
  .brand :global(.mark) { transition: transform 900ms var(--ease-out); }
  .brand:hover :global(.mark) { transform: rotate(180deg); }

  /* Numbered links and a plain, underlined call to action, all on the right */
  .nav ul {
    display: flex;
    gap: clamp(1.75rem, 0.5rem + 2.4vw, 3.25rem);
    list-style: none;
    padding: 0;
  }
  .nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 0.4rem;
    text-decoration: none;
    color: var(--ink);
  }
  .nav-n {
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink-3);
    transition: color var(--dur) var(--ease);
  }
  .nav-l {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 2px;
    transition: background-size 360ms var(--ease);
  }
  .nav a:hover .nav-l, .nav a[aria-current='page'] .nav-l { background-size: 100% 1px; }
  .nav a:hover .nav-n, .nav a[aria-current='page'] .nav-n { color: var(--accent-soft); }

  /* Underlined exactly like the links' current-page line, so the two sit at the same height */
  .header-cta {
    display: inline-flex;
    align-items: baseline;
    padding-block: 0.4rem;
    white-space: nowrap;
    color: var(--ink);
    text-decoration: none;
  }
  .cta-l {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 2px;
    transition: background-size 200ms var(--ease);
  }
  .header-cta:hover .cta-l { background-image: linear-gradient(var(--accent), var(--accent)); background-size: 100% 2px; }

  /* Baselines line up, so the call to action sits level with the numbered links */
  .header-actions { display: flex; align-items: baseline; gap: clamp(1.75rem, 0.5rem + 2.4vw, 3.25rem); }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.2rem 0.55rem 0.6rem;
    border: 0;
    background: none;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .menu-icon { position: relative; width: 22px; height: 12px; display: inline-block; }
  .menu-icon i {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 360ms var(--ease), top 360ms var(--ease);
  }
  .menu-icon i:first-child { top: 2px; }
  .menu-icon i:last-child { top: 9px; }
  .is-open .menu-icon i:first-child { top: 5.5px; transform: rotate(45deg); }
  .is-open .menu-icon i:last-child { top: 5.5px; transform: rotate(-45deg); }

  .mobile-nav {
    position: fixed;
    top: calc(64px + env(safe-area-inset-top, 0px));
    left: 0;
    right: 0;
    bottom: 0;
    background: #0d1826;
    overflow-y: auto;
    padding-block: var(--s-6) calc(var(--s-7) + env(safe-area-inset-bottom, 0px));
    padding-left: max(var(--gutter), env(safe-area-inset-left, 0px));
    padding-right: max(var(--gutter), env(safe-area-inset-right, 0px));
  }
  .mobile-nav ul { list-style: none; padding: 0; display: grid; }
  .mobile-nav li {
    border-bottom: 1px solid var(--rule);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 400ms var(--ease-out), transform 500ms var(--ease-out);
    transition-delay: calc(var(--i) * 40ms + 60ms);
  }
  .is-open .mobile-nav li { opacity: 1; transform: none; }
  .mobile-nav a {
    display: block;
    padding-block: 1rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink);
  }
  .mobile-nav a[aria-current='page'] { color: var(--accent); }
  .mobile-meta {
    margin-top: var(--s-6);
    display: grid;
    gap: 0.25rem;
    color: var(--ink-3);
    font-size: 0.9rem;
  }

  @media (max-width: 1023px) {
    .nav, .header-cta { display: none; }
    .menu-toggle { display: inline-flex; }
    .header-inner { height: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nav li { opacity: 1; transform: none; }
  }
</style>
