---
import ResultVisual from './ResultVisual.astro';
/**
 * Home: cards in the same two groups (and colours) as the case studies. A small line icon, a name,
 * and one short line. By default, the everyday work we take on (under the section's opening line),
 * with a note that these are only examples. Given its own groups (the case studies, on phones),
 * each card links to its case study and shows an arrow.
 * Laptops: the two groups side by side, each a 2 x 2 grid, Operations Efficiency first. Phones: one card per line.
 */
interface Item {
  name: string;
  line: string;
  icon: string;
  href?: string;
  /** A case study: shown with a still of its graphic, like the case study bars on laptops */
  rv?: string;
}
interface Group {
  key: 'build' | 'fix';
  title: string;
  note: string;
  items: Item[];
}
interface Props {
  groups?: Group[];
  note?: string;
  class?: string;
}
const examples: Group[] = [
  {
    key: 'fix',
    title: 'Operations Efficiency',
    note: 'Costs down',
    items: [
      { name: 'Automated Workflows', line: 'Repetitive work, off your plate', icon: 'M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z M12 3v3 M12 18v3 M3 12h3 M18 12h3 M5.6 5.6l2.1 2.1 M16.3 16.3l2.1 2.1 M5.6 18.4l2.1-2.1 M16.3 7.7l2.1-2.1' },
      { name: 'Connected Systems', line: 'Entered once, synced everywhere', icon: 'M4 8h13l-3-3 M20 16H7l3 3' },
      { name: 'Bottleneck Removal', line: 'Delays found and designed out', icon: 'M3 4.5h18l-7 8v6l-4 2v-8z' },
      { name: 'Live Reporting', line: 'Real numbers, not spreadsheets', icon: 'M4 20h16 M7 16v-4 M12 16V7 M17 16v-7' },
    ],
  },
  {
    key: 'build',
    title: 'Revenue Development',
    note: 'Revenue up',
    items: [
      { name: 'New Digital Products', line: 'Your expertise, made sellable', icon: 'M12 3l8 4.5-8 4.5-8-4.5z M4 12l8 4.5 8-4.5 M4 16.5l8 4.5 8-4.5' },
      { name: 'Lead Generation Engines', line: 'A steady flow of qualified leads', icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6 M18 8v6 M15 11h6' },
      { name: 'Online Quoting and Ordering', line: 'Quotes and orders, online', icon: 'M7 3h7l4 4v14H7z M14 3v4h4 M10 12h5 M10 16h5' },
      { name: 'Client Platforms', line: 'Portals your clients log in to', icon: 'M3 5h18v14H3z M3 9h18 M6.5 7h.01 M9 7h.01' },
    ],
  },
];
const {
  groups = examples,
  note = 'This list is not comprehensive. If something slows your team down or holds back growth, we can build for it.',
  class: className = '',
} = Astro.props;
/* The everyday examples (not the case studies): one panel per group */
const panels = !Astro.props.groups;
---

<div class:list={['ex', className, { 'ex-panels': panels }]}>
  {
    groups.map((g) => (
      <section class:list={['ex-group', `ex-${g.key}`]} aria-label={g.title}>
        <p class="ex-head">
          <span class="ex-title">{g.title}</span>
          <span class="ex-note">{g.note}</span>
        </p>
        <ul class="ex-cards">
          {g.items.map((it) => {
            const Tag = it.href ? 'a' : 'div';
            return (
              <li>
                <Tag class:list={['ex-card', { 'ex-link': it.href }]} href={it.href}>
                  {it.rv ? (
                    <div class="ex-thumb" aria-hidden="true">
                      <div class="ex-thumb-live" data-frozen>
                        <ResultVisual id={it.rv} />
                      </div>
                    </div>
                  ) : (
                    <span class="ex-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d={it.icon} />
                      </svg>
                    </span>
                  )}
                  <span class="ex-text">
                    <span class="ex-name">{it.name}</span>
                    <span class="ex-line">{it.line}</span>
                  </span>
                  {it.href && (
                    <span class="ex-arr" aria-hidden="true">
                      →
                    </span>
                  )}
                </Tag>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
  {note && <p class="ex-more">{note}</p>}
</div>

<style>
  .ex {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 1rem + 2.5vw, 3.5rem);
    margin-bottom: clamp(5.5rem, 3.75rem + 4.75vw, 8.5rem);
  }
  .ex-build { --c: var(--hl); --c-rgb: var(--hl-rgb); }
  .ex-fix { --c: var(--warm); --c-rgb: var(--warm-rgb); }
  /* The same heads as the case study list: title, a coloured note, a firm rule */
  .ex-head { display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem; padding-bottom: 0.5rem; margin-bottom: 0.9rem; border-bottom: 1px solid var(--rule-2); }
  .ex-title { font-family: var(--font-display); font-size: 1.0625rem; color: var(--ink); }
  .ex-note { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap; color: var(--c); }

  .ex-cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 0.65rem; }
  .ex-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: center;
    /* A touch more room on top, to balance the coloured line along the top edge */
    padding: 1.1rem 1.05rem 0.9rem;
    border: 1px solid var(--bar-line, rgb(27 42 61 / 0.1));
    border-radius: var(--radius-lg);
    background: var(--bar-bg, #fff);
    box-shadow: var(--bar-shadow, none);
    overflow: hidden;
  }
  /* A fine line in the group's colour along the top of each card */
  .ex-card::before { content: ''; position: absolute; inset: 0 0 auto; height: 2px; background: var(--c); opacity: 0.85; }
  .ex-icon {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgb(var(--c-rgb) / 0.1);
  }
  .ex-icon svg { width: 19px; height: 19px; fill: none; stroke: var(--c); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ex-cards > li { display: grid; }
  /* Cards that open a case study: an arrow on the right, and a slight lift on hover */
  .ex-link { grid-template-columns: auto minmax(0, 1fr) auto; text-decoration: none; color: inherit; transition: border-color 200ms var(--ease), transform 200ms var(--ease); }
  .ex-link:hover { border-color: rgb(var(--c-rgb) / 0.45); transform: translateY(-1px); }
  .ex-arr { color: var(--c); font-size: 1rem; transition: transform 200ms var(--ease); }
  .ex-link:hover .ex-arr { transform: translateX(3px); }
  /* The examples are only examples */
  .ex-more { grid-column: 1 / -1; margin-top: 1.1rem; font-size: 0.9375rem; line-height: 1.5; color: var(--ink-2); }
  .ex-text { display: grid; gap: 0.2rem; min-width: 0; }
  .ex-name { font-family: var(--font-display); font-size: 1.0625rem; line-height: 1.25; color: var(--ink); }
  .ex-line { font-size: 0.875rem; line-height: 1.4; color: var(--ink-2); }

  @media (max-width: 1099px) {
    .ex { grid-template-columns: minmax(0, 1fr); row-gap: 2.5rem; }
  }
  /* Laptops: every card the same height in both groups */
  @media (min-width: 1100px) {
    .ex-card { min-height: 5.5rem; }
    .ex-name { font-size: 1rem; }
  }
  @media (min-width: 1100px) and (max-width: 1399px) {
    .ex-card { min-height: 6rem; }
  }
  /* Phones: one card per line, each with its icon, name and short line */
  @media (max-width: 640px) {
    .ex { row-gap: 2.25rem; margin-bottom: 4.25rem; }
    .ex-head { margin-bottom: 0.75rem; }
    .ex-cards { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; gap: 0.55rem; }
    .ex-card { padding: 1rem 0.95rem 0.8rem; gap: 0.85rem; }
    .ex-icon { width: 34px; height: 34px; }
    .ex-name { font-size: 1rem; }
    .ex-line { font-size: 0.875rem; }
  }
  /* Small phones: a little smaller, so each card keeps to two lines and they all match */
  @media (max-width: 380px) {
    .ex-card { gap: 0.7rem; padding: 0.88rem 0.8rem 0.7rem; }
    .ex-icon { width: 30px; height: 30px; }
    .ex-icon svg { width: 16px; height: 16px; }
    .ex-name { font-size: 0.9375rem; }
    .ex-line { font-size: 0.8125rem; }
    .ex-link { gap: 0.6rem; }
  }
  /* The everyday examples: one panel per group instead of eight boxes, on the same dark panel as the
     chart below. Restrained, like the chart's own frame: no glow and no motion. Each group's colour
     is a quiet, muted tone, used only for a short rule by the title, the label and the line icons.
     Inside, the examples sit in a simple grid with no boxes of their own, divided by fine rules. */
  .ex-panels .ex-fix { --tone: #d9958f; }
  .ex-panels .ex-build { --tone: #9cc8ea; }
  .ex-panels .ex-group {
    --ink: #eef3f8;
    --ink-2: #a3b3c4;
    --hair: 255 255 255;
    position: relative;
    padding: clamp(1.35rem, 1rem + 1vw, 1.85rem) clamp(1.35rem, 1rem + 1.2vw, 2.1rem) clamp(0.4rem, 0.25rem + 0.4vw, 0.7rem);
    border: 1px solid rgb(255 255 255 / 0.07);
    border-radius: var(--radius-lg);
    background: linear-gradient(165deg, #0f1d2d 0%, #0a1521 100%);
    box-shadow: 0 24px 48px -30px rgb(4 18 30 / 0.55);
    color: var(--ink);
    overflow: hidden;
  }
  .ex-panels .ex-head { margin-bottom: 0; padding-bottom: 0.9rem; border-bottom: 1px solid rgb(255 255 255 / 0.1); }
  .ex-panels .ex-title { display: inline-flex; align-items: center; gap: 0.7rem; font-size: 1.3125rem; line-height: 1.25; }
  /* A short rule in the group's tone, like the numbered list on the Nonprofits page */
  .ex-panels .ex-title::before { content: ''; width: 1.1rem; height: 1.5px; background: var(--tone); flex: none; }
  .ex-panels .ex-note { color: var(--tone); opacity: 0.9; }
  .ex-panels .ex-icon svg { stroke: var(--tone); stroke-width: 1.5; opacity: 0.9; }
  .ex-panels .ex-cards { gap: 0 clamp(1.25rem, 0.75rem + 1.5vw, 2.25rem); grid-auto-rows: auto; }
  .ex-panels .ex-card {
    min-height: 0;
    gap: 0.85rem;
    align-items: start;
    padding: 1.05rem 0;
    border: 0;
    border-radius: 0;
    background: none;
    box-shadow: none;
    overflow: visible;
  }
  .ex-panels .ex-card::before { display: none; }
  .ex-panels .ex-cards > li:nth-child(n + 3) .ex-card { border-top: 1px solid rgb(255 255 255 / 0.07); }
  .ex-panels .ex-icon { width: auto; height: auto; padding-top: 0.15rem; border-radius: 0; background: none; }
  .ex-panels .ex-icon svg { width: 20px; height: 20px; }
  @media (max-width: 640px) {
    .ex-panels .ex-cards > li:nth-child(n + 2) .ex-card { border-top: 1px solid rgb(255 255 255 / 0.07); }
    .ex-panels .ex-card { padding: 0.95rem 0; }
    .ex-panels .ex-title { font-size: 1.1875rem; }
  }
  /* Laptops: on the home page the panels sit on the same columns as the chart and case studies
     below them (set in FixBuild), so the left one is a little narrower. The examples are a step
     smaller and a little closer together, so each one keeps to one line. */
  @media (min-width: 1100px) {
    .ex-panels .ex-group { padding-inline: 1.6rem; }
    .ex-panels .ex-cards { column-gap: 1.5rem; }
    .ex-panels .ex-card { gap: 0.7rem; }
    .ex-panels .ex-name { font-size: 0.9375rem; }
    .ex-panels .ex-line { font-size: 0.84375rem; }
    .ex-panels .ex-icon svg { width: 18px; height: 18px; }
  }
  @media (min-width: 1440px) {
    .ex-panels .ex-group { padding-inline: 1.85rem; }
    .ex-panels .ex-cards { column-gap: 2rem; }
  }
  /* Small laptops: one example per row, so none of them wraps */
  @media (min-width: 1100px) and (max-width: 1279px) {
    .ex-panels .ex-cards { grid-template-columns: minmax(0, 1fr); }
    .ex-panels .ex-cards > li:nth-child(n + 2) .ex-card { border-top: 1px solid rgb(255 255 255 / 0.07); }
  }
  /* Phones: no short rule, so the title keeps to one line beside its label */
  @media (max-width: 480px) {
    .ex-panels .ex-title::before { display: none; }
  }
  @media (max-width: 380px) {
    .ex-panels .ex-icon svg { width: 18px; height: 18px; }
  }

  /* Case studies (phones): the same bars as the case study list on laptops. A still of the graphic
     on the left, the result in the display face with the rest a step quieter, a quiet arrow,
     and no coloured line. */
  .ex-bars .ex-card::before { display: none; }
  .ex-bars .ex-card { gap: 0.8rem; padding: 0.55rem 0.9rem 0.55rem 0.55rem; min-height: 5rem; }
  .ex-bars .ex-link:hover { border-color: rgb(var(--hair) / 0.22); }
  .ex-thumb { position: relative; width: 64px; height: 40px; border-radius: 4px; overflow: hidden; background: #1f4d6f; }
  .ex-thumb-live { position: absolute; left: 0; top: 0; width: 640px; transform: scale(0.1); transform-origin: 0 0; pointer-events: none; }
  .ex-thumb-live :global(.rv-split) { display: none; }
  .ex-thumb-live :global(.rv) { padding: 14px; gap: 0; }
  .ex-bars .ex-name { font-size: 1rem; }
  .ex-bars .ex-line { font-family: var(--font-display); font-size: 0.875rem; line-height: 1.3; color: var(--ink-3); }
  .ex-bars .ex-arr { color: var(--ink-3); }
  @media (max-width: 380px) {
    .ex-bars .ex-card { gap: 0.65rem; padding-right: 0.75rem; min-height: 4.7rem; }
    .ex-thumb { width: 52px; height: 34px; }
    .ex-thumb-live { transform: scale(0.08125); }
    .ex-bars .ex-name { font-size: 0.9375rem; }
    .ex-bars .ex-line { font-size: 0.8125rem; }
  }
  @media (max-width: 340px) {
    .ex-bars .ex-card { min-height: 5.9rem; }
  }
</style>
