---
/**
 * Nonprofits page: what changes, told the same way as Our Work. Each outcome is a band with
 * its words on one side and a live before-and-after graphic (ResultVisual) on the other.
 * Names, roles and numbers in the graphics are illustrations, not client data.
 */
import ResultVisual from './ResultVisual.astro';

const outcomes = [
  {
    id: 'np-mission',
    kicker: 'More mission per dollar',
    title: 'Staff hours move from paperwork back to the people you serve.',
    hl: ['paperwork', 'the people you serve'],
    body: 'The same team and the same budget deliver more of the work that matters.',
  },
  {
    id: 'np-impact',
    kicker: 'Cleaner proof of impact',
    title: 'Board and funder reports, ready whenever someone asks.',
    hl: ['ready whenever someone asks'],
    body: 'Built from the data you already collect, instead of weeks of spreadsheets.',
  },
  {
    id: 'np-outlast',
    kicker: 'Systems that outlast us',
    title: 'Documented, owned by your team, and running without heroics.',
    hl: ['owned by your team'],
    body: 'Nothing depends on one person, or on us, after we hand over.',
  },
];

/* Set the highlighted phrases in blue */
const parts = (title: string, hl: string[]) => {
  const out: { t: string; on: boolean }[] = [];
  let rest = title;
  while (rest) {
    const hits = hl.map((h) => ({ h, i: rest.indexOf(h) })).filter((x) => x.i >= 0).sort((a, b) => a.i - b.i);
    if (!hits.length) {
      out.push({ t: rest, on: false });
      break;
    }
    const { h, i } = hits[0];
    if (i) out.push({ t: rest.slice(0, i), on: false });
    out.push({ t: h, on: true });
    rest = rest.slice(i + h.length);
  }
  return out;
};
---

<section class="outcomes-section" aria-labelledby="outcomes-title">
  <div class="wrap outcomes-head" data-reveal>
    <p class="eyebrow">What changes</p>
    <h2 id="outcomes-title">The same team, with more time for the mission.</h2>
  </div>

  <ol class="outcomes">
    {
      outcomes.map((o, i) => (
        <li class:list={['o-band', { flip: i % 2 === 1 }]}>
          <div class="wrap o-grid">
            <div class="o-text" data-reveal>
              <p class="o-kicker">
                <span class="o-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="o-sep" aria-hidden="true" />
                {o.kicker}
              </p>
              <h3>{parts(o.title, o.hl).map((p) => (p.on ? <span class="hl">{p.t}</span> : p.t))}</h3>
              <p class="o-body">{o.body}</p>
            </div>
            <div class="o-visual" data-reveal>
              <ResultVisual id={o.id} />
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .outcomes-section { padding-top: var(--section); }
  .outcomes-head { display: grid; gap: var(--s-4); margin-bottom: var(--s-7); }
  .outcomes-head h2 { max-width: 20ch; }
  .outcomes { list-style: none; padding: 0; margin: 0; }

  /* Bands, like the projects on Our Work: words on one side, the graphic on the other */
  .o-band { padding-block: clamp(3.5rem, 2rem + 4.5vw, 6.5rem); border-top: 1px solid var(--rule); }
  .o-band:nth-child(odd) { background: var(--paper-2); }
  .o-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s-8); align-items: center; }
  .flip .o-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .flip .o-text { order: 2; }
  .o-text { display: grid; gap: var(--s-4); align-content: center; }
  .o-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .o-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-soft); }
  .o-text h3 { font-size: var(--step-3); line-height: 1.12; max-width: 20ch; }
  .o-text h3 .hl { color: var(--accent); }
  .o-body { color: var(--ink-2); font-size: var(--step-1); max-width: 38ch; }
  .o-visual { min-width: 0; }

  @media (max-width: 960px) {
    .o-grid, .flip .o-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .flip .o-text { order: 0; }
  }
  /* Phones: tighter, the words then the graphic */
  @media (max-width: 640px) {
    .outcomes-head { margin-bottom: var(--s-5); }
    .o-band { padding-block: 2.5rem; }
    .o-grid, .flip .o-grid { gap: var(--s-4); }
    .o-text { gap: 0.6rem; }
    .o-kicker { font-size: 0.6875rem; }
    .o-text h3 { font-size: 1.5rem; max-width: none; }
    .o-body { display: none; }
  }
</style>
