---
/**
 * Home hero, bottom right: frosted glass with work going on behind it. Cards move from one
 * column to the next, bars rise and settle, a trend line draws, a cursor moves between them and
 * small lights blink, all seen through the glass, so it is clear something is being built but
 * not what. Decorative only; still with reduced motion; hidden on small screens.
 */
const bars = [0.42, 0.66, 0.5, 0.82, 0.58, 0.74];
---

<div class="glass" aria-hidden="true">
  <div class="behind">
    <span class="g-top"></span>
    <span class="g-col g-col-1"></span>
    <span class="g-col g-col-2"></span>
    <span class="g-card c1"></span>
    <span class="g-card c2"></span>
    <span class="g-card c3"></span>
    <span class="g-card c4"></span>
    <span class="g-card c5"></span>
    <span class="g-card g-move"></span>
    <div class="g-bars">
      {bars.map((h, i) => <span class="g-bar" style={`--h:${h};--i:${i}`}></span>)}
    </div>
    <svg class="g-line" viewBox="0 0 100 40" preserveAspectRatio="none">
      <path d="M2 34 C18 32 26 26 38 24 S60 14 72 12 S90 6 98 4" pathLength="1" />
    </svg>
    <span class="g-dot d1"></span>
    <span class="g-dot d2"></span>
    <span class="g-dot d3"></span>
    <span class="g-cursor"></span>
  </div>
  <div class="pane"></div>
</div>

<style>
  .glass {
    position: absolute;
    z-index: 0;
    right: max(var(--gutter), calc((100% - var(--max)) / 2));
    bottom: clamp(3.5rem, 2rem + 8vh, 7.5rem);
    width: clamp(300px, 26vw, 420px);
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    pointer-events: none;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.5);
  }

  /* ---------- What is behind the glass ---------- */
  .behind { position: absolute; inset: 0; background: rgb(14 30 50 / 0.5); }
  .behind > *:not(.g-bars) { opacity: 0.85; }
  .behind > * { position: absolute; display: block; }
  .g-top { left: 6%; right: 6%; top: 6%; height: 6%; border-radius: 4px; background: rgb(255 255 255 / 0.16); }
  .g-col { top: 18%; height: 74%; width: 26%; border-radius: 6px; background: rgb(255 255 255 / 0.05); }
  .g-col-1 { left: 6%; }
  .g-col-2 { left: 36%; }
  .g-card { width: 22%; height: 13%; border-radius: 5px; background: rgb(226 236 246 / 0.32); }
  .c1 { left: 8%; top: 38%; }
  .c2 { left: 8%; top: 55%; }
  .c3 { left: 8%; top: 72%; background: rgb(142 192 230 / 0.4); }
  .c4 { left: 38%; top: 38%; }
  .c5 { left: 38%; top: 55%; background: rgb(111 210 157 / 0.32); }
  .g-move { left: 8%; top: 21%; background: rgb(236 244 251 / 0.5); }

  .behind > .g-bars { left: 68%; right: 6%; top: 46%; bottom: 8%; display: flex; align-items: flex-end; gap: 7%; }
  .g-bar { flex: 1; height: 100%; border-radius: 3px 3px 1px 1px; background: rgb(142 192 230 / 0.55); transform-origin: bottom; transform: scaleY(var(--h)); }
  .g-line { left: 66%; right: 5%; top: 20%; height: 22%; width: auto; overflow: visible; }
  .g-line path { fill: none; stroke: rgb(207 230 248 / 0.75); stroke-width: 2.5; vector-effect: non-scaling-stroke; stroke-linecap: round; }
  .g-dot { width: 7px; height: 7px; border-radius: 50%; background: #6fd29d; }
  .d1 { left: 28%; top: 8.2%; }
  .d2 { left: 84%; top: 8.2%; background: #8ec0e6; }
  .d3 { left: 88.5%; top: 8.2%; background: #8ec0e6; }
  .g-cursor { width: 10px; height: 10px; border-radius: 50%; background: #fff; box-shadow: 0 0 10px rgb(255 255 255 / 0.8); left: 20%; top: 30%; }

  /* ---------- The glass ---------- */
  .pane {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    -webkit-backdrop-filter: blur(10px) saturate(1.1);
    backdrop-filter: blur(10px) saturate(1.1);
    background:
      linear-gradient(115deg, rgb(255 255 255 / 0.07) 0%, rgb(255 255 255 / 0) 38%, rgb(255 255 255 / 0) 70%, rgb(255 255 255 / 0.04) 100%),
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05), inset 0 1px 0 rgb(255 255 255 / 0.09);
  }

  /* ---------- The work, always going on ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .g-move { animation: g-move 13s cubic-bezier(0.6, 0, 0.3, 1) infinite; }
    @keyframes g-move {
      0%, 12% { transform: translate(0, 0); opacity: 0; }
      18% { transform: translate(0, 0); opacity: 1; }
      34% { transform: translate(0, -2%); }
      52%, 70% { transform: translate(136%, 0); opacity: 1; }
      84%, 100% { transform: translate(136%, 0); opacity: 0; }
    }
    .g-bar { animation: g-bar 9s ease-in-out infinite; animation-delay: calc(var(--i) * -1.3s); }
    @keyframes g-bar {
      0%, 100% { transform: scaleY(var(--h)); }
      50% { transform: scaleY(calc(var(--h) * 0.55 + 0.2)); }
    }
    .g-line path { stroke-dasharray: 1 1; animation: g-line 11s ease-in-out infinite; }
    @keyframes g-line {
      0% { stroke-dashoffset: 1; opacity: 0; }
      10% { opacity: 1; }
      55%, 85% { stroke-dashoffset: 0; opacity: 1; }
      100% { stroke-dashoffset: 0; opacity: 0; }
    }
    .g-dot { animation: g-blink 3.4s ease-in-out infinite; }
    .d2 { animation-delay: -1.1s; }
    .d3 { animation-delay: -2.3s; }
    @keyframes g-blink {
      0%, 100% { opacity: 0.25; }
      50% { opacity: 1; }
    }
    .g-cursor { animation: g-cursor 13s cubic-bezier(0.6, 0, 0.3, 1) infinite; }
    @keyframes g-cursor {
      0% { transform: translate(0, 0); }
      18% { transform: translate(-20%, -40%); }
      52% { transform: translate(1150%, -40%); }
      70% { transform: translate(1150%, 300%); }
      86% { transform: translate(2500%, 250%); }
      100% { transform: translate(0, 0); }
    }
  }

  @media (max-width: 960px) {
    .glass { display: none; }
  }
</style>
