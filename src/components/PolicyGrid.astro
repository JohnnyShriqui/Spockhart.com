---
/**
 * A grid of short, plain-language commitments, used on the Security
 * page. The note slot sits underneath for contact details and dates.
 */
interface Props {
  items: { title: string; body: string }[];
}
const { items } = Astro.props;
---

<section class="section">
  <div class="wrap">
    <ul class="practices grid-3" data-reveal="stagger">
      {
        items.map((p) => (
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              <path d="M10 1 17.8 5.5 17.8 14.5 10 19 2.2 14.5 2.2 5.5Z" fill="none" stroke="currentColor" stroke-width="1.1" />
              <path d="M6.5 10.2 9 12.6l4.6-5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h2>{p.title}</h2>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
    {
      Astro.slots.has('default') && (
        <div class="policy-note" data-reveal>
          <slot />
        </div>
      )
    }
  </div>
</section>

<style>
  .practices { list-style: none; padding: 0; row-gap: var(--s-7); }
  .practices li { display: grid; gap: var(--s-3); align-content: start; padding-top: var(--s-5); border-top: 1px solid var(--rule); }
  .practices svg { width: 22px; height: 22px; color: var(--accent-soft); }
  .practices h2 { font-size: var(--step-2); }
  .practices p { font-family: var(--font-text); color: var(--ink-2); }
  .policy-note { display: grid; gap: var(--s-2); margin-top: var(--s-8); color: var(--ink-2); max-width: 60ch; }
  .policy-note :global(.updated) { font-size: 0.875rem; color: var(--ink-3); }
</style>
