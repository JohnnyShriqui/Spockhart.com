---
/**
 * Home hero, bottom right: a quiet sign of work going on in the background. Faint flow lines
 * sweep toward the corner and small points of light travel along them, at different speeds,
 * forever. It fades out on every side, so it has no edges and no meaning to read.
 * Decorative only; still with reduced motion.
 */
const W = 1000;
const H = 700;
const LINES = 16;
const lines = Array.from({ length: LINES }, (_, k) => {
  const t = k / (LINES - 1);
  const y0 = 120 + t * 420;
  const y1 = 380 + t * 300;
  const bow = 60 + 40 * Math.sin(k * 1.7);
  return `M-40 ${y0.toFixed(1)} C${(W * 0.32).toFixed(1)} ${(y0 - bow).toFixed(1)} ${(W * 0.62).toFixed(1)} ${(y1 + bow * 0.6).toFixed(1)} ${W + 40} ${y1.toFixed(1)}`;
});
/* Which lines carry light, how long each trip takes, and where in its trip each starts */
const movers = [
  { line: 2, dur: 17, at: 0.1 },
  { line: 4, dur: 22, at: 0.55 },
  { line: 5, dur: 14, at: 0.3 },
  { line: 7, dur: 19, at: 0.8 },
  { line: 8, dur: 25, at: 0.05 },
  { line: 10, dur: 16, at: 0.65 },
  { line: 11, dur: 21, at: 0.35 },
  { line: 13, dur: 18, at: 0.9 },
  { line: 14, dur: 27, at: 0.45 },
  { line: 7, dur: 23, at: 0.2 },
  { line: 10, dur: 29, at: 0.15 },
];
---

<div class="flow" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice">
    {lines.map((d, k) => <path id={`flow-${k}`} d={d} class="flow-line" style={`--o:${(0.05 + 0.05 * Math.sin(k * 0.9) ** 2).toFixed(3)}`} />)}
    <g class="flow-movers">
      {
        movers.map((m) => (
          <circle r="2" class="flow-dot">
            <animateMotion dur={`${m.dur}s`} begin={`-${(m.dur * m.at).toFixed(1)}s`} repeatCount="indefinite" rotate="auto">
              <mpath href={`#flow-${m.line}`} />
            </animateMotion>
            <animate attributeName="opacity" values="0;0.85;0.85;0" keyTimes="0;0.15;0.8;1" dur={`${m.dur}s`} begin={`-${(m.dur * m.at).toFixed(1)}s`} repeatCount="indefinite" />
          </circle>
        ))
      }
    </g>
  </svg>
</div>

<style>
  .flow {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(62%, 980px);
    height: 78%;
    z-index: 0;
    pointer-events: none;
    /* Fades out on every side: no edges */
    -webkit-mask-image: radial-gradient(ellipse 62% 58% at 68% 66%, #000 0%, rgb(0 0 0 / 0.6) 40%, transparent 78%);
    mask-image: radial-gradient(ellipse 62% 58% at 68% 66%, #000 0%, rgb(0 0 0 / 0.6) 40%, transparent 78%);
  }
  .flow svg { width: 100%; height: 100%; display: block; }
  .flow-line { fill: none; stroke: #8ec0e6; stroke-width: 1; opacity: var(--o); vector-effect: non-scaling-stroke; }
  .flow-dot { fill: #cfe6f8; filter: drop-shadow(0 0 4px rgb(142 192 230 / 0.9)); }
  /* The lines drift very slowly, so the field itself breathes */
  @media (prefers-reduced-motion: no-preference) {
    .flow svg { animation: flow-drift 38s ease-in-out infinite alternate; }
    @keyframes flow-drift {
      from { transform: translate3d(0, 0, 0) scale(1); }
      to { transform: translate3d(-2.5%, -1.5%, 0) scale(1.04); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-movers { display: none; }
  }
  @media (max-width: 640px) {
    .flow { width: 100%; height: 60%; opacity: 0.7; }
  }
</style>
