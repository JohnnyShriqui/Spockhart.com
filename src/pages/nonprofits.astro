---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import GapChart from '../components/GapChart.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import NonprofitOutcomes from '../components/NonprofitOutcomes.astro';


---

<Base
  title="Nonprofits"
  description="Every nonprofit faces the same fundamental challenge: unlimited demand on limited resources. Spockhart closes that gap by taking tedious, repetitive tasks off your team."
>
  <PageHero
    eyebrow="Nonprofits"
    title="Engineering nonprofit impact."
    lead="Every nonprofit faces the same fundamental challenge: unlimited demand on limited resources. We exist to close that gap."
  >
    <div class="btn-row">
      <a class="btn" href="/contact/">Start a conversation <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <GapChart slot="figure" />
  </PageHero>

  <NonprofitOutcomes />

  <ClosingCTA
    title="Let’s close the gap."
    body="Tell us where your team’s time goes. We’ll show you how much of it could go back to the mission."
  />
</Base>
