---
import Base from '../layouts/Base.astro';
import Horizon from '../components/Horizon.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import NonprofitImpact from '../components/NonprofitImpact.astro';
---

<Base
  title="Nonprofits"
  description="Every nonprofit faces the same fundamental challenge: unlimited demand on limited resources. Spockhart closes that gap by taking tedious, repetitive tasks off your team."
>
  <!-- The horizon: night to day as the gap between demand and resources closes, then the light
       room the rest of the page sits in -->
  <Horizon
    setup="Every nonprofit faces the same fundamental challenge:"
    title={'Unlimited\u00A0demand on\u00A0limited resources.'}
  />

  <div class="page-body body-nonprofit room-light" data-body>
    <NonprofitImpact />

    <ClosingCTA
      terse
      title="Let’s close the gap."
    />
  </div>
</Base>
