---
import Base from '../layouts/Base.astro';
import Mist from '../components/Mist.astro';
import Calculator from '../components/Calculator.astro';
import FixBuild from '../components/FixBuild.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';

---

<Base>
  <section class="hero hero-dark theme-home" data-hero-dark>
    <Mist />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="load-in" style="--i:1">We optimize <em class="display-em">operations.</em></h1>
        <div class="accent-rule load-in" style="--i:2"></div>
        <p class="lead load-in" style="--i:2">
          Spockhart works alongside your team to optimize existing processes, automate repetitive tasks, and develop new capabilities.
          Within {site.offer.prototypeDays} days, you’ll have a working first version.
        </p>
        <div class="btn-row load-in" style="--i:3">
          <a class="btn" href="/contact/">Start a conversation <span class="arr" aria-hidden="true">→</span></a>
        </div>
      </div>

    </div>

  </section>


  <FixBuild />

  <Calculator />

  <ClosingCTA terse />
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 5rem + 6vw, 10rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero > .wrap { position: relative; z-index: 1; }
  /* Laptops: the hero fills the screen, its content centred below the header */
  @media (min-width: 961px) {
    .hero {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      align-items: center;
      padding-top: calc(76px + clamp(1.5rem, 1rem + 2vw, 3rem));
      padding-bottom: clamp(2.5rem, 1.5rem + 2vw, 4rem);
    }
    .hero > .wrap { width: 100%; }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  .hero-copy { display: grid; gap: var(--s-5); justify-items: start; }
  .hero-copy h1 { font-size: clamp(3rem, 1.6rem + 6vw, 6.75rem); max-width: 10ch; }
  .hero-copy .lead { max-width: 48ch; }
  .hero-copy .btn-row { margin-top: var(--s-3); }
</style>
