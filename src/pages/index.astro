---
import Base from '../layouts/Base.astro';
import Mist from '../components/Mist.astro';
import Aura from '../components/Aura.astro';
import HeroLive from '../components/HeroLive.astro';
import Calculator from '../components/Calculator.astro';
import FixBuild from '../components/FixBuild.astro';
import ClosingCTA from '../components/ClosingCTA.astro';

---

<Base>
  <section class="hero hero-dark theme-home" data-hero-dark>
    <Mist />
    <HeroLive />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="load-in" style="--i:1">We optimize <em class="display-em">operations.</em></h1>
        <div class="accent-rule load-in" style="--i:2"></div>
      </div>

    </div>

  </section>


  <!-- The page carries on in the hero's deep blue -->
  <div class="page-dark dark-home" data-dark-page>
    <Aura span={4} />
    <FixBuild />

    <Calculator />

    <ClosingCTA terse />
  </div>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 5rem + 6vw, 10rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero > .wrap { position: relative; z-index: 1; }
  /* Laptops: the hero fills the screen, its content centred below the header */
  @media (min-width: 961px) {
    .hero {
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      align-items: center;
      /* The headline sits a little above the middle of the screen */
      padding-top: calc(88px + clamp(1.5rem, 1rem + 2vw, 3rem));
      padding-bottom: clamp(7rem, 3rem + 14vh, 13rem);
    }
    .hero > .wrap { width: 100%; }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  .hero-copy { display: grid; gap: var(--s-5); justify-items: start; }
  .hero-copy h1 { font-size: clamp(3rem, 1.6rem + 6vw, 6.75rem); max-width: 10ch; }
</style>
