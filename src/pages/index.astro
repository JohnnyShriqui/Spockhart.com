---
import Base from '../layouts/Base.astro';
import Mist from '../components/Mist.astro';
import HeroLive from '../components/HeroLive.astro';
import Calculator from '../components/Calculator.astro';
import FixBuild from '../components/FixBuild.astro';
import ClosingCTA from '../components/ClosingCTA.astro';

---

<Base>
  <section class="hero hero-dark theme-home" data-hero-dark>
    <Mist />
    <HeroLive />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="load-in" style="--i:1">We optimize <em class="display-em">operations.</em></h1>
        <div class="accent-rule load-in" style="--i:2"></div>
      </div>
    </div>
    <!-- Frosted glass that settles over the hero as the page slides up over it -->
    <div class="hero-frost" aria-hidden="true"></div>
  </section>


  <!-- The rest of the page: one light room that rises over the hero like a sheet -->
  <div class="page-body body-home room-light" data-body>
    <FixBuild />

    <Calculator />

    <ClosingCTA terse card />
  </div>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 5rem + 6vw, 10rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero > .wrap { position: relative; z-index: 1; }
  /* Every screen size: the hero fills the screen (the visible part, on phones, with the browser
     bars showing), its content centred below the header */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    /* The headline sits a little above the middle of the screen */
    padding-top: calc(72px + clamp(1rem, 0.5rem + 2vw, 3rem));
    padding-bottom: clamp(5rem, 2rem + 14vh, 13rem);
  }
  .hero > .wrap { width: 100%; }
  @media (min-width: 961px) {
    .hero { padding-top: calc(88px + clamp(1.5rem, 1rem + 2vw, 3rem)); }
  }
  /* Phones and tablets: the headline is centred in the space above the corner graphic */
  @media (max-width: 960px) {
    .hero { padding-bottom: calc(clamp(2.5rem, 1.5rem + 5vh, 5rem) + 12.5rem); }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  /* The hero holds still while the rest of the page slides up over it, and frosts over as it
     goes: the frost fades in with how far the page has been scrolled (set below) */
  .hero { position: sticky; top: 0; z-index: 0; }
  .hero-frost {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: rgb(12 23 36 / calc(var(--frost, 0) * 0.3));
  }
  /* The blur itself deepens as the page scrolls, so the hero goes soft rather than fading. It is
     only switched on once the page has moved: phone browsers stop redrawing what sits under a
     blur, which froze the moving graphic in the corner while the page was at the top. */
  .hero.is-frosting .hero-frost {
    -webkit-backdrop-filter: blur(calc(var(--frost, 0) * 24px)) saturate(calc(1 + var(--frost, 0) * 0.15));
    backdrop-filter: blur(calc(var(--frost, 0) * 24px)) saturate(calc(1 + var(--frost, 0) * 0.15));
  }
  .hero-copy { display: grid; gap: var(--s-5); justify-items: start; }
  .hero-copy h1 { font-size: clamp(3rem, 1.6rem + 6vw, 6.75rem); max-width: 10ch; }
</style>

<style is:global>
  /* The page below the home hero is one light sheet between two dark rooms: it rides up over the
     hero, rounded at the top with its top edge catching the light, and its rounded bottom
     overlaps the footer a little, so the footer shows in its corners */
  .body-home {
    --sheet-r: 32px;
    z-index: 1;
    border-radius: var(--sheet-r);
    margin-bottom: calc(var(--sheet-r) * -1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), 0 -28px 60px -24px rgb(0 0 0 / 0.5), 0 28px 60px -24px rgb(0 0 0 / 0.5);
  }
  .body-home.room-light::after { border-radius: inherit; }

  /* ==========================================================================
     Flow: the page is not one centred column of blocks. It zigzags down the room, each thing
     stepping to the other side of the last and some reaching past the column's edges, and the
     cards nearer to you pass by a little faster as you scroll (data-depth).
     ========================================================================== */
  .body-home {
    /* How far a card may reach past the column, keeping 2.5rem clear of the screen's edge */
    --bleed: clamp(0px, max(var(--gutter), (100vw - var(--max)) / 2) - 2.5rem, 4rem);
  }
  @media (min-width: 1100px) {
    /* The two example panels step down from left to right, the second reaching past the column;
       the note sits under the first */
    .body-home .ex-panels { align-items: start; }
    .body-home .ex-panels > .ex-slot:nth-child(2) {
      top: clamp(4.5rem, 1rem + 5vw, 7.5rem);
      margin-right: calc(var(--bleed) * -1);
    }
    .body-home .ex-panels .ex-more { grid-column: 1; max-width: 30em; }
    /* The calculator steps in from the left and reaches past the column on the right */
    .body-home .calc-stand { margin-left: 12%; margin-right: calc(var(--bleed) * -1); }
    /* The closing card steps back to the left: it reaches past the column's left edge and stops
       short of its right one */
    .body-home .closing-stand { margin-left: calc(var(--bleed) * -1); margin-right: clamp(2rem, 14vw - 6rem, 9rem); }
  }
  /* Tablets: the panels, one above the other, step from side to side */
  @media (min-width: 700px) and (max-width: 1099px) {
    .body-home .ex-panels > .ex-slot:nth-child(1) { margin-right: 8%; }
    .body-home .ex-panels > .ex-slot:nth-child(2) { margin-left: 8%; }
  }
  @media (max-width: 640px) {
    .body-home { --sheet-r: 22px; }
  }
</style>

<script>
  function initFrost() {
    const hero = document.querySelector<HTMLElement>('.theme-home');
    if (!hero || hero.dataset.frost) return;
    hero.dataset.frost = '1';
    let ticking = false;
    const update = () => {
      ticking = false;
      const f = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.75)));
      hero.style.setProperty('--frost', f.toFixed(3));
      hero.classList.toggle('is-frosting', f > 0.01);
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', update, { passive: true });
  }
  initFrost();
  document.addEventListener('spockhart:view', initFrost);
</script>
