---
import Base from '../layouts/Base.astro';
import Mist from '../components/Mist.astro';
import HeroLive from '../components/HeroLive.astro';
import Calculator from '../components/Calculator.astro';
import FixBuild from '../components/FixBuild.astro';
import ClosingCTA from '../components/ClosingCTA.astro';

---

<Base>
  <section class="hero hero-dark theme-home" data-hero-dark>
    <Mist />
    <HeroLive />
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="load-in" style="--i:1">We optimize <em class="display-em">operations.</em></h1>
        <div class="accent-rule load-in" style="--i:2"></div>
      </div>
    </div>
    <!-- Frosted glass that settles over the hero as the page slides up over it -->
    <div class="hero-frost" aria-hidden="true"></div>
  </section>


  <!-- The page carries on in the hero's deep blue -->
  <div class="page-body body-home" data-body>
    <FixBuild />

    <Calculator />

    <ClosingCTA terse />
  </div>
</Base>

<style>
  .hero {
    position: relative;
    padding-top: clamp(7.5rem, 5rem + 6vw, 10rem);
    padding-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero > .wrap { position: relative; z-index: 1; }
  /* Every screen size: the hero fills the screen (the visible part, on phones, with the browser
     bars showing), its content centred below the header */
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    /* The headline sits a little above the middle of the screen */
    padding-top: calc(72px + clamp(1rem, 0.5rem + 2vw, 3rem));
    padding-bottom: clamp(5rem, 2rem + 14vh, 13rem);
  }
  .hero > .wrap { width: 100%; }
  @media (min-width: 961px) {
    .hero { padding-top: calc(88px + clamp(1.5rem, 1rem + 2vw, 3rem)); }
  }
  /* Phones and tablets: the headline is centred in the space above the corner graphic */
  @media (max-width: 960px) {
    .hero { padding-bottom: calc(clamp(2.5rem, 1.5rem + 5vh, 5rem) + 12.5rem); }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
  }
  /* The hero holds still while the rest of the page slides up over it, and frosts over as it
     goes: the frost fades in with how far the page has been scrolled (set below) */
  .hero { position: sticky; top: 0; z-index: 0; }
  .hero-frost {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: rgb(12 23 36 / calc(var(--frost, 0) * 0.3));
  }
  /* The blur itself deepens as the page scrolls, so the hero goes soft rather than fading. It is
     only switched on once the page has moved: phone browsers stop redrawing what sits under a
     blur, which froze the moving graphic in the corner while the page was at the top. */
  .hero.is-frosting .hero-frost {
    -webkit-backdrop-filter: blur(calc(var(--frost, 0) * 24px)) saturate(calc(1 + var(--frost, 0) * 0.15));
    backdrop-filter: blur(calc(var(--frost, 0) * 24px)) saturate(calc(1 + var(--frost, 0) * 0.15));
  }
  .hero-copy { display: grid; gap: var(--s-5); justify-items: start; }
  .hero-copy h1 { font-size: clamp(3rem, 1.6rem + 6vw, 6.75rem); max-width: 10ch; }
</style>

<style is:global>
  /* The page below the home hero rides over it, with a soft shadow along its top edge */
  .body-home { z-index: 1; box-shadow: 0 -28px 60px -24px rgb(0 0 0 / 0.5); }
</style>

<script>
  function initFrost() {
    const hero = document.querySelector<HTMLElement>('.theme-home');
    if (!hero || hero.dataset.frost) return;
    hero.dataset.frost = '1';
    let ticking = false;
    const update = () => {
      ticking = false;
      const f = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.75)));
      hero.style.setProperty('--frost', f.toFixed(3));
      hero.classList.toggle('is-frosting', f > 0.01);
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', update, { passive: true });
  }
  initFrost();
  document.addEventListener('spockhart:view', initFrost);
</script>
