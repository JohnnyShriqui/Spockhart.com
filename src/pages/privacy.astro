---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PolicyGrid from '../components/PolicyGrid.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';

const updated = 'November 7, 2026';

const points = [
  {
    title: 'Only what you send us',
    body: 'When you use our contact form or email us, we receive what you choose to share: usually your name, email, organization, role and message.',
  },
  {
    title: 'Your numbers stay with you',
    body: 'The calculator runs in your browser. We never see what you enter unless you include the result in a message to us.',
  },
  {
    title: 'No tracking cookies',
    body: 'If we measure visits, we use a privacy-focused service that counts them without cookies and without identifying you.',
  },
  {
    title: 'Used only to reply',
    body: 'We use your information to respond, to discuss working together and to keep a record of our conversation. We never sell it or use it for advertising, and we delete it once we no longer need it.',
  },
  {
    title: 'Shared only to run the site',
    body: 'The providers behind our website, forms and email can use your information only to provide their services to us, and some may store it outside Canada. We disclose it otherwise only where the law requires.',
  },
  {
    title: 'Your rights under Canadian law',
    body: 'Under PIPEDA, you can ask to see the information we hold about you, correct it, or withdraw your consent. We respond within 30 days.',
  },
];
---

<Base title="Privacy policy" description="How Spockhart collects, uses and protects personal information submitted through spockhart.com.">
  <PageHero
    eyebrow="Privacy"
    title="We collect very little."
    lead="What we collect through this website, why we collect it, and the choices you have."
  />
  <PolicyGrid items={points}>
    <p>
      This website is operated by {site.legalName}, based in {site.city}, {site.region}. Questions about your information?
      Email <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <p class="updated">Last updated {updated}. If this policy changes, we will update this date.</p>
  </PolicyGrid>
  <ClosingCTA />
</Base>
