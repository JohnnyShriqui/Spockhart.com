---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Mist from '../components/Mist.astro';
---

<Base title="Page not found" noindex>
  <section class="nf hero-dark theme-quiet" data-hero-dark>
    <Mist />
    <div class="wrap nf-inner">
      <div class="load-in" style="--i:0"><Mark size={84} tone="brand" assemble tilt /></div>
      <h1 class="load-in" style="--i:2">This page is not here.</h1>
      <p class="lead load-in" style="--i:3">The link may be old, or the address may have a typo.</p>
      <div class="btn-row load-in" style="--i:4">
        <a class="btn" href="/">Go to the home page <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-top: clamp(9rem, 6rem + 8vw, 13rem); padding-bottom: var(--section); }
  .nf-inner { display: grid; gap: var(--s-5); justify-items: start; }
  .nf h1 { font-size: var(--step-5); max-width: 14ch; }
</style>
