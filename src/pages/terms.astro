---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PolicyGrid from '../components/PolicyGrid.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';

const updated = 'November 7, 2026';

const points = [
  {
    title: 'Using this site',
    body: 'By using spockhart.com, you agree to these terms. If you do not agree, please do not use the site.',
  },
  {
    title: 'Information, not advice',
    body: 'Everything here, including the case studies and the calculator, is general information. It is not professional, financial or legal advice and does not create a client relationship. Calculator results are estimates based on the figures you enter.',
  },
  {
    title: 'Our team’s experience',
    body: 'Projects on Our Work were delivered by members of our team in previous or current roles at other organizations. They are not Spockhart engagements, and client names are withheld.',
  },
  {
    title: 'Our content',
    body: `The text, design, graphics and code of this site belong to ${site.legalName}. Share links to any page freely, but please do not copy or republish our content without permission.`,
  },
  {
    title: 'Provided as is',
    body: `To the extent the law allows, ${site.legalName} is not liable for any loss from using this site or relying on its content, or for the content of websites we link to.`,
  },
  {
    title: `${site.region} law`,
    body: `These terms are governed by the laws of the Province of ${site.region} and the federal laws of ${site.country} that apply there.`,
  },
];
---

<Base title="Terms of use" description="Terms of use for spockhart.com.">
  <PageHero eyebrow="Terms of use" title="Terms, in plain language." lead="The terms that apply when you use this website." />
  <PolicyGrid items={points}>
    <p>
      Questions about these terms? Email <a class="link" href={`mailto:${site.email}`}>{site.email}</a>.
    </p>
    <p class="updated">Last updated {updated}.</p>
  </PolicyGrid>
  <ClosingCTA />
</Base>
