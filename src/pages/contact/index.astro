---
import Base from '../../layouts/Base.astro';
import CopyEmail from '../../components/CopyEmail.astro';
import Logo from '../../components/Logo.astro';
import { site } from '../../config/site';
---

<Base title="Contact" description="Start a conversation with Spockhart. Tell us what your team could accomplish with more time and we will reply within one business day." lightHero>
  <!-- A light room, like every other page; the form is the one dark card in it, standing in a pool
       of light, and the ways to reach us directly are small raised chips beside it -->
  <div class="page-body body-contact room-light" data-body>
  <section class="contact">
    <div class="wrap contact-grid">
      <div class="contact-intro">
        <h1 class="load-in" style="--i:1">Start a conversation.</h1>
        <p class="lead load-in" style="--i:2">Tell us what your team could accomplish with more time. We reply within {site.offer.replyWithin}.</p>

        <div class="load-in contact-direct" style="--i:3">
          <div class="direct-options">
            <div class="direct-option">
              <p class="label">Email</p>
              <CopyEmail tilt />
            </div>
            <div class="direct-option">
              <p class="label">Phone</p>
              <CopyEmail value={site.phone} tilt />
            </div>
          </div>
          <p class="small muted">{site.city}, {site.country}</p>
        </div>
      </div>

      <div class="contact-stand stand lit load-in" style="--i:2">
      <div class="contact-form-wrap contact-card" data-tilt="3" data-tilt-depth="2200" data-tilt-focus="still">
        <div class="letterhead" aria-hidden="true">
          <Logo mark={false} />
          <span class="lh-meta">{site.city}, {site.country}</span>
        </div>
        <form class="contact-form" data-contact-form data-endpoint={site.formEndpoint} data-key={site.formAccessKey} novalidate>
          <div class="row-2">
            <div class="field">
              <label for="cf-name">Name</label>
              <input class="input" id="cf-name" name="name" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="cf-email">Work email</label>
              <input class="input" id="cf-email" name="email" type="email" autocomplete="email" required />
            </div>
          </div>
          <div class="row-2 row-org">
            <div class="field">
              <label for="cf-org">Organization</label>
              <input class="input" id="cf-org" name="organization" autocomplete="organization" required />
            </div>
            <div class="field">
              <label for="cf-size">Team size</label>
              <select class="select" id="cf-size" name="size">
                <option value="1-10">1 to 10</option>
                <option value="11-50" selected>11 to 50</option>
                <option value="51-200">51 to 200</option>
                <option value="201-1000">201 to 1,000</option>
                <option value="1000+">1,000+</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="cf-message">What could your team accomplish with more time?</label>
            <textarea
              class="textarea"
              id="cf-message"
              name="message"
              rows="3"
              required
              placeholder="A sentence or two is plenty."
            ></textarea>
          </div>
          <input type="hidden" id="cf-type" name="type" value="" />
          <input type="hidden" id="cf-estimate" name="estimate" value="" />
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="form-foot">
            <button class="btn" type="submit" data-submit>
              <span data-submit-label>Send</span> <span class="arr" aria-hidden="true">→</span>
            </button>
            <p class="small muted">We use your details only to reply.</p>
          </div>
          <p class="form-error" role="alert" data-form-error hidden></p>
        </form>

        <div class="compose" data-compose hidden>
          <p class="eyebrow">Almost there</p>
          <h2>Send this to {site.email}</h2>
          <p class="muted">Your message is ready. Send it from your email and we will reply within {site.offer.replyWithin}.</p>
          <pre class="compose-body" data-compose-body></pre>
          <div class="btn-row">
            <a class="btn" data-compose-mail href={`mailto:${site.email}`}>Open in email <span class="arr" aria-hidden="true">→</span></a>
            <button class="btn btn-ghost" type="button" data-compose-copy>Copy message</button>
          </div>
        </div>
      </div>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  import { initContactForm } from '../../scripts/contact';
  initContactForm();
</script>

<style>
  .contact {
    padding-top: clamp(7rem, 4.5rem + 5vw, 10rem);
    padding-bottom: var(--section);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: start;
  }
  .contact-intro { display: grid; gap: var(--s-5); align-content: start; }
  .contact-intro h1 { font-size: var(--step-5); max-width: 9ch; }
  .contact-direct { display: grid; gap: var(--s-4); justify-items: start; margin-top: var(--s-4); }
  /* Email and phone side by side, each with its own label; they stack when there is no room */
  .direct-options { display: flex; flex-wrap: wrap; gap: var(--s-5) var(--s-6); }
  .direct-option { display: grid; gap: var(--s-3); justify-items: start; }
  .label { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); }

  .contact-form-wrap {
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .contact-form { display: grid; gap: var(--s-4); }
  .row-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4); }
  .row-org { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .contact-form .textarea { min-height: 6.5rem; }
  .optional { font-weight: 400; color: var(--ink-3); margin-left: 0.35rem; font-size: 0.8125rem; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .form-foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4); }
  .form-foot .small { max-width: 34ch; }
  .form-error { color: #b4483c; font-size: 0.9375rem; }
  .btn[aria-busy='true'] { opacity: 0.7; pointer-events: none; }

  .compose { display: grid; gap: var(--s-4); }
  .compose h2 { font-size: var(--step-3); }
  .compose-body {
    white-space: pre-wrap;
    word-break: break-word;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.6;
    padding: var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    max-height: 22rem;
    overflow: auto;
  }

  /* Tablets and phones: the heading, then the form, then the email option */
  @media (max-width: 960px) {
    .contact { padding-top: clamp(6.5rem, 5rem + 4vw, 8.5rem); }
    .contact-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
    .contact-intro { display: contents; }
    .contact-intro h1 { font-size: clamp(2.25rem, 1.6rem + 3vw, 3.5rem); max-width: none; }
    .contact-form-wrap { order: 1; margin-top: var(--s-2); }
    .contact-direct { order: 2; margin-top: var(--s-4); }
  }
  /* Phones: name and email stay side by side; organization and size share a row */
  @media (max-width: 560px) {
    .contact-form { gap: 0.85rem; }
    .row-2 { gap: 0.6rem; }
    .contact-form .field { gap: 0.3rem; }
    .contact-form label { font-size: 0.8125rem; }
    .contact-form .input, .contact-form .select { padding-block: 0.6rem; }
    .contact-form .textarea { min-height: 5.5rem; }
    .form-foot { gap: var(--s-3); }
  }

  /* ==========================================================================
     The room and the card. The page is a light room; the form is a midnight card standing in a
     pool of light on the wall, lifted off the floor, its letterhead and its fields written in
     light. It leans under the pointer like every card, and holds still while you write in it.
     ========================================================================== */
  .contact-intro h1 { color: #1b2a3d; }
  .contact-intro .lead { color: #4a5d72; }
  .contact-stand { position: relative; }
  .contact-stand.lit::after { inset: -14% -10%; }

  .contact-card {
    --ink: #eef3f8;
    --ink-2: #b5c4d3;
    --ink-3: #8fa1b4;
    --rule: rgb(255 255 255 / 0.12);
    --rule-2: rgb(255 255 255 / 0.24);
    --accent: #8ec0e6;
    --accent-soft: #8ec0e6;
    --btn-bg: #eef3f8;
    --btn-fg: #14212f;
    --btn-bg-hover: #ffffff;
    --paper: rgb(255 255 255 / 0.05);
    --selection: rgb(142 192 230 / 0.3);
    position: relative;
    isolation: isolate;
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem) clamp(1.5rem, 1rem + 2.4vw, 3rem);
    border: 0;
    border-radius: 24px;
    color: var(--ink);
    color-scheme: dark;
    background:
      radial-gradient(60% 70% at 0% 0%, rgb(46 104 152 / 0.45), transparent 70%),
      radial-gradient(50% 60% at 100% 100%, rgb(38 96 142 / 0.28), transparent 72%),
      linear-gradient(165deg, #0e1d2e 0%, #0a1521 100%);
    box-shadow: var(--lift-dark);
  }
  /* A fine grain, so the dark reads as a material rather than a flat fill */
  .contact-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 200px;
    opacity: 0.1;
    mix-blend-mode: overlay;
  }

  /* The letterhead: the wordmark and where we are, over a fine rule */
  .letterhead {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding-bottom: 1rem;
    margin-bottom: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .letterhead :global(.logo) { color: #eef3f8; }
  .lh-meta { font-size: 0.6875rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #8fa1b4; }

  /* The fields, written in light: a line under each, which glows blue while you write on it,
     and ruled lines for the message */
  .contact-card .field label { color: #c9d6e2; }
  .contact-card :is(.input, .select, .textarea) {
    padding-inline: 0;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 0;
    background-color: transparent;
    box-shadow: none;
    color: #eef3f8;
    caret-color: #8ec0e6;
  }
  .contact-card :is(.input, .textarea)::placeholder { color: #6f849a; }
  .contact-card .select {
    padding-right: 1.75rem;
    background-image: linear-gradient(45deg, transparent 50%, #b5c4d3 50%), linear-gradient(135deg, #b5c4d3 50%, transparent 50%);
    background-position: calc(100% - 0.6rem) 55%, calc(100% - 0.25rem) 55%;
  }
  .contact-card .select option { color: #14212f; background: #eef3f8; }
  .contact-card :is(.input, .select, .textarea):hover { border-bottom-color: rgb(255 255 255 / 0.4); }
  .contact-card :is(.input, .select):focus {
    border-bottom-color: #8ec0e6;
    box-shadow: 0 1px 0 #8ec0e6, 0 8px 14px -10px rgb(63 208 255 / 0.55);
  }
  .contact-card .textarea {
    padding-top: 0.15rem;
    line-height: 2rem;
    border-bottom: 0;
    background-image: repeating-linear-gradient(180deg, rgb(255 255 255 / 0) 0, rgb(255 255 255 / 0) calc(2rem - 1px), rgb(255 255 255 / 0.12) calc(2rem - 1px), rgb(255 255 255 / 0.12) 2rem);
    background-attachment: local;
  }
  .contact-card .textarea:focus {
    box-shadow: none;
    background-image: repeating-linear-gradient(180deg, rgb(255 255 255 / 0) 0, rgb(255 255 255 / 0) calc(2rem - 1px), rgb(142 192 230 / 0.45) calc(2rem - 1px), rgb(142 192 230 / 0.45) 2rem);
  }
  /* A browser's autofill keeps the card's colours rather than painting the field pale */
  .contact-card :is(.input, .textarea):-webkit-autofill {
    -webkit-text-fill-color: #eef3f8;
    box-shadow: 0 0 0 100px #0f1f31 inset;
    transition: background-color 9999s;
  }
  .contact-card .btn { box-shadow: inset 0 1px 0 #ffffff, 0 10px 22px -12px rgb(0 0 0 / 0.6); }
  .contact-card .btn-ghost { color: #eef3f8; border-color: rgb(255 255 255 / 0.28); box-shadow: none; }
  .contact-card .btn-ghost:hover { border-color: #eef3f8; }
  .contact-card .small.muted, .contact-card .muted { color: #8fa1b4; }
  .contact-card .form-error { color: #ff9aaa; }
  .contact-card .eyebrow { color: #8ec0e6; }
  .contact-card .compose h2 { color: #ffffff; }

  /* The direct lines beside it: small white chips, raised off the wall, that lean under the pointer */
  .contact-direct :global(.copy-email) {
    border: 1px solid rgb(12 26 41 / 0.06);
    border-radius: 12px;
    background: linear-gradient(180deg, #ffffff 0%, #f6f8fb 100%);
    color: #1b2a3d;
    box-shadow: var(--lift-soft);
  }
  .contact-direct :global(.copy-email:hover) { border-color: rgb(12 26 41 / 0.12); background: linear-gradient(180deg, #ffffff 0%, #f6f8fb 100%); }

  /* Phones and tablets: the card lies flat and full width */
  @media (max-width: 960px) {
    .contact-stand { order: 1; margin-top: var(--s-2); }
    .contact-card { border-radius: 20px; }
  }
</style>
