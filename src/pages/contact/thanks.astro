---
import Base from '../../layouts/Base.astro';
import Mark from '../../components/Mark.astro';
import { site } from '../../config/site';
---

<Base title="Thank you" noindex>
  <section class="thanks">
    <div class="wrap thanks-inner">
      <div class="load-in" style="--i:0"><Mark size={72} tone="brand" assemble tilt /></div>
      <h1 class="load-in" style="--i:1">Thank you. We have it.</h1>
      <p class="lead load-in" style="--i:2">
        A member of our team will reply within {site.offer.replyWithin}. In the meantime, here is how we work.
      </p>
      <div class="btn-row load-in" style="--i:3">
        <a class="btn" href="/approach/">See our approach <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href="/work/">See our team&rsquo;s work</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks { padding-top: clamp(9rem, 6rem + 8vw, 13rem); padding-bottom: var(--section); }
  .thanks-inner { display: grid; gap: var(--s-5); justify-items: start; }
  .thanks h1 { font-size: var(--step-5); max-width: 14ch; }
</style>
