---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import AdvisorCard from '../../components/AdvisorCard.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { advisors } from '../../data/advisors';
import { site } from '../../config/site';
---

<Base title="About" description="Spockhart is a Toronto engineering firm that takes tedious, repetitive tasks out of how organizations run.">
  <PageHero
    eyebrow="About"
    title="Engineers who give back."
    lead="Spockhart is a Toronto engineering firm built on a simple idea: the careful engineering that makes large organizations run well should be working for everyone else too."
  />

  <section class="section" aria-labelledby="story-title">
    <div class="wrap split">
      <div class="split-head" data-reveal>
        <p class="eyebrow">Why we started</p>
        <h2 id="story-title">The same problem, everywhere we looked.</h2>
      </div>
      <div class="story" data-reveal>
        <p class="lead">
          Our team spent years building systems for large organizations: platforms, marketplaces, even hardware for space. Outside
          of work, we volunteered and gave to causes we care about.
        </p>
        <p>
          In both places we kept seeing the same thing. Talented people were losing hours every week to work that should run on
          its own: copying, chasing, reconciling and reporting. The waste was obvious from the inside, and almost nobody had the
          time to fix it.
        </p>
        <blockquote>We started Spockhart to fix it.</blockquote>
      </div>
    </div>
  </section>

  {site.showAdvisors && advisors.length > 0 && (
  <section class="section band-recessed" aria-labelledby="board-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Advisory board</p>
        <h2 id="board-title">Guided by people who have done it.</h2>
        <p>Leaders across technology, business and philanthropy who challenge our thinking and hold us to a high standard.</p>
      </div>
      <div class="grid-4 board" data-reveal="stagger">
        {advisors.map((a) => <AdvisorCard advisor={a} />)}
      </div>
    </div>
  </section>
  )}

  <ClosingCTA
    title="Come meet the team."
    body="Thirty minutes, no pitch deck. Bring the process that frustrates your people most, and we’ll show you how we would take it apart."
    primary={{ label: 'Meet with us', href: '/contact/' }}
  />
</Base>

<style>
  .story { display: grid; gap: var(--s-5); max-width: 64ch; }
  .story p:not(.lead) { color: var(--ink-2); }
  .story blockquote {
    margin-top: var(--s-3);
    padding-left: var(--s-5);
    border-left: 2px solid var(--accent-soft);
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .board { row-gap: var(--s-7); }
</style>
