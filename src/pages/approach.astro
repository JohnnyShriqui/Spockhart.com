---
import Base from '../layouts/Base.astro';
import Process from '../components/Process.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';
---

<Base
  title="Approach"
  description={`How Spockhart works: embedded with your team, a working prototype in ${site.offer.prototypeDays} days, and systems you own.`}
  lightHero
>
  <!-- One light room. It opens straight on the process: four steps, each a large card, descending
       to the right as a staircase (Process.astro), then the closing card -->
  <div class="page-body body-approach room-light" data-body>
    <!-- The page opens straight on the first step; its title is there for screen readers and search -->
    <h1 class="visually-hidden">Approach: how we work, in four steps</h1>

    <Process />

    <ClosingCTA
      terse
      title="Results in 30 days starts here."
      primary={{ label: 'Plan the first 30 days', href: '/contact/' }}
    />
  </div>
</Base>

<style>
  /* The page opens straight on the first step, just under the header */
  .body-approach :global(.proc) { padding-top: clamp(8.5rem, 7rem + 3vw, 10.5rem); }
  @media (max-width: 640px) {
    .body-approach :global(.proc) { padding-top: 6.75rem; }
  }
</style>
