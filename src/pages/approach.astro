---
import Base from '../layouts/Base.astro';
import Process from '../components/Process.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';
---

<Base
  title="Approach"
  description={`How Spockhart works: embedded with your team, a working prototype in ${site.offer.prototypeDays} days, and systems you own.`}
  lightHero
>
  <!-- One light room. It opens straight on the process: four steps, each a large card, descending
       to the right as a staircase (Process.astro), then the closing card -->
  <div class="page-body body-approach room-light room-blue" data-body>
    <!-- A title on the wall, as on the other pages, then the four steps -->
    <header class="wrap page-head">
      <h1 class="load-in" style="--i:1">Our Approach.</h1>
      <p class="lead load-in" style="--i:2">We embed with your team as partners, from the first look to the handover.</p>
    </header>

    <Process />

    <ClosingCTA
      terse
      title="Results in 30 days starts here."
      primary={{ label: 'Plan the first 30 days', href: '/contact/' }}
    />
  </div>
</Base>

<style>
  /* The title sits where Contact's does; the first step follows a short way below */
  .page-head { padding-top: clamp(7rem, 4.5rem + 5vw, 10rem); }
  .page-head .lead { margin-top: var(--s-4); }
  .body-approach :global(.proc) { padding-top: clamp(3rem, 2rem + 2.5vw, 4.5rem); }
  @media (max-width: 640px) {
    .page-head { padding-top: 6.5rem; }
    .body-approach :global(.proc) { padding-top: 2.5rem; }
  }
</style>
