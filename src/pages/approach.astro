---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Path from '../components/Path.astro';
import { site } from '../config/site';
---

<Base
  title="Approach"
  description={`How Spockhart works: embedded with your team, a working prototype in ${site.offer.prototypeDays} days, and systems you own.`}
  lightHero
>
  <!-- One light room. It opens on the process itself: the phases climb above a line of light
       that runs down the page and on into the closing card (Path.astro). -->
  <div class="page-body body-approach room-light" data-body>
    <Path />

    <section class="ap-top" aria-labelledby="ap-title">
      <div class="wrap ap-head">
        <h1 id="ap-title" class="load-in" style="--i:1">Embedded from day one.</h1>
      </div>
    </section>

    <section class="section engagement engagement-fix" aria-labelledby="engagement-title">
      <div class="wrap">
        <div class="section-head load-in" style="--i:3">
          <p class="track-label">Operations Efficiency</p>
          <h2 id="engagement-title">How We Optimize Existing Operations:</h2>
        </div>
        <Timeline path />
      </div>
    </section>

    <section class="section engagement engagement-grow" aria-labelledby="growth-title">
      <div class="wrap">
        <div class="section-head" data-reveal>
          <p class="track-label">Revenue Development</p>
          <h2 id="growth-title">How We Create New Opportunities for Growth:</h2>
        </div>
        <Timeline track="grow" path />
      </div>
    </section>

    <ClosingCTA
      terse
      title="Results in 30 days starts here."
      primary={{ label: 'Plan the first 30 days', href: '/contact/' }}
    />
  </div>
</Base>

<style>
  /* Everything sits above the line of light and its dots */
  .body-approach > :is(section, :global(.closing)) { position: relative; z-index: 1; }

  /* The opening: the title, on one line */
  .ap-top { padding-top: clamp(7rem, 5.5rem + 3.5vw, 9.5rem); }
  .ap-head { display: grid; }
  .ap-head h1 { font-size: clamp(2.75rem, 1.4rem + 3.6vw, 5rem); max-width: none; letter-spacing: -0.03em; }

  /* Each set: its label and title, then the phases climbing above the line */
  .engagement .track-label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .engagement .section-head { gap: 0.6rem; max-width: none; }
  .engagement .section-head h2 { font-size: var(--step-3); max-width: none; }
  .engagement-fix { padding-top: clamp(3rem, 2rem + 3vw, 5rem); padding-bottom: clamp(5rem, 3rem + 6vw, 9rem); }
  .engagement-grow { padding-top: 0; padding-bottom: clamp(4rem, 3rem + 4vw, 7rem); }
  @media (min-width: 901px) {
    .engagement .section-head { margin-bottom: clamp(2rem, 1rem + 2vw, 3rem); }
  }
  @media (max-width: 900px) {
    .ap-head { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
  }
  @media (max-width: 640px) {
    .ap-top { padding-top: 5.5rem; }
    .engagement { padding-bottom: 0; }
    .engagement-grow { padding-top: 4.5rem; padding-bottom: 3rem; }
    .engagement .section-head { margin-bottom: 0.25rem; }
  }
</style>
