---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';
---

<Base
  title="Approach"
  description={`How Spockhart works: embedded with your team, a working prototype in ${site.offer.prototypeDays} days, and systems you own.`}
>
  <PageHero
    eyebrow="Approach"
    title="Embedded from day one."
  />

  <section class="section band-recessed engagement" aria-labelledby="engagement-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">The engagement</p>
        <h2 id="engagement-title">Four phases.</h2>
      </div>
      <Timeline />
    </div>
  </section>

  <ClosingCTA
    title="Results in 30 days starts here."
    primary={{ label: 'Plan the first 30 days', href: '/contact/' }}
  />
</Base>

<style>
  /* Phones: the bar sits right under the title; the phases run to the bottom of the section */
  @media (max-width: 640px) {
    .engagement { padding-bottom: 0; }
    .engagement .section-head { margin-bottom: 0.25rem; }
  }
</style>
