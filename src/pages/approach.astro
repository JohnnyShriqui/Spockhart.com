---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Timeline from '../components/Timeline.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../config/site';
---

<Base
  title="Approach"
  description={`How Spockhart works: embedded with your team, a working prototype in ${site.offer.prototypeDays} days, and systems you own.`}
>
  <PageHero
    theme="approach"
    title="Embedded from day one."
    lead="From workflow automation to building entirely new digital offerings, we turn great opportunities into working solutions."
  />

  <section class="section band-recessed engagement engagement-fix" aria-labelledby="engagement-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Operations Efficiency</p>
        <h2 id="engagement-title">Build better ways of working.</h2>
      </div>
      <Timeline />
    </div>
  </section>

  <section class="section band-recessed engagement engagement-grow" aria-labelledby="growth-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Revenue Development</p>
        <h2 id="growth-title">Create new ways to grow.</h2>
      </div>
      <Timeline track="grow" />
    </div>
  </section>

  <ClosingCTA
    terse
    title="Results in 30 days starts here."
    body="Tell us where you’d like to see your team improve. We’ll walk you through what the diagnosis and first prototype would look like for your team."
    primary={{ label: 'Plan the first 30 days', href: '/contact/' }}
  />
</Base>

<style>
  /* Laptops: the title sits close to the bar so the whole engagement fits on one screen */
  @media (min-width: 901px) {
    .engagement .section-head { gap: var(--s-2); margin-bottom: var(--s-5); }
    .engagement .section-head h2 { font-size: var(--step-3); max-width: none; }
  }
  /* The two tracks run on one band, one straight after the other */
  .engagement-fix { padding-bottom: var(--s-8); }
  .engagement-grow { padding-top: 0; }
  /* Phones: the bar sits right under the title; the phases run to the bottom of the section */
  @media (max-width: 640px) {
    .engagement { padding-bottom: 0; }
    .engagement-grow { padding-top: var(--s-4); }
    .engagement .section-head { margin-bottom: 0.25rem; }
  }
</style>
