---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Honeycomb from '../../components/Honeycomb.astro';
import ResultVisual from '../../components/ResultVisual.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { iconFor, headline, plainTitle as plain } from '../../lib/work';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

/**
 * Each case study has its own colour mood, light and dark in turn, and each fades into the next
 * as you scroll, so the page keeps changing instead of repeating. Neighbouring colours are mixed
 * in OKLab, so the blends stay clean rather than passing through grey.
 */
const moods = [
  { name: 'mist', dark: false, base: '#e9f0f8', accent: '#245a86', g1: 'rgb(146 188 228 / 0.5)', g1x: '82%', g2: 'rgb(255 255 255 / 0.6)', g2x: '12%', rv: ['#1f4d6f', '#173f5c', '#133650', '#8ec0e6'] },
  { name: 'petrol', dark: true, base: '#0b2430', accent: '#7fd0d2', g1: 'rgb(30 130 142 / 0.36)', g1x: '22%', g2: 'rgb(40 82 134 / 0.26)', g2x: '90%', rv: ['#155a62', '#0f474e', '#0b3a40', '#7fd0d2'] },
  { name: 'ivory', dark: false, base: '#f5eee4', accent: '#8a4b2d', g1: 'rgb(242 200 160 / 0.5)', g1x: '82%', g2: 'rgb(210 224 240 / 0.45)', g2x: '10%', rv: ['#7a4632', '#663a29', '#553022', '#f3c6a0'] },
  { name: 'indigo', dark: true, base: '#141a36', accent: '#b3b8ff', g1: 'rgb(108 98 198 / 0.34)', g1x: '22%', g2: 'rgb(44 100 162 / 0.26)', g2x: '92%', rv: ['#3a3f8f', '#2e3376', '#252964', '#b9bdff'] },
  { name: 'sky', dark: false, base: '#e1edf9', accent: '#1d5c96', g1: 'rgb(255 255 255 / 0.7)', g1x: '16%', g2: 'rgb(116 174 226 / 0.36)', g2x: '88%', rv: ['#1d5c96', '#174d7f', '#12406b', '#a3d3f7'] },
  { name: 'steel', dark: true, base: '#0c1a2b', accent: '#8ec0e6', g1: 'rgb(52 118 182 / 0.38)', g1x: '24%', g2: 'rgb(28 92 112 / 0.26)', g2x: '92%', rv: ['#1f4a72', '#183c5e', '#13314e', '#8ec0e6'] },
  { name: 'lavender', dark: false, base: '#eaecfa', accent: '#3c4a9c', g1: 'rgb(184 188 246 / 0.5)', g1x: '82%', g2: 'rgb(255 255 255 / 0.6)', g2x: '10%', rv: ['#434fa3', '#37428b', '#2d3776', '#c8ccff'] },
  { name: 'copper', dark: true, base: '#16171f', accent: '#f1b98f', g1: 'rgb(196 124 84 / 0.28)', g1x: '22%', g2: 'rgb(58 90 142 / 0.3)', g2x: '92%', rv: ['#6a4334', '#56362a', '#472d23', '#f1b98f'] },
];
const HERO_END = '#0c1f28'; // the bottom edge of the Our Work hero (it fades to this, see global.css)
const PAGE = '#f0f3f7'; // the page below the last case study

const hexToRgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
const toLin = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
const fromLin = (c: number) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
const toOklab = (hex: string) => {
  const [r, g, b] = hexToRgb(hex).map(toLin);
  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];
};
const fromOklab = ([L, a, b]: number[]) => {
  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
  const rgb = [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];
  return '#' + rgb.map((c) => Math.round(Math.min(1, Math.max(0, fromLin(c))) * 255).toString(16).padStart(2, '0')).join('');
};
/* Blending between two moods passes through a slightly richer middle colour (a touch more
   chroma, leaning to the stronger colour's hue), so the blend glows instead of turning grey.
   The path is a smooth curve through that middle, with no corner anywhere. */
const blend = (a: string, b: string, t: number) => {
  const A = toOklab(a);
  const B = toOklab(b);
  const cA = Math.hypot(A[1], A[2]);
  const cB = Math.hypot(B[1], B[2]);
  const M = A.map((v, i) => (v + B[i]) / 2);
  const D = cA > cB ? A : B;
  const dc = Math.hypot(D[1], D[2]) || 1;
  let dir = [D[1] / dc, D[2] / dc];
  const mc = Math.hypot(M[1], M[2]);
  if (mc > 1e-4) {
    dir = [0.5 * dir[0] + (0.5 * M[1]) / mc, 0.5 * dir[1] + (0.5 * M[2]) / mc];
    const n = Math.hypot(dir[0], dir[1]) || 1;
    dir = [dir[0] / n, dir[1] / n];
  }
  const c = (cA + cB) / 2 + 0.035;
  const mid = [M[0], dir[0] * c, dir[1] * c];
  const C = mid.map((v, i) => 2 * v - 0.5 * A[i] - 0.5 * B[i]);
  return fromOklab(A.map((v, i) => (1 - t) ** 2 * v + 2 * t * (1 - t) * C[i] + t * t * B[i]));
};
const ease = (t: number) => t * t * (3 - 2 * t);
const STEPS = 20;
const at = (k: number) => `calc(var(--band) * ${(k / STEPS).toFixed(2)})`;
// The first case study takes the whole blend from the hero, and the last the whole blend into the page
const fade = (prev: string, base: string, next: string, first: boolean, last: boolean) => {
  const top = Array.from({ length: STEPS + 1 }, (_, k) => {
    const u = k / STEPS;
    return `${blend(prev, base, ease(first ? u : 0.5 + 0.5 * u))} ${at(k)}`;
  });
  const bottom = Array.from({ length: STEPS + 1 }, (_, k) => {
    const u = k / STEPS;
    return `${blend(base, next, ease(last ? u : 0.5 * u))} calc(100% - var(--band) + ${at(k)})`;
  });
  return `linear-gradient(180deg, ${top.join(', ')}, ${bottom.join(', ')})`;
};
const moodStyle = (i: number) => {
  const m = moods[i % moods.length];
  const prev = i === 0 ? HERO_END : moods[(i - 1) % moods.length].base;
  const next = i === all.length - 1 ? PAGE : moods[(i + 1) % moods.length].base;
  return {
    m,
    style: `--fade:${fade(prev, m.base, next, i === 0, i === all.length - 1)};--rv-frame:${m.rv[0]};--rv-win:${m.rv[1]};--rv-bar:${m.rv[2]};--rv-hot:${m.rv[3]};--g1:${m.g1};--g1x:${m.g1x};--g2:${m.g2};--g2x:${m.g2x};--accent:${m.accent};--accent-soft:${m.accent}`,
  };
};


/**
 * Case study bodies are short markdown: a few "## Heading" sections of plain
 * paragraphs. They are shown as side-by-side columns in each project's details.
 */
const sectionsOf = (body = '') =>
  body
    .split(/^## /m)
    .slice(1)
    .map((chunk) => {
      const [heading, ...rest] = chunk.split('\n');
      const paras = rest
        .join('\n')
        .split(/\n\s*\n/)
        .map((p) => p.replace(/\s+/g, ' ').trim())
        .filter(Boolean);
      return { heading: heading.trim(), paras };
    });


---

<Base
  title="Our Work"
  description="What the people behind Spockhart have delivered: platforms, marketplaces, sales systems, production floors and engineering prototypes. Client names withheld."
>
  <PageHero
    class="work-hero"
    theme="work"
    title="Our team’s experience."
    lead="Spockhart is a new firm built on years of experience. Our team has transformed operations and built technology at some of North America’s largest organizations, with the examples below drawn from previous roles."
  >
    <Honeycomb slot="figure" />
  </PageHero>

  <section class="projects" aria-label="Projects" data-projects>
    {
      all.map((entry, i) => {
        const d = entry.data;
        const live = d.status === 'in-development';
        const panelId = `${entry.id}-details`;
        const mood = moodStyle(i);
        return (
          <article id={entry.id} class:list={['project', `mood-${mood.m.name}`, { flip: i % 2 === 1, dark: mood.m.dark }]} style={mood.style} data-project>
            <div class="wrap project-grid">
              <div class="project-text" data-reveal>
                <p class="project-kicker">
                  Case study {String(i + 1).padStart(2, '0')}
                  <span class="kicker-sep" aria-hidden="true" />
                  {d.sector}
                </p>
                <p class="project-client">
                  <span class="client-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d={iconFor(entry.id)} />
                    </svg>
                  </span>
                  <span class="client-name">{d.client}</span>
                </p>
                <h2>{headline(d.title).map((part, k) => (k % 2 ? <span class="hl">{part}</span> : part))}</h2>
                <button class="cs-toggle at-text" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
              <div class="project-visual" data-reveal>
                <ResultVisual id={entry.id} />
                <button class="cs-toggle at-visual" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="cs-panel" id={panelId} data-panel data-open="false" role="region" aria-label={`${plain(d.title)} details`}>
              <div class="cs-panel-inner">
                <div class="wrap">
                  <div class:list={['cs-card', { 'on-light': mood.m.dark }]}>
                    <ul class="cs-metrics">
                      {d.metrics.map((m) => (
                        <li>
                          <span class="cs-m-value">{m.value}</span>
                          <span class="cs-m-label">{m.label}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="cs-cols">
                      {sectionsOf(entry.body).map((s) => (
                        <div class="cs-col">
                          <h3>{s.heading}</h3>
                          <div class="cs-text">
                            {s.paras.map((p) => (
                              <p>{p}</p>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                    <p class="cs-foot">
                      <span>
                        {live
                          ? 'Being built by a member of our team in a current role. Not a Spockhart engagement. Client name withheld.'
                          : 'Led by a member of our team in a previous role. Not a Spockhart engagement. Client name withheld.'}
                      </span>
                      <span class="cs-scope">Scope: {d.scope}</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <noscript>
    <style>
      .cs-panel { grid-template-rows: 1fr !important; }
      .cs-panel-inner { visibility: visible !important; }
      .cs-toggle { display: none !important; }
    </style>
  </noscript>

  <ClosingCTA terse title="Your operation could be next." />
</Base>

<script>
  // Each project opens its details in place. A link to /work/#project-id opens that one.
  function initProjects() {
    const root = document.querySelector<HTMLElement>('[data-projects]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // Each project has two buttons: under the headline on laptops, under the graphic on
    // phones and tablets. Only one shows at a time; both stay in step.
    const set = (project: HTMLElement, open: boolean) => {
      const panel = project.querySelector<HTMLElement>('[data-panel]');
      if (!panel) return;
      panel.dataset.open = String(open);
      project.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
        const label = toggle.querySelector('[data-label]');
        if (label) label.textContent = open ? 'Hide the details' : 'See the details';
      });
    };

    root.querySelectorAll<HTMLElement>('[data-project]').forEach((project) => {
      project.querySelectorAll('[data-toggle]').forEach((toggle) =>
        toggle.addEventListener('click', () => {
          set(project, project.querySelector<HTMLElement>('[data-panel]')?.dataset.open !== 'true');
        }),
      );
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const project = id ? root.querySelector<HTMLElement>(`[data-project][id="${CSS.escape(id)}"]`) : null;
      if (!project) return;
      set(project, true);
      requestAnimationFrame(() => project.scrollIntoView({ block: 'start' }));
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
  initProjects();
  document.addEventListener('spockhart:view', initProjects);
</script>

<style>
  .project {
    padding-block: clamp(3.5rem, 2rem + 4.5vw, 6.5rem);
    scroll-margin-top: 72px;
    /* Its own mood, fading in from the case study above and out into the one below */
    /* The glows sit in the middle of the section and fade out well before its edges */
    background:
      radial-gradient(46% 48% at var(--g1x) 50%, var(--g1), transparent 70%),
      radial-gradient(38% 42% at var(--g2x) 52%, var(--g2), transparent 70%),
      var(--fade);
    /* Each colour is only at full strength through the middle of its section; the rest is
       one long blend into its neighbours, so the page reads as one continuous wash */
    --band: 50%;
  }
  /* Every other case study is set deep and dark, so the page changes as you scroll. The light
     detail sheet stays light inside it. */
  /* A very fine grain over the whole run of case studies keeps the long blends from banding */
  .projects { position: relative; }
  .projects::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 200px;
    opacity: 0.05;
    mix-blend-mode: overlay;
  }
  /* Stacked layouts start the words near the top, so the blends are shorter there */
  @media (max-width: 960px) {
    .project { --band: 32%; }
  }

  /* The closing section follows on from the last case study with no rule between them */
  .projects ~ :global(.closing) { border-top: 0; }

  /* Dark moods: light text. The detail sheet stays a light card inside them. */
  .project.dark {
    --ink: #eef3f8;
    --ink-2: #b9c7d5;
    --ink-3: #98abbe;
    --rule: rgb(255 255 255 / 0.1);
    --rule-2: rgb(255 255 255 / 0.22);
    color: var(--ink);
  }
  .project.dark h2 { color: var(--ink); }
  .project.dark .client-mark::before { background: #eef3f8; }
  .project.dark .client-mark svg { stroke: #14212f; }
  .project.dark .cs-toggle:hover { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.4); }
  .project .project-visual > :global(.rv) { box-shadow: 0 30px 60px -34px rgb(10 20 35 / 0.45); }
  .project.dark .project-visual > :global(.rv) { box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.6); }
  /* The detail sheet's accent goes back to the brand blue, whatever the mood */
  .project .cs-card { --accent: #2c5f8a; --accent-soft: #4a8aba; }
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: center;
  }
  /* Flipped rows swap sides but keep the graphic in the wider column */
  .flip .project-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .flip .project-text { order: 2; }
  .project-text { display: grid; gap: var(--s-4); justify-items: start; align-content: center; }

  /* "Case study 01 · Sector": says plainly what this is */
  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kicker-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-soft); }

  /* The client, as named as we can: an industry mark where the logo would be */
  .project-client { display: flex; align-items: center; gap: 0.85rem; }
  .client-mark { position: relative; flex: none; display: grid; place-items: center; width: 44px; height: 50px; }
  .client-mark::before { content: ''; position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .client-mark svg { position: relative; width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .client-name { font-family: var(--font-display); font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.75rem); line-height: 1.15; color: var(--ink); }

  .project-text h2 { font-size: var(--step-3); line-height: 1.12; max-width: 22ch; }
  .project-text h2 .hl { color: var(--accent); }
  .project-text .cs-toggle { margin-top: var(--s-2); }
  .cs-toggle.at-visual { display: none; }
  .project-visual { min-width: 0; display: grid; gap: var(--s-4); justify-items: start; }
  .project-visual > :global(.rv) { justify-self: stretch; }

  .cs-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem 0.6rem 1.1rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .cs-toggle:hover { background: var(--surface); border-color: var(--ink-3); }
  .cs-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 400ms var(--ease-out); }
  .cs-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* ---------- The details, laid out like a case study sheet ---------- */
  .cs-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 550ms var(--ease-out); }
  .cs-panel[data-open='true'] { grid-template-rows: 1fr; }
  .cs-panel-inner { min-height: 0; overflow: hidden; }
  .cs-panel[data-open='false'] .cs-panel-inner { visibility: hidden; transition: visibility 0s 550ms; }
  .cs-card {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding: clamp(1.25rem, 0.9rem + 1.3vw, 2rem) clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  /* Results: values on one line across, labels lined up underneath */
  .cs-metrics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0 var(--s-6);
  }
  .cs-metrics li {
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    gap: 0.3rem;
    padding-top: var(--s-3);
    border-top: 2px solid var(--ink);
  }
  .cs-m-value {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variant-numeric: lining-nums;
  }
  .cs-m-label { font-size: 0.8125rem; color: var(--ink-2); line-height: 1.4; }
  /* The story: one row each, label on the left */
  .cs-cols { display: grid; border-top: 1px solid var(--rule); }
  .cs-col {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .cs-col h3 { padding-top: 0.3rem; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .cs-text { display: grid; gap: var(--s-2); }
  .cs-text p { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.55; }
  .cs-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: calc(var(--s-2) * -1);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  @media (max-width: 960px) {
    .project-grid, .flip .project-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .flip .project-text { order: 0; }
    .cs-toggle.at-text { display: none; }
    .cs-toggle.at-visual { display: inline-flex; }
  }
  /* Phones: tighter, same content */
  @media (max-width: 640px) {
    .project { padding-block: 2.5rem; }
    .project-grid, .flip .project-grid { gap: var(--s-5); }
    .project-text { gap: 0.65rem; }
    .project-kicker { font-size: 0.6875rem; }
    .client-mark { width: 36px; height: 41px; }
    .client-mark svg { width: 18px; height: 18px; }
    .client-name { font-size: 1.25rem; }
    .project-text h2 { font-size: 1.375rem; max-width: none; }
    .cs-toggle { padding: 0.45rem 0.85rem 0.45rem 0.95rem; font-size: 0.875rem; }
    .cs-card { margin-top: var(--s-5); gap: var(--s-5); }
    .cs-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s-4); }
    .cs-metrics li { padding-top: var(--s-3); margin-bottom: var(--s-4); }
    .cs-m-value { font-size: 1.125rem; }
