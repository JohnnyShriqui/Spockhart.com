---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ResultVisual from '../../components/ResultVisual.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import KbkLogo from '../../components/KbkLogo.astro';
import { iconFor, headline, plainTitle as plain } from '../../lib/work';

/* Our engagement in progress first (Kids Being Kids), then our team's earlier projects */
const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);

/* Hovering the marker above each case study says plainly whose work it was */
const tipFor = (kind: string) =>
  kind === 'spockhart' ? 'A Spockhart engagement, under way now.' : 'This project was led or worked on by our team before Spockhart.';

/**
 * Case study bodies are short markdown: a few "## Heading" sections of plain paragraphs and short
 * "- " lists. They are shown as rows in each project's details.
 */
type Block = { list: false; text: string } | { list: true; items: string[] };
const sectionsOf = (body = '') =>
  body
    .split(/^## /m)
    .slice(1)
    .map((chunk) => {
      const [heading, ...rest] = chunk.split('\n');
      const blocks: Block[] = rest
        .join('\n')
        .split(/\n\s*\n/)
        .map((b) => b.trim())
        .filter(Boolean)
        .map((b) => {
          const lines = b.split('\n').map((l) => l.trim());
          return lines.every((l) => l.startsWith('- '))
            ? { list: true as const, items: lines.map((l) => l.slice(2).trim()) }
            : { list: false as const, text: b.replace(/\s+/g, ' ') };
        });
      return { heading: heading.trim(), blocks };
    });
---

<Base
  title="Our Experience"
  description="Kids Being Kids, the engagement we are in now, and what the people behind Spockhart have delivered before: platforms, sales systems, production floors and engineering prototypes."
  lightHero
>

  <!-- One light room from top to bottom: a title on the wall, as on the other pages, then the
       case studies -->
  <div class="page-body work-body room-light room-blue" data-body>
  <header class="wrap page-head">
    <h1 class="load-in" style="--i:1">Our Experience.</h1>
    <p class="lead load-in" style="--i:2">What we’re building now, and what our team delivered before Spockhart.</p>
  </header>

  <section class="projects" aria-label="Case studies" data-projects>
    {
      all.map((entry, i) => {
        const d = entry.data;
        const ours = d.kind === 'spockhart';
        const panelId = `${entry.id}-details`;
        const tipId = `${entry.id}-origin`;
        return (
          <article id={entry.id} class:list={['project', { flip: i % 2 === 1, tint: i % 2 === 1 }]} data-project>
            <div class="wrap project-grid">
              <div class="project-text" data-reveal>
                <p class:list={['project-origin', { 'is-ours': ours }]} tabindex="0" aria-describedby={tipId}>
                  {ours ? (
                    <span class="origin-live" aria-hidden="true" />
                  ) : (
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9 M2.4 2.6v2.6H5 M8 5.2V8l2 1.3" />
                    </svg>
                  )}
                  {d.origin}
                  <span class="origin-tip" role="tooltip" id={tipId}>{tipFor(d.kind)}</span>
                </p>
                <p class="project-kicker">
                  Case study {String(i + 1).padStart(2, '0')}
                  <span class="kicker-sep" aria-hidden="true" />
                  {d.sector}
                </p>
                <p class="project-client">
                  {ours ? (
                    <span class="client-logo">
                      <KbkLogo />
                    </span>
                  ) : (
                    <span class="client-mark" aria-hidden="true">
                      <svg viewBox="0 0 24 24">
                        <path d={iconFor(entry.id)} />
                      </svg>
                    </span>
                  )}
                  <span class="client-name">{d.client}</span>
                </p>
                <h2>{headline(d.title).map((part, k) => (k % 2 ? <span class="hl">{part}</span> : part))}</h2>
                <button class="cs-toggle at-text" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
              <div class="project-visual" data-reveal>
                <div class="rv-stage" data-tilt="4" data-tilt-depth="1800">
                  <ResultVisual id={entry.id} />
                </div>
                <button class="cs-toggle at-visual" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="cs-panel" id={panelId} data-panel data-open="false" role="region" aria-label={`${plain(d.title)} details`}>
              <div class="cs-panel-inner">
                <div class="wrap">
                  <div class="cs-card" data-tilt="3" data-tilt-depth="2600">
                    {ours && (
                      <p class="cs-head">
                        <span class="cs-head-title">The scorecard</span>
                        <span class="cs-head-note">Targets for the first season, spring 2027</span>
                      </p>
                    )}
                    <ul class="cs-metrics">
                      {d.metrics.map((m) => (
                        <li>
                          <span class="cs-m-value">{m.value}</span>
                          <span class="cs-m-label">{m.label}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="cs-cols">
                      {sectionsOf(entry.body).map((s) => (
                        <div class="cs-col">
                          <h3>{s.heading}</h3>
                          <div class="cs-text">
                            {s.blocks.map((b) =>
                              b.list ? (
                                <ul class="cs-list">
                                  {b.items.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              ) : (
                                <p>{b.text}</p>
                              ),
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                    <p class="cs-foot">
                      <span>{ours ? 'Every figure here is a target until the pilot reports its results in May 2027.' : 'Client name withheld.'}</span>
                      <span class="cs-scope">Scope: {d.scope}</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <noscript>
    <style>
      .cs-panel { grid-template-rows: 1fr !important; }
      .cs-panel-inner { visibility: visible !important; }
      .cs-toggle { display: none !important; }
    </style>
  </noscript>

  <ClosingCTA terse title="Your operation could be next." />
  </div>
</Base>

<script>
  // Each project opens its details in place. A link to /work/#project-id opens that one.
  function initProjects() {
    const root = document.querySelector<HTMLElement>('[data-projects]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // Each project has two buttons: under the headline on laptops, under the graphic on
    // phones and tablets. Only one shows at a time; both stay in step.
    const set = (project: HTMLElement, open: boolean) => {
      const panel = project.querySelector<HTMLElement>('[data-panel]');
      if (!panel) return;
      panel.dataset.open = String(open);
      // Once it has opened, the card's shadow may reach past the panel's edge; while it opens or
      // closes, the panel clips it so the slide stays clean
      clearTimeout(Number(panel.dataset.settle));
      panel.classList.remove('is-settled');
      if (open) panel.dataset.settle = String(window.setTimeout(() => panel.classList.add('is-settled'), 600));
      project.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
        const label = toggle.querySelector('[data-label]');
        if (label) label.textContent = open ? 'Hide the details' : 'See the details';
      });
    };

    root.querySelectorAll<HTMLElement>('[data-project]').forEach((project) => {
      project.querySelectorAll('[data-toggle]').forEach((toggle) =>
        toggle.addEventListener('click', () => {
          set(project, project.querySelector<HTMLElement>('[data-panel]')?.dataset.open !== 'true');
        }),
      );
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const project = id ? root.querySelector<HTMLElement>(`[data-project][id="${CSS.escape(id)}"]`) : null;
      if (!project) return;
      set(project, true);
      requestAnimationFrame(() => project.scrollIntoView({ block: 'start' }));
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
  initProjects();
  document.addEventListener('spockhart:view', initProjects);
</script>

<style>
  /* ---------- One light room, top to bottom ----------
     Its rounded bottom overlaps the footer a little, so the footer shows in its corners, as on the
     home page. */
  .work-body {
    --sheet-r: 32px;
    z-index: 1;
    margin-bottom: calc(var(--sheet-r) * -1);
    border-radius: 0 0 var(--sheet-r) var(--sheet-r);
    box-shadow: 0 28px 60px -24px rgb(0 0 0 / 0.5);
  }
  .work-body.room-light::after { border-radius: inherit; }
  .work-body :global(.closing) { border-top: 0; }
  @media (max-width: 640px) {
    .work-body { --sheet-r: 22px; }
  }

  /* Each case study: a pool of light on the wall behind its graphic, fading out well before the
     edges of the case study, so nothing ever meets on a line */
  .project {
    --pool-x: 70%;
    padding-block: clamp(3.5rem, 2rem + 4.5vw, 6.5rem);
    scroll-margin-top: 72px;
    background: radial-gradient(46% 40% at var(--pool-x) 50%, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.3) 45%, transparent 72%);
  }
  .project.flip { --pool-x: 30%; }
  .project-visual :global(.scene) { will-change: transform; }
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: center;
  }
  /* Flipped rows swap sides but keep the graphic in the wider column */
  .flip .project-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .flip .project-text { order: 2; }
  .project-text { display: grid; gap: var(--s-4); justify-items: start; align-content: center; }

  /* Above each project: when it was done (before Spockhart), so no one mistakes it for a Spockhart engagement */
  .project-origin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .project-origin svg { width: 14px; height: 14px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }

  /* "Case study 01 · Sector": says plainly what this is */
  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kicker-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-soft); }

  /* The client, as named as we can: an industry mark where the logo would be */
  .project-client { display: flex; align-items: center; gap: 0.85rem; }
  .client-mark { position: relative; flex: none; display: grid; place-items: center; width: 44px; height: 50px; }
  .client-mark::before { content: ''; position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .client-mark svg { position: relative; width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .client-name { font-family: var(--font-display); font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.75rem); line-height: 1.15; color: var(--ink); }

  .project-text h2 { font-size: var(--step-3); line-height: 1.12; max-width: 22ch; }
  .project-text h2 .hl { color: var(--accent); }
  .project-text .cs-toggle { margin-top: var(--s-2); }
  .cs-toggle.at-visual { display: none; }
  .project-visual { min-width: 0; display: grid; gap: var(--s-4); justify-items: start; }

  .cs-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem 0.6rem 1.1rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .cs-toggle:hover { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.4); }
  .cs-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 400ms var(--ease-out); }
  .cs-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* ---------- The details, laid out like a case study sheet ---------- */
  .cs-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 550ms var(--ease-out); }
  .cs-panel[data-open='true'] { grid-template-rows: 1fr; }
  .cs-panel-inner { min-height: 0; overflow: hidden; }
  .cs-panel[data-open='false'] .cs-panel-inner { visibility: hidden; transition: visibility 0s 550ms; }
  .cs-card {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding: clamp(1.25rem, 0.9rem + 1.3vw, 2rem) clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  /* Results: values on one line across, labels lined up underneath */
  .cs-metrics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0 var(--s-6);
  }
  .cs-metrics li {
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    gap: 0.3rem;
    padding-top: var(--s-3);
    border-top: 2px solid var(--ink);
  }
  .cs-m-value {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variant-numeric: lining-nums;
  }
  .cs-m-label { font-size: 0.8125rem; color: var(--ink-2); line-height: 1.4; }
  /* The story: one row each, label on the left */
  .cs-cols { display: grid; border-top: 1px solid var(--rule); }
  .cs-col {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .cs-col h3 { padding-top: 0.3rem; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .cs-text { display: grid; gap: var(--s-2); }
  .cs-text p { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.55; }
  .cs-list { list-style: none; padding: 0; display: grid; gap: 0.45rem; }
  .cs-list li { position: relative; padding-left: 1.35rem; color: var(--ink-2); font-size: 0.9375rem; line-height: 1.5; }
  .cs-list li::before { content: ''; position: absolute; left: 0.1rem; top: 0.68em; width: 0.6rem; height: 1.5px; background: var(--accent); }
  .cs-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: calc(var(--s-2) * -1);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  @media (max-width: 960px) {
    .project-grid, .flip .project-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .flip .project-text { order: 0; }
    .cs-toggle.at-text { display: none; }
    .cs-toggle.at-visual { display: inline-flex; }
  }
  /* Phones: tighter, same content */
  @media (max-width: 640px) {
    .project { padding-block: 2.5rem; }
    .project-grid, .flip .project-grid { gap: var(--s-5); }
    .project-text { gap: 0.65rem; }
    .project-kicker { font-size: 0.6875rem; }
    .client-mark { width: 36px; height: 41px; }
    .client-mark svg { width: 18px; height: 18px; }
    .client-name { font-size: 1.25rem; }
    .project-text h2 { font-size: 1.375rem; max-width: none; }
    .cs-toggle { padding: 0.45rem 0.85rem 0.45rem 0.95rem; font-size: 0.875rem; }
    .cs-card { margin-top: var(--s-5); gap: var(--s-5); }
    .cs-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s-4); }
    .cs-metrics li { padding-top: var(--s-3); margin-bottom: var(--s-4); }
    .cs-m-value { font-size: 1.125rem; }
    .cs-m-label { font-size: 0.8125rem; }
    .cs-col { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); padding-block: var(--s-3); }
    .cs-text p { font-size: 0.9375rem; }
  }

  /* ==========================================================================
     The graphics: dark cards standing in the light room, as on the home page. Midnight blue with
     the brand's steel light in one corner, a lit top edge, a tight contact shadow and a long soft
     one, and their shadow on the floor beneath them.
     ========================================================================== */
  .project-visual { justify-items: stretch; }
  .project-visual > .cs-toggle { justify-self: start; }
  .rv-stage { position: relative; isolation: isolate; }
  .rv-stage::after {
    content: '';
    position: absolute;
    z-index: -1;
    left: 7%;
    right: 7%;
    bottom: -40px;
    height: 60px;
    border-radius: 50%;
    background: var(--floor);
    filter: blur(10px);
    pointer-events: none;
  }
  .project .rv-stage > :global(.rv) {
    --rv-frame: #10233a;
    --rv-win: #14293f;
    --rv-bar: #112338;
    --rv-win-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 20px 40px -26px rgb(0 0 0 / 0.7);
    border-radius: 20px;
    background:
      radial-gradient(70% 55% at 0% 0%, rgb(46 104 152 / 0.42), transparent 70%),
      radial-gradient(50% 50% at 100% 100%, rgb(38 96 142 / 0.18), transparent 72%),
      linear-gradient(165deg, #0f2236 0%, #0a1625 100%);
    box-shadow: var(--lift-dark);
  }

  /* ---------- The words beside each graphic, with a little more finish ---------- */
  /* The client's mark stands slightly off the page */
  .client-mark { filter: drop-shadow(0 6px 8px rgb(12 26 41 / 0.22)); }
  /* "Before Spockhart" and "See the details": raised a little off the page, lit along their top */
  .project-origin,
  .cs-toggle {
    border: 1px solid rgb(27 42 61 / 0.1);
    background: linear-gradient(180deg, #ffffff, #f3f6f9);
    box-shadow: var(--lift-soft);
  }
  .cs-toggle { transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .cs-toggle:hover {
    border-color: rgb(27 42 61 / 0.18);
    background: #ffffff;
    box-shadow: var(--lift-soft), 0 14px 22px -14px rgb(12 26 41 / 0.3);
  }

  /* ---------- The details: a white card, raised off the page ---------- */
  .cs-panel-inner > .wrap { padding-block: 2.25rem 4.5rem; }
  .cs-panel.is-settled .cs-panel-inner { overflow: visible; }
  .cs-card {
    /* Always in front of the visual above it, so that card's shadow falls behind it, never on it */
    position: relative;
    z-index: 1;
    margin-top: 0;
    border: 1px solid rgb(27 42 61 / 0.06);
    border-radius: 20px;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    box-shadow: var(--lift);
  }
  @media (max-width: 640px) {
    .project .rv-stage > :global(.rv),
    .cs-card { border-radius: 16px; }
    .rv-stage::after { bottom: -26px; height: 40px; }
    .cs-panel-inner > .wrap { padding-block: 1.5rem 3rem; }
  }
  /* The title sits where Contact's does; the first case study follows a short way below */
  .page-head { padding-top: clamp(7rem, 4.5rem + 5vw, 10rem); }
  .page-head .lead { margin-top: var(--s-4); }
  .projects > .project:first-child { padding-top: clamp(2.5rem, 1.5rem + 2.5vw, 4rem); }

  /* ---------- The marker above each case study, and what it means on hover ---------- */
  .project-origin { position: relative; cursor: default; outline: none; }
  .project-origin:focus-visible { box-shadow: var(--lift-soft), 0 0 0 2px var(--accent-soft); }
  .origin-live { position: relative; flex: none; width: 8px; height: 8px; margin-inline: 3px; border-radius: 50%; background: #2a8fc4; box-shadow: 0 0 6px rgb(63 208 255 / 0.8); }
  .origin-live::after { content: ''; position: absolute; inset: -4px; border-radius: 50%; border: 1.5px solid rgb(42 143 196 / 0.6); opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .origin-live::after { animation: origin-ping 2.6s cubic-bezier(0.2, 0.7, 0.3, 1) infinite; }
  }
  @keyframes origin-ping {
    0% { transform: scale(0.5); opacity: 0.9; }
    80%, 100% { transform: scale(2.1); opacity: 0; }
  }
  /* Beside the marker, pointing at it; under it on phones, where there is no room beside */
  .origin-tip {
    position: absolute;
    left: calc(100% + 12px);
    top: 50%;
    z-index: 5;
    width: max-content;
    max-width: min(17rem, 70vw);
    padding: 0.6rem 0.85rem;
    border-radius: 12px;
    background: linear-gradient(180deg, #1a2c40, #111f30);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), 0 14px 28px -12px rgb(12 26 41 / 0.55), 0 2px 6px rgb(12 26 41 / 0.15);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.45;
    text-wrap: pretty;
    color: #e6eff8;
    opacity: 0;
    translate: -4px -50%;
    pointer-events: none;
    transition: opacity 220ms var(--ease), translate 260ms var(--ease-out);
  }
  .origin-tip::before {
    content: '';
    position: absolute;
    top: 50%;
    left: -4px;
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 2px;
    background: #172a3d;
    rotate: 45deg;
  }
  .project-origin:hover .origin-tip,
  .project-origin:focus .origin-tip { opacity: 1; translate: 0 -50%; }
