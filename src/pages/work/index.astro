---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Honeycomb from '../../components/Honeycomb.astro';
import ResultVisual from '../../components/ResultVisual.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import { iconFor, headline, plainTitle as plain } from '../../lib/work';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);


/**
 * Case study bodies are short markdown: a few "## Heading" sections of plain
 * paragraphs. They are shown as side-by-side columns in each project's details.
 */
const sectionsOf = (body = '') =>
  body
    .split(/^## /m)
    .slice(1)
    .map((chunk) => {
      const [heading, ...rest] = chunk.split('\n');
      const paras = rest
        .join('\n')
        .split(/\n\s*\n/)
        .map((p) => p.replace(/\s+/g, ' ').trim())
        .filter(Boolean);
      return { heading: heading.trim(), paras };
    });


---

<Base
  title="Our Work"
  description="What the people behind Spockhart have delivered: platforms, marketplaces, sales systems, production floors and engineering prototypes. Client names withheld."
>
  <PageHero
    class="work-hero"
    theme="work"
    title="Our team’s experience."
    lead="Spockhart is a new firm built on years of experience. Our team has transformed operations and built technology at some of North America’s largest organizations, with the examples below drawn from previous roles."
  >
    <Honeycomb slot="figure" />
  </PageHero>

  <section class="projects" aria-label="Projects" data-projects>
    {
      all.map((entry, i) => {
        const d = entry.data;
        const live = d.status === 'in-development';
        const panelId = `${entry.id}-details`;
        return (
          <article id={entry.id} class:list={['project', { flip: i % 2 === 1, dark: i % 2 === 1 }]} data-project>
            <div class="wrap project-grid">
              <div class="project-text" data-reveal>
                <p class="project-kicker">
                  Case study {String(i + 1).padStart(2, '0')}
                  <span class="kicker-sep" aria-hidden="true" />
                  {d.sector}
                </p>
                <p class="project-client">
                  <span class="client-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d={iconFor(entry.id)} />
                    </svg>
                  </span>
                  <span class="client-name">{d.client}</span>
                </p>
                <h2>{headline(d.title).map((part, k) => (k % 2 ? <span class="hl">{part}</span> : part))}</h2>
                <button class="cs-toggle at-text" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
              <div class="project-visual" data-reveal>
                <ResultVisual id={entry.id} />
                <button class="cs-toggle at-visual" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="cs-panel" id={panelId} data-panel data-open="false" role="region" aria-label={`${plain(d.title)} details`}>
              <div class="cs-panel-inner">
                <div class="wrap">
                  <div class:list={['cs-card', { 'on-light': i % 2 === 1 }]}>
                    <ul class="cs-metrics">
                      {d.metrics.map((m) => (
                        <li>
                          <span class="cs-m-value">{m.value}</span>
                          <span class="cs-m-label">{m.label}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="cs-cols">
                      {sectionsOf(entry.body).map((s) => (
                        <div class="cs-col">
                          <h3>{s.heading}</h3>
                          <div class="cs-text">
                            {s.paras.map((p) => (
                              <p>{p}</p>
                            ))}
                          </div>
                        </div>
                      ))}
                    </div>
                    <p class="cs-foot">
                      <span>
                        {live
                          ? 'Being built by a member of our team in a current role. Not a Spockhart engagement. Client name withheld.'
                          : 'Led by a member of our team in a previous role. Not a Spockhart engagement. Client name withheld.'}
                      </span>
                      <span class="cs-scope">Scope: {d.scope}</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <noscript>
    <style>
      .cs-panel { grid-template-rows: 1fr !important; }
      .cs-panel-inner { visibility: visible !important; }
      .cs-toggle { display: none !important; }
    </style>
  </noscript>

  <ClosingCTA terse title="Your operation could be next." />
</Base>

<script>
  // Each project opens its details in place. A link to /work/#project-id opens that one.
  function initProjects() {
    const root = document.querySelector<HTMLElement>('[data-projects]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // Each project has two buttons: under the headline on laptops, under the graphic on
    // phones and tablets. Only one shows at a time; both stay in step.
    const set = (project: HTMLElement, open: boolean) => {
      const panel = project.querySelector<HTMLElement>('[data-panel]');
      if (!panel) return;
      panel.dataset.open = String(open);
      project.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
        const label = toggle.querySelector('[data-label]');
        if (label) label.textContent = open ? 'Hide the details' : 'See the details';
      });
    };

    root.querySelectorAll<HTMLElement>('[data-project]').forEach((project) => {
      project.querySelectorAll('[data-toggle]').forEach((toggle) =>
        toggle.addEventListener('click', () => {
          set(project, project.querySelector<HTMLElement>('[data-panel]')?.dataset.open !== 'true');
        }),
      );
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const project = id ? root.querySelector<HTMLElement>(`[data-project][id="${CSS.escape(id)}"]`) : null;
      if (!project) return;
      set(project, true);
      requestAnimationFrame(() => project.scrollIntoView({ block: 'start' }));
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
  initProjects();
  document.addEventListener('spockhart:view', initProjects);
</script>

<style>
  .project { padding-block: clamp(3.5rem, 2rem + 4.5vw, 6.5rem); border-bottom: 1px solid var(--rule); scroll-margin-top: 72px; }
  /* Every other case study is set deep and dark, so the page changes as you scroll. The light
     detail sheet stays light inside it. */
  .project.dark {
    --ink: #eef3f8;
    --ink-2: #b5c4d3;
    --ink-3: #94a8bc;
    --rule: rgb(255 255 255 / 0.1);
    --rule-2: rgb(255 255 255 / 0.22);
    --accent: #8ec0e6;
    --accent-soft: #6fa8d6;
    position: relative;
    color: var(--ink);
    border-bottom-color: transparent;
    background:
      radial-gradient(50% 75% at 22% 50%, rgb(40 98 146 / 0.42), transparent 72%),
      radial-gradient(40% 60% at 100% 0%, rgb(54 66 128 / 0.28), transparent 72%),
      linear-gradient(170deg, #0c1826 0%, #10223a 100%);
  }
  .project.dark h2 { color: var(--ink); }
  .project.dark .client-mark::before { background: #eef3f8; }
  .project.dark .client-mark svg { stroke: #14212f; }
  .project.dark .cs-toggle:hover { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.4); }
  .project.dark .project-visual > :global(.rv) { box-shadow: 0 30px 60px -36px rgb(0 0 0 / 0.6); }
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: center;
  }
  /* Flipped rows swap sides but keep the graphic in the wider column */
  .flip .project-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .flip .project-text { order: 2; }
  .project-text { display: grid; gap: var(--s-4); justify-items: start; align-content: center; }

  /* "Case study 01 · Sector": says plainly what this is */
  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kicker-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-soft); }

  /* The client, as named as we can: an industry mark where the logo would be */
  .project-client { display: flex; align-items: center; gap: 0.85rem; }
  .client-mark { position: relative; flex: none; display: grid; place-items: center; width: 44px; height: 50px; }
  .client-mark::before { content: ''; position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .client-mark svg { position: relative; width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .client-name { font-family: var(--font-display); font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.75rem); line-height: 1.15; color: var(--ink); }

  .project-text h2 { font-size: var(--step-3); line-height: 1.12; max-width: 22ch; }
  .project-text h2 .hl { color: var(--accent); }
  .project-text .cs-toggle { margin-top: var(--s-2); }
  .cs-toggle.at-visual { display: none; }
  .project-visual { min-width: 0; display: grid; gap: var(--s-4); justify-items: start; }
  .project-visual > :global(.rv) { justify-self: stretch; }

  .cs-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem 0.6rem 1.1rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .cs-toggle:hover { background: var(--surface); border-color: var(--ink-3); }
  .cs-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 400ms var(--ease-out); }
  .cs-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* ---------- The details, laid out like a case study sheet ---------- */
  .cs-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 550ms var(--ease-out); }
  .cs-panel[data-open='true'] { grid-template-rows: 1fr; }
  .cs-panel-inner { min-height: 0; overflow: hidden; }
  .cs-panel[data-open='false'] .cs-panel-inner { visibility: hidden; transition: visibility 0s 550ms; }
  .cs-card {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding: clamp(1.25rem, 0.9rem + 1.3vw, 2rem) clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  /* Results: values on one line across, labels lined up underneath */
  .cs-metrics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0 var(--s-6);
  }
  .cs-metrics li {
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    gap: 0.3rem;
    padding-top: var(--s-3);
    border-top: 2px solid var(--ink);
  }
  .cs-m-value {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variant-numeric: lining-nums;
  }
  .cs-m-label { font-size: 0.8125rem; color: var(--ink-2); line-height: 1.4; }
  /* The story: one row each, label on the left */
  .cs-cols { display: grid; border-top: 1px solid var(--rule); }
  .cs-col {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
  .cs-col h3 { padding-top: 0.3rem; font-family: var(--font-body); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .cs-text { display: grid; gap: var(--s-2); }
  .cs-text p { color: var(--ink-2); font-size: 0.9375rem; line-height: 1.55; }
  .cs-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-5);
    margin-top: calc(var(--s-2) * -1);
    font-size: 0.8125rem;
    color: var(--ink-3);
  }

  @media (max-width: 960px) {
    .project-grid, .flip .project-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .flip .project-text { order: 0; }
    .cs-toggle.at-text { display: none; }
    .cs-toggle.at-visual { display: inline-flex; }
  }
  /* Phones: tighter, same content */
  @media (max-width: 640px) {
    .project { padding-block: 2.5rem; }
    .project-grid, .flip .project-grid { gap: var(--s-5); }
    .project-text { gap: 0.65rem; }
    .project-kicker { font-size: 0.6875rem; }
    .client-mark { width: 36px; height: 41px; }
    .client-mark svg { width: 18px; height: 18px; }
    .client-name { font-size: 1.25rem; }
    .project-text h2 { font-size: 1.375rem; max-width: none; }
    .cs-toggle { padding: 0.45rem 0.85rem 0.45rem 0.95rem; font-size: 0.875rem; }
    .cs-card { margin-top: var(--s-5); gap: var(--s-5); }
    .cs-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s-4); }
    .cs-metrics li { padding-top: var(--s-3); margin-bottom: var(--s-4); }
    .cs-m-value { font-size: 1.125rem; }
    .cs-m-label { font-size: 0.8125rem; }
    .cs-col { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); padding-block: var(--s-3); }
    .cs-text p { font-size: 0.9375rem; }
    :global(.work-hero .hero-figure) { display: none; }
  }
</style>
