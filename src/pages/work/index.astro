---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HeroLive from '../../components/HeroLive.astro';
import ResultVisual from '../../components/ResultVisual.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';
import KitMatchVisual from '../../components/KitMatchVisual.astro';
import KbkLogo from '../../components/KbkLogo.astro';
import { iconFor, headline, plainTitle as plain } from '../../lib/work';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
/* The engagement we are in now leads the page, in its own card; our team's earlier projects follow */
const feature = all.find((e) => e.data.kind === 'spockhart');
const past = all.filter((e) => e.data.kind !== 'spockhart');

/* Kids Being Kids: the plan, by month. `now` is the step under way, moved on by hand as the work
   moves, so the page never claims a step that hasn't happened. */
const plan = [
  { name: 'Map and baseline', when: 'November 2026' },
  { name: 'Build KitMatch', when: 'November to December' },
  { name: 'Winter test', when: 'January to February' },
  { name: 'Spring drives', when: 'March to April' },
  { name: 'Kits handed off', when: 'April to May' },
  { name: 'Results and handover', when: 'May 2027' },
];
const now = 0;


/**
 * Case study bodies are short markdown: a few "## Heading" sections of plain paragraphs and short
 * "- " lists. They are shown as rows in each project's details.
 */
type Block = { list: false; text: string } | { list: true; items: string[] };
const sectionsOf = (body = '') =>
  body
    .split(/^## /m)
    .slice(1)
    .map((chunk) => {
      const [heading, ...rest] = chunk.split('\n');
      const blocks: Block[] = rest
        .join('\n')
        .split(/\n\s*\n/)
        .map((b) => b.trim())
        .filter(Boolean)
        .map((b) => {
          const lines = b.split('\n').map((l) => l.trim());
          return lines.every((l) => l.startsWith('- '))
            ? { list: true as const, items: lines.map((l) => l.slice(2).trim()) }
            : { list: false as const, text: b.replace(/\s+/g, ' ') };
        });
      return { heading: heading.trim(), blocks };
    });


---

<Base
  title="Our Work"
  description="Kids Being Kids, the engagement we are in now, and what the people behind Spockhart have delivered before: platforms, sales systems, production floors and engineering prototypes."
  lightHero
>

  <!-- One light room from top to bottom. It opens on a dark card, standing just under the header,
       with the page's title and the live revenue vs costs chart; the case studies follow. -->
  <div class="page-body work-body room-light" data-body>
  <section class="work-top" aria-labelledby="work-title">
    <div class="work-stage stand">
      <div class="work-card" data-tilt="3" data-tilt-depth="2600">
        <div class="work-copy">
          <h1 id="work-title" class="load-in" style="--i:1">Our team’s experience.</h1>
          <div class="accent-rule load-in" style="--i:2"></div>
          <p class="work-note load-in" style="--i:3">
            <strong>Please note:</strong> some of these projects were led or worked on by our team before Spockhart, and their client names are withheld.
          </p>
        </div>
        <div class="work-figure load-fade">
          <HeroLive inline />
        </div>
      </div>
    </div>
  </section>

  <section class="projects" aria-label="Projects" data-projects>
    {
      feature && (
        <article id={feature.id} class="kbk" aria-labelledby="kbk-title" data-project>
          <div class="kbk-wide stand" data-reveal>
            <div class="kbk-card" data-tilt="2" data-tilt-depth="3000">
              <div class="kbk-text">
                <p class="kbk-status">
                  <span class="kbk-live" aria-hidden="true" />
                  {feature.data.origin}
                  <span class="kbk-sep" aria-hidden="true" />
                  <span class="kbk-status-l">Spockhart engagement</span>
                </p>
                <div class="kbk-client">
                  <span class="kbk-mark">
                    <KbkLogo />
                  </span>
                  <span class="kbk-who">
                    <span class="kbk-name">{feature.data.client}</span>
                    <span class="kbk-where">
                      {feature.data.sector} · {feature.data.location}
                    </span>
                  </span>
                </div>
                <h2 id="kbk-title">
                  {headline(feature.data.title).map((part, k) => (k % 2 ? <span class="hl">{part}</span> : part))}
                </h2>
                <p class="kbk-lead">{feature.data.summary}</p>
                <ul class="kbk-facts">
                  <li>
                    <span class="kbk-f-v">KitMatch</span>
                    <span class="kbk-f-l">What we’re building</span>
                  </li>
                  <li>
                    <span class="kbk-f-v">Every sport</span>
                    <span class="kbk-f-l">Not just shoes, and every partner program</span>
                  </li>
                  <li>
                    <span class="kbk-f-v">150 kids</span>
                    <span class="kbk-f-l">Fully kitted in the first season, our target</span>
                  </li>
                </ul>
                <button class="cs-toggle kbk-toggle" type="button" aria-expanded="false" aria-controls={`${feature.id}-details`} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
              <div class="kbk-display">
                <KitMatchVisual chapters />
              </div>
              <div class="kbk-plan">
                <div class="kbk-plan-head">
                  <h3>The plan</h3>
                  <p>Built over the winter, proven over one season.</p>
                </div>
                <ol class="kbk-rail" style={`--now:${now}`}>
                  {plan.map((p, i) => (
                    <li class:list={[{ 'is-now': i === now, 'is-done': i < now }]} aria-current={i === now ? 'step' : undefined}>
                      <span class="kbk-node" aria-hidden="true" />
                      {i === now && <span class="kbk-now">Now</span>}
                      <span class="kbk-p-name">{p.name}</span>
                      <span class="kbk-p-when">{p.when}</span>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          </div>

          <div class="cs-panel" id={`${feature.id}-details`} data-panel data-open="false" role="region" aria-label={`${feature.data.client} details`}>
            <div class="cs-panel-inner">
              <div class="kbk-wide kbk-sheet-wrap">
                <div class="cs-card kbk-sheet" data-tilt="3" data-tilt-depth="2600">
                  <p class="kbk-sheet-head">
                    <span class="kbk-sheet-title">The scorecard</span>
                    <span class="kbk-sheet-note">Targets for the first season, spring 2027</span>
                  </p>
                  <ul class="cs-metrics">
                    {feature.data.metrics.map((m) => (
                      <li>
                        <span class="cs-m-value">{m.value}</span>
                        <span class="cs-m-label">{m.label}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="cs-cols">
                    {sectionsOf(feature.body).map((s) => (
                      <div class="cs-col">
                        <h3>{s.heading}</h3>
                        <div class="cs-text">
                          {s.blocks.map((b) =>
                            b.list ? (
                              <ul class="cs-list">
                                {b.items.map((item) => (
                                  <li>{item}</li>
                                ))}
                              </ul>
                            ) : (
                              <p>{b.text}</p>
                            ),
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                  <p class="cs-foot">
                    <span>Every figure here is a target until the pilot reports its results in May 2027.</span>
                    <span class="cs-scope">Scope: {feature.data.scope}</span>
                  </p>
                </div>
              </div>
            </div>
          </div>
        </article>
      )
    }
    {
      past.map((entry, i) => {
        const d = entry.data;
        const panelId = `${entry.id}-details`;
        return (
          <article id={entry.id} class:list={['project', { flip: i % 2 === 1, tint: i % 2 === 1 }]} data-project>
            <div class="wrap project-grid">
              <div class="project-text" data-reveal>
                <p class="project-origin">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M2.5 8a5.5 5.5 0 1 0 1.6-3.9 M2.4 2.6v2.6H5 M8 5.2V8l2 1.3" />
                  </svg>
                  {d.origin}
                </p>
                <p class="project-kicker">
                  Case study {String(i + 1).padStart(2, '0')}
                  <span class="kicker-sep" aria-hidden="true" />
                  {d.sector}
                </p>
                <p class="project-client">
                  <span class="client-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d={iconFor(entry.id)} />
                    </svg>
                  </span>
                  <span class="client-name">{d.client}</span>
                </p>
                <h2>{headline(d.title).map((part, k) => (k % 2 ? <span class="hl">{part}</span> : part))}</h2>
                <button class="cs-toggle at-text" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
              <div class="project-visual" data-reveal>
                <div class="rv-stage" data-tilt="4" data-tilt-depth="1800">
                  <ResultVisual id={entry.id} />
                </div>
                <button class="cs-toggle at-visual" type="button" aria-expanded="false" aria-controls={panelId} data-toggle>
                  <span data-label>See the details</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M3.5 6l4.5 4.5L12.5 6" />
                  </svg>
                </button>
              </div>
            </div>

            <div class="cs-panel" id={panelId} data-panel data-open="false" role="region" aria-label={`${plain(d.title)} details`}>
              <div class="cs-panel-inner">
                <div class="wrap">
                  <div class="cs-card" data-tilt="3" data-tilt-depth="2600">
                    <ul class="cs-metrics">
                      {d.metrics.map((m) => (
                        <li>
                          <span class="cs-m-value">{m.value}</span>
                          <span class="cs-m-label">{m.label}</span>
                        </li>
                      ))}
                    </ul>
                    <div class="cs-cols">
                      {sectionsOf(entry.body).map((s) => (
                        <div class="cs-col">
                          <h3>{s.heading}</h3>
                          <div class="cs-text">
                            {s.blocks.map((b) =>
                              b.list ? (
                                <ul class="cs-list">
                                  {b.items.map((item) => (
                                    <li>{item}</li>
                                  ))}
                                </ul>
                              ) : (
                                <p>{b.text}</p>
                              ),
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                    <p class="cs-foot">
                      <span>
                        Client name withheld.
                      </span>
                      <span class="cs-scope">Scope: {d.scope}</span>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <noscript>
    <style>
      .cs-panel { grid-template-rows: 1fr !important; }
      .cs-panel-inner { visibility: visible !important; }
      .cs-toggle { display: none !important; }
    </style>
  </noscript>

  <ClosingCTA terse title="Your operation could be next." />
  </div>
</Base>

<script>
  // Each project opens its details in place. A link to /work/#project-id opens that one.
  function initProjects() {
    const root = document.querySelector<HTMLElement>('[data-projects]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = '1';

    // Each project has two buttons: under the headline on laptops, under the graphic on
    // phones and tablets. Only one shows at a time; both stay in step.
    const set = (project: HTMLElement, open: boolean) => {
      const panel = project.querySelector<HTMLElement>('[data-panel]');
      if (!panel) return;
      panel.dataset.open = String(open);
      // Once it has opened, the card's shadow may reach past the panel's edge; while it opens or
      // closes, the panel clips it so the slide stays clean
      clearTimeout(Number(panel.dataset.settle));
      panel.classList.remove('is-settled');
      if (open) panel.dataset.settle = String(window.setTimeout(() => panel.classList.add('is-settled'), 600));
      project.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(open));
        const label = toggle.querySelector('[data-label]');
        if (label) label.textContent = open ? 'Hide the details' : 'See the details';
      });
    };

    root.querySelectorAll<HTMLElement>('[data-project]').forEach((project) => {
      project.querySelectorAll('[data-toggle]').forEach((toggle) =>
        toggle.addEventListener('click', () => {
          set(project, project.querySelector<HTMLElement>('[data-panel]')?.dataset.open !== 'true');
        }),
      );
    });

    const fromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      const project = id ? root.querySelector<HTMLElement>(`[data-project][id="${CSS.escape(id)}"]`) : null;
      if (!project) return;
      set(project, true);
      requestAnimationFrame(() => project.scrollIntoView({ block: 'start' }));
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
  initProjects();
  document.addEventListener('spockhart:view', initProjects);
</script>

<style>
  /* ---------- One light room, top to bottom ----------
     Its rounded bottom overlaps the footer a little, so the footer shows in its corners, as on the
     home page. */
  .work-body {
    --sheet-r: 32px;
    z-index: 1;
    margin-bottom: calc(var(--sheet-r) * -1);
    border-radius: 0 0 var(--sheet-r) var(--sheet-r);
    box-shadow: 0 28px 60px -24px rgb(0 0 0 / 0.5);
  }
  .work-body.room-light::after { border-radius: inherit; }
  .work-body :global(.closing) { border-top: 0; }
  @media (max-width: 640px) {
    .work-body { --sheet-r: 22px; }
  }

  /* ---------- The opening card ----------
     Midnight blue, as in the home page's hero: the brand's steel light rising in one corner, a fine
     grain, a lit top edge, and its shadow on the floor (.stand). The title and the note on the
     left, the live chart on the right. As wide as the closing card. */
  .work-top { padding-top: clamp(7rem, 5.5rem + 3.5vw, 9.5rem); padding-bottom: clamp(1.5rem, 0.75rem + 2vw, 3rem); }
  .work-stage { max-width: var(--max); margin-inline: auto; }
  .work-top { padding-inline: max(var(--gutter), env(safe-area-inset-left, 0px)); }
  @media (min-width: 1100px) {
    .work-stage {
      --reach: clamp(0px, max(var(--gutter), (100vw - var(--max)) / 2) - 2.5rem, 4rem);
      max-width: calc(var(--max) + var(--reach));
    }
  }
  .work-card {
    --ink: #eef3f8;
    --ink-2: #b5c4d3;
    --accent: #8ec0e6;
    --accent-soft: #6fa8d6;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: center;
    padding: clamp(2.5rem, 1.5rem + 3.5vw, 4.75rem) clamp(1.75rem, 0.75rem + 4vw, 5rem);
    border-radius: 28px;
    color: var(--ink);
    background:
      radial-gradient(55% 90% at 85% 15%, rgb(46 104 152 / 0.5), transparent 70%),
      radial-gradient(50% 80% at 0% 110%, rgb(42 95 142 / 0.32), transparent 72%),
      radial-gradient(40% 60% at 35% -10%, rgb(56 66 132 / 0.28), transparent 72%),
      linear-gradient(165deg, #09131e 0%, #0d1c2d 55%, #10233a 100%);
    box-shadow: var(--lift-dark);
  }
  .work-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    background-image: var(--grain);
    background-size: 200px;
    opacity: 0.12;
    mix-blend-mode: overlay;
  }
  .work-copy { display: grid; gap: var(--s-5); justify-items: start; }
  .work-copy h1 { max-width: 9ch; color: #fff; text-shadow: 0 12px 26px rgb(0 0 0 / 0.3); }
  .work-figure { width: 100%; max-width: 440px; justify-self: end; }
  .work-figure :global(.live-inline) { max-width: none; }
  /* The disclaimer: plain, set apart by a fine rule, a step quieter than the title */
  .work-note {
    max-width: 30rem;
    margin-top: var(--s-2);
    padding-left: 0.95rem;
    border-left: 2px solid var(--accent-soft);
    font-size: 0.875rem;
    line-height: 1.55;
    text-wrap: pretty;
    color: var(--ink-2);
  }
  .work-note strong { font-weight: 600; color: var(--ink); }
  @media (max-width: 960px) {
    .work-card { grid-template-columns: minmax(0, 1fr); }
    .work-figure { justify-self: start; max-width: 420px; }
  }
  @media (max-width: 640px) {
    .work-top { padding-top: 5.5rem; padding-bottom: 1.75rem; }
    .work-card { border-radius: 20px; }
    .work-figure { display: none; }
  }

  /* Each case study: a pool of light on the wall behind its graphic, fading out well before the
     edges of the case study, so nothing ever meets on a line */
  .project {
    --pool-x: 70%;
    padding-block: clamp(3.5rem, 2rem + 4.5vw, 6.5rem);
    scroll-margin-top: 72px;
    background: radial-gradient(46% 40% at var(--pool-x) 50%, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.3) 45%, transparent 72%);
  }
  .project.flip { --pool-x: 30%; }
  .project-visual :global(.scene) { will-change: transform; }
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: center;
  }
  /* Flipped rows swap sides but keep the graphic in the wider column */
  .flip .project-grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .flip .project-text { order: 2; }
  .project-text { display: grid; gap: var(--s-4); justify-items: start; align-content: center; }

  /* Above each project: when it was done (before Spockhart), so no one mistakes it for a Spockhart engagement */
  .project-origin {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.8rem 0.35rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.04);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-2);
  }
  .project-origin svg { width: 14px; height: 14px; flex: none; fill: none; stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }

  /* "Case study 01 · Sector": says plainly what this is */
  .project-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .kicker-sep { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-soft); }

  /* The client, as named as we can: an industry mark where the logo would be */
  .project-client { display: flex; align-items: center; gap: 0.85rem; }
  .client-mark { position: relative; flex: none; display: grid; place-items: center; width: 44px; height: 50px; }
  .client-mark::before { content: ''; position: absolute; inset: 0; clip-path: var(--hex); background: var(--ink); }
  .client-mark svg { position: relative; width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .client-name { font-family: var(--font-display); font-size: clamp(1.375rem, 1.15rem + 0.7vw, 1.75rem); line-height: 1.15; color: var(--ink); }

  .project-text h2 { font-size: var(--step-3); line-height: 1.12; max-width: 22ch; }
  .project-text h2 .hl { color: var(--accent); }
  .project-text .cs-toggle { margin-top: var(--s-2); }
  .cs-toggle.at-visual { display: none; }
  .project-visual { min-width: 0; display: grid; gap: var(--s-4); justify-items: start; }

  .cs-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem 0.6rem 1.1rem;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
    background: transparent;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    transition: background-color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .cs-toggle:hover { background: rgb(255 255 255 / 0.08); border-color: rgb(255 255 255 / 0.4); }
  .cs-toggle svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: transform 400ms var(--ease-out); }
  .cs-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }

  /* ---------- The details, laid out like a case study sheet ---------- */
  .cs-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 550ms var(--ease-out); }
  .cs-panel[data-open='true'] { grid-template-rows: 1fr; }
  .cs-panel-inner { min-height: 0; overflow: hidden; }
  .cs-panel[data-open='false'] .cs-panel-inner { visibility: hidden; transition: visibility 0s 550ms; }
  .cs-card {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding: clamp(1.25rem, 0.9rem + 1.3vw, 2rem) clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  /* Results: values on one line across, labels lined up underneath */
  .cs-metrics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 0 var(--s-6);
  }
  .cs-metrics li {
    grid-row: span 2;
    display: grid;
    grid-template-rows: subgrid;
    gap: 0.3rem;
    padding-top: var(--s-3);
    border-top: 2px solid var(--ink);
  }
  .cs-m-value {
    align-self: end;
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-variant-numeric: lining-nums;
  }
  .cs-m-label { font-size: 0.8125rem; color: var(--ink-2); line-height: 1.4; }
  /* The story: one row each, label on the left */
  .cs-cols { display: grid; border-top: 1px solid var(--rule); }
  .cs-col {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
  }
