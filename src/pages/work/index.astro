---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Honeycomb from '../../components/Honeycomb.astro';
import ResultVisual from '../../components/ResultVisual.astro';
import ClosingCTA from '../../components/ClosingCTA.astro';

const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const done = all.filter((e) => e.data.status === 'complete');
const current = all.filter((e) => e.data.status === 'in-development');
---

<Base
  title="Work"
  description="What the people behind Spockhart have delivered: platforms, marketplaces, sales systems, production floors and engineering prototypes. Client names withheld."
>
  <PageHero
    eyebrow="Work"
    title="Our team’s experience."
    lead="Spockhart is a new firm. The people behind it are not."
  >
    <p class="hero-more">
      Before Spockhart, our team led transformations, built technology, and solved operational problems inside some of North
      America’s largest organizations. These are a few examples of what we’ve delivered.
    </p>
    <p class="disclosure">
      Projects were led by members of our team in previous roles. They were not Spockhart engagements. Client names withheld.
    </p>
    <Honeycomb slot="figure" />
  </PageHero>

  <section class="projects" aria-label="Projects">
    {
      done.map((entry, i) => (
        <article class:list={['project', { flip: i % 2 === 1, tint: i % 2 === 1 }]}>
          <div class="wrap project-grid">
            <div class="project-text" data-reveal>
              <p class="project-meta">
                <span class="tag">{entry.data.kind === 'spockhart' ? 'Spockhart client work' : 'Team experience'}</span>
                <span>{entry.data.sector}</span>
              </p>
              <h2>
                <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
              </h2>
              <p class="project-summary">{entry.data.summary}</p>
              <p class="project-client">{entry.data.client}</p>
              <a class="arrow-link" href={`/work/${entry.id}/`}>
                <span>Read the case study</span>
                <span class="arr" aria-hidden="true">→</span>
              </a>
            </div>
            <div class="project-visual" data-reveal>
              <ResultVisual id={entry.id} />
            </div>
          </div>
        </article>
      ))
    }
  </section>

  {
    current.length > 0 && (
      <section class="projects current" aria-labelledby="current-title">
        <div class="wrap current-head" data-reveal>
          <p class="eyebrow">Currently in development</p>
          <h2 id="current-title">What our team is building now.</h2>
        </div>
        {current.map((entry) => (
          <article class="project">
            <div class="wrap project-grid">
              <div class="project-text" data-reveal>
                <p class="project-meta">
                  <span class="tag tag-live">In development</span>
                  <span>{entry.data.sector}</span>
                </p>
                <h2>
                  <a href={`/work/${entry.id}/`}>{entry.data.title}</a>
                </h2>
                <p class="project-summary">{entry.data.summary}</p>
                <p class="project-client">{entry.data.client}</p>
                <a class="arrow-link" href={`/work/${entry.id}/`}>
                  <span>Read more</span>
                  <span class="arr" aria-hidden="true">→</span>
                </a>
              </div>
              <div class="project-visual" data-reveal>
                <ResultVisual id={entry.id} />
              </div>
            </div>
          </article>
        ))}
      </section>
    )
  }

  <ClosingCTA title="Your operation could be next." />
</Base>

<style>
  .disclosure {
    display: inline-flex;
    gap: 0.6rem;
    align-items: baseline;
    max-width: 52ch;
    font-size: 0.875rem;
    color: var(--ink-3);
    padding-left: 0.9rem;
    border-left: 2px solid var(--accent-soft);
  }
  .project { padding-block: clamp(4rem, 2.5rem + 5vw, 7rem); border-bottom: 1px solid var(--rule); }
  .project.tint { background: var(--paper-2); }
  .project-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: center;
  }
  .flip .project-text { order: 2; }
  .project-text { display: grid; gap: var(--s-4); justify-items: start; align-content: center; }
  .project-meta { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; font-size: 0.875rem; color: var(--ink-3); }
  .project-text h2 { font-size: var(--step-3); line-height: 1.1; max-width: 18ch; }
  .hero-more { color: var(--ink-2); max-width: 54ch; }
  .current { background: var(--paper-2); border-top: 1px solid var(--rule); }
  .current-head { display: grid; gap: var(--s-2); padding-top: clamp(4rem, 2.5rem + 5vw, 6rem); }
  .current-head h2 { font-size: var(--step-4); }
  .current .project { border-bottom: 0; padding-top: var(--s-7); }
  .tag-live { background: var(--accent-wash); color: var(--brand); border-color: transparent; }
  .project-text h2 a { color: inherit; text-decoration: none; }
  .project-text h2 a:hover { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--accent-soft); text-underline-offset: 6px; }
  .project-summary { color: var(--ink-2); font-size: var(--step-1); max-width: 44ch; }
  .project-client { font-size: 0.875rem; color: var(--ink-3); }
  .project-visual { min-width: 0; }
  @media (max-width: 960px) {
    .project-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .flip .project-text { order: 0; }
  }
</style>
